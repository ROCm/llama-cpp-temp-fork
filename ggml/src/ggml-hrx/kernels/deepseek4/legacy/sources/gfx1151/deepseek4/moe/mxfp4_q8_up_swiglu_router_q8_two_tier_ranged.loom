              %s29_scale_i8 = view.load %slot_view[%s29_addr0] : view<274877906944xi8, #dense> -> i8
              %s29_payload_addr = index.add %s29_addr0, %one : index
              %s29_payload_i8 = vector.load %slot_view[%s29_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s29_scale_i8, %s29_payload_i8 : i8, vector<16xi8>
            }
            case 6 {
              %s30_addr0 = index.add %segment30_base, %plane_byte : index
              %s30_scale_i8 = view.load %slot_view[%s30_addr0] : view<274877906944xi8, #dense> -> i8
              %s30_payload_addr = index.add %s30_addr0, %one : index
              %s30_payload_i8 = vector.load %slot_view[%s30_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s30_scale_i8, %s30_payload_i8 : i8, vector<16xi8>
            }
            default {
              %s31_addr0 = index.add %segment31_base, %plane_byte : index
              %s31_scale_i8 = view.load %slot_view[%s31_addr0] : view<274877906944xi8, #dense> -> i8
              %s31_payload_addr = index.add %s31_addr0, %one : index
              %s31_payload_i8 = vector.load %slot_view[%s31_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s31_scale_i8, %s31_payload_i8 : i8, vector<16xi8>
            }
            }
            scf.yield %g3_scale_i8, %g3_payload_i8 : i8, vector<16xi8>
          }
          case 4 {
            %g4_scale_i8, %g4_payload_i8 = scf.switch %slot_in_group -> (i8, vector<16xi8>) {
            case 0 {
              %s32_addr0 = index.add %segment32_base, %plane_byte : index
              %s32_scale_i8 = view.load %slot_view[%s32_addr0] : view<274877906944xi8, #dense> -> i8
              %s32_payload_addr = index.add %s32_addr0, %one : index
              %s32_payload_i8 = vector.load %slot_view[%s32_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s32_scale_i8, %s32_payload_i8 : i8, vector<16xi8>
            }
            case 1 {
              %s33_addr0 = index.add %segment33_base, %plane_byte : index
              %s33_scale_i8 = view.load %slot_view[%s33_addr0] : view<274877906944xi8, #dense> -> i8
              %s33_payload_addr = index.add %s33_addr0, %one : index
              %s33_payload_i8 = vector.load %slot_view[%s33_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s33_scale_i8, %s33_payload_i8 : i8, vector<16xi8>
            }
            case 2 {
              %s34_addr0 = index.add %segment34_base, %plane_byte : index
              %s34_scale_i8 = view.load %slot_view[%s34_addr0] : view<274877906944xi8, #dense> -> i8
              %s34_payload_addr = index.add %s34_addr0, %one : index
              %s34_payload_i8 = vector.load %slot_view[%s34_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s34_scale_i8, %s34_payload_i8 : i8, vector<16xi8>
            }
            case 3 {
              %s35_addr0 = index.add %segment35_base, %plane_byte : index
              %s35_scale_i8 = view.load %slot_view[%s35_addr0] : view<274877906944xi8, #dense> -> i8
              %s35_payload_addr = index.add %s35_addr0, %one : index
              %s35_payload_i8 = vector.load %slot_view[%s35_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s35_scale_i8, %s35_payload_i8 : i8, vector<16xi8>
            }
            case 4 {
              %s36_addr0 = index.add %segment36_base, %plane_byte : index
              %s36_scale_i8 = view.load %slot_view[%s36_addr0] : view<274877906944xi8, #dense> -> i8
              %s36_payload_addr = index.add %s36_addr0, %one : index
              %s36_payload_i8 = vector.load %slot_view[%s36_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s36_scale_i8, %s36_payload_i8 : i8, vector<16xi8>
            }
            case 5 {
              %s37_addr0 = index.add %segment37_base, %plane_byte : index
              %s37_scale_i8 = view.load %slot_view[%s37_addr0] : view<274877906944xi8, #dense> -> i8
              %s37_payload_addr = index.add %s37_addr0, %one : index
              %s37_payload_i8 = vector.load %slot_view[%s37_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s37_scale_i8, %s37_payload_i8 : i8, vector<16xi8>
            }
            case 6 {
              %s38_addr0 = index.add %segment38_base, %plane_byte : index
              %s38_scale_i8 = view.load %slot_view[%s38_addr0] : view<274877906944xi8, #dense> -> i8
              %s38_payload_addr = index.add %s38_addr0, %one : index
              %s38_payload_i8 = vector.load %slot_view[%s38_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s38_scale_i8, %s38_payload_i8 : i8, vector<16xi8>
            }
            default {
              %s39_addr0 = index.add %segment39_base, %plane_byte : index
              %s39_scale_i8 = view.load %slot_view[%s39_addr0] : view<274877906944xi8, #dense> -> i8
              %s39_payload_addr = index.add %s39_addr0, %one : index
              %s39_payload_i8 = vector.load %slot_view[%s39_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s39_scale_i8, %s39_payload_i8 : i8, vector<16xi8>
            }
            }
            scf.yield %g4_scale_i8, %g4_payload_i8 : i8, vector<16xi8>
          }
          default {
            %g5_scale_i8, %g5_payload_i8 = scf.switch %slot_in_group -> (i8, vector<16xi8>) {
            case 0 {
              %s40_addr0 = index.add %segment40_base, %plane_byte : index
              %s40_scale_i8 = view.load %slot_view[%s40_addr0] : view<274877906944xi8, #dense> -> i8
              %s40_payload_addr = index.add %s40_addr0, %one : index
              %s40_payload_i8 = vector.load %slot_view[%s40_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s40_scale_i8, %s40_payload_i8 : i8, vector<16xi8>
            }
            case 1 {
              %s41_addr0 = index.add %segment41_base, %plane_byte : index
              %s41_scale_i8 = view.load %slot_view[%s41_addr0] : view<274877906944xi8, #dense> -> i8
              %s41_payload_addr = index.add %s41_addr0, %one : index
              %s41_payload_i8 = vector.load %slot_view[%s41_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s41_scale_i8, %s41_payload_i8 : i8, vector<16xi8>
            }
            default {
              %s42_addr0 = index.add %segment42_base, %plane_byte : index
              %s42_scale_i8 = view.load %slot_view[%s42_addr0] : view<274877906944xi8, #dense> -> i8
              %s42_payload_addr = index.add %s42_addr0, %one : index
              %s42_payload_i8 = vector.load %slot_view[%s42_payload_addr] : view<274877906944xi8, #dense> -> vector<16xi8>
              scf.yield %s42_scale_i8, %s42_payload_i8 : i8, vector<16xi8>
            }
            }
            scf.yield %g5_scale_i8, %g5_payload_i8 : i8, vector<16xi8>
          }
          }
          %scale_i32 = scalar.extui %scale_i8 : i8 to i32
          %payload_i32 = vector.bitcast %payload_i8 : vector<16xi8> to vector<4xi32>
          // Each payload byte is [high E2M1 nibble | low E2M1 nibble].
          // Decode four bytes at once with independent packed-byte arithmetic.
          // low produces logical K[0..15], high produces K[16..31].
          %nibble_mask = vector.constant 0x0f0f0f0f : vector<4xi32>
          %magnitude_mask = vector.constant 0x07070707 : vector<4xi32>
          %byte_ones = vector.constant 0x01010101 : vector<4xi32>
          %two_bit_mask = vector.constant 0x03030303 : vector<4xi32>
          %byte_fill = vector.constant 0x000000ff : vector<4xi32>
          %shift_one = vector.constant 1 : vector<4xi32>
          %shift_two = vector.constant 2 : vector<4xi32>
          %shift_three = vector.constant 3 : vector<4xi32>
          %shift_four = vector.constant 4 : vector<4xi32>
          %shift_seven = vector.constant 7 : vector<4xi32>

          %code_low = vector.andi %payload_i32, %nibble_mask : vector<4xi32>
          %payload_high0 = vector.shrui %payload_i32, %shift_four : vector<4xi32>
          %code_high = vector.andi %payload_high0, %nibble_mask : vector<4xi32>

          %low_mag0 = vector.andi %code_low, %magnitude_mask : vector<4xi32>
          %low_rem = vector.andi %low_mag0, %two_bit_mask : vector<4xi32>
          %low_rem_shift = vector.shrui %low_rem, %shift_one : vector<4xi32>
          %low_both0 = vector.andi %low_rem, %low_rem_shift : vector<4xi32>
          %low_both = vector.andi %low_both0, %byte_ones : vector<4xi32>
          %low_both_x2 = vector.shli %low_both, %shift_one : vector<4xi32>
          %low_extra = vector.addi %low_rem, %low_both_x2 : vector<4xi32>
          %low_high0 = vector.shrui %low_mag0, %shift_two : vector<4xi32>
          %low_high = vector.andi %low_high0, %byte_ones : vector<4xi32>
          %low_large_mask = vector.muli %low_high, %byte_fill : vector<4xi32>
          %low_large_extra = vector.andi %low_extra, %low_large_mask : vector<4xi32>
          %low_mag = vector.addi %low_mag0, %low_large_extra : vector<4xi32>
          %low_nz_s1 = vector.shrui %low_mag, %shift_one : vector<4xi32>
          %low_nz1 = vector.ori %low_mag, %low_nz_s1 : vector<4xi32>
          %low_nz_s2 = vector.shrui %low_nz1, %shift_two : vector<4xi32>
          %low_nz2 = vector.ori %low_nz1, %low_nz_s2 : vector<4xi32>
          %low_nonzero = vector.andi %low_nz2, %byte_ones : vector<4xi32>
          %low_sign0 = vector.shrui %code_low, %shift_three : vector<4xi32>
          %low_sign_raw = vector.andi %low_sign0, %byte_ones : vector<4xi32>
          %low_sign = vector.andi %low_sign_raw, %low_nonzero : vector<4xi32>
          %low_sign_mask = vector.muli %low_sign, %byte_fill : vector<4xi32>
          %low_signed0 = vector.xori %low_mag, %low_sign_mask : vector<4xi32>
          %decoded_low = vector.addi %low_signed0, %low_sign : vector<4xi32>

          %high_mag0 = vector.andi %code_high, %magnitude_mask : vector<4xi32>
          %high_rem = vector.andi %high_mag0, %two_bit_mask : vector<4xi32>
          %high_rem_shift = vector.shrui %high_rem, %shift_one : vector<4xi32>
          %high_both0 = vector.andi %high_rem, %high_rem_shift : vector<4xi32>
          %high_both = vector.andi %high_both0, %byte_ones : vector<4xi32>
          %high_both_x2 = vector.shli %high_both, %shift_one : vector<4xi32>
          %high_extra = vector.addi %high_rem, %high_both_x2 : vector<4xi32>
          %high_high0 = vector.shrui %high_mag0, %shift_two : vector<4xi32>
          %high_high = vector.andi %high_high0, %byte_ones : vector<4xi32>
          %high_large_mask = vector.muli %high_high, %byte_fill : vector<4xi32>
          %high_large_extra = vector.andi %high_extra, %high_large_mask : vector<4xi32>
          %high_mag = vector.addi %high_mag0, %high_large_extra : vector<4xi32>
          %high_nz_s1 = vector.shrui %high_mag, %shift_one : vector<4xi32>
          %high_nz1 = vector.ori %high_mag, %high_nz_s1 : vector<4xi32>
          %high_nz_s2 = vector.shrui %high_nz1, %shift_two : vector<4xi32>
          %high_nz2 = vector.ori %high_nz1, %high_nz_s2 : vector<4xi32>
          %high_nonzero = vector.andi %high_nz2, %byte_ones : vector<4xi32>
          %high_sign0 = vector.shrui %code_high, %shift_three : vector<4xi32>
          %high_sign_raw = vector.andi %high_sign0, %byte_ones : vector<4xi32>
          %high_sign = vector.andi %high_sign_raw, %high_nonzero : vector<4xi32>
          %high_sign_mask = vector.muli %high_sign, %byte_fill : vector<4xi32>
          %high_signed0 = vector.xori %high_mag, %high_sign_mask : vector<4xi32>
          %decoded_high = vector.addi %high_signed0, %high_sign : vector<4xi32>

          // kvalues_mxfp4 is twice the E2M1 value, so use half of the E8M0
          // scale: 2^(e-128). Preserve the two subnormal scales and NaN.
          %scale_is_small = scalar.cmpi ult, %scale_i32, %two_i32 : i32
          %small_shift = scf.select %scale_is_small, %scale_i32, %zero_i32 : i32
          %small_scale_bits = scalar.shli %minimum_scale_bits_i32, %small_shift : i32
          %normal_scale_safe = scf.select %scale_is_small, %one_i32, %scale_i32 : i32
          %normal_exponent = scalar.subi %normal_scale_safe, %one_i32 : i32
          %normal_scale_bits = scalar.shli %normal_exponent, %twentythree_i32 : i32
          %finite_scale_bits = scf.select %scale_is_small, %small_scale_bits, %normal_scale_bits : i32
          %scale_is_nan = scalar.cmpi eq, %scale_i32, %byte_mask_i32 : i32
          %scale_bits = scf.select %scale_is_nan, %quiet_nan_bits_i32, %finite_scale_bits : i32
          %scale_f32 = scalar.bitcast %scale_bits : i32 to f32
          scf.yield %decoded_low, %decoded_high, %scale_f32 : vector<4xi32>, vector<4xi32>, f32
        } else {
          scf.yield %zero_i32x4, %zero_i32x4, %zero_f32 : vector<4xi32>, vector<4xi32>, f32
        }
        %is_row0 = index.cmp eq, %row_phase, %zero : index
        %next_row0_low = scf.select %is_row0, %decoded_low, %carry_row0_low : vector<4xi32>
        %next_row0_high = scf.select %is_row0, %decoded_high, %carry_row0_high : vector<4xi32>
        %next_row0_scale = scf.select %is_row0, %weight_scale, %carry_row0_scale : f32
        %next_row1_low = scf.select %is_row0, %carry_row1_low, %decoded_low : vector<4xi32>
        %next_row1_high = scf.select %is_row0, %carry_row1_high, %decoded_high : vector<4xi32>
        %next_row1_scale = scf.select %is_row0, %carry_row1_scale, %weight_scale : f32
        scf.yield %next_row0_low, %next_row0_high, %next_row0_scale, %next_row1_low, %next_row1_high, %next_row1_scale : vector<4xi32>, vector<4xi32>, f32, vector<4xi32>, vector<4xi32>, f32
      }

      %chunk_accumulator, %chunk_accumulator_second = scf.for %inner_block = [%zero to %four step %one](%inner_acc = %acc, %inner_acc_second = %acc_second : vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
        %inner_k_offset = index.mul %inner_block, %thirtytwo : index
        %k_base = index.add %k_chunk, %inner_k_offset : index
        %act_buffer0 = index.rem %inner_block, %two : index
        %act_buffer = index.assume %act_buffer0 [range(%act_buffer0, 0, 1)] : index
        %act_buffer_is_zero = index.cmp eq, %act_buffer, %zero : index
      // One packed word per active lane covers the 16x32 Q8 tile.  The
      // native quantizer writes eight little-endian int8x4 words per K32 group;
      // keeping that representation makes both global and LDS accesses b32.
      %activation_word_lane = index.cmp ult, %lane, %twofiftysix : index
      scf.if %activation_word_lane {
        %match = index.div %lane, %eight : index
        %word_in_group = index.rem %lane, %eight : index
        %match_valid = index.cmp ult, %match, %window_match_count : index
        %activation_word = scf.if %match_valid -> (i32) {
          %token_i32 = view.load %tok_view[%match] : view<32xi32, #dense> -> i32
          %selected_i32 = view.load %sel_view[%match] : view<32xi32, #dense> -> i32
          %k_base_i32 = index.cast %k_base : index to i32
          %word_in_group_i32 = index.cast %word_in_group : index to i32
          %token_base_i32 = scalar.muli %token_i32, %down_token_stride_i32 : i32
          %selected_base_i32 = scalar.constant 0 : i32
          %source0_i32 = scalar.addi %token_base_i32, %selected_base_i32 : i32
          %source1_i32 = scalar.addi %source0_i32, %k_base_i32 : i32
          %source_word_base_i32 = scalar.shrui %source1_i32, %two_i32 : i32
          %source_word_i32 = scalar.addi %source_word_base_i32, %word_in_group_i32 : i32
          %source_word1 = index.cast %source_word_i32 : i32 to index
          %source_word = index.assume %source_word1 [range(%source_word1, 0, 268435455)] : index
          %value = view.load %aq_word_view[%source_word] : view<268435456xi32, #dense> -> i32
          scf.yield %value : i32
        } else {
          scf.yield %zero_i32 : i32
        }
        view.store %activation_word, %act_word_ping_view[%act_buffer, %lane] : i32, view<2x256xi32, #dense>
      }

      // Store activation scales in the exact eight-register WMMA fragment
      // order used by the native Q8 kernels: even rows followed by odd rows.
      scf.if %fill_lane {
        %scale_match_valid = index.cmp ult, %lane, %window_match_count : index
        %activation_scale = scf.if %scale_match_valid -> (f32) {
          %token_i32 = view.load %tok_view[%lane] : view<32xi32, #dense> -> i32
          %selected_i32 = view.load %sel_view[%lane] : view<32xi32, #dense> -> i32
          %k_base_scale_i32 = index.cast %k_base : index to i32
          %token_scale_base_i32 = scalar.muli %token_i32, %down_token_stride_i32 : i32
          %selected_scale_base_i32 = scalar.constant 0 : i32
          %source_scale0_i32 = scalar.addi %token_scale_base_i32, %selected_scale_base_i32 : i32
          %source_scale1_i32 = scalar.addi %source_scale0_i32, %k_base_scale_i32 : i32
          %scale_index_i32 = scalar.shrui %source_scale1_i32, %five_i32 : i32
          %scale_index0 = index.cast %scale_index_i32 : i32 to index
          %scale_index = index.assume %scale_index0 [range(%scale_index0, 0, 33554431)] : index
          %scale = view.load %as_view[%scale_index] : view<33554432xf32, #dense> -> f32
          scf.yield %scale : f32
        } else {
          scf.yield %zero_f32 : f32
        }
        %scale_match_local = index.rem %lane, %sixteen : index
        %scale_match_tile = index.div %lane, %sixteen : index
        %scale_parity = index.rem %scale_match_local, %two : index
        %scale_register = index.div %scale_match_local, %two : index
        %scale_plane = index.mul %scale_parity, %eight : index
        %scale_tile_base = index.mul %scale_match_tile, %sixteen : index
        %scale_destination0 = index.add %scale_tile_base, %scale_plane : index
        %scale_destination1 = index.add %scale_destination0, %scale_register : index
        %scale_destination = index.assume %scale_destination1 [range(%scale_destination1, 0, 31)] : index
        view.store %activation_scale, %act_scale_ping_view[%act_buffer, %scale_destination] : f32, view<2x32xf32, #dense>
      }

      %source_row8 = index.rem %wave_lane, %eight : index
        %source_lane0 = index.mul %source_row8, %four : index
        %source_lane = index.add %source_lane0, %inner_block : index
        %source_lane_i32 = index.cast %source_lane : index to i32
        %row0_low_wave = kernel.subgroup.broadcast %decoded_row0_low from %source_lane_i32 : vector<4xi32>, i32
        %row0_high_wave = kernel.subgroup.broadcast %decoded_row0_high from %source_lane_i32 : vector<4xi32>, i32
        %row0_scale_wave = kernel.subgroup.broadcast %decoded_row0_scale from %source_lane_i32 : f32, i32
        %row1_low_wave = kernel.subgroup.broadcast %decoded_row1_low from %source_lane_i32 : vector<4xi32>, i32
        %row1_high_wave = kernel.subgroup.broadcast %decoded_row1_high from %source_lane_i32 : vector<4xi32>, i32
        %row1_scale_wave = kernel.subgroup.broadcast %decoded_row1_scale from %source_lane_i32 : f32, i32
        %fragment_row = index.rem %wave_lane, %sixteen : index
        %rhs_uses_row0 = index.cmp ult, %fragment_row, %eight : index
        %decoded_low_wave = scf.select %rhs_uses_row0, %row0_low_wave, %row1_low_wave : vector<4xi32>
        %decoded_high_wave = scf.select %rhs_uses_row0, %row0_high_wave, %row1_high_wave : vector<4xi32>
        %weight_scale_wave = scf.select %rhs_uses_row0, %row0_scale_wave, %row1_scale_wave : f32
        kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
      %lhs0_raw = scf.if %act_buffer_is_zero -> (vector<16xi8>) {
        %lhs0_ping = vector.fragment.load<lhs> %act0_view[%zero, %zero] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs0_ping : vector<16xi8>
      } else {
        %lhs0_pong = vector.fragment.load<lhs> %act1_view[%zero, %zero] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs0_pong : vector<16xi8>
      }
      %lhs0_words = vector.bitcast %lhs0_raw : vector<16xi8> to vector<4xi32>
      %lhs0 = vector.fragment<lhs> %lhs0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rhs0 = vector.fragment<rhs> %decoded_low_wave shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %int_acc = vector.fragment<init> %zero_i32x8 shape [%sixteen, %sixteen] : vector<8xi32>
      %int_next0 = vector.mma %lhs0, %rhs0, %int_acc : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %lhs1_raw = scf.if %act_buffer_is_zero -> (vector<16xi8>) {
        %lhs1_ping = vector.fragment.load<lhs> %act0_view[%zero, %sixteen] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs1_ping : vector<16xi8>
      } else {
        %lhs1_pong = vector.fragment.load<lhs> %act1_view[%zero, %sixteen] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs1_pong : vector<16xi8>
      }
      %lhs1_words = vector.bitcast %lhs1_raw : vector<16xi8> to vector<4xi32>
      %lhs1 = vector.fragment<lhs> %lhs1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rhs1 = vector.fragment<rhs> %decoded_high_wave shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %int_next1 = vector.mma %lhs1, %rhs1, %int_next0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %dot_f32 = vector.sitofp %int_next1 : vector<8xi32> to vector<8xf32>
      %lane_lo = index.rem %wave_lane, %sixteen : index
      %lane_hi = index.div %wave_lane, %sixteen : index
      %activation_scale_base0 = index.mul %lane_hi, %eight : index
      %activation_scale_base = index.assume %activation_scale_base0 [range(%activation_scale_base0, 0, 8)] : index
      %activation_scales = scf.if %act_buffer_is_zero -> (vector<8xf32>) {
        %activation_scales_ping = vector.load %act_scale0_view[%activation_scale_base] : view<32xf32, #dense> -> vector<8xf32>
        scf.yield %activation_scales_ping : vector<8xf32>
      } else {
        %activation_scales_pong = vector.load %act_scale1_view[%activation_scale_base] : view<32xf32, #dense> -> vector<8xf32>
        scf.yield %activation_scales_pong : vector<8xf32>
      }
      %weight_scales = vector.splat %weight_scale_wave : vector<8xf32>
      %combined_scales = vector.mulf %activation_scales, %weight_scales : vector<8xf32>
      %next = vector.fmaf %dot_f32, %combined_scales, %inner_acc : vector<8xf32>
      %next_second = scf.if %has_second_window -> (vector<8xf32>) {
        %lhs_second0_raw = scf.if %act_buffer_is_zero -> (vector<16xi8>) {
        %lhs_second0_ping = vector.fragment.load<lhs> %act0_view[%sixteen, %zero] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs_second0_ping : vector<16xi8>
      } else {
        %lhs_second0_pong = vector.fragment.load<lhs> %act1_view[%sixteen, %zero] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs_second0_pong : vector<16xi8>
      }
        %lhs_second0_words = vector.bitcast %lhs_second0_raw : vector<16xi8> to vector<4xi32>
        %lhs_second0 = vector.fragment<lhs> %lhs_second0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %int_second_acc = vector.fragment<init> %zero_i32x8 shape [%sixteen, %sixteen] : vector<8xi32>
        %int_second_next0 = vector.mma %lhs_second0, %rhs0, %int_second_acc : vector<4xi32>, vector<4xi32>, vector<8xi32>
        %lhs_second1_raw = scf.if %act_buffer_is_zero -> (vector<16xi8>) {
        %lhs_second1_ping = vector.fragment.load<lhs> %act0_view[%sixteen, %sixteen] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs_second1_ping : vector<16xi8>
      } else {
        %lhs_second1_pong = vector.fragment.load<lhs> %act1_view[%sixteen, %sixteen] shape [%sixteen, %sixteen] : view<32x32xi8, #dense> -> vector<16xi8>
        scf.yield %lhs_second1_pong : vector<16xi8>
      }
        %lhs_second1_words = vector.bitcast %lhs_second1_raw : vector<16xi8> to vector<4xi32>
        %lhs_second1 = vector.fragment<lhs> %lhs_second1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %int_second_next1 = vector.mma %lhs_second1, %rhs1, %int_second_next0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
        %dot_second_f32 = vector.sitofp %int_second_next1 : vector<8xi32> to vector<8xf32>
        %activation_scale_second_base0 = index.add %activation_scale_base, %sixteen : index
        %activation_scale_second_base = index.assume %activation_scale_second_base0 [range(%activation_scale_second_base0, 16, 24)] : index
        %activation_scales_second = scf.if %act_buffer_is_zero -> (vector<8xf32>) {
        %activation_scales_second_ping = vector.load %act_scale0_view[%activation_scale_second_base] : view<32xf32, #dense> -> vector<8xf32>
        scf.yield %activation_scales_second_ping : vector<8xf32>
      } else {
        %activation_scales_second_pong = vector.load %act_scale1_view[%activation_scale_second_base] : view<32xf32, #dense> -> vector<8xf32>
        scf.yield %activation_scales_second_pong : vector<8xf32>
      }
        %combined_scales_second = vector.mulf %activation_scales_second, %weight_scales : vector<8xf32>
        %next_second_value = vector.fmaf %dot_second_f32, %combined_scales_second, %inner_acc_second : vector<8xf32>
        scf.yield %next_second_value : vector<8xf32>
      } else {
        scf.yield %inner_acc_second : vector<8xf32>
      }
        scf.yield %next, %next_second : vector<8xf32>, vector<8xf32>
      }
      scf.yield %chunk_accumulator, %chunk_accumulator_second : vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    vector.fragment.store<result> %accumulator, %result_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x128xf32, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    scf.for %q8_output_pass_a = [%zero to %eight step %one] {
      %q8_pass_base_a = index.mul %q8_output_pass_a, %eight : index
      %q8_output_group_a = index.add %q8_pass_base_a, %wave : index
      %q8_match_a = index.div %q8_output_group_a, %four : index
      %q8_row_block_a = index.rem %q8_output_group_a, %four : index
      %q8_match_valid_a = index.cmp ult, %q8_match_a, %match_count : index
      %q8_row_block_base_a = index.mul %q8_row_block_a, %thirtytwo : index
      %q8_row_local_a = index.add %q8_row_block_base_a, %wave_lane : index
      %q8_row_a = index.add %row_tile_base, %q8_row_local_a : index
      %q8_row_valid_a = index.cmp ult, %q8_row_a, %rows : index
      %q8_output_valid_a = scalar.andi %q8_match_valid_a, %q8_row_valid_a : i1
      %q8_fused_weighted_a = scf.if %q8_output_valid_a -> (f32) {
        %q8_token_i32_a = view.load %tok_view[%q8_match_a] : view<32xi32, #dense> -> i32
        %q8_selected_i32_a = view.load %sel_view[%q8_match_a] : view<32xi32, #dense> -> i32
        %q8_token0_a = index.cast %q8_token_i32_a : i32 to index
        %q8_token_a = index.assume %q8_token0_a [range(%q8_token0_a, 0, 1048575)] : index
        %q8_selected0_a = index.cast %q8_selected_i32_a : i32 to index
        %q8_selected_a = index.assume %q8_selected0_a [range(%q8_selected0_a, 0, 127)] : index
        %q8_token_base_a = index.mul %q8_token_a, %dst_token_stride : index
        %q8_selected_base_a = index.mul %q8_selected_a, %rows : index
        %q8_destination_a_a = index.add %q8_token_base_a, %q8_selected_base_a : index
        %q8_destination_b_a = index.add %q8_destination_a_a, %q8_row_a : index
        %q8_destination_a = index.assume %q8_destination_b_a [range(%q8_destination_b_a, 0, 1073741823)] : index
        %q8_up_raw_a = view.load %result_view[%q8_match_a, %q8_row_local_a] : view<16x128xf32, #dense> -> f32
        %q8_gate_value_a = view.load %gate_view[%q8_destination_a] : view<1073741824xf32, #dense> -> f32
        %q8_gate_silu_a = scalar.siluf %q8_gate_value_a : f32
        %q8_up_hi_a = scalar.minnumf %q8_up_raw_a, %up_clamp_max : f32
        %q8_up_clamped_a = scalar.maxnumf %q8_up_hi_a, %up_clamp_min : f32
        %q8_fused_a = scalar.mulf %q8_gate_silu_a, %q8_up_clamped_a : f32
        %q8_router_token_base_a = index.mul %q8_token_a, %router_token_stride : index
        %q8_router_index0_a = index.add %q8_router_token_base_a, %q8_selected_a : index
        %q8_router_index_a = index.assume %q8_router_index0_a [range(%q8_router_index0_a, 0, 268435455)] : index
        %q8_route_weight_a = view.load %router_view[%q8_router_index_a] : view<268435456xf32, #dense> -> f32
        %q8_weighted_a = scalar.mulf %q8_fused_a, %q8_route_weight_a : f32
        scf.yield %q8_weighted_a : f32
      } else {
        scf.yield %zero_f32 : f32
      }

      %q8_absolute_a = scalar.absf %q8_fused_weighted_a : f32
      %q8_max1_peer_a, %q8_max1_valid_a = kernel.subgroup.shuffle<xor> %q8_absolute_a, %shuffle_xor1, %shuffle_width : f32, i32, i32
      %q8_max1_a = scalar.maxnumf %q8_absolute_a, %q8_max1_peer_a : f32
      %q8_max2_peer_a, %q8_max2_valid_a = kernel.subgroup.shuffle<xor> %q8_max1_a, %shuffle_xor2, %shuffle_width : f32, i32, i32
      %q8_max2_a = scalar.maxnumf %q8_max1_a, %q8_max2_peer_a : f32
      %q8_max4_peer_a, %q8_max4_valid_a = kernel.subgroup.shuffle<xor> %q8_max2_a, %shuffle_xor4, %shuffle_width : f32, i32, i32
      %q8_max4_a = scalar.maxnumf %q8_max2_a, %q8_max4_peer_a : f32
      %q8_max8_peer_a, %q8_max8_valid_a = kernel.subgroup.shuffle<xor> %q8_max4_a, %shuffle_xor8, %shuffle_width : f32, i32, i32
      %q8_max8_a = scalar.maxnumf %q8_max4_a, %q8_max8_peer_a : f32
      %q8_max16_peer_a, %q8_max16_valid_a = kernel.subgroup.shuffle<xor> %q8_max8_a, %shuffle_xor16, %shuffle_width : f32, i32, i32
      %q8_group_max_a = scalar.maxnumf %q8_max8_a, %q8_max16_peer_a : f32
      %q8_amax_a = scalar.maxnumf %q8_group_max_a, %qact_amax_eps : f32
      %q8_scale_a = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_amax_a, %qact_inv127 : f32
      %q8_rscale_a = scalar.divf<reassoc|nnan|ninf|nsz> %qact_f127, %q8_amax_a : f32
      %q8_scaled_a = scalar.mulf %q8_fused_weighted_a, %q8_rscale_a : f32
      %q8_rounded_a = scalar.roundf %q8_scaled_a : f32
      %q8_q32_a = scalar.fptosi %q8_rounded_a : f32 to i32
      %q8_q8_a = scalar.trunci %q8_q32_a : i32 to i8

      %q8_store_token_i32_a = view.load %tok_view[%q8_match_a] : view<32xi32, #dense> -> i32
      %q8_store_selected_i32_a = view.load %sel_view[%q8_match_a] : view<32xi32, #dense> -> i32
      %q8_store_token0_a = index.cast %q8_store_token_i32_a : i32 to index
      %q8_store_token_a = index.assume %q8_store_token0_a [range(%q8_store_token0_a, 0, 1048575)] : index
      %q8_store_selected0_a = index.cast %q8_store_selected_i32_a : i32 to index
      %q8_store_selected_a = index.assume %q8_store_selected0_a [range(%q8_store_selected0_a, 0, 127)] : index
      %q8_store_token_base_a = index.mul %q8_store_token_a, %dst_token_stride : index
      %q8_store_selected_base_a = index.mul %q8_store_selected_a, %rows : index
      %q8_store_destination_a_a = index.add %q8_store_token_base_a, %q8_store_selected_base_a : index
      %q8_store_destination_b_a = index.add %q8_store_destination_a_a, %q8_row_a : index
      %q8_store_destination_a = index.assume %q8_store_destination_b_a [range(%q8_store_destination_b_a, 0, 1073741823)] : index
      scf.if %q8_output_valid_a {
        view.store %q8_q8_a, %out_qs_view[%q8_store_destination_a] : i8, view<1073741824xi8, #dense>
      }

      %q8_dst_token_group_stride_a = index.div %dst_token_stride, %thirtytwo : index
      %q8_selected_group_stride_a = index.div %rows, %thirtytwo : index
      %q8_token_group_base_a = index.mul %q8_store_token_a, %q8_dst_token_group_stride_a : index
      %q8_selected_group_base_a = index.mul %q8_store_selected_a, %q8_selected_group_stride_a : index
      %q8_row_tile_group_base_a = index.mul %tile, %four : index
      %q8_group_index_a_a = index.add %q8_token_group_base_a, %q8_selected_group_base_a : index
      %q8_group_index_b_a = index.add %q8_group_index_a_a, %q8_row_tile_group_base_a : index
      %q8_group_index0_a = index.add %q8_group_index_b_a, %q8_row_block_a : index
      %q8_group_index_a = index.assume %q8_group_index0_a [range(%q8_group_index0_a, 0, 33554431)] : index
      %q8_is_scale_leader_a = index.cmp eq, %wave_lane, %zero : index
      %q8_store_scale_a = scalar.andi %q8_output_valid_a, %q8_is_scale_leader_a : i1
      scf.if %q8_store_scale_a {
        view.store %q8_scale_a, %out_scale_view[%q8_group_index_a] : f32, view<33554432xf32, #dense>
      }
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    // The second accumulator reuses the same LDS result tile after every lane
    // has consumed the first one.
    scf.if %has_second_window {
      vector.fragment.store<result> %accumulator_second, %result_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x128xf32, #dense>
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
      scf.for %q8_output_pass_b = [%zero to %eight step %one] {
        %q8_pass_base_b = index.mul %q8_output_pass_b, %eight : index
        %q8_output_group_b = index.add %q8_pass_base_b, %wave : index
        %q8_match_b = index.div %q8_output_group_b, %four : index
        %q8_row_block_b = index.rem %q8_output_group_b, %four : index
        %q8_match_slot_b = index.add %q8_match_b, %sixteen : index
        %q8_match_valid_b = index.cmp ult, %q8_match_b, %match_count_second : index
        %q8_row_block_base_b = index.mul %q8_row_block_b, %thirtytwo : index
        %q8_row_local_b = index.add %q8_row_block_base_b, %wave_lane : index
        %q8_row_b = index.add %row_tile_base, %q8_row_local_b : index
        %q8_row_valid_b = index.cmp ult, %q8_row_b, %rows : index
        %q8_output_valid_b = scalar.andi %q8_match_valid_b, %q8_row_valid_b : i1
        %q8_fused_weighted_b = scf.if %q8_output_valid_b -> (f32) {
          %q8_token_i32_b = view.load %tok_view[%q8_match_slot_b] : view<32xi32, #dense> -> i32
          %q8_selected_i32_b = view.load %sel_view[%q8_match_slot_b] : view<32xi32, #dense> -> i32
          %q8_token0_b = index.cast %q8_token_i32_b : i32 to index
          %q8_token_b = index.assume %q8_token0_b [range(%q8_token0_b, 0, 1048575)] : index
          %q8_selected0_b = index.cast %q8_selected_i32_b : i32 to index
          %q8_selected_b = index.assume %q8_selected0_b [range(%q8_selected0_b, 0, 127)] : index
          %q8_token_base_b = index.mul %q8_token_b, %dst_token_stride : index
          %q8_selected_base_b = index.mul %q8_selected_b, %rows : index
          %q8_destination_a_b = index.add %q8_token_base_b, %q8_selected_base_b : index
          %q8_destination_b_b = index.add %q8_destination_a_b, %q8_row_b : index
          %q8_destination_b = index.assume %q8_destination_b_b [range(%q8_destination_b_b, 0, 1073741823)] : index
          %q8_up_raw_b = view.load %result_view[%q8_match_b, %q8_row_local_b] : view<16x128xf32, #dense> -> f32
          %q8_gate_value_b = view.load %gate_view[%q8_destination_b] : view<1073741824xf32, #dense> -> f32
          %q8_gate_silu_b = scalar.siluf %q8_gate_value_b : f32
          %q8_up_hi_b = scalar.minnumf %q8_up_raw_b, %up_clamp_max : f32
          %q8_up_clamped_b = scalar.maxnumf %q8_up_hi_b, %up_clamp_min : f32
          %q8_fused_b = scalar.mulf %q8_gate_silu_b, %q8_up_clamped_b : f32
          %q8_router_token_base_b = index.mul %q8_token_b, %router_token_stride : index
          %q8_router_index0_b = index.add %q8_router_token_base_b, %q8_selected_b : index
          %q8_router_index_b = index.assume %q8_router_index0_b [range(%q8_router_index0_b, 0, 268435455)] : index
          %q8_route_weight_b = view.load %router_view[%q8_router_index_b] : view<268435456xf32, #dense> -> f32
          %q8_weighted_b = scalar.mulf %q8_fused_b, %q8_route_weight_b : f32
          scf.yield %q8_weighted_b : f32
        } else {
          scf.yield %zero_f32 : f32
        }

        %q8_absolute_b = scalar.absf %q8_fused_weighted_b : f32
        %q8_max1_peer_b, %q8_max1_valid_b = kernel.subgroup.shuffle<xor> %q8_absolute_b, %shuffle_xor1, %shuffle_width : f32, i32, i32
        %q8_max1_b = scalar.maxnumf %q8_absolute_b, %q8_max1_peer_b : f32
        %q8_max2_peer_b, %q8_max2_valid_b = kernel.subgroup.shuffle<xor> %q8_max1_b, %shuffle_xor2, %shuffle_width : f32, i32, i32
        %q8_max2_b = scalar.maxnumf %q8_max1_b, %q8_max2_peer_b : f32
        %q8_max4_peer_b, %q8_max4_valid_b = kernel.subgroup.shuffle<xor> %q8_max2_b, %shuffle_xor4, %shuffle_width : f32, i32, i32
        %q8_max4_b = scalar.maxnumf %q8_max2_b, %q8_max4_peer_b : f32
        %q8_max8_peer_b, %q8_max8_valid_b = kernel.subgroup.shuffle<xor> %q8_max4_b, %shuffle_xor8, %shuffle_width : f32, i32, i32
        %q8_max8_b = scalar.maxnumf %q8_max4_b, %q8_max8_peer_b : f32
        %q8_max16_peer_b, %q8_max16_valid_b = kernel.subgroup.shuffle<xor> %q8_max8_b, %shuffle_xor16, %shuffle_width : f32, i32, i32
        %q8_group_max_b = scalar.maxnumf %q8_max8_b, %q8_max16_peer_b : f32
        %q8_amax_b = scalar.maxnumf %q8_group_max_b, %qact_amax_eps : f32
        %q8_scale_b = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_amax_b, %qact_inv127 : f32
        %q8_rscale_b = scalar.divf<reassoc|nnan|ninf|nsz> %qact_f127, %q8_amax_b : f32
        %q8_scaled_b = scalar.mulf %q8_fused_weighted_b, %q8_rscale_b : f32
        %q8_rounded_b = scalar.roundf %q8_scaled_b : f32
        %q8_q32_b = scalar.fptosi %q8_rounded_b : f32 to i32
        %q8_q8_b = scalar.trunci %q8_q32_b : i32 to i8

        %q8_store_token_i32_b = view.load %tok_view[%q8_match_slot_b] : view<32xi32, #dense> -> i32
        %q8_store_selected_i32_b = view.load %sel_view[%q8_match_slot_b] : view<32xi32, #dense> -> i32
        %q8_store_token0_b = index.cast %q8_store_token_i32_b : i32 to index
        %q8_store_token_b = index.assume %q8_store_token0_b [range(%q8_store_token0_b, 0, 1048575)] : index
        %q8_store_selected0_b = index.cast %q8_store_selected_i32_b : i32 to index
        %q8_store_selected_b = index.assume %q8_store_selected0_b [range(%q8_store_selected0_b, 0, 127)] : index
        %q8_store_token_base_b = index.mul %q8_store_token_b, %dst_token_stride : index
        %q8_store_selected_base_b = index.mul %q8_store_selected_b, %rows : index
        %q8_store_destination_a_b = index.add %q8_store_token_base_b, %q8_store_selected_base_b : index
        %q8_store_destination_b_b = index.add %q8_store_destination_a_b, %q8_row_b : index
        %q8_store_destination_b = index.assume %q8_store_destination_b_b [range(%q8_store_destination_b_b, 0, 1073741823)] : index
        scf.if %q8_output_valid_b {
          view.store %q8_q8_b, %out_qs_view[%q8_store_destination_b] : i8, view<1073741824xi8, #dense>
        }

        %q8_dst_token_group_stride_b = index.div %dst_token_stride, %thirtytwo : index
        %q8_selected_group_stride_b = index.div %rows, %thirtytwo : index
        %q8_token_group_base_b = index.mul %q8_store_token_b, %q8_dst_token_group_stride_b : index
        %q8_selected_group_base_b = index.mul %q8_store_selected_b, %q8_selected_group_stride_b : index
        %q8_row_tile_group_base_b = index.mul %tile, %four : index
        %q8_group_index_a_b = index.add %q8_token_group_base_b, %q8_selected_group_base_b : index
        %q8_group_index_b_b = index.add %q8_group_index_a_b, %q8_row_tile_group_base_b : index
        %q8_group_index0_b = index.add %q8_group_index_b_b, %q8_row_block_b : index
        %q8_group_index_b = index.assume %q8_group_index0_b [range(%q8_group_index0_b, 0, 33554431)] : index
        %q8_is_scale_leader_b = index.cmp eq, %wave_lane, %zero : index
        %q8_store_scale_b = scalar.andi %q8_output_valid_b, %q8_is_scale_leader_b : i1
        scf.if %q8_store_scale_b {
          view.store %q8_scale_b, %out_scale_view[%q8_group_index_b] : f32, view<33554432xf32, #dense>
        }
      }
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    }
  }
  }
  kernel.return
}
