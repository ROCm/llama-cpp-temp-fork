      %p0_3_t1_i1 = vector.mma %p0_3_t1_lb, %p0_3_t1_rb, %p0_3_t1_i0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %p0_3_t1_wk = index.constant 3 : index
