          %w1_activation_row = index.constant 16 : index
          %w1_lhs0_raw = vector.fragment.load<lhs> %w4_act_view[%w1_activation_row, %zero] shape [%sixteen, %sixteen] : view<64x32xi8, #dense> -> vector<16xi8>
          %w1_lhs0_words = vector.bitcast %w1_lhs0_raw : vector<16xi8> to vector<4xi32>
          %w1_lhs0 = vector.fragment<lhs> %w1_lhs0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
          %w1_int_acc = vector.fragment<init> %w4_zero_i32x8 shape [%sixteen, %sixteen] : vector<8xi32>
          %w1_int_next0 = vector.mma %w1_lhs0, %rhs0, %w1_int_acc : vector<4xi32>, vector<4xi32>, vector<8xi32>
          %w1_lhs1_raw = vector.fragment.load<lhs> %w4_act_view[%w1_activation_row, %sixteen] shape [%sixteen, %sixteen] : view<64x32xi8, #dense> -> vector<16xi8>
          %w1_lhs1_words = vector.bitcast %w1_lhs1_raw : vector<16xi8> to vector<4xi32>
          %w1_lhs1 = vector.fragment<lhs> %w1_lhs1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
          %w1_int_next1 = vector.mma %w1_lhs1, %rhs1, %w1_int_next0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
