// Register-tiled BF16 x F32 matmul -- 32 rows x 32 cols per workgroup.
//
// Lane owns 1 row x 4 columns and holds 4 vector<4xf32> accumulators over
// the whole k loop, reduced to scalars once at write-out. Activations are staged
// 32 cols x 64 k per chunk into LDS (49152 B).

config.decl @hrx2_shape_k : %value: index where [range(%value, 4, 32768), mul(%value, 4)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 1, 262144)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 32768)]

kernel.def export("hrx2_mul_mat_bf16_f32_tiled32x32x64") @hrx2_mul_mat_bf16_f32_tiled32x32x64() {
  %unit = index.constant 1 : index
  %rt = index.constant 32 : index
  %rt_m1 = index.constant 31 : index
  %ct = index.constant 32 : index
  %ct_m1 = index.constant 31 : index
  %wg = index.constant 1024 : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %rows_up = index.add %rows, %rt_m1 : index
  %row_tiles = index.div %rows_up, %rt : index
  %cols_up = index.add %cols, %ct_m1 : index
  %col_tiles = index.div %cols_up, %ct : index
  // Column tiles on x so concurrent workgroups share a row tile's weights.
  kernel.launch.config workgroups(%col_tiles, %row_tiles, %unit) workgroup_size(%wg, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %k_cpl_c = index.constant 4 : index
  %k_quads = index.constant 16 : index
  %k_wg = index.constant 256 : index
  %k_sk = index.constant 4 : index
  %k_sk_m1 = index.constant 3 : index
  %k_sl0 = index.constant 0 : index
  %k_sl1 = index.constant 1024 : index
  %k_sl2 = index.constant 2048 : index
  %k_sl3 = index.constant 3072 : index
  %k_act_elems = index.constant 2048 : index
  %k_ac1 = index.constant 64 : index
  %k_col1 = index.constant 1 : index
  %k_ac2 = index.constant 128 : index
  %k_col2 = index.constant 2 : index
  %k_ac3 = index.constant 192 : index
  %k_col3 = index.constant 3 : index
  %k_su1 = index.constant 256 : index
  %k_rt = index.constant 32 : index
  %k_ct = index.constant 32 : index
  %k_kc = index.constant 64 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_v4 = vector.constant 0.0 : vector<4xf32>

  %k = config.get @hrx2_shape_k : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %k_b = index.assume %k [range(%k, 4, 32768)] : index
  %rows_b = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 32768)] : index
  %nchunks = index.div %k_b, %k_kc : index

  %col_tile0 = kernel.workgroup.id<x> : index
  %row_tile0 = kernel.workgroup.id<y> : index
  %tid0 = kernel.workitem.id<x> : index
  %col_tile = index.assume %col_tile0 [range(%col_tile0, 0, 32767)] : index
  %row_tile = index.assume %row_tile0 [range(%row_tile0, 0, 262143)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 1023)] : index
  %k_slice = index.div %tid, %k_wg : index
  %sub = index.rem %tid, %k_wg : index


  %src0_g = buffer.assume.memory_space<global> %src0 : buffer
  %src1_g = buffer.assume.memory_space<global> %src1 : buffer
  %dst_g = buffer.assume.memory_space<global> %dst : buffer
  %src0_na, %src1_na, %dst_na = buffer.assume.noalias %src0_g, %src1_g, %dst_g : buffer, buffer, buffer
  %src1_view = buffer.view %src1_na[%base] : buffer -> view<1073741824xf32, #dense>
  %src0_view = buffer.view %src0_na[%base] : buffer -> view<1073741824xbf16, #dense>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32, #dense>

  %lds_bytes = index.constant 49152 : offset
  %scratch = buffer.alloca %lds_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %av_e = index.mul %k_slice, %k_act_elems : index
  %av_b = index.mul %av_e, %four : index
  %av_o = index.cast %av_b : index to offset
  %act_view = buffer.view %scratch[%av_o] : buffer -> view<2048xf32, #dense>

  // Lane owns one row and 4 columns. Keeping a wave on one column group makes
  // every LDS activation read wave-uniform, i.e. a broadcast.
  %lane_row = index.rem %sub, %k_rt : index
  %col_grp = index.div %sub, %k_rt : index
  %row_base = index.mul %row_tile, %k_rt : index
  %row_raw = index.add %row_base, %lane_row : index
  %row_valid = index.cmp ult, %row_raw, %rows_b : index
  %row_safe = index.rem %row_raw, %rows_b : index
  %w_row_base = index.mul %row_safe, %k_b : index
  %col_tile_base = index.mul %col_tile, %k_ct : index
  %lane_col_l = index.mul %col_grp, %k_cpl_c : index
  %lane_col_g = index.add %col_tile_base, %lane_col_l : index

  %lane_col_l_kc = index.mul %lane_col_l, %k_kc : index
  %lane_row_kc = index.mul %lane_row, %k_kc : index

  %niter_r = index.add %nchunks, %k_sk_m1 : index
  %niter = index.div %niter_r, %k_sk : index
  %o0, %o1, %o2, %o3 = scf.for %iter = [%zero to %niter step %one](
      %b0 = %zero_v4 : vector<4xf32>,
      %b1 = %zero_v4 : vector<4xf32>,
      %b2 = %zero_v4 : vector<4xf32>,
      %b3 = %zero_v4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %chunk_m = index.mul %iter, %k_sk : index
    %chunk_r = index.add %chunk_m, %k_slice : index
    %chunk_ok = index.cmp ult, %chunk_r, %nchunks : index
    %chunk = index.rem %chunk_r, %nchunks : index
    %chunk_k = index.mul %chunk, %k_kc : index


    // ---- stage 32 cols x 64 activations into LDS ----
    %sc0_l = index.div %sub, %k_quads : index
    %sq0 = index.rem %sub, %k_quads : index
    %sc0_g0 = index.add %col_tile_base, %sc0_l : index
    %sc0_ok = index.cmp ult, %sc0_g0, %cols_b : index
    %sc0_g = index.rem %sc0_g0, %cols_b : index
    %ss0_0 = index.mul %sc0_g, %k_b : index
    %ss0_1 = index.add %ss0_0, %chunk_k : index
    %ss0_2 = index.mul %sq0, %four : index
    %ss0_r = index.add %ss0_1, %ss0_2 : index
    %ss0 = index.assume %ss0_r [range(%ss0_r, 0, 1073741820)] : index
    %sv0_0 = vector.load %src1_view[%ss0] : view<1073741824xf32, #dense> -> vector<4xf32>
    %sv0_c = scf.select %sc0_ok, %sv0_0, %zero_v4 : vector<4xf32>
    %sv0 = scf.select %chunk_ok, %sv0_c, %zero_v4 : vector<4xf32>
    %sd0_0 = index.mul %sc0_l, %k_kc : index
    %sd0_1 = index.mul %sq0, %four : index
    %sd0_r = index.add %sd0_0, %sd0_1 : index
    %sd0 = index.assume %sd0_r [range(%sd0_r, 0, 2044)] : index
    vector.store %sv0, %act_view[%sd0] : vector<4xf32>, view<2048xf32, #dense>
    %su1_i = index.add %sub, %k_su1 : index
    %sc1_l = index.div %su1_i, %k_quads : index
    %sq1 = index.rem %su1_i, %k_quads : index
    %sc1_g0 = index.add %col_tile_base, %sc1_l : index
    %sc1_ok = index.cmp ult, %sc1_g0, %cols_b : index
    %sc1_g = index.rem %sc1_g0, %cols_b : index
    %ss1_0 = index.mul %sc1_g, %k_b : index
    %ss1_1 = index.add %ss1_0, %chunk_k : index
    %ss1_2 = index.mul %sq1, %four : index
    %ss1_r = index.add %ss1_1, %ss1_2 : index
    %ss1 = index.assume %ss1_r [range(%ss1_r, 0, 1073741820)] : index
    %sv1_0 = vector.load %src1_view[%ss1] : view<1073741824xf32, #dense> -> vector<4xf32>
    %sv1_c = scf.select %sc1_ok, %sv1_0, %zero_v4 : vector<4xf32>
    %sv1 = scf.select %chunk_ok, %sv1_c, %zero_v4 : vector<4xf32>
    %sd1_0 = index.mul %sc1_l, %k_kc : index
    %sd1_1 = index.mul %sq1, %four : index
    %sd1_r = index.add %sd1_0, %sd1_1 : index
    %sd1 = index.assume %sd1_r [range(%sd1_r, 0, 2044)] : index
    vector.store %sv1, %act_view[%sd1] : vector<4xf32>, view<2048xf32, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    %n0, %n1, %n2, %n3 = scf.for %q = [%zero to %k_quads step %one](
        %c0 = %b0 : vector<4xf32>,
        %c1 = %b1 : vector<4xf32>,
        %c2 = %b2 : vector<4xf32>,
        %c3 = %b3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %qk = index.mul %q, %four : index
      %wg_0 = index.add %w_row_base, %chunk_k : index
      %wg_1 = index.add %wg_0, %qk : index
      %wg_i = index.assume %wg_1 [range(%wg_1, 0, 1073741820)] : index
      %two = index.constant 2 : index
      %wg_by = index.mul %wg_i, %two : index
      %wv_off = index.cast %wg_by : index to offset
      %wv_view = buffer.view %src0_na[%wv_off] : buffer -> view<4xbf16, #dense>
      %wv_bf16 = vector.load %wv_view[%zero] : view<4xbf16, #dense> -> vector<4xbf16>
      %wv = vector.extf %wv_bf16 : vector<4xbf16> to vector<4xf32>
      %al_base = index.add %lane_col_l_kc, %qk : index
      %ai0_r = index.add %al_base, %zero : index
      %ai0 = index.assume %ai0_r [range(%ai0_r, 0, 2044)] : index
      %av0 = vector.load %act_view[%ai0] : view<2048xf32, #dense> -> vector<4xf32>
      %n0 = vector.fmaf %wv, %av0, %c0 : vector<4xf32>
      %ai1_r = index.add %al_base, %k_ac1 : index
      %ai1 = index.assume %ai1_r [range(%ai1_r, 0, 2044)] : index
      %av1 = vector.load %act_view[%ai1] : view<2048xf32, #dense> -> vector<4xf32>
      %n1 = vector.fmaf %wv, %av1, %c1 : vector<4xf32>
      %ai2_r = index.add %al_base, %k_ac2 : index
      %ai2 = index.assume %ai2_r [range(%ai2_r, 0, 2044)] : index
      %av2 = vector.load %act_view[%ai2] : view<2048xf32, #dense> -> vector<4xf32>
      %n2 = vector.fmaf %wv, %av2, %c2 : vector<4xf32>
      %ai3_r = index.add %al_base, %k_ac3 : index
      %ai3 = index.assume %ai3_r [range(%ai3_r, 0, 2044)] : index
      %av3 = vector.load %act_view[%ai3] : view<2048xf32, #dense> -> vector<4xf32>
      %n3 = vector.fmaf %wv, %av3, %c3 : vector<4xf32>
      scf.yield %n0, %n1, %n2, %n3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %n0, %n1, %n2, %n3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }

  %red_e = index.constant 8192 : index
  %red_b = index.mul %red_e, %four : index
  %red_o = index.cast %red_b : index to offset
  %red_view = buffer.view %scratch[%red_o] : buffer -> view<4096xf32, #dense>
  %k_wgcpl = index.constant 1024 : index
  %slot_s = index.mul %k_slice, %k_wgcpl : index
  %slot_t = index.mul %sub, %k_cpl_c : index
  %slot = index.add %slot_s, %slot_t : index
  %pp0 = vector.reduce<addf, reassoc|nnan|nsz> %o0, %zero_f32 : vector<4xf32>, f32
  %sl0 = index.add %slot, %zero : index
  view.store %pp0, %red_view[%sl0] : f32, view<4096xf32, #dense>
  %pp1 = vector.reduce<addf, reassoc|nnan|nsz> %o1, %zero_f32 : vector<4xf32>, f32
  %sl1 = index.add %slot, %k_col1 : index
  view.store %pp1, %red_view[%sl1] : f32, view<4096xf32, #dense>
  %pp2 = vector.reduce<addf, reassoc|nnan|nsz> %o2, %zero_f32 : vector<4xf32>, f32
  %sl2 = index.add %slot, %k_col2 : index
  view.store %pp2, %red_view[%sl2] : f32, view<4096xf32, #dense>
  %pp3 = vector.reduce<addf, reassoc|nnan|nsz> %o3, %zero_f32 : vector<4xf32>, f32
  %sl3 = index.add %slot, %k_col3 : index
  view.store %pp3, %red_view[%sl3] : f32, view<4096xf32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %is_s0 = index.cmp eq, %k_slice, %zero : index
  %rb0 = index.add %slot_t, %zero : index
  %rr0_0 = index.add %rb0, %k_sl0 : index
  %rv0_0 = view.load %red_view[%rr0_0] : view<4096xf32, #dense> -> f32
  %rr0_1 = index.add %rb0, %k_sl1 : index
  %rv0_1 = view.load %red_view[%rr0_1] : view<4096xf32, #dense> -> f32
  %rr0_2 = index.add %rb0, %k_sl2 : index
  %rv0_2 = view.load %red_view[%rr0_2] : view<4096xf32, #dense> -> f32
  %rr0_3 = index.add %rb0, %k_sl3 : index
  %rv0_3 = view.load %red_view[%rr0_3] : view<4096xf32, #dense> -> f32
  %ra0_1 = scalar.addf<nnan|nsz> %rv0_0, %rv0_1 : f32
  %ra0_2 = scalar.addf<nnan|nsz> %ra0_1, %rv0_2 : f32
  %ra0_3 = scalar.addf<nnan|nsz> %ra0_2, %rv0_3 : f32
  %ds0_lds = index.constant 0 : index
  %rb1 = index.add %slot_t, %k_col1 : index
  %rr1_0 = index.add %rb1, %k_sl0 : index
  %rv1_0 = view.load %red_view[%rr1_0] : view<4096xf32, #dense> -> f32
  %rr1_1 = index.add %rb1, %k_sl1 : index
  %rv1_1 = view.load %red_view[%rr1_1] : view<4096xf32, #dense> -> f32
  %rr1_2 = index.add %rb1, %k_sl2 : index
  %rv1_2 = view.load %red_view[%rr1_2] : view<4096xf32, #dense> -> f32
  %rr1_3 = index.add %rb1, %k_sl3 : index
  %rv1_3 = view.load %red_view[%rr1_3] : view<4096xf32, #dense> -> f32
  %ra1_1 = scalar.addf<nnan|nsz> %rv1_0, %rv1_1 : f32
  %ra1_2 = scalar.addf<nnan|nsz> %ra1_1, %rv1_2 : f32
  %ra1_3 = scalar.addf<nnan|nsz> %ra1_2, %rv1_3 : f32
  %ds1_lds = index.constant 0 : index
  %rb2 = index.add %slot_t, %k_col2 : index
  %rr2_0 = index.add %rb2, %k_sl0 : index
  %rv2_0 = view.load %red_view[%rr2_0] : view<4096xf32, #dense> -> f32
  %rr2_1 = index.add %rb2, %k_sl1 : index
  %rv2_1 = view.load %red_view[%rr2_1] : view<4096xf32, #dense> -> f32
  %rr2_2 = index.add %rb2, %k_sl2 : index
  %rv2_2 = view.load %red_view[%rr2_2] : view<4096xf32, #dense> -> f32
  %rr2_3 = index.add %rb2, %k_sl3 : index
  %rv2_3 = view.load %red_view[%rr2_3] : view<4096xf32, #dense> -> f32
  %ra2_1 = scalar.addf<nnan|nsz> %rv2_0, %rv2_1 : f32
  %ra2_2 = scalar.addf<nnan|nsz> %ra2_1, %rv2_2 : f32
  %ra2_3 = scalar.addf<nnan|nsz> %ra2_2, %rv2_3 : f32
  %ds2_lds = index.constant 0 : index
  %rb3 = index.add %slot_t, %k_col3 : index
  %rr3_0 = index.add %rb3, %k_sl0 : index
  %rv3_0 = view.load %red_view[%rr3_0] : view<4096xf32, #dense> -> f32
  %rr3_1 = index.add %rb3, %k_sl1 : index
  %rv3_1 = view.load %red_view[%rr3_1] : view<4096xf32, #dense> -> f32
  %rr3_2 = index.add %rb3, %k_sl2 : index
  %rv3_2 = view.load %red_view[%rr3_2] : view<4096xf32, #dense> -> f32
  %rr3_3 = index.add %rb3, %k_sl3 : index
  %rv3_3 = view.load %red_view[%rr3_3] : view<4096xf32, #dense> -> f32
  %ra3_1 = scalar.addf<nnan|nsz> %rv3_0, %rv3_1 : f32
  %ra3_2 = scalar.addf<nnan|nsz> %ra3_1, %rv3_2 : f32
  %ra3_3 = scalar.addf<nnan|nsz> %ra3_2, %rv3_3 : f32
  %ds3_lds = index.constant 0 : index

  // ---- write out: dst is [rows, cols], consecutive columns are `rows` apart ----
  scf.if %is_s0 {
    %dc0_r = index.add %lane_col_g, %zero : index
    %dc0_ok = index.cmp ult, %dc0_r, %cols_b : index
    %ds0 = scalar.addf<nnan|nsz> %ra0_3, %zero_f32 : f32
    %dc0 = index.rem %dc0_r, %cols_b : index
    %di0_0 = index.mul %dc0, %rows_b : index
    %di0_r = index.add %di0_0, %row_raw : index
    %di0 = index.assume %di0_r [range(%di0_r, 0, 1073741823)] : index
    scf.if %dc0_ok {
      scf.if %row_valid {
        view.store %ds0, %dst_view[%di0] : f32, view<1073741824xf32, #dense>
      }
    }
    %dc1_r = index.add %lane_col_g, %k_col1 : index
    %dc1_ok = index.cmp ult, %dc1_r, %cols_b : index
    %ds1 = scalar.addf<nnan|nsz> %ra1_3, %zero_f32 : f32
    %dc1 = index.rem %dc1_r, %cols_b : index
    %di1_0 = index.mul %dc1, %rows_b : index
    %di1_r = index.add %di1_0, %row_raw : index
    %di1 = index.assume %di1_r [range(%di1_r, 0, 1073741823)] : index
    scf.if %dc1_ok {
      scf.if %row_valid {
        view.store %ds1, %dst_view[%di1] : f32, view<1073741824xf32, #dense>
      }
    }
    %dc2_r = index.add %lane_col_g, %k_col2 : index
    %dc2_ok = index.cmp ult, %dc2_r, %cols_b : index
    %ds2 = scalar.addf<nnan|nsz> %ra2_3, %zero_f32 : f32
    %dc2 = index.rem %dc2_r, %cols_b : index
    %di2_0 = index.mul %dc2, %rows_b : index
    %di2_r = index.add %di2_0, %row_raw : index
    %di2 = index.assume %di2_r [range(%di2_r, 0, 1073741823)] : index
    scf.if %dc2_ok {
      scf.if %row_valid {
        view.store %ds2, %dst_view[%di2] : f32, view<1073741824xf32, #dense>
      }
    }
    %dc3_r = index.add %lane_col_g, %k_col3 : index
    %dc3_ok = index.cmp ult, %dc3_r, %cols_b : index
    %ds3 = scalar.addf<nnan|nsz> %ra3_3, %zero_f32 : f32
    %dc3 = index.rem %dc3_r, %cols_b : index
    %di3_0 = index.mul %dc3, %rows_b : index
    %di3_r = index.add %di3_0, %row_raw : index
    %di3 = index.assume %di3_r [range(%di3_r, 0, 1073741823)] : index
    scf.if %dc3_ok {
      scf.if %row_valid {
        view.store %ds3, %dst_view[%di3] : f32, view<1073741824xf32, #dense>
      }
    }
  }
  kernel.return
}
