// Token-one BF16 x F32 matvec. Each lane loads eight adjacent K elements and
// one workgroup reduces a complete output row.
config.decl @hrx2_shape_k : %value: index where [range(%value, 2048, 32768), mul(%value, 2048)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 1), mul(%value, 1)]

kernel.def export("hrx2_mul_mat_bf16_f32_decode_vec8_token1_wg256") @hrx2_mul_mat_bf16_f32_decode_vec8_token1_wg256() {
  %one = index.constant 1 : index
  %rows = config.get @hrx2_shape_rows : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %eight = index.constant 8 : index
  %workgroup_size = index.constant 256 : index

  %k = config.get @hrx2_shape_k : index
  %k_bounded = index.assume %k [range(%k, 2048, 32768), mul(%k, 2048)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 4095)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_view = buffer.view %src0_noalias[%base] : buffer -> view<134217728xbf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<32768xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<4096xf32, #dense>

  %src0_row_base = index.mul %row, %k_bounded : index
  %lane_base = index.mul %lane, %eight : index
  %step = index.mul %workgroup_size, %eight : index
  %sum = scf.for %i = [%lane_base to %k_bounded step %step](%acc = %zero_f32 : f32) -> (f32) {
    %src0_index = index.add %src0_row_base, %i : index
    %src0_index_bounded = index.assume %src0_index [range(%src0_index, 0, 134217720), mul(%src0_index, 8)] : index
    %src1_index_bounded = index.assume %i [range(%i, 0, 32760), mul(%i, 8)] : index
    %a_bf16 = vector.load %src0_view[%src0_index_bounded] : view<134217728xbf16, #dense> -> vector<8xbf16>
    %a = vector.extf %a_bf16 : vector<8xbf16> to vector<8xf32>
    %b = vector.load %src1_view[%src1_index_bounded] : view<32768xf32, #dense> -> vector<8xf32>
    %next = vector.dotf %a, %b, %acc : vector<8xf32>, vector<8xf32>, f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %sum : f32

  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%row] : f32, view<4096xf32, #dense>
  }
  kernel.return
}
