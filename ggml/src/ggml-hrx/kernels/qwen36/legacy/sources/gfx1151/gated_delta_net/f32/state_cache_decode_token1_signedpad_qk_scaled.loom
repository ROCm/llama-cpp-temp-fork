    scf.if %tid_lt_c {
      %pg0 = view.load %gs_flat[%k64] : view<80xf32> -> f32
      %pg1 = view.load %gs_flat[%k65] : view<80xf32> -> f32
      %pg2 = view.load %gs_flat[%k66] : view<80xf32> -> f32
      %pg3 = view.load %gs_flat[%k67] : view<80xf32> -> f32
      %pg4 = view.load %gs_flat[%k68] : view<80xf32> -> f32
      %pg5 = view.load %gs_flat[%k69] : view<80xf32> -> f32
      %pg6 = view.load %gs_flat[%k70] : view<80xf32> -> f32
