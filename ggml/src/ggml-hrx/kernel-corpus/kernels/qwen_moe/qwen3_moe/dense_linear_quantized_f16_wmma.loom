          %ql1_high0 = vector.shrui %ql1_words, %shift4 : vector<4xi32>
          %ql0_high = vector.andi %ql0_high0, %nibble_mask : vector<4xi32>
          %ql1_high = vector.andi %ql1_high0, %nibble_mask : vector<4xi32>
          %qh2_bits = vector.andi %qh_words, %high2_mask : vector<4xi32>
          %qh3_bits0 = vector.andi %qh_words, %high3_mask : vector<4xi32>
          %qh3_bits = vector.shrui %qh3_bits0, %shift2 : vector<4xi32>
          %codes0 = vector.ori %ql0_high, %qh2_bits : vector<4xi32>
          %codes1 = vector.ori %ql1_high, %qh3_bits : vector<4xi32>
          scf.yield %codes0, %codes1 : vector<4xi32>, vector<4xi32>
        }
        %codes0_u8 = vector.bitcast %codes0_words : vector<4xi32> to vector<16xi8>
        %codes1_u8 = vector.bitcast %codes1_words : vector<4xi32> to vector<16xi8>
        %codes0_unsigned_f32 = vector.uitofp %codes0_u8 : vector<16xi8> to vector<16xf32>
        %codes1_unsigned_f32 = vector.uitofp %codes1_u8 : vector<16xi8> to vector<16xf32>
        %codes0_f32 = vector.addf %codes0_unsigned_f32, %negative32_f32 : vector<16xf32>
        %codes1_f32 = vector.addf %codes1_unsigned_f32, %negative32_f32 : vector<16xf32>
        %scale0_i8, %scale1_i8 = scf.if %use_scale_row_layout -> (i8, i8) {
