  %valid_row = index.cmp ult, %row0, %output_size : index
  %safe_row = scf.select %valid_row, %row0, %c0 : index
  %block_count = index.div %input_size, %c256 : index
  %blocks_padded = index.add %block_count, %c3 : index
  %iterations = index.div %blocks_padded, %c4 : index
  %lane_block = index.div %lane, %c8 : index
  %block_lane0 = index.rem %lane, %c8 : index
  %block_lane = index.assume %block_lane0 [range(%block_lane0, 0, 7)] : index
  %qact_noalias, %scale_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %qact, %qact_scales, %weight, %output : buffer, buffer, buffer, buffer
  %lane_sum = scf.if %valid_row -> (f32) {
    %sum = scf.for %iteration = [%c0 to %iterations step %c1](%acc = %zero_f32 : f32) -> (f32) unroll {
      %iteration_block = index.mul %iteration, %c4 : index
      %block0 = index.add %iteration_block, %lane_block : index
      %valid_block = index.cmp ult, %block0, %block_count : index
      %value = scf.if %valid_block -> (f32) {
        %contribution = func.call @qwen3_moe_symi4_tensor_plane_block_lane(%input_size, %output_size, %safe_row, %block0, %block_lane, %weight_noalias, %qact_noalias, %scale_noalias) : (index, index, index, index, index, buffer, buffer, buffer) -> (f32)
        scf.yield %contribution : f32
      } else {
