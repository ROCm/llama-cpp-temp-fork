  %rows_per_tile = index.constant 128 : index
  %wg = index.constant 256 : index
  %rows0 = config.get @hrx2_shape_mul_mat_id_rows : index
  %nexperts0 = config.get @hrx2_shape_mul_mat_id_nexperts : index
  %rows_bounded = index.assume %rows0 [range(%rows0, 1, 32768)] : index
  %nexperts_bounded = index.assume %nexperts0 [range(%nexperts0, 1, 1024)] : index
  %row_tiles0 = index.add %rows_bounded, %rows_per_tile : index
  %row_tiles1 = index.sub %row_tiles0, %unit : index
  %row_tiles = index.div %row_tiles1, %rows_per_tile : index
  kernel.launch.config workgroups(%row_tiles, %nexperts_bounded, %unit) workgroup_size(%wg, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %idx: buffer, %dst: buffer, %gate: buffer, %aq: buffer, %as: buffer, %asum: buffer, %tbl: buffer) {
  %apply_swiglu = scalar.constant true : i1
  func.apply<qwen36.mmid.q5.static.body>(%apply_swiglu, %src0, %src1, %idx, %dst, %gate, %aq, %as, %asum, %tbl) : (i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
