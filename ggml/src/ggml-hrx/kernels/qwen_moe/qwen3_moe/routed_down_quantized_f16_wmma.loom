      %p0_3_t1_mb = index.assume %p0_3_t1_mb0 [range(%p0_3_t1_mb0, 0, 248)] : index
      %p0_3_t1_aui = vector.load %act_sum_view[%p0_3_t1_mb] : view<256xi32> -> vector<8xi32>
