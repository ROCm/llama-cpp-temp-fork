// Defines GGML's block_q8_1_x4 physical-layout accessors and packs contiguous
// F32 activations into that layout. Four logical 32-element Q8_1 blocks share
// one 144-byte physical group:
//
//   struct block_q8_1_x4 {
//     f16 ds[4][2];   // per-block (scale, quantized_sum * scale)
//     i32 qs[4][8];   // four signed i8 values per packed word
//   };
config.decl @ggml.quantize_q8_1_x4.group_capacity : %value: index where [range(%value, 1, 524288)]

// Loads one logical 32-element Q8_1 block from the four-way physical packing.
// `row_byte_base` addresses the first x4 group for one activation row.
func.def inline @ggml_q8_1_x4_block(%q8_input: buffer, %row_byte_base: offset, %q8_block: index) -> (vector<32xi8>, f32, f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %payload_byte_add = index.constant 16 : offset
  %group = index.div %q8_block, %c4 : index
  %inner0 = index.rem %q8_block, %c4 : index
  %inner = index.assume %inner0 [range(%inner0, 0, 3)] : index
  %group_byte_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_byte_base = index.add %row_byte_base, %group_byte_add : offset
  %payload_byte_base = index.add %group_byte_base, %payload_byte_add : offset
  %ds_view = buffer.view %q8_input[%group_byte_base] : buffer -> view<8xf16>
  %payload_view = buffer.view %q8_input[%payload_byte_base] : buffer -> view<32xi32>
  %d_index = index.mul %inner, %c2 : index
  %s_index = index.add %d_index, %c1 : index
  %word_index = index.mul %inner, %c8 : index
  %d_f16 = view.load %ds_view[%d_index] : view<8xf16> -> f16
  %s_f16 = view.load %ds_view[%s_index] : view<8xf16> -> f16
  %words = vector.load %payload_view[%word_index] : view<32xi32> -> vector<8xi32>
  %values = vector.bitcast %words : vector<8xi32> to vector<32xi8>
  %d = scalar.extf %d_f16 : f16 to f32
  %s = scalar.extf %s_f16 : f16 to f32
  func.return %values, %d, %s : vector<32xi8>, f32, f32
}

// Loads one packed four-value word and its block scale. Dot-product kernels
// use this narrower form so a lane does not load the other seven words owned
// by its subgroup peers.
func.def inline @ggml_q8_1_x4_word(%q8_input: buffer, %row_byte_base: offset, %q8_block: index, %word_in_block: index) -> (vector<4xi8>, f32) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %payload_byte_add = index.constant 16 : offset
  %group = index.div %q8_block, %c4 : index
  %inner0 = index.rem %q8_block, %c4 : index
  %inner = index.assume %inner0 [range(%inner0, 0, 3)] : index
  %word0 = index.assume %word_in_block [range(%word_in_block, 0, 7)] : index
  %group_byte_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_byte_base = index.add %row_byte_base, %group_byte_add : offset
  %payload_byte_base = index.add %group_byte_base, %payload_byte_add : offset
  %ds_view = buffer.view %q8_input[%group_byte_base] : buffer -> view<8xf16>
  %payload_view = buffer.view %q8_input[%payload_byte_base] : buffer -> view<32xi32>
  %d_index = index.mul %inner, %c2 : index
  %inner_word_base = index.mul %inner, %c8 : index
  %word_index = index.add %inner_word_base, %word0 : index
  %d_f16 = view.load %ds_view[%d_index] : view<8xf16> -> f16
  %packed = vector.load %payload_view[%word_index] : view<32xi32> -> vector<1xi32>
  %values = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %d = scalar.extf %d_f16 : f16 to f32
  func.return %values, %d : vector<4xi8>, f32
}

// Packs one explicit physical group. Callers provide the complete physical
// group domain and an in-range ordinal, and guarantee that one complete
// 32-lane wave executes after all 128 source values are visible. The uniform
// publication predicate suppresses only destination writes so every lane still
// reaches the workgroup barriers.
func.template<ggml.quantize_q8_1_x4.group_body> device @ggml_quantize_q8_1_x4_group_body(%publish_output: i1, %group_count0: index, %group0: index, %input: buffer, %output: buffer) {
  %group_count, %group = index.assume %group_count0, %group0 [range(%group_count0, 1, 524288), lt(%group0, %group_count0)] : index, index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %group_bytes = index.constant 144 : index
  %payload_byte_add = index.constant 16 : index
  %scratch_d_byte_add = index.constant 128 : offset
  %scratch_bytes = index.constant 144 : offset
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c127 = scalar.constant 127.0 : f32
  %c0_offset = index.constant 0 : offset
  %launched_element_count = index.mul %group_count, %c128 : index
  %block_in_group0 = index.div %lane, %c8 : index
  %block_in_group = index.assume %block_in_group0 [range(%block_in_group0, 0, 3)] : index
  %word_in_block0 = index.rem %lane, %c8 : index
  %word_in_block = index.assume %word_in_block0 [range(%word_in_block0, 0, 7)] : index
  %group_element_base = index.mul %group, %c128 : index
  %block_element_add = index.mul %block_in_group, %c32 : index
  %block_word_add = index.mul %block_in_group, %c8 : index
  %word_element_add = index.mul %word_in_block, %c4 : index
  %input_block_base = index.add %group_element_base, %block_element_add : index
  %input_index = index.add %input_block_base, %word_element_add : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%launched_element_count]xf32>
  %input_values = vector.load %input_view[%input_index] : view<[%launched_element_count]xf32> -> vector<4xf32>
  %absolute_values = vector.absf %input_values : vector<4xf32>
  %thread_max = vector.reduce<maxnumf> %absolute_values, %c0_f32 : vector<4xf32>, f32
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_values = buffer.view %scratch[%c0_offset] : buffer -> view<32xf32>
  %scratch_d = buffer.view %scratch[%scratch_d_byte_add] : buffer -> view<4xf32>
  view.store %thread_max, %scratch_values[%lane] : f32, view<32xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %is_cohort_leader = index.cmp eq, %word_in_block, %c0 : index
  scf.if %is_cohort_leader {
    %cohort_base = index.mul %block_in_group, %c8 : index
    %cohort_maxima = vector.load %scratch_values[%cohort_base] : view<32xf32> -> vector<8xf32>
    %amax = vector.reduce<maxnumf> %cohort_maxima, %c0_f32 : vector<8xf32>, f32
    %d = scalar.divf %amax, %c127 : f32
    view.store %d, %scratch_d[%block_in_group] : f32, view<4xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %d = view.load %scratch_d[%block_in_group] : view<4xf32> -> f32
  %d_nonzero = scalar.cmpf one, %d, %c0_f32 : f32
  %d_inverse = scf.if %d_nonzero -> (f32) {
    %inverse = scalar.divf %c1_f32, %d : f32
    scf.yield %inverse : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %d_inverse_vector = vector.splat %d_inverse : vector<4xf32>
  %scaled_values = vector.mulf %input_values, %d_inverse_vector : vector<4xf32>
  %rounded_values = vector.roundf %scaled_values : vector<4xf32>
  %quantized_values = vector.fptosi %rounded_values : vector<4xf32> to vector<4xi8>
  %packed_word = vector.bitcast %quantized_values : vector<4xi8> to vector<1xi32>
  %group_byte_index = index.mul %group, %group_bytes : index
  %group_byte_offset = index.cast %group_byte_index : index to offset
  %payload_byte_index = index.add %group_byte_index, %payload_byte_add : index
  %payload_byte_offset = index.cast %payload_byte_index : index to offset
  %group_ds = buffer.view %output_noalias[%group_byte_offset] : buffer -> view<8xf16>
  %group_qs = buffer.view %output_noalias[%payload_byte_offset] : buffer -> view<32xi32>
  %packed_word_index0 = index.add %block_word_add, %word_in_block : index
  %packed_word_index = index.assume %packed_word_index0 [range(%packed_word_index0, 0, 31)] : index
  scf.if %publish_output {
    vector.store %packed_word, %group_qs[%packed_word_index] : vector<1xi32>, view<32xi32>
  }
  %thread_sum = vector.reduce<addf> %rounded_values, %c0_f32 : vector<4xf32>, f32
  view.store %thread_sum, %scratch_values[%lane] : f32, view<32xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %publishes_metadata = scalar.andi %is_cohort_leader, %publish_output : i1
  scf.if %publishes_metadata {
    %cohort_base = index.mul %block_in_group, %c8 : index
    %cohort_sums = vector.load %scratch_values[%cohort_base] : view<32xf32> -> vector<8xf32>
    %quantized_sum = vector.reduce<addf> %cohort_sums, %c0_f32 : vector<8xf32>, f32
    %s = scalar.mulf %quantized_sum, %d : f32
    %d_f16 = scalar.fptrunc %d : f32 to f16
    %s_f16 = scalar.fptrunc %s : f32 to f16
    %ds_index = index.mul %block_in_group, %c2 : index
    view.store %d_f16, %group_ds[%ds_index] : f16, view<8xf16>
    %s_index = index.add %ds_index, %c1 : index
    view.store %s_f16, %group_ds[%s_index] : f16, view<8xf16>
  }
  func.return
}

// A 32-lane workgroup owns one physical group. Each eight-lane cohort loads
// four values, computes one Q8_1 block, and writes disjoint metadata and packed
// words. The LDS reductions make the independent eight-lane cohorts explicit.
kernel.def @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) {
  %group_capacity = config.get @ggml.quantize_q8_1_x4.group_capacity : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%group_capacity, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer) {
  %group_capacity = config.get @ggml.quantize_q8_1_x4.group_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), mul(%input_size, 128)] : index
  %elements_per_group = index.constant 128 : index
  %c0 = index.constant 0 : index
  %element_count = index.mul %bounded_token_count, %bounded_input_size : index
  %group_count0 = index.div %element_count, %elements_per_group : index
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 524288), le(%group_count0, %group_capacity)] : index
  %group0 = kernel.workgroup.id<x> : index
  %valid_group = index.cmp ult, %group0, %group_count : index
  %safe_group = scf.select %valid_group, %group0, %c0 : index
  %group = index.assume %safe_group [lt(%safe_group, %group_count)] : index
  func.apply<ggml.quantize_q8_1_x4.group_body>(%valid_group, %group_count, %group, %input, %output) : (i1, index, index, buffer, buffer)
  kernel.return
}

// This check-only inspector keeps the production packer ABI exact while
// exposing packed words and heterogeneous metadata as comparable tensors.
kernel.def @ggml_q8_1_x4_inspect_one_group() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %words: buffer, %d_values: buffer, %s_values: buffer) {
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %payload_offset = index.constant 16 : offset
  %c0_offset = index.constant 0 : offset
  %packed_ds = buffer.view %packed[%c0_offset] : buffer -> view<8xf16>
  %packed_words = buffer.view %packed[%payload_offset] : buffer -> view<32xi32>
  %word_output = buffer.view %words[%c0_offset] : buffer -> view<32xi32>
  %d_output = buffer.view %d_values[%c0_offset] : buffer -> view<4xf32>
  %s_output = buffer.view %s_values[%c0_offset] : buffer -> view<4xf32>
  %word = view.load %packed_words[%lane] : view<32xi32> -> i32
  view.store %word, %word_output[%lane] : i32, view<32xi32>
  %is_metadata_lane = index.cmp ult, %lane, %c4 : index
  scf.if %is_metadata_lane {
    %ds_index = index.mul %lane, %c2 : index
    %s_index = index.add %ds_index, %c1 : index
    %d_f16 = view.load %packed_ds[%ds_index] : view<8xf16> -> f16
    %s_f16 = view.load %packed_ds[%s_index] : view<8xf16> -> f16
    %d = scalar.extf %d_f16 : f16 to f32
    %s = scalar.extf %s_f16 : f16 to f32
    view.store %d, %d_output[%lane] : f32, view<4xf32>
    view.store %s, %s_output[%lane] : f32, view<4xf32>
  }
  kernel.return
}

check.case public @ggml_quantize_q8_1_x4_f32_nonzero_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(128) : index
  %positive_input = check.generate.fill value(1.0) : tensor<128xf32>
  %negative_input = check.generate.fill value(-1.0) : tensor<128xf32>
  %positive_packed = check.generate.fill value(0) : tensor<144xi8>
  %negative_packed = check.generate.fill value(0) : tensor<144xi8>
  %positive_words = check.generate.fill value(0) : tensor<32xi32>
  %negative_words = check.generate.fill value(0) : tensor<32xi32>
  %positive_d = check.generate.fill value(0.0) : tensor<4xf32>
  %negative_d = check.generate.fill value(0.0) : tensor<4xf32>
  %positive_s = check.generate.fill value(0.0) : tensor<4xf32>
  %negative_s = check.generate.fill value(0.0) : tensor<4xf32>
  %expected_positive_words = check.generate.fill value(2139062143) : tensor<32xi32>
  %expected_negative_words = check.generate.fill value(-2122219135) : tensor<32xi32>
  %expected_d = check.generate.fill value(0.00787353515625) : tensor<4xf32>
  %expected_positive_s = check.generate.fill value(32.0) : tensor<4xf32>
  %expected_negative_s = check.generate.fill value(-32.0) : tensor<4xf32>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %positive_input, %positive_packed) : [index, index](index, index, tensor<128xf32>, tensor<144xi8>)
  kernel.launch @ggml_q8_1_x4_inspect_one_group[](%positive_packed, %positive_words, %positive_d, %positive_s) : [](tensor<144xi8>, tensor<32xi32>, tensor<4xf32>, tensor<4xf32>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %negative_input, %negative_packed) : [index, index](index, index, tensor<128xf32>, tensor<144xi8>)
  kernel.launch @ggml_q8_1_x4_inspect_one_group[](%negative_packed, %negative_words, %negative_d, %negative_s) : [](tensor<144xi8>, tensor<32xi32>, tensor<4xf32>, tensor<4xf32>)
  check.expect.equal actual(%positive_words) expected(%expected_positive_words) : tensor<32xi32>
  check.expect.equal actual(%negative_words) expected(%expected_negative_words) : tensor<32xi32>
  check.expect.close actual(%positive_d) expected(%expected_d) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.expect.close actual(%negative_d) expected(%expected_d) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.expect.close actual(%positive_s) expected(%expected_positive_s) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.expect.close actual(%negative_s) expected(%expected_negative_s) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @ggml_quantize_q8_1_x4_f32_benchmark_case {
  %token_count = check.param.choice values([1, 4, 8, 17, 32, 63, 128, 129, 512]) name("token_count") : index
  %input_size = check.literal value(2048) : index
  %input = check.generate.fill value(0.0) : tensor<[%token_count]x2048xf32>
  %packed = check.generate.fill value(1) : tensor<[%token_count]x2304xi8>
  %expected = check.generate.fill value(0) : tensor<[%token_count]x2304xi8>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %packed) : [index, index](index, index, tensor<[%token_count]x2048xf32>, tensor<[%token_count]x2304xi8>)
  check.expect.equal actual(%packed) expected(%expected) : tensor<[%token_count]x2304xi8>
  check.return
}

check.benchmark<@ggml_quantize_q8_1_x4_f32_nonzero_case> @ggml_quantize_q8_1_x4_f32_small

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_decode {token_count = 1}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_small_batch_8 {token_count = 8}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_32 {token_count = 32}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_128 {token_count = 128}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_512 {token_count = 512}

// ============================================================================
// Qwen3.6 compile-time-specialized roots in this native semantic family
// ============================================================================

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/prepass/quant_act_q8.loom
// ----------------------------------------------------------------------------
// Cooperative activation Q8 quantization for gfx1151.
//
// One aligned group of eight lanes owns each 32-element quantization block.
// Every lane loads four adjacent values, so a wave load covers four complete
// contiguous 128-byte groups. A wave iterates eight batches and retains the
// same 256 groups per workgroup as the one-group-per-lane implementation.
// XOR shuffles reduce only within each aligned eight-lane group.

config.decl @hrx2_shape_qact_k : %value: index where [range(%value, 32, 65536), mul(%value, 32)]
config.decl @hrx2_shape_qact_cols : %value: index where [range(%value, 1, 16384)]

kernel.def export("hrx2_quant_act_q8") @hrx2_quant_act_q8() {
  %unit = index.constant 1 : index
  %wg = index.constant 256 : index
  %wg_m1 = index.constant 255 : index
  %c32 = index.constant 32 : index
  %k = config.get @hrx2_shape_qact_k : index
  %cols = config.get @hrx2_shape_qact_cols : index
  %total = index.mul %k, %cols : index
  %groups = index.div %total, %c32 : index
  %rounded = index.add %groups, %wg_m1 : index
  %workgroups = index.div %rounded, %wg : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%wg, %unit, %unit) : index
} launch(%src: buffer, %qs: buffer, %ds: buffer, %sums: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index

  %zero_f32 = scalar.constant 0.0 : f32
  %amax_eps = scalar.constant 1.0e-30 : f32
  %inv127 = scalar.constant 0.00787401574803149606 : f32
  %f127 = scalar.constant 127.0 : f32
  %xor1 = scalar.constant 1 : i32
  %xor2 = scalar.constant 2 : i32
  %xor4 = scalar.constant 4 : i32
  %shuffle_width = scalar.constant 32 : i32

  %k = config.get @hrx2_shape_qact_k : index
  %cols = config.get @hrx2_shape_qact_cols : index
  %k_b = index.assume %k [range(%k, 32, 65536)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 16384)] : index
  %total = index.mul %k_b, %cols_b : index
  %groups0 = index.div %total, %c32 : index
  %groups = index.assume %groups0 [range(%groups0, 1, 33554432)] : index

  %wgid0 = kernel.workgroup.id<x> : index
  %tid0 = kernel.workitem.id<x> : index
  %wgid = index.assume %wgid0 [range(%wgid0, 0, 131071)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %wave = index.div %tid, %c32 : index
  %lane = index.rem %tid, %c32 : index
  %group_in_wave = index.div %lane, %c8 : index
  %lane_in_group = index.rem %lane, %c8 : index
  %lane_mod4 = index.rem %lane_in_group, %c4 : index
  %group_half = index.div %lane_in_group, %c4 : index
  %is_scale_leader = index.cmp eq, %lane_in_group, %zero : index
  %is_sum_leader = index.cmp eq, %lane_mod4, %zero : index
  %wg_group_base = index.mul %wgid, %c256 : index
  %wave_group_base = index.mul %wave, %c4 : index
  %local_group_base = index.add %wg_group_base, %wave_group_base : index

  %src_g = buffer.assume.memory_space<global> %src : buffer
  %qs_g = buffer.assume.memory_space<global> %qs : buffer
  %ds_g = buffer.assume.memory_space<global> %ds : buffer
  %sums_g = buffer.assume.memory_space<global> %sums : buffer
  %src_na, %qs_na, %ds_na, %sums_na = buffer.assume.noalias %src_g, %qs_g, %ds_g, %sums_g : buffer, buffer, buffer, buffer
  %src_elems = index.assume %total [range(%total, 32, 1073741824)] : index
  %src_view = buffer.view %src_na[%base] : buffer -> view<[%src_elems]xf32>
  %qs_words = index.div %total, %c4 : index
  %qs_view = buffer.view %qs_na[%base] : buffer -> view<[%qs_words]xi32>
  %ds_view = buffer.view %ds_na[%base] : buffer -> view<[%groups]xf32>
  %sum_slots = index.mul %groups, %two : index
  %sum_view = buffer.view %sums_na[%base] : buffer -> view<[%sum_slots]xi32>

  scf.for %batch = [%zero to %c8 step %one] {
    %batch_group_off = index.mul %batch, %c32 : index
    %gid0 = index.add %local_group_base, %batch_group_off : index
    %gid1 = index.add %gid0, %group_in_wave : index
    %gid = index.assume %gid1 [range(%gid1, 0, 33554431)] : index
    %in_range = index.cmp ult, %gid, %groups : index
    scf.if %in_range {
      %ebase0 = index.mul %gid, %c32 : index
      %lane_elem_off = index.mul %lane_in_group, %c4 : index
      %ebase1 = index.add %ebase0, %lane_elem_off : index
      %ebase = index.assume %ebase1 [range(%ebase1, 0, 1073741820)] : index
      %v = vector.load %src_view[%ebase] : view<[%src_elems]xf32> -> vector<4xf32>

      %av = vector.absf %v : vector<4xf32>
      %lane_max = vector.reduce<maxnumf, reassoc|nnan|nsz> %av, %zero_f32 : vector<4xf32>, f32
      %max_x1_peer, %max_x1_valid = kernel.subgroup.shuffle<xor> %lane_max, %xor1, %shuffle_width : f32, i32, i32
      %max_x1 = scalar.maxnumf %lane_max, %max_x1_peer : f32
      %max_x2_peer, %max_x2_valid = kernel.subgroup.shuffle<xor> %max_x1, %xor2, %shuffle_width : f32, i32, i32
      %max_x2 = scalar.maxnumf %max_x1, %max_x2_peer : f32
      %max_x4_peer, %max_x4_valid = kernel.subgroup.shuffle<xor> %max_x2, %xor4, %shuffle_width : f32, i32, i32
      %group_max = scalar.maxnumf %max_x2, %max_x4_peer : f32
      %amax = scalar.maxnumf %group_max, %amax_eps : f32
      %a_scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %inv127 : f32
      %a_rscale = scalar.divf<reassoc|nnan|ninf|nsz> %f127, %amax : f32
      scf.if %is_scale_leader {
        view.store %a_scale, %ds_view[%gid] : f32, view<[%groups]xf32>
      }

      %rs = vector.splat %a_rscale : vector<4xf32>
      %scaled = vector.mulf %v, %rs : vector<4xf32>
      %rounded = vector.roundf %scaled : vector<4xf32>
      %q32 = vector.fptosi %rounded : vector<4xf32> to vector<4xi32>
      %q8 = vector.trunci %q32 : vector<4xi32> to vector<4xi8>
      %qwordv = vector.bitcast %q8 : vector<4xi8> to vector<1xi32>
      %qword = vector.extract %qwordv[0] : vector<1xi32> -> i32
      %word_base = index.mul %gid, %c8 : index
      %word_index0 = index.add %word_base, %lane_in_group : index
      %word_index = index.assume %word_index0 [range(%word_index0, 0, 268435455)] : index
      view.store %qword, %qs_view[%word_index] : i32, view<[%qs_words]xi32>

      %lane_sum = vector.reduce<addf, reassoc|nnan|nsz> %rounded, %zero_f32 : vector<4xf32>, f32
      %sum_x1_peer, %sum_x1_valid = kernel.subgroup.shuffle<xor> %lane_sum, %xor1, %shuffle_width : f32, i32, i32
      %sum_x1 = scalar.addf<reassoc|nnan|nsz> %lane_sum, %sum_x1_peer : f32
      %sum_x2_peer, %sum_x2_valid = kernel.subgroup.shuffle<xor> %sum_x1, %xor2, %shuffle_width : f32, i32, i32
      %half_sum = scalar.addf<reassoc|nnan|nsz> %sum_x1, %sum_x2_peer : f32
      scf.if %is_sum_leader {
        %sum_value = scalar.fptosi %half_sum : f32 to i32
        %sum_base = index.mul %gid, %two : index
        %sum_index0 = index.add %sum_base, %group_half : index
        %sum_index = index.assume %sum_index0 [range(%sum_index0, 0, 67108863)] : index
        view.store %sum_value, %sum_view[%sum_index] : i32, view<[%sum_slots]xi32>
      }
    }
  }
  kernel.return
}

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/prepass/quant_act_q8_packed.loom
// ----------------------------------------------------------------------------
// Quantize a contiguous f32 activation matrix to int8 with per-32 block scales.
//
//   src  [k, cols] f32, k contiguous
//   qs   int8[cols][k]            the packed int8 payload
//   ds   f32 [cols][k/32]         one scale per 32-element block
//   sums i32 [cols][k/16]         one int8 sum per 16 elements
//
// The sums serve the weight-side bias corrections: Q4_K's per-group min applies
// over 32 and adds the two halves, Q6_K's constant -32 applies over 16 and uses
// them separately.
//
// Every GEMM that consumes q8-style activations used to quantize them itself,
// once per workgroup. The q8_0 dense GEMM tiles rows by 256 over an 8192-row
// weight matrix, so the same 32 activation columns were re-read as f32 and
// re-quantized 32 times; the expert GEMM re-quantized each matched token once
// per row tile (4x for gate/up, 16x for down). Hoisting it here does the work
// once and hands the GEMMs an int8 operand, which is a quarter of the bytes.
//
// One lane owns one 32-element group: eight 128-bit loads, an amax reduction
// and a pack into eight i32 words. Lanes walk consecutive groups so a wave
// reads 4 KiB contiguous and writes 1 KiB contiguous.


kernel.def export("hrx2_quant_act_q8_packed") @hrx2_quant_act_q8_packed() {
  %unit = index.constant 1 : index
  %wg = index.constant 256 : index
  %wg_m1 = index.constant 255 : index
  %c32 = index.constant 32 : index
  %k = config.get @hrx2_shape_qact_k : index
  %cols = config.get @hrx2_shape_qact_cols : index
  %total = index.mul %k, %cols : index
  %groups = index.div %total, %c32 : index
  %rounded = index.add %groups, %wg_m1 : index
  %workgroups = index.div %rounded, %wg : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%wg, %unit, %unit) : index
} launch(%src: buffer, %packed: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index

  %zero_i32 = scalar.constant 0 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %amax_eps = scalar.constant 1.0e-30 : f32
  %inv127 = scalar.constant 0.00787401574803149606 : f32
  %f127 = scalar.constant 127.0 : f32

  %k = config.get @hrx2_shape_qact_k : index
  %cols = config.get @hrx2_shape_qact_cols : index
  %k_b = index.assume %k [range(%k, 32, 65536)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 16384)] : index
  %total = index.mul %k_b, %cols_b : index
  %groups0 = index.div %total, %c32 : index
  %groups = index.assume %groups0 [range(%groups0, 1, 33554432)] : index

  %wgid0 = kernel.workgroup.id<x> : index
  %lane0 = kernel.workitem.id<x> : index
  %wgid = index.assume %wgid0 [range(%wgid0, 0, 131071)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %gid0 = index.mul %wgid, %c256 : index
  %gid1 = index.add %gid0, %lane : index
  %gid = index.assume %gid1 [range(%gid1, 0, 33554431)] : index
  %in_range = index.cmp ult, %gid, %groups : index

  %src_g = buffer.assume.memory_space<global> %src : buffer
  %packed_g = buffer.assume.memory_space<global> %packed : buffer
  %src_na, %packed_na = buffer.assume.noalias %src_g, %packed_g : buffer, buffer
  %src_elems = index.assume %total [range(%total, 32, 1073741824)] : index
  %src_view = buffer.view %src_na[%base] : buffer -> view<[%src_elems]xf32>
  %qs_words = index.div %total, %c4 : index
  %ds_byte_index = index.mul %groups, %c32 : index
  %ds_byte_offset = index.cast %ds_byte_index : index to offset
  %ds_bytes = index.mul %groups, %c4 : index
  %sum_byte_index = index.add %ds_byte_index, %ds_bytes : index
  %sum_byte_offset = index.cast %sum_byte_index : index to offset
  %qs_view = buffer.view %packed_na[%base] : buffer -> view<[%qs_words]xi32>
  %ds_view = buffer.view %packed_na[%ds_byte_offset] : buffer -> view<[%groups]xf32>
  %c2 = index.constant 2 : index
  %sum_slots = index.mul %groups, %c2 : index
  %sum_view = buffer.view %packed_na[%sum_byte_offset] : buffer -> view<[%sum_slots]xi32>

  scf.if %in_range {
    %ebase0 = index.mul %gid, %c32 : index
    %ebase = index.assume %ebase0 [range(%ebase0, 0, 1073741792)] : index

    %e0 = index.add %ebase, %zero : index
    %v0 = vector.load %src_view[%e0] : view<[%src_elems]xf32> -> vector<4xf32>
    %o1 = index.constant 4 : index
    %e1r = index.add %ebase, %o1 : index
    %e1 = index.assume %e1r [range(%e1r, 0, 1073741820)] : index
    %v1 = vector.load %src_view[%e1] : view<[%src_elems]xf32> -> vector<4xf32>
    %o2 = index.constant 8 : index
    %e2r = index.add %ebase, %o2 : index
    %e2 = index.assume %e2r [range(%e2r, 0, 1073741820)] : index
    %v2 = vector.load %src_view[%e2] : view<[%src_elems]xf32> -> vector<4xf32>
    %o3 = index.constant 12 : index
    %e3r = index.add %ebase, %o3 : index
    %e3 = index.assume %e3r [range(%e3r, 0, 1073741820)] : index
    %v3 = vector.load %src_view[%e3] : view<[%src_elems]xf32> -> vector<4xf32>
    %o4 = index.constant 16 : index
    %e4r = index.add %ebase, %o4 : index
    %e4 = index.assume %e4r [range(%e4r, 0, 1073741820)] : index
    %v4 = vector.load %src_view[%e4] : view<[%src_elems]xf32> -> vector<4xf32>
    %o5 = index.constant 20 : index
    %e5r = index.add %ebase, %o5 : index
    %e5 = index.assume %e5r [range(%e5r, 0, 1073741820)] : index
    %v5 = vector.load %src_view[%e5] : view<[%src_elems]xf32> -> vector<4xf32>
    %o6 = index.constant 24 : index
    %e6r = index.add %ebase, %o6 : index
    %e6 = index.assume %e6r [range(%e6r, 0, 1073741820)] : index
    %v6 = vector.load %src_view[%e6] : view<[%src_elems]xf32> -> vector<4xf32>
    %o7 = index.constant 28 : index
    %e7r = index.add %ebase, %o7 : index
    %e7 = index.assume %e7r [range(%e7r, 0, 1073741820)] : index
    %v7 = vector.load %src_view[%e7] : view<[%src_elems]xf32> -> vector<4xf32>

    %a0 = vector.absf %v0 : vector<4xf32>
    %m0 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a0, %zero_f32 : vector<4xf32>, f32
    %a1 = vector.absf %v1 : vector<4xf32>
    %m1 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a1, %zero_f32 : vector<4xf32>, f32
    %a2 = vector.absf %v2 : vector<4xf32>
    %m2 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a2, %zero_f32 : vector<4xf32>, f32
    %a3 = vector.absf %v3 : vector<4xf32>
    %m3 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a3, %zero_f32 : vector<4xf32>, f32
    %a4 = vector.absf %v4 : vector<4xf32>
    %m4 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a4, %zero_f32 : vector<4xf32>, f32
    %a5 = vector.absf %v5 : vector<4xf32>
    %m5 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a5, %zero_f32 : vector<4xf32>, f32
    %a6 = vector.absf %v6 : vector<4xf32>
    %m6 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a6, %zero_f32 : vector<4xf32>, f32
    %a7 = vector.absf %v7 : vector<4xf32>
    %m7 = vector.reduce<maxnumf, reassoc|nnan|nsz> %a7, %zero_f32 : vector<4xf32>, f32

    %x1 = scalar.maxnumf %m0, %m1 : f32
    %x2 = scalar.maxnumf %x1, %m2 : f32
    %x3 = scalar.maxnumf %x2, %m3 : f32
    %x4 = scalar.maxnumf %x3, %m4 : f32
    %x5 = scalar.maxnumf %x4, %m5 : f32
    %x6 = scalar.maxnumf %x5, %m6 : f32
    %x7 = scalar.maxnumf %x6, %m7 : f32
    %amax = scalar.maxnumf %x7, %amax_eps : f32
    %a_scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %inv127 : f32
    %a_rscale = scalar.divf<reassoc|nnan|ninf|nsz> %f127, %amax : f32
    view.store %a_scale, %ds_view[%gid] : f32, view<[%groups]xf32>

    %rs = vector.splat %a_rscale : vector<4xf32>
    // Packed-word slots step by one; %o1..%o7 are element strides for the loads
    // above and must not be reused here.
    %p1 = index.constant 1 : index
    %p2 = index.constant 2 : index
    %p3 = index.constant 3 : index
    %p4 = index.constant 4 : index
    %p5 = index.constant 5 : index
    %p6 = index.constant 6 : index
    %p7 = index.constant 7 : index
    %wbase0 = index.mul %gid, %c8 : index
    %wbase = index.assume %wbase0 [range(%wbase0, 0, 268435448)] : index

    %s0 = vector.mulf %v0, %rs : vector<4xf32>
    %r0 = vector.roundf %s0 : vector<4xf32>
    %q0 = vector.fptosi %r0 : vector<4xf32> to vector<4xi32>
    %q0i8 = vector.trunci %q0 : vector<4xi32> to vector<4xi8>
    %q0v = vector.bitcast %q0i8 : vector<4xi8> to vector<1xi32>
    %q0w = vector.extract %q0v[0] : vector<1xi32> -> i32
    %w0i = index.add %wbase, %zero : index
    view.store %q0w, %qs_view[%w0i] : i32, view<[%qs_words]xi32>

    %s1 = vector.mulf %v1, %rs : vector<4xf32>
    %r1 = vector.roundf %s1 : vector<4xf32>
    %q1 = vector.fptosi %r1 : vector<4xf32> to vector<4xi32>
    %q1i8 = vector.trunci %q1 : vector<4xi32> to vector<4xi8>
    %q1v = vector.bitcast %q1i8 : vector<4xi8> to vector<1xi32>
    %q1w = vector.extract %q1v[0] : vector<1xi32> -> i32
    %w1r = index.add %wbase, %p1 : index
    %w1i = index.assume %w1r [range(%w1r, 0, 268435455)] : index
    view.store %q1w, %qs_view[%w1i] : i32, view<[%qs_words]xi32>

    %s2 = vector.mulf %v2, %rs : vector<4xf32>
    %r2 = vector.roundf %s2 : vector<4xf32>
    %q2 = vector.fptosi %r2 : vector<4xf32> to vector<4xi32>
    %q2i8 = vector.trunci %q2 : vector<4xi32> to vector<4xi8>
    %q2v = vector.bitcast %q2i8 : vector<4xi8> to vector<1xi32>
    %q2w = vector.extract %q2v[0] : vector<1xi32> -> i32
    %w2r = index.add %wbase, %p2 : index
    %w2i = index.assume %w2r [range(%w2r, 0, 268435455)] : index
    view.store %q2w, %qs_view[%w2i] : i32, view<[%qs_words]xi32>

    %s3 = vector.mulf %v3, %rs : vector<4xf32>
    %r3 = vector.roundf %s3 : vector<4xf32>
    %q3 = vector.fptosi %r3 : vector<4xf32> to vector<4xi32>
    %q3i8 = vector.trunci %q3 : vector<4xi32> to vector<4xi8>
    %q3v = vector.bitcast %q3i8 : vector<4xi8> to vector<1xi32>
    %q3w = vector.extract %q3v[0] : vector<1xi32> -> i32
    %w3r = index.add %wbase, %p3 : index
    %w3i = index.assume %w3r [range(%w3r, 0, 268435455)] : index
    view.store %q3w, %qs_view[%w3i] : i32, view<[%qs_words]xi32>

    %s4 = vector.mulf %v4, %rs : vector<4xf32>
    %r4 = vector.roundf %s4 : vector<4xf32>
    %q4 = vector.fptosi %r4 : vector<4xf32> to vector<4xi32>
    %q4i8 = vector.trunci %q4 : vector<4xi32> to vector<4xi8>
    %q4v = vector.bitcast %q4i8 : vector<4xi8> to vector<1xi32>
    %q4w = vector.extract %q4v[0] : vector<1xi32> -> i32
    %w4r = index.add %wbase, %p4 : index
    %w4i = index.assume %w4r [range(%w4r, 0, 268435455)] : index
    view.store %q4w, %qs_view[%w4i] : i32, view<[%qs_words]xi32>

    %s5 = vector.mulf %v5, %rs : vector<4xf32>
    %r5 = vector.roundf %s5 : vector<4xf32>
    %q5 = vector.fptosi %r5 : vector<4xf32> to vector<4xi32>
    %q5i8 = vector.trunci %q5 : vector<4xi32> to vector<4xi8>
    %q5v = vector.bitcast %q5i8 : vector<4xi8> to vector<1xi32>
    %q5w = vector.extract %q5v[0] : vector<1xi32> -> i32
    %w5r = index.add %wbase, %p5 : index
    %w5i = index.assume %w5r [range(%w5r, 0, 268435455)] : index
    view.store %q5w, %qs_view[%w5i] : i32, view<[%qs_words]xi32>

    %s6 = vector.mulf %v6, %rs : vector<4xf32>
    %r6 = vector.roundf %s6 : vector<4xf32>
    %q6 = vector.fptosi %r6 : vector<4xf32> to vector<4xi32>
    %q6i8 = vector.trunci %q6 : vector<4xi32> to vector<4xi8>
    %q6v = vector.bitcast %q6i8 : vector<4xi8> to vector<1xi32>
    %q6w = vector.extract %q6v[0] : vector<1xi32> -> i32
    %w6r = index.add %wbase, %p6 : index
    %w6i = index.assume %w6r [range(%w6r, 0, 268435455)] : index
    view.store %q6w, %qs_view[%w6i] : i32, view<[%qs_words]xi32>

    %s7 = vector.mulf %v7, %rs : vector<4xf32>
    %r7 = vector.roundf %s7 : vector<4xf32>
    %q7 = vector.fptosi %r7 : vector<4xf32> to vector<4xi32>
    %q7i8 = vector.trunci %q7 : vector<4xi32> to vector<4xi8>
    %q7v = vector.bitcast %q7i8 : vector<4xi8> to vector<1xi32>
    %q7w = vector.extract %q7v[0] : vector<1xi32> -> i32
    %w7r = index.add %wbase, %p7 : index
    %w7i = index.assume %w7r [range(%w7r, 0, 268435455)] : index
    view.store %q7w, %qs_view[%w7i] : i32, view<[%qs_words]xi32>

    %fs0 = vector.reduce<addf, reassoc|nnan|nsz> %r0, %zero_f32 : vector<4xf32>, f32
    %fs1 = vector.reduce<addf, reassoc|nnan|nsz> %r1, %zero_f32 : vector<4xf32>, f32
    %fs2 = vector.reduce<addf, reassoc|nnan|nsz> %r2, %zero_f32 : vector<4xf32>, f32
    %fs3 = vector.reduce<addf, reassoc|nnan|nsz> %r3, %zero_f32 : vector<4xf32>, f32
    %fs4 = vector.reduce<addf, reassoc|nnan|nsz> %r4, %zero_f32 : vector<4xf32>, f32
    %fs5 = vector.reduce<addf, reassoc|nnan|nsz> %r5, %zero_f32 : vector<4xf32>, f32
    %fs6 = vector.reduce<addf, reassoc|nnan|nsz> %r6, %zero_f32 : vector<4xf32>, f32
    %fs7 = vector.reduce<addf, reassoc|nnan|nsz> %r7, %zero_f32 : vector<4xf32>, f32
    %lo01 = scalar.addf<reassoc|nnan|nsz> %fs0, %fs1 : f32
    %lo23 = scalar.addf<reassoc|nnan|nsz> %fs2, %fs3 : f32
    %lo = scalar.addf<reassoc|nnan|nsz> %lo01, %lo23 : f32
    %hi45 = scalar.addf<reassoc|nnan|nsz> %fs4, %fs5 : f32
    %hi67 = scalar.addf<reassoc|nnan|nsz> %fs6, %fs7 : f32
    %hi = scalar.addf<reassoc|nnan|nsz> %hi45, %hi67 : f32
    %slo = scalar.fptosi %lo : f32 to i32
    %shi = scalar.fptosi %hi : f32 to i32
    %sbase = index.mul %gid, %c2 : index
    %sbase1 = index.add %sbase, %p1 : index
    view.store %slo, %sum_view[%sbase] : i32, view<[%sum_slots]xi32>
    view.store %shi, %sum_view[%sbase1] : i32, view<[%sum_slots]xi32>
  }
  kernel.return
}
