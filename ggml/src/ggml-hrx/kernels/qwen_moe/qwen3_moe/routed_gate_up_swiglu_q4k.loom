      %p1_3_t1_wi = index.assume %p1_3_t1_wi1 [range(%p1_3_t1_wi1, 0, 639)] : index
      %p1_3_t1_d = view.load %wsc_view[%p1_3_t1_wi] : view<640xf32> -> f32
      %p1_3_t1_m = view.load %wmn_view[%p1_3_t1_wi] : view<640xf32> -> f32
