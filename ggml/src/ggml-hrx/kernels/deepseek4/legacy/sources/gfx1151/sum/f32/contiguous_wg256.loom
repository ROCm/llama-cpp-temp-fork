config.decl @shape_sum_f32_total_size : %value: index where [range(%value, 1, 1073741824)]
config.decl @tuning_sum_f32_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

kernel.def export("hrx2_sum_f32") @hrx2_sum_f32() {
  %unit = index.constant 1 : index
  %workgroup_size = config.get @tuning_sum_f32_workgroup_size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %total_size = config.get @shape_sum_f32_total_size : index
  %workgroup_size = config.get @tuning_sum_f32_workgroup_size : index
  %total_size_bounded = index.assume %total_size [range(%total_size, 1, 1073741824)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index
  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_view = buffer.view %src0_global[%base] : buffer -> view<[%total_size_bounded]xf32, #dense>
  %dst_view = buffer.view %dst_global[%base] : buffer -> view<1xf32, #dense>
  %lane_sum = scf.for %i = [%lane to %total_size_bounded step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %src0_view[%i] : view<[%total_size_bounded]xf32, #dense> -> f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value : f32
    scf.yield %next : f32
  }
  %total = kernel.workgroup.reduce<addf> %lane_sum : f32
  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %total, %dst_view[%zero] : f32, view<1xf32, #dense>
  }
  kernel.return
}
