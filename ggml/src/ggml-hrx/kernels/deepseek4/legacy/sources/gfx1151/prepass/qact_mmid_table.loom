// Combined Q8 activation quantization and MMID match-table prepass.

config.decl @hrx2_shape_qact_k : %value: index where [range(%value, 32, 65536), mul(%value, 32)]
config.decl @hrx2_shape_qact_cols : %value: index where [range(%value, 1, 16384)]
config.decl @hrx2_shape_mul_mat_id_nexperts : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_mul_mat_id_nselected : %value: index where [range(%value, 1, 128)]
config.decl @hrx2_shape_mul_mat_id_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_idx_token_stride : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_qact_sums_offset_bytes : %value: index where [range(%value, 4, 1073741824), mul(%value, 4)]

kernel.def export("hrx2_qact_mmid_table") @hrx2_qact_mmid_table() {
  %one = index.constant 1 : index
  %wg = index.constant 256 : index
  %minus_one = index.constant -1 : index
  %qact_k = config.get @hrx2_shape_qact_k : index
  %qact_cols = config.get @hrx2_shape_qact_cols : index
  %qact_elements = index.mul %qact_k, %qact_cols : index
  %qact_workgroup_elements = index.constant 8192 : index
  %qact_rounding = index.add %qact_workgroup_elements, %minus_one : index
  %qact_rounded = index.add %qact_elements, %qact_rounding : index
  %qact_groups = index.div %qact_rounded, %qact_workgroup_elements : index
  %experts = config.get @hrx2_shape_mul_mat_id_nexperts : index
  %total_groups = index.add %qact_groups, %experts : index
  kernel.launch.config workgroups(%total_groups, %one, %one)
      workgroup_size(%wg, %one, %one) : index
} launch(%qa_src: buffer, %qa_qs: buffer, %qa_meta: buffer,
          %mm_idx: buffer, %prepass_mmid: buffer) {
  %phase_zero = index.constant 0 : index
  %phase_one = index.constant 1 : index
  %phase_wg = index.constant 256 : index
  %phase_minus_one = index.constant -1 : index
  %phase_qact_k = config.get @hrx2_shape_qact_k : index
  %phase_qact_cols = config.get @hrx2_shape_qact_cols : index
  %phase_qact_elements = index.mul %phase_qact_k, %phase_qact_cols : index
  %phase_qact_wg_elements = index.constant 8192 : index
  %phase_qact_rounding = index.add %phase_qact_wg_elements, %phase_minus_one : index
  %phase_qact_rounded = index.add %phase_qact_elements, %phase_qact_rounding : index
  %phase_qact_groups = index.div %phase_qact_rounded, %phase_qact_wg_elements : index
  %phase_experts = config.get @hrx2_shape_mul_mat_id_nexperts : index
  %phase_mmid_end = index.add %phase_qact_groups, %phase_experts : index
  %phase_wgid = kernel.workgroup.id<x> : index
  %phase_is_qact = index.cmp ult, %phase_wgid, %phase_qact_groups : index
  %phase_mmid_lo = index.cmp uge, %phase_wgid, %phase_qact_groups : index
  %phase_mmid_hi = index.cmp ult, %phase_wgid, %phase_mmid_end : index
  %phase_is_mmid = scalar.andi %phase_mmid_lo, %phase_mmid_hi : i1

  scf.if %phase_is_qact {
  %qa_base = index.constant 0 : offset
  %qa_sums_base_i = config.get @hrx2_qact_sums_offset_bytes : index
  %qa_sums_base = index.cast %qa_sums_base_i : index to offset
  %qa_zero = index.constant 0 : index
  %qa_one = index.constant 1 : index
  %qa_two = index.constant 2 : index
  %qa_c4 = index.constant 4 : index
  %qa_c8 = index.constant 8 : index
  %qa_c32 = index.constant 32 : index
  %qa_c256 = index.constant 256 : index

  %qa_zero_f32 = scalar.constant 0.0 : f32
  %qa_amax_eps = scalar.constant 1.0e-30 : f32
  %qa_inv127 = scalar.constant 0.00787401574803149606 : f32
  %qa_f127 = scalar.constant 127.0 : f32
  %qa_xor1 = scalar.constant 1 : i32
  %qa_xor2 = scalar.constant 2 : i32
  %qa_xor4 = scalar.constant 4 : i32
  %qa_shuffle_width = scalar.constant 32 : i32

  %qa_k = config.get @hrx2_shape_qact_k : index
  %qa_cols = config.get @hrx2_shape_qact_cols : index
  %qa_k_b = index.assume %qa_k [range(%qa_k, 32, 65536)] : index
  %qa_cols_b = index.assume %qa_cols [range(%qa_cols, 1, 16384)] : index
  %qa_total = index.mul %qa_k_b, %qa_cols_b : index
  %qa_groups0 = index.div %qa_total, %qa_c32 : index
  %qa_groups = index.assume %qa_groups0 [range(%qa_groups0, 1, 33554432)] : index

  %qa_wgid0 = index.add %phase_wgid, %phase_zero : index
  %qa_tid0 = kernel.workitem.id<x> : index
  %qa_wgid = index.assume %qa_wgid0 [range(%qa_wgid0, 0, 131071)] : index
  %qa_tid = index.assume %qa_tid0 [range(%qa_tid0, 0, 255)] : index
  %qa_wave = index.div %qa_tid, %qa_c32 : index
  %qa_lane = index.rem %qa_tid, %qa_c32 : index
  %qa_group_in_wave = index.div %qa_lane, %qa_c8 : index
  %qa_lane_in_group = index.rem %qa_lane, %qa_c8 : index
  %qa_lane_mod4 = index.rem %qa_lane_in_group, %qa_c4 : index
  %qa_group_half = index.div %qa_lane_in_group, %qa_c4 : index
  %qa_is_scale_leader = index.cmp eq, %qa_lane_in_group, %qa_zero : index
  %qa_is_sum_leader = index.cmp eq, %qa_lane_mod4, %qa_zero : index
  %qa_wg_group_base = index.mul %qa_wgid, %qa_c256 : index
  %qa_wave_group_base = index.mul %qa_wave, %qa_c4 : index
  %qa_local_group_base = index.add %qa_wg_group_base, %qa_wave_group_base : index

  %qa_src_g = buffer.assume.memory_space<global> %qa_src : buffer
  %qa_qs_g = buffer.assume.memory_space<global> %qa_qs : buffer
  %qa_meta_g = buffer.assume.memory_space<global> %qa_meta : buffer
  %qa_src_na, %qa_qs_na, %qa_meta_na = buffer.assume.noalias %qa_src_g, %qa_qs_g, %qa_meta_g : buffer, buffer, buffer
  %qa_src_elems = index.assume %qa_total [range(%qa_total, 32, 1073741824)] : index
  %qa_src_view = buffer.view %qa_src_na[%qa_base] : buffer -> view<[%qa_src_elems]xf32, #dense>
  %qa_qs_words = index.div %qa_total, %qa_c4 : index
  %qa_qs_view = buffer.view %qa_qs_na[%qa_base] : buffer -> view<[%qa_qs_words]xi32, #dense>
  %qa_ds_view = buffer.view %qa_meta_na[%qa_base] : buffer -> view<[%qa_groups]xf32, #dense>
  %qa_sum_slots = index.mul %qa_groups, %qa_two : index
  %qa_sum_view = buffer.view %qa_meta_na[%qa_sums_base] : buffer -> view<[%qa_sum_slots]xi32, #dense>

  scf.for %qa_batch = [%qa_zero to %qa_c8 step %qa_one] {
    %qa_batch_group_off = index.mul %qa_batch, %qa_c32 : index
    %qa_gid0 = index.add %qa_local_group_base, %qa_batch_group_off : index
    %qa_gid1 = index.add %qa_gid0, %qa_group_in_wave : index
    %qa_gid = index.assume %qa_gid1 [range(%qa_gid1, 0, 33554431)] : index
    %qa_in_range = index.cmp ult, %qa_gid, %qa_groups : index
    scf.if %qa_in_range {
      %qa_ebase0 = index.mul %qa_gid, %qa_c32 : index
      %qa_lane_elem_off = index.mul %qa_lane_in_group, %qa_c4 : index
      %qa_ebase1 = index.add %qa_ebase0, %qa_lane_elem_off : index
      %qa_ebase = index.assume %qa_ebase1 [range(%qa_ebase1, 0, 1073741820)] : index
      %qa_v = vector.load %qa_src_view[%qa_ebase] : view<[%qa_src_elems]xf32, #dense> -> vector<4xf32>

      %qa_av = vector.absf %qa_v : vector<4xf32>
      %qa_lane_max = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_av, %qa_zero_f32 : vector<4xf32>, f32
      %qa_max_x1_peer, %qa_max_x1_valid = kernel.subgroup.shuffle<xor> %qa_lane_max, %qa_xor1, %qa_shuffle_width : f32, i32, i32
      %qa_max_x1 = scalar.maxnumf %qa_lane_max, %qa_max_x1_peer : f32
      %qa_max_x2_peer, %qa_max_x2_valid = kernel.subgroup.shuffle<xor> %qa_max_x1, %qa_xor2, %qa_shuffle_width : f32, i32, i32
      %qa_max_x2 = scalar.maxnumf %qa_max_x1, %qa_max_x2_peer : f32
      %qa_max_x4_peer, %qa_max_x4_valid = kernel.subgroup.shuffle<xor> %qa_max_x2, %qa_xor4, %qa_shuffle_width : f32, i32, i32
      %qa_group_max = scalar.maxnumf %qa_max_x2, %qa_max_x4_peer : f32
      %qa_amax = scalar.maxnumf %qa_group_max, %qa_amax_eps : f32
      %qa_a_scale = scalar.mulf<reassoc|nnan|ninf|nsz> %qa_amax, %qa_inv127 : f32
      %qa_a_rscale = scalar.divf<reassoc|nnan|ninf|nsz> %qa_f127, %qa_amax : f32
      scf.if %qa_is_scale_leader {
        view.store %qa_a_scale, %qa_ds_view[%qa_gid] : f32, view<[%qa_groups]xf32, #dense>
      }

      %qa_rs = vector.splat %qa_a_rscale : vector<4xf32>
      %qa_scaled = vector.mulf %qa_v, %qa_rs : vector<4xf32>
      %qa_rounded = vector.roundf %qa_scaled : vector<4xf32>
      %qa_q32 = vector.fptosi %qa_rounded : vector<4xf32> to vector<4xi32>
      %qa_q8 = vector.trunci %qa_q32 : vector<4xi32> to vector<4xi8>
      %qa_qwordv = vector.bitcast %qa_q8 : vector<4xi8> to vector<1xi32>
      %qa_qword = vector.extract %qa_qwordv[0] : vector<1xi32> -> i32
      %qa_word_base = index.mul %qa_gid, %qa_c8 : index
      %qa_word_index0 = index.add %qa_word_base, %qa_lane_in_group : index
      %qa_word_index = index.assume %qa_word_index0 [range(%qa_word_index0, 0, 268435455)] : index
      view.store %qa_qword, %qa_qs_view[%qa_word_index] : i32, view<[%qa_qs_words]xi32, #dense>

      %qa_lane_sum = vector.reduce<addf, reassoc|nnan|nsz> %qa_rounded, %qa_zero_f32 : vector<4xf32>, f32
      %qa_sum_x1_peer, %qa_sum_x1_valid = kernel.subgroup.shuffle<xor> %qa_lane_sum, %qa_xor1, %qa_shuffle_width : f32, i32, i32
      %qa_sum_x1 = scalar.addf<reassoc|nnan|nsz> %qa_lane_sum, %qa_sum_x1_peer : f32
      %qa_sum_x2_peer, %qa_sum_x2_valid = kernel.subgroup.shuffle<xor> %qa_sum_x1, %qa_xor2, %qa_shuffle_width : f32, i32, i32
      %qa_half_sum = scalar.addf<reassoc|nnan|nsz> %qa_sum_x1, %qa_sum_x2_peer : f32
      scf.if %qa_is_sum_leader {
        %qa_sum_value = scalar.fptosi %qa_half_sum : f32 to i32
        %qa_sum_base = index.mul %qa_gid, %qa_two : index
        %qa_sum_index0 = index.add %qa_sum_base, %qa_group_half : index
        %qa_sum_index = index.assume %qa_sum_index0 [range(%qa_sum_index0, 0, 67108863)] : index
        view.store %qa_sum_value, %qa_sum_view[%qa_sum_index] : i32, view<[%qa_sum_slots]xi32, #dense>
      }
    }
  }
  }
  scf.if %phase_is_mmid {
  %mm_base = index.constant 0 : offset
  %mm_table_base = index.constant 0 : offset
  %mm_zero = index.constant 0 : index
  %mm_one = index.constant 1 : index
  %mm_two = index.constant 2 : index
  %mm_k_wg = index.constant 256 : index
  %mm_k_last = index.constant 255 : index
  %mm_k_pack = index.constant 128 : index
  %mm_zero_i32 = scalar.constant 0 : i32
  %mm_one_i32 = scalar.constant 1 : i32

  %mm_nselected = config.get @hrx2_shape_mul_mat_id_nselected : index
  %mm_ntokens = config.get @hrx2_shape_mul_mat_id_ntokens : index
  %mm_idx_stride = config.get @hrx2_shape_mul_mat_id_idx_token_stride : index
  %mm_nsel = index.assume %mm_nselected [range(%mm_nselected, 1, 128)] : index
  %mm_ntok = index.assume %mm_ntokens [range(%mm_ntokens, 1, 1048576)] : index
  %mm_istride = index.assume %mm_idx_stride [range(%mm_idx_stride, 1, 1048576)] : index

  %mm_lane0 = kernel.workitem.id<x> : index
  %mm_lane = index.assume %mm_lane0 [range(%mm_lane0, 0, 255)] : index
  %mm_expert0 = index.sub %phase_wgid, %phase_qact_groups : index
  %mm_expert = index.assume %mm_expert0 [range(%mm_expert0, 0, 1023)] : index
  %mm_expert_i32 = index.cast %mm_expert : index to i32

  %mm_idx_g = buffer.assume.memory_space<global> %mm_idx : buffer
  %mm_tbl_g = buffer.assume.memory_space<global> %prepass_mmid : buffer
  %mm_idx_na, %mm_tbl_na = buffer.assume.noalias %mm_idx_g, %mm_tbl_g : buffer, buffer
  %mm_idx_view = buffer.view %mm_idx_na[%mm_base] : buffer -> view<1073741824xi32, #dense>
  %mm_tbl_view = buffer.view %mm_tbl_na[%mm_table_base] : buffer -> view<268435456xi32, #dense>

  %mm_stride0 = index.mul %mm_ntok, %mm_nsel : index
  %mm_stride = index.mul %mm_stride0, %mm_two : index
  %mm_tbl_base0 = index.mul %mm_expert, %mm_stride : index
  %mm_tbl_base = index.assume %mm_tbl_base0 [range(%mm_tbl_base0, 0, 268435455)] : index

  // 256 lane counts, reused for the inclusive-prefix broadcast and cursors.
  %mm_lds_bytes = index.constant 1024 : offset
  %mm_scratch = buffer.alloca %mm_lds_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %mm_cnt_view = buffer.view %mm_scratch[%mm_base] : buffer -> view<256xi32, #dense>

  view.store %mm_zero_i32, %mm_cnt_view[%mm_lane] : i32, view<256xi32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

  scf.for %mm_tok = [%mm_lane to %mm_ntok step %mm_k_wg] {
    scf.for %mm_sel = [%mm_zero to %mm_nsel step %mm_one] {
      %mm_row = index.mul %mm_tok, %mm_istride : index
      %mm_at0 = index.add %mm_row, %mm_sel : index
      %mm_at = index.assume %mm_at0 [range(%mm_at0, 0, 1073741823)] : index
      %mm_e = view.load %mm_idx_view[%mm_at] : view<1073741824xi32, #dense> -> i32
      %mm_hit = scalar.cmpi eq, %mm_e, %mm_expert_i32 : i32
      scf.if %mm_hit {
        %mm_cur = view.load %mm_cnt_view[%mm_lane] : view<256xi32, #dense> -> i32
        %mm_nxt = scalar.addi %mm_cur, %mm_one_i32 : i32
        view.store %mm_nxt, %mm_cnt_view[%mm_lane] : i32, view<256xi32, #dense>
      }
    }
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

  %mm_mine = view.load %mm_cnt_view[%mm_lane] : view<256xi32, #dense> -> i32
  %mm_incl = kernel.workgroup.scan<addi> %mm_mine
      {mode = inclusive, direction = forward} : i32
  view.store %mm_incl, %mm_cnt_view[%mm_lane] : i32, view<256xi32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %mm_prefix = scalar.subi %mm_incl, %mm_mine : i32
  %mm_total = view.load %mm_cnt_view[%mm_k_last] : view<256xi32, #dense> -> i32
  %mm_is_zero = index.cmp eq, %mm_lane, %mm_zero : index
  scf.if %mm_is_zero {
    view.store %mm_total, %mm_tbl_view[%mm_tbl_base] : i32, view<268435456xi32, #dense>
  }

  // Scatter: the lane's cursor starts at its exclusive prefix.
  view.store %mm_prefix, %mm_cnt_view[%mm_lane] : i32, view<256xi32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  scf.for %mm_tok = [%mm_lane to %mm_ntok step %mm_k_wg] {
    scf.for %mm_sel = [%mm_zero to %mm_nsel step %mm_one] {
      %mm_row2 = index.mul %mm_tok, %mm_istride : index
      %mm_at2_0 = index.add %mm_row2, %mm_sel : index
      %mm_at2 = index.assume %mm_at2_0 [range(%mm_at2_0, 0, 1073741823)] : index
      %mm_e2 = view.load %mm_idx_view[%mm_at2] : view<1073741824xi32, #dense> -> i32
      %mm_hit2 = scalar.cmpi eq, %mm_e2, %mm_expert_i32 : i32
      scf.if %mm_hit2 {
        %mm_rk = view.load %mm_cnt_view[%mm_lane] : view<256xi32, #dense> -> i32
        %mm_rk_i = index.cast %mm_rk : i32 to index
        %mm_rk_b = index.assume %mm_rk_i [range(%mm_rk_i, 0, 2097151)] : index
        %mm_slot0 = index.add %mm_tbl_base, %mm_one : index
        %mm_slot1 = index.add %mm_slot0, %mm_rk_b : index
        %mm_slot = index.assume %mm_slot1 [range(%mm_slot1, 0, 268435455)] : index
        %mm_packed0 = index.mul %mm_tok, %mm_k_pack : index
        %mm_packed1 = index.add %mm_packed0, %mm_sel : index
        %mm_packed = index.cast %mm_packed1 : index to i32
        view.store %mm_packed, %mm_tbl_view[%mm_slot] : i32, view<268435456xi32, #dense>
        %mm_rk2 = scalar.addi %mm_rk, %mm_one_i32 : i32
        view.store %mm_rk2, %mm_cnt_view[%mm_lane] : i32, view<256xi32, #dense>
      }
    }
  }
  }
  kernel.return
}
