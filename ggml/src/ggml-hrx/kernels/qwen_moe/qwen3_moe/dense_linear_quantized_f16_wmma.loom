// Specialized root formerly in qwen36/legacy/sources/gfx1151/mul_mat/q8_0_f32/mul_mat_q8_0_f32_wmmai8_gdn_rms_side_epilogue.loom
// ----------------------------------------------------------------------------
// int8 WMMA Q8_0 x F32 matrix multiply -- 64 rows x 64 cols per
