    %high_b2 = vector.andi %high_b2s, %byte_ones : vector<4xi32>
    %high_b1x2 = vector.shli %high_b1, %shift_one : vector<4xi32>
    %high_b01 = vector.andi %high_b0, %high_b1 : vector<4xi32>
    %high_b01x2 = vector.shli %high_b01, %shift_one : vector<4xi32>
    %high_extra0 = vector.addi %high_b0, %high_b1x2 : vector<4xi32>
    %high_extra = vector.addi %high_extra0, %high_b01x2 : vector<4xi32>
    %high_lm1 = vector.shli %high_b2, %shift_one : vector<4xi32>
    %high_lm2 = vector.ori %high_b2, %high_lm1 : vector<4xi32>
    %high_lm4 = vector.shli %high_lm2, %shift_two : vector<4xi32>
    %high_lm7 = vector.ori %high_lm2, %high_lm4 : vector<4xi32>
    %high_lm8 = vector.shli %high_lm7, %shift_four : vector<4xi32>
    %high_large_mask = vector.ori %high_lm7, %high_lm8 : vector<4xi32>
    %high_large_extra = vector.andi %high_extra, %high_large_mask : vector<4xi32>
    %high_mag = vector.addi %high_mag0, %high_large_extra : vector<4xi32>
    %high_sign0 = vector.shrui %code_high, %shift_three : vector<4xi32>
    %high_sign_raw = vector.andi %high_sign0, %byte_ones : vector<4xi32>
    %high_nz_s1 = vector.shrui %high_mag, %shift_one : vector<4xi32>
    %high_nz1 = vector.ori %high_mag, %high_nz_s1 : vector<4xi32>
    %high_nz_s2 = vector.shrui %high_nz1, %shift_two : vector<4xi32>
    %high_nz2 = vector.ori %high_nz1, %high_nz_s2 : vector<4xi32>
    %high_nonzero = vector.andi %high_nz2, %byte_ones : vector<4xi32>
    %high_sign = vector.andi %high_sign_raw, %high_nonzero : vector<4xi32>
    %high_sm1 = vector.shli %high_sign, %shift_one : vector<4xi32>
    %high_sm2 = vector.ori %high_sign, %high_sm1 : vector<4xi32>
    %high_sm4 = vector.shli %high_sm2, %shift_two : vector<4xi32>
    %high_sm7 = vector.ori %high_sm2, %high_sm4 : vector<4xi32>
    %high_sm8 = vector.shli %high_sm7, %shift_four : vector<4xi32>
    %high_sign_mask = vector.ori %high_sm7, %high_sm8 : vector<4xi32>
    %high_signed0 = vector.xori %high_mag, %high_sign_mask : vector<4xi32>
    %decoded_high = vector.addi %high_signed0, %high_sign : vector<4xi32>

    %aq_block0 = index.mul %block, %thirtytwo : index
    %aq_block = index.add %selected_aq_base, %aq_block0 : index
    %aq_offset = index.cast %aq_block : index to offset
    %aq_block_view = buffer.view %aq_na[%aq_offset] : buffer -> view<32xi8, #dense>
    %activation = vector.load %aq_block_view[%zero] : view<32xi8, #dense> -> vector<32xi8>
    %activation_low = vector.slice %activation[0] : vector<32xi8> -> vector<16xi8>
    %activation_high = vector.slice %activation[16] : vector<32xi8> -> vector<16xi8>
    %weight_low = vector.bitcast %decoded_low : vector<4xi32> to vector<16xi8>
    %weight_high = vector.bitcast %decoded_high : vector<4xi32> to vector<16xi8>
    %dot_low = vector.dot4i<s8s8> %weight_low, %activation_low, %zero_i32x4 :
        vector<16xi8>, vector<16xi8>, vector<4xi32>
    %dot_parts = vector.dot4i<s8s8> %weight_high, %activation_high, %dot_low :
        vector<16xi8>, vector<16xi8>, vector<4xi32>
    %dot_i32 = vector.reduce<addi> %dot_parts, %zero_i32 : vector<4xi32>, i32

    %scale_i32 = scalar.extui %scale_i8 : i8 to i32
    %scale_is_small = scalar.cmpi ult, %scale_i32, %two_i32 : i32
    %small_shift = scf.select %scale_is_small, %scale_i32, %zero_i32 : i32
    %small_scale_bits = scalar.shli %minimum_scale_bits_i32, %small_shift : i32
    %normal_scale_safe = scf.select %scale_is_small, %one_i32, %scale_i32 : i32
    %normal_exponent = scalar.subi %normal_scale_safe, %one_i32 : i32
    %normal_scale_bits = scalar.shli %normal_exponent, %twentythree_i32 : i32
    %finite_scale_bits = scf.select %scale_is_small, %small_scale_bits, %normal_scale_bits : i32
    %scale_is_nan = scalar.cmpi eq, %scale_i32, %byte_mask_i32 : i32
    %scale_bits = scf.select %scale_is_nan, %quiet_nan_bits_i32, %finite_scale_bits : i32
    %weight_scale = scalar.bitcast %scale_bits : i32 to f32
    %as_index = index.add %selected_as_base, %block : index
    %act_scale = view.load %as_view[%as_index] : view<33554432xf32, #dense> -> f32
    %combined_scale = scalar.mulf %weight_scale, %act_scale : f32
    %partial_index = index.add %wave_partial_base, %block : index
    view.store %dot_i32, %dot_view[%partial_index] : i32, view<512xi32, #dense>
    view.store %combined_scale, %scale_view[%partial_index] : f32, view<512xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

  %is_lane_zero = index.cmp eq, %wave_lane, %zero : index
  %row_valid = index.cmp ult, %row, %rows : index
  %writer = scalar.andi %is_lane_zero, %row_valid : i1
  scf.if %writer {
    %sum = scf.for %block = [%zero to %blocks step %one](%acc = %zero_f32 : f32) -> (f32) {
      %partial_index = index.add %wave_partial_base, %block : index
      %dot_i32 = view.load %dot_view[%partial_index] : view<512xi32, #dense> -> i32
      %dot_f32 = scalar.sitofp %dot_i32 : i32 to f32
      %combined_scale = view.load %scale_view[%partial_index] : view<512xf32, #dense> -> f32
      %next = scalar.fmaf %dot_f32, %combined_scale, %acc : f32
      scf.yield %next : f32
    }
    %destination0 = index.mul %selected, %rows : index
    %destination = index.add %destination0, %row : index
    view.store %sum, %dst_view[%destination] : f32, view<1073741824xf32, #dense>
  }
  }
  kernel.return
}
