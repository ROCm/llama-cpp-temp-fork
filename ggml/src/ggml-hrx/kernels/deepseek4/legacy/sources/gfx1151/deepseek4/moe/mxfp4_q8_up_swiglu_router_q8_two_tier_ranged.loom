// High-capacity two-tier streamed MXFP4 x Q8 expert-stationary MUL_MAT_ID for gfx1151.
//
// Each workgroup owns 128 output rows of one expert. Eight wave32s each own a
// 16-row signed-int8 WMMA tile while sharing up to 32 routed activations and a
// 32-value K tile. Activations and their F32 K32 scales are produced by the
// native quant_act_q8 prepass.
// host_cache begins with int32 slot_map[1024] followed by the immutable
// begin-layer residency cohort map. The global slot ID dynamically selects
// device_cache for slots [0, D) or host_cache for slots [D, D + H). No expert
// identity or tier is compiled into the kernel.

config.decl @hrx2_shape_mul_mat_id_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @hrx2_shape_mul_mat_id_rows : %value: index where [range(%value, 1, 32768)]
config.decl @hrx2_shape_mul_mat_id_nexperts : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_mul_mat_id_nselected : %value: index where [range(%value, 1, 128)]
config.decl @hrx2_shape_mul_mat_id_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_src1_selected_stride : %value: index where [range(%value, 0, 1048576)]
config.decl @hrx2_shape_mul_mat_id_src1_token_stride : %value: index where [range(%value, 1, 1073741824)]
config.decl @hrx2_shape_mul_mat_id_dst_token_stride : %value: index where [range(%value, 1, 1073741824)]
config.decl @hrx2_shape_mul_mat_id_host_slot_base_offset_bytes : %value: index where [range(%value, 0, 274877906944)]
config.decl @hrx2_shape_mul_mat_id_device_slot_base_offset_bytes : %value: index where [range(%value, 0, 274877906944)]
config.decl @hrx2_shape_mul_mat_id_device_slot_count : %value: index where [range(%value, 0, 11008)]
config.decl @hrx2_shape_mul_mat_id_host_slot_count : %value: index where [range(%value, 0, 11008)]
config.decl @hrx2_shape_mul_mat_id_slot_stride_bytes : %value: index where [range(%value, 1, 274877906944)]
config.decl @hrx2_up_only_plane_offset_bytes : %value: index where [range(%value, 0, 274877906944)]
config.decl @hrx2_up_clamp_min : %value: f32
config.decl @hrx2_up_clamp_max : %value: f32
config.decl @hrx2_router_token_stride : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_streamed_cohort : %value: index where [range(%value, 0, 2)]

kernel.def export("hrx2_mxfp4_q8_up_swiglu_router_q8_two_tier_ranged") @hrx2_mxfp4_q8_up_swiglu_router_q8_two_tier_ranged() {
  %one = index.constant 1 : index
  %rows_per_tile = index.constant 128 : index
  %workgroup_size = index.constant 256 : index
  %rows0 = config.get @hrx2_shape_mul_mat_id_rows : index
  %nexperts0 = config.get @hrx2_shape_mul_mat_id_nexperts : index
  %rows = index.assume %rows0 [range(%rows0, 1, 32768)] : index
  %nexperts = index.assume %nexperts0 [range(%nexperts0, 1, 1024)] : index
  %tiles_numerator = index.add %rows, %rows_per_tile : index
  %tiles_adjusted = index.sub %tiles_numerator, %one : index
  %row_tiles = index.div %tiles_adjusted, %rows_per_tile : index
  kernel.launch.config workgroups(%row_tiles, %nexperts, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%expert_begin_i64: i64, %expert_end_i64: i64, %host_cache: buffer, %device_cache: buffer, %aq: buffer, %as: buffer,
