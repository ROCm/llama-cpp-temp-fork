    %wpp2_block1 = index.add %wpp2_block0, %wpp2_block_g : index
    %wpp2_block = index.assume %wpp2_block1 [range(%wpp2_block1, 0, 31580640)] : index
    %wpp2_byte0 = index.mul %wpp2_block, %c34 : index
    %wpp2_byte1 = index.add %wpp2_byte0, %two : index
    %wpp2_half_bytes = index.mul %wpp2_payload_half, %sixteen : index
    %wpp2_byte2 = index.add %wpp2_byte1, %wpp2_half_bytes : index
    %wpp2_byte = index.assume %wpp2_byte2 [range(%wpp2_byte2, 0, 1073741808)] : index
    %wpp2_payload = vector.load %src0_i8[%wpp2_byte] : view<1073741824xi8, #dense> -> vector<16xi8>
    %wpp2_dst_row = index.mul %wpp2_row, %k_wstride : index
