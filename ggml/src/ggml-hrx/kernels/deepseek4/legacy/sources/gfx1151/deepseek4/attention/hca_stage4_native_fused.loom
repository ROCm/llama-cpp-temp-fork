  %state1_v = buffer.view %state1_g[%base] : buffer -> view<524288xf32, #dense>
  %state_dst1_v = buffer.view %state_dst1_g[%base] : buffer -> view<8192xf32, #dense>
  %projection_v = buffer.view %projection_g[%base] : buffer -> view<65536xf32, #dense>

  %row_base0 = index.mul %row, %c512 : index
  %row_base = index.assume %row_base0 [range(%row_base0, 0, 65024)] : index
  %sum = scf.for %vcol = [%lane to %c32 step %c256]
      (%acc = %zero_f32 : f32) -> (f32) {
    %col0 = index.mul %vcol, %c16 : index
    %index0 = index.add %row_base, %col0 : index
    %index = index.assume %index0 [range(%index0, 0, 65520)] : index
    %values = vector.load %src_v[%index] : view<65536xf32, #dense> -> vector<16xf32>
    %squares = vector.mulf<reassoc|nnan|ninf|nsz> %values, %values : vector<16xf32>
    %next = vector.reduce<addf, reassoc|nnan|ninf|nsz> %squares, %acc : vector<16xf32>, f32
    scf.yield %next : f32
