            %payload_i8 = vector.bitcast %payload_i32 : vector<4xi32> to vector<16xi8>
            // Each payload byte is [high E2M1 nibble | low E2M1 nibble].
            // Decode four bytes at once with independent packed-byte arithmetic.
            // low produces logical K[0..15], high produces K[16..31].
                        %lut_packed0 = vector.slice %payload_i8[0] : vector<16xi8> -> vector<2xi8>
            %lut_codes0 = vector.bitunpacku<4> %lut_packed0 : vector<2xi8> -> vector<4xi8>
            %lut_decoded0 = vector.table.lookup %e2m1_i8_lut[%lut_codes0] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded0_i32x1 = vector.bitcast %lut_decoded0 : vector<4xi8> to vector<1xi32>
            %lut_decoded0_i32 = vector.extract %lut_decoded0_i32x1[0] : vector<1xi32> -> i32
            %lut_packed1 = vector.slice %payload_i8[2] : vector<16xi8> -> vector<2xi8>
            %lut_codes1 = vector.bitunpacku<4> %lut_packed1 : vector<2xi8> -> vector<4xi8>
            %lut_decoded1 = vector.table.lookup %e2m1_i8_lut[%lut_codes1] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded1_i32x1 = vector.bitcast %lut_decoded1 : vector<4xi8> to vector<1xi32>
            %lut_decoded1_i32 = vector.extract %lut_decoded1_i32x1[0] : vector<1xi32> -> i32
            %lut_packed2 = vector.slice %payload_i8[4] : vector<16xi8> -> vector<2xi8>
            %lut_codes2 = vector.bitunpacku<4> %lut_packed2 : vector<2xi8> -> vector<4xi8>
            %lut_decoded2 = vector.table.lookup %e2m1_i8_lut[%lut_codes2] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded2_i32x1 = vector.bitcast %lut_decoded2 : vector<4xi8> to vector<1xi32>
            %lut_decoded2_i32 = vector.extract %lut_decoded2_i32x1[0] : vector<1xi32> -> i32
            %lut_packed3 = vector.slice %payload_i8[6] : vector<16xi8> -> vector<2xi8>
            %lut_codes3 = vector.bitunpacku<4> %lut_packed3 : vector<2xi8> -> vector<4xi8>
            %lut_decoded3 = vector.table.lookup %e2m1_i8_lut[%lut_codes3] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded3_i32x1 = vector.bitcast %lut_decoded3 : vector<4xi8> to vector<1xi32>
            %lut_decoded3_i32 = vector.extract %lut_decoded3_i32x1[0] : vector<1xi32> -> i32
            %lut_packed4 = vector.slice %payload_i8[8] : vector<16xi8> -> vector<2xi8>
            %lut_codes4 = vector.bitunpacku<4> %lut_packed4 : vector<2xi8> -> vector<4xi8>
            %lut_decoded4 = vector.table.lookup %e2m1_i8_lut[%lut_codes4] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded4_i32x1 = vector.bitcast %lut_decoded4 : vector<4xi8> to vector<1xi32>
            %lut_decoded4_i32 = vector.extract %lut_decoded4_i32x1[0] : vector<1xi32> -> i32
            %lut_packed5 = vector.slice %payload_i8[10] : vector<16xi8> -> vector<2xi8>
            %lut_codes5 = vector.bitunpacku<4> %lut_packed5 : vector<2xi8> -> vector<4xi8>
            %lut_decoded5 = vector.table.lookup %e2m1_i8_lut[%lut_codes5] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded5_i32x1 = vector.bitcast %lut_decoded5 : vector<4xi8> to vector<1xi32>
            %lut_decoded5_i32 = vector.extract %lut_decoded5_i32x1[0] : vector<1xi32> -> i32
            %lut_packed6 = vector.slice %payload_i8[12] : vector<16xi8> -> vector<2xi8>
            %lut_codes6 = vector.bitunpacku<4> %lut_packed6 : vector<2xi8> -> vector<4xi8>
            %lut_decoded6 = vector.table.lookup %e2m1_i8_lut[%lut_codes6] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded6_i32x1 = vector.bitcast %lut_decoded6 : vector<4xi8> to vector<1xi32>
            %lut_decoded6_i32 = vector.extract %lut_decoded6_i32x1[0] : vector<1xi32> -> i32
            %lut_packed7 = vector.slice %payload_i8[14] : vector<16xi8> -> vector<2xi8>
            %lut_codes7 = vector.bitunpacku<4> %lut_packed7 : vector<2xi8> -> vector<4xi8>
            %lut_decoded7 = vector.table.lookup %e2m1_i8_lut[%lut_codes7] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
            %lut_decoded7_i32x1 = vector.bitcast %lut_decoded7 : vector<4xi8> to vector<1xi32>
            %lut_decoded7_i32 = vector.extract %lut_decoded7_i32x1[0] : vector<1xi32> -> i32
            %lut_words = vector.from_elements %lut_decoded0_i32, %lut_decoded1_i32, %lut_decoded2_i32, %lut_decoded3_i32, %lut_decoded4_i32, %lut_decoded5_i32, %lut_decoded6_i32, %lut_decoded7_i32 : vector<8xi32>
            %lut_byte_mask = vector.constant 0x000000ff : vector<8xi32>
            %lut_second_byte_mask = vector.constant 0x0000ff00 : vector<8xi32>
            %lut_shift8 = vector.constant 8 : vector<8xi32>
            %lut_shift16 = vector.constant 16 : vector<4xi32>
            %lut_words_shift8 = vector.shrui %lut_words, %lut_shift8 : vector<8xi32>
            %lut_low0 = vector.andi %lut_words, %lut_byte_mask : vector<8xi32>
            %lut_low1 = vector.andi %lut_words_shift8, %lut_second_byte_mask : vector<8xi32>
            %lut_low_pairs = vector.ori %lut_low0, %lut_low1 : vector<8xi32>
            %lut_high0 = vector.andi %lut_words_shift8, %lut_byte_mask : vector<8xi32>
            %lut_words_shift16 = vector.shrui %lut_words_shift8, %lut_shift8 : vector<8xi32>
            %lut_high1 = vector.andi %lut_words_shift16, %lut_second_byte_mask : vector<8xi32>
            %lut_high_pairs = vector.ori %lut_high0, %lut_high1 : vector<8xi32>
            %lut_low_even, %lut_low_odd = vector.deinterleave<0> %lut_low_pairs : vector<8xi32> -> vector<4xi32>, vector<4xi32>
            %lut_high_even, %lut_high_odd = vector.deinterleave<0> %lut_high_pairs : vector<8xi32> -> vector<4xi32>, vector<4xi32>
            %lut_low_odd_high = vector.shli %lut_low_odd, %lut_shift16 : vector<4xi32>
            %lut_high_odd_high = vector.shli %lut_high_odd, %lut_shift16 : vector<4xi32>
            %decoded_low = vector.ori %lut_low_even, %lut_low_odd_high : vector<4xi32>
            %decoded_high = vector.ori %lut_high_even, %lut_high_odd_high : vector<4xi32>

            // kvalues_mxfp4 is twice the E2M1 value, so use half of the E8M0
            // scale: 2^(e-128). Preserve the two subnormal scales and NaN.
            %scale_is_small = scalar.cmpi ult, %scale_i32, %two_i32 : i32
            %small_shift = scf.select %scale_is_small, %scale_i32, %zero_i32 : i32
            %small_scale_bits = scalar.shli %minimum_scale_bits_i32, %small_shift : i32
            %normal_scale_safe = scf.select %scale_is_small, %one_i32, %scale_i32 : i32
            %normal_exponent = scalar.subi %normal_scale_safe, %one_i32 : i32
            %normal_scale_bits = scalar.shli %normal_exponent, %twentythree_i32 : i32
            %finite_scale_bits = scf.select %scale_is_small, %small_scale_bits, %normal_scale_bits : i32
            %scale_is_nan = scalar.cmpi eq, %scale_i32, %byte_mask_i32 : i32
            %scale_bits = scf.select %scale_is_nan, %quiet_nan_bits_i32, %finite_scale_bits : i32
            %scale_f32 = scalar.bitcast %scale_bits : i32 to f32
            scf.yield %decoded_low, %decoded_high, %scale_f32 : vector<4xi32>, vector<4xi32>, f32
          } else {
            scf.yield %zero_i32x4, %zero_i32x4, %zero_f32 : vector<4xi32>, vector<4xi32>, f32
          }
          %weight_store_base = index.mul %row_local, %eight : index
          %weight_store_high = index.add %weight_store_base, %four : index
          vector.store %decoded_low, %weight_word_view[%weight_store_base] : vector<4xi32>, view<1024xi32, #dense>
          vector.store %decoded_high, %weight_word_view[%weight_store_high] : vector<4xi32>, view<1024xi32, #dense>
          view.store %weight_scale, %weight_scale_view[%row_local] : f32, view<128xf32, #dense>
        }
        kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

        %lhs0_raw = vector.fragment.load<lhs> %act_view[%zero, %zero] shape [%sixteen, %sixteen] : view<16x32xi8, #dense> -> vector<16xi8>
        %lhs0_words = vector.bitcast %lhs0_raw : vector<16xi8> to vector<4xi32>
        %lhs0 = vector.fragment<lhs> %lhs0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %rhs0_raw = vector.fragment.load<rhs> %weight_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : view<32x128xi8, %rhs_layout> -> vector<16xi8>
        %rhs0_words = vector.bitcast %rhs0_raw : vector<16xi8> to vector<4xi32>
        %rhs0 = vector.fragment<rhs> %rhs0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %int_acc = vector.fragment<init> %zero_i32x8 shape [%sixteen, %sixteen] : vector<8xi32>
        %int_next0 = vector.mma %lhs0, %rhs0, %int_acc : vector<4xi32>, vector<4xi32>, vector<8xi32>
        %lhs1_raw = vector.fragment.load<lhs> %act_view[%zero, %sixteen] shape [%sixteen, %sixteen] : view<16x32xi8, #dense> -> vector<16xi8>
        %lhs1_words = vector.bitcast %lhs1_raw : vector<16xi8> to vector<4xi32>
        %lhs1 = vector.fragment<lhs> %lhs1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %rhs1_raw = vector.fragment.load<rhs> %weight_view[%sixteen, %wave_row_base] shape [%sixteen, %sixteen] : view<32x128xi8, %rhs_layout> -> vector<16xi8>
        %rhs1_words = vector.bitcast %rhs1_raw : vector<16xi8> to vector<4xi32>
        %rhs1 = vector.fragment<rhs> %rhs1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
        %int_next1 = vector.mma %lhs1, %rhs1, %int_next0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
        %dot_f32 = vector.sitofp %int_next1 : vector<8xi32> to vector<8xf32>
        %lane_lo = index.rem %wave_lane, %sixteen : index
        %lane_hi = index.div %wave_lane, %sixteen : index
        %activation_scale_base0 = index.mul %lane_hi, %eight : index
        %activation_scale_base = index.assume %activation_scale_base0 [range(%activation_scale_base0, 0, 8)] : index
        %activation_scales = vector.load %act_scale_view[%activation_scale_base] : view<16xf32, #dense> -> vector<8xf32>
        %weight_scale_index0 = index.add %wave_row_base, %lane_lo : index
        %weight_scale_index = index.assume %weight_scale_index0 [range(%weight_scale_index0, 0, 127)] : index
        %weight_scale_value = view.load %weight_scale_view[%weight_scale_index] : view<128xf32, #dense> -> f32
        %weight_scales = vector.splat %weight_scale_value : vector<8xf32>
        %combined_scales = vector.mulf %activation_scales, %weight_scales : vector<8xf32>
        %next = vector.fmaf %dot_f32, %combined_scales, %acc : vector<8xf32>
        kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
        scf.yield %next : vector<8xf32>
      }

      vector.fragment.store<result> %accumulator, %result_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x128xf32, #dense>
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

      // Eight waves quantize 32 (match, K32) groups in four passes. Down consumes
      // only the payload and scale; do not materialize the unused Q8 half sums.
      scf.for %output_pass = [%zero to %four step %one] {
        %pass_base = index.mul %output_pass, %eight : index
        %output_group = index.add %pass_base, %wave : index
        %match = index.div %output_group, %two : index
        %row_block = index.rem %output_group, %two : index
        %match_valid = index.cmp ult, %match, %match_count : index
        %row_block_base = index.mul %row_block, %thirtytwo : index
        %row_local = index.add %row_block_base, %wave_lane : index
        %row = index.add %row_tile_base, %row_local : index
        %row_valid = index.cmp ult, %row, %rows : index
        %output_valid = scalar.andi %match_valid, %row_valid : i1
        %fused_weighted = scf.if %output_valid -> (f32) {
          %token_i32 = view.load %tok_view[%match] : view<16xi32, #dense> -> i32
          %selected_i32 = view.load %sel_view[%match] : view<16xi32, #dense> -> i32
          %token0 = index.cast %token_i32 : i32 to index
          %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
          %selected0 = index.cast %selected_i32 : i32 to index
          %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
          %up_row_local = index.add %row_local, %sixtyfour : index
          %gate_raw = view.load %result_view[%match, %row_local] : view<16x128xf32, #dense> -> f32
          %up_raw = view.load %result_view[%match, %up_row_local] : view<16x128xf32, #dense> -> f32
          %gate_clamped = scalar.minnumf %gate_raw, %gate_clamp_max : f32
          %gate_silu = scalar.siluf %gate_clamped : f32
          %up_hi = scalar.minnumf %up_raw, %up_clamp_max : f32
          %up_clamped = scalar.maxnumf %up_hi, %up_clamp_min : f32
          %fused = scalar.mulf %gate_silu, %up_clamped : f32
          %router_token_base = index.mul %token, %router_token_stride : index
          %router_index0 = index.add %router_token_base, %selected : index
          %router_index = index.assume %router_index0 [range(%router_index0, 0, 268435455)] : index
          %route_weight = view.load %router_view[%router_index] : view<268435456xf32, #dense> -> f32
          %weighted = scalar.mulf %fused, %route_weight : f32
          scf.yield %weighted : f32
        } else {
          scf.yield %zero_f32 : f32
        }

        %absolute = scalar.absf %fused_weighted : f32
        %max1_peer, %max1_valid = kernel.subgroup.shuffle<xor> %absolute, %shuffle_xor1, %shuffle_width : f32, i32, i32
        %max1 = scalar.maxnumf %absolute, %max1_peer : f32
        %max2_peer, %max2_valid = kernel.subgroup.shuffle<xor> %max1, %shuffle_xor2, %shuffle_width : f32, i32, i32
        %max2 = scalar.maxnumf %max1, %max2_peer : f32
        %max4_peer, %max4_valid = kernel.subgroup.shuffle<xor> %max2, %shuffle_xor4, %shuffle_width : f32, i32, i32
        %max4 = scalar.maxnumf %max2, %max4_peer : f32
        %max8_peer, %max8_valid = kernel.subgroup.shuffle<xor> %max4, %shuffle_xor8, %shuffle_width : f32, i32, i32
        %max8 = scalar.maxnumf %max4, %max8_peer : f32
        %max16_peer, %max16_valid = kernel.subgroup.shuffle<xor> %max8, %shuffle_xor16, %shuffle_width : f32, i32, i32
        %group_max = scalar.maxnumf %max8, %max16_peer : f32
        %amax = scalar.maxnumf %group_max, %qact_amax_eps : f32
        %scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %qact_inv127 : f32
        %rscale = scalar.divf<reassoc|nnan|ninf|nsz> %qact_f127, %amax : f32
        %scaled = scalar.mulf %fused_weighted, %rscale : f32
        %rounded = scalar.roundf %scaled : f32
        %q32 = scalar.fptosi %rounded : f32 to i32
        %q8 = scalar.trunci %q32 : i32 to i8

        %token_i32 = view.load %tok_view[%match] : view<16xi32, #dense> -> i32
        %selected_i32 = view.load %sel_view[%match] : view<16xi32, #dense> -> i32
        %token0 = index.cast %token_i32 : i32 to index
        %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
        %selected0 = index.cast %selected_i32 : i32 to index
        %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
        %token_base = index.mul %token, %dst_token_stride : index
        %selected_base = index.mul %selected, %rows : index
        %destination0 = index.add %token_base, %selected_base : index
        %destination1 = index.add %destination0, %row : index
        %destination = index.assume %destination1 [range(%destination1, 0, 1073741823)] : index
        scf.if %output_valid {
          view.store %q8, %out_qs_view[%destination] : i8, view<1073741824xi8, #dense>
        }

        // The token/selected strides and row tile are all K32 aligned.  Build
        // the metadata group index from those uniform group strides instead of
        // dividing the lane-varying byte destination.
        %dst_token_group_stride = index.div %dst_token_stride, %thirtytwo : index
        %selected_group_stride = index.div %rows, %thirtytwo : index
        %token_group_base = index.mul %token, %dst_token_group_stride : index
        %selected_group_base = index.mul %selected, %selected_group_stride : index
        %row_tile_group_base = index.mul %tile, %two : index
        %group_index_a = index.add %token_group_base, %selected_group_base : index
        %group_index_b = index.add %group_index_a, %row_tile_group_base : index
        %group_index0 = index.add %group_index_b, %row_block : index
        %group_index = index.assume %group_index0 [range(%group_index0, 0, 33554431)] : index
        %is_scale_leader = index.cmp eq, %wave_lane, %zero : index
        %store_scale = scalar.andi %output_valid, %is_scale_leader : i1
        scf.if %store_scale {
          view.store %scale, %out_scale_view[%group_index] : f32, view<33554432xf32, #dense>
        }

      }
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    }
  } else {
    scf.for %group_base = [%zero to %total step %sixtyfour] {
      // Keep W4-only vector constants iteration-local so they die
      // before the output epilogue instead of crossing the group backedge.
      %w4_zero_i32x4 = vector.constant 0 : vector<4xi32>
      %w4_zero_i32x8 = vector.constant 0 : vector<8xi32>
      %w4_zero_f32x8 = vector.constant 0.0 : vector<8xf32>
      %fill_lane = index.cmp ult, %lane, %sixtyfour : index
      scf.if %fill_lane {
        view.store %zero_i32, %w4_tok_view[%lane] : i32, view<64xi32, #dense>
        view.store %zero_i32, %w4_sel_view[%lane] : i32, view<64xi32, #dense>
        %match_index = index.add %group_base, %lane : index
        %match_valid = index.cmp ult, %match_index, %total : index
        scf.if %match_valid {
          %table_match0 = index.add %table_base, %one : index
          %table_match1 = index.add %table_match0, %match_index : index
          %table_match = index.assume %table_match1 [range(%table_match1, 0, 268435455)] : index
          %packed = view.load %table_view[%table_match] : view<268435456xi32, #dense> -> i32
          %packed_index0 = index.cast %packed : i32 to index
          %packed_index = index.assume %packed_index0 [range(%packed_index0, 0, 134217727)] : index
          %token = index.div %packed_index, %onetwentyeight : index
          %selected = index.rem %packed_index, %onetwentyeight : index
          %token_i32 = index.cast %token : index to i32
          %selected_i32 = index.cast %selected : index to i32
          view.store %token_i32, %w4_tok_view[%lane] : i32, view<64xi32, #dense>
          view.store %selected_i32, %w4_sel_view[%lane] : i32, view<64xi32, #dense>
        }
      }
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

      %group_remaining = index.sub %total, %group_base : index
      %group_full = index.cmp ugt, %group_remaining, %sixtyfour : index
      %group_count0 = scf.select %group_full, %sixtyfour, %group_remaining : index
      %group_count = index.assume %group_count0 [range(%group_count0, 1, 64)] : index
      %window_numerator = index.add %group_count, %sixteen : index
      %window_adjusted = index.sub %window_numerator, %one : index
      %window_count0 = index.div %window_adjusted, %sixteen : index
      %window_count = index.assume %window_count0 [range(%window_count0, 1, 4)] : index
      %w1_compute_window = index.constant 1 : index
      %w1_compute_active = index.cmp ult, %w1_compute_window, %window_count : index
      %w2_compute_window = index.constant 2 : index
      %w2_compute_active = index.cmp ult, %w2_compute_window, %window_count : index
      %w3_compute_window = index.constant 3 : index
      %w3_compute_active = index.cmp ult, %w3_compute_window, %window_count : index

      %accumulator0, %accumulator1, %accumulator2, %accumulator3 = scf.for %k_chunk = [%zero to %k step %sixtyfour](%acc0 = %w4_zero_f32x8, %acc1 = %w4_zero_f32x8, %acc2 = %w4_zero_f32x8, %acc3 = %w4_zero_f32x8 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
        // Two lanes fetch two adjacent canonical records for one row. A
        // wave covers all 16 rows while keeping only one decoded record live
        // per lane over the two increasing K32 phases.
        %block2 = index.rem %wave_lane, %two : index
        %row16 = index.div %wave_lane, %two : index
        %block_base = index.div %k_chunk, %thirtytwo : index
        %block = index.add %block_base, %block2 : index
        %block_k_base = index.mul %block, %thirtytwo : index
        %weight_k_valid = index.cmp ult, %block_k_base, %k : index
        // Decode one fixed row record per lane. The K64 owner mapping
        // preserves canonical record traffic and exact increasing-K order.
        %row_in_wave_r0 = index.add %row16, %zero : index
          %row_local_r0 = index.add %wave_row_base, %row_in_wave_r0 : index
          %logical_row_local_r0 = index.add %logical_wave_row_base, %row_in_wave_r0 : index
          %row_r0 = index.add %row_tile_base, %logical_row_local_r0 : index
          %row_valid_r0 = index.cmp ult, %row_r0, %rows : index
          %row_k_valid_r0 = scalar.andi %row_valid_r0, %weight_k_valid : i1
          %weight_valid_r0 = scalar.andi %row_k_valid_r0, %slot_valid : i1
