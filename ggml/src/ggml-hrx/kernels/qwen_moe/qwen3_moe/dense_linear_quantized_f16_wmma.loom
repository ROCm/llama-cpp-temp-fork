} launch(%qact: buffer, %qact_scales: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c256 = index.constant 256 : index
  %zero_i32 = scalar.constant 0 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %input_size0 = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size0 = config.get @qwen3_moe.dense_quantized.output_size : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
