func.def inline @qwen3_moe_q4k_tensor_plane_row_lane(%input_size0: index, %output_size0: index, %output_row: index, %weight: buffer, %q8_input: buffer, %q8_row_byte_base: offset, %lane0: index) -> (f32) {
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c256 = index.constant 256 : index
  %zero = scalar.constant 0.0 : f32
  %block_count = index.div %input_size, %c256 : index
  %blocks_padded = index.add %block_count, %c3 : index
  %iterations = index.div %blocks_padded, %c4 : index
  %lane_block = index.div %lane, %c8 : index
  %block_lane0 = index.rem %lane, %c8 : index
  %block_lane = index.assume %block_lane0 [range(%block_lane0, 0, 7)] : index
  %pair_iterations = index.div %iterations, %c2 : index
  %paired_sum = scf.for %pair_iteration = [%c0 to %pair_iterations step %c1](%acc = %zero : f32) -> (f32) unroll {
    %iteration_a = index.mul %pair_iteration, %c2 : index
    %iteration_block_a = index.mul %iteration_a, %c4 : index
    %block_a = index.add %iteration_block_a, %lane_block : index
    %block_b = index.add %block_a, %c4 : index
    %value_a, %value_b = func.call @qwen3_moe_q4k_tensor_plane_pair_lane(%input_size, %output_size, %output_row, %block_a, %block_b, %block_count, %block_lane, %weight, %q8_input, %q8_row_byte_base) : (index, index, index, index, index, index, index, buffer, buffer, offset) -> (f32, f32)
    %next_a = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value_a : f32
    %next_b = scalar.addf<reassoc|nnan|ninf|nsz> %next_a, %value_b : f32
    scf.yield %next_b : f32
  }
  %covered_iterations = index.mul %pair_iterations, %c2 : index
  %tail_iteration_block = index.mul %covered_iterations, %c4 : index
  %tail_block = index.add %tail_iteration_block, %lane_block : index
  %valid_tail = index.cmp ult, %tail_block, %block_count : index
