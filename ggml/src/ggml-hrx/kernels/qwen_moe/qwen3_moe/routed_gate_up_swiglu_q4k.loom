      %p1_2_t1_i1 = vector.mma %p1_2_t1_lb, %p1_2_t1_rb, %p1_2_t1_i0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %p1_2_t1_wk = index.constant 2 : index
