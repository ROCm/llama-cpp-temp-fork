      %w0_output_window = index.constant 0 : index
      %w0_window_active = index.cmp ult, %w0_output_window, %window_count : index
      scf.if %w0_window_active {
      vector.fragment.store<result> %accumulator0, %w4_result_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x128xf32, #dense>
