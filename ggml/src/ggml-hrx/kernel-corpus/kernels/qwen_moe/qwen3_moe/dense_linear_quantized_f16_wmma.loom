// Eight adjacent lanes quantize one K32 block and emit payload, scale, sum, and a zero-representable zero point.
// Subtracting eight maps the affine U4 code to gfx1151's signed-lhs IU4 contract.
config.decl @qwen3.qact_u4asym.shape_k : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

config.decl @qwen3.qact_u4asym.shape_cols : %value: index where [range(%value, 1, 16384)]

kernel.def export("qwen3_quant_act_u4asym") @qwen3_quant_act_u4asym() {
  %unit = index.constant 1 : index
  %wg = index.constant 256 : index
  %groups_per_wg_m1 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %k = config.get @qwen3.qact_u4asym.shape_k : index
  %cols = config.get @qwen3.qact_u4asym.shape_cols : index
  %total = index.mul %k, %cols : index
  %groups = index.div %total, %c32 : index
  %rounded = index.add %groups, %groups_per_wg_m1 : index
  %workgroups = index.div %rounded, %c32 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%wg, %unit, %unit) : index
} launch(%src: buffer, %qs: buffer, %ds: buffer, %meta: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %bias_neg8 = vector.constant -8 : vector<4xi32>
  %nibble_mask = vector.constant 15 : vector<4xi32>
  %c8_i32 = scalar.constant 8 : i32
  %eps = scalar.constant 1.0000000000000001e-30 : f32
  %f15 = scalar.constant 15.0 : f32
  %vzero = vector.constant 0.0 : vector<4xf32>
  %v15 = vector.constant 15.0 : vector<4xf32>
  %xor1 = scalar.constant 1 : i32
  %xor2 = scalar.constant 2 : i32
  %xor4 = scalar.constant 4 : i32
  %shift4 = scalar.constant 4 : i32
  %shift8 = scalar.constant 8 : i32
  %shift12 = scalar.constant 12 : i32
  %shuffle_width = scalar.constant 32 : i32

  %k = config.get @qwen3.qact_u4asym.shape_k : index
  %cols = config.get @qwen3.qact_u4asym.shape_cols : index
  %k_b = index.assume %k [range(%k, 32, 65536)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 16384)] : index
  %total = index.mul %k_b, %cols_b : index
  %groups0 = index.div %total, %c32 : index
  %groups = index.assume %groups0 [range(%groups0, 1, 33554432)] : index

  %wgid0 = kernel.workgroup.id<x> : index
  %tid0 = kernel.workitem.id<x> : index
  %wgid = index.assume %wgid0 [range(%wgid0, 0, 131071)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %lane = index.rem %tid, %c32 : index
  %lane_in_group = index.rem %lane, %c8 : index
  %is_leader = index.cmp eq, %lane_in_group, %zero : index
  %wg_group_base = index.mul %wgid, %c32 : index
  %wave_group_base = index.div %tid, %c8 : index
  %gid0 = index.add %wg_group_base, %wave_group_base : index
  %gid = index.assume %gid0 [range(%gid0, 0, 33554431)] : index
  %in_range = index.cmp ult, %gid, %groups : index

  %src_g = buffer.assume.memory_space<global> %src : buffer
  %qs_g = buffer.assume.memory_space<global> %qs : buffer
  %ds_g = buffer.assume.memory_space<global> %ds : buffer
  %meta_g = buffer.assume.memory_space<global> %meta : buffer
  %src_na, %qs_na, %ds_na, %meta_na = buffer.assume.noalias %src_g, %qs_g, %ds_g, %meta_g : buffer, buffer, buffer, buffer
  %src_elems = index.assume %total [range(%total, 32, 1073741824)] : index
  %src_view = buffer.view %src_na[%base] : buffer -> view<[%src_elems]xf32>
  %qs_halfwords = index.div %total, %c4 : index
  %qs_view = buffer.view %qs_na[%base] : buffer -> view<[%qs_halfwords]xi16>
  %ds_view = buffer.view %ds_na[%base] : buffer -> view<[%groups]xf32>
  %meta_count = index.mul %groups, %two : index
  %meta_view = buffer.view %meta_na[%base] : buffer -> view<[%meta_count]xi32>

  scf.if %in_range {
    %ebase0 = index.mul %gid, %c32 : index
    %lane_elem_off = index.mul %lane_in_group, %c4 : index
    %ebase1 = index.add %ebase0, %lane_elem_off : index
    %ebase = index.assume %ebase1 [range(%ebase1, 0, 1073741820)] : index
    %v = vector.load %src_view[%ebase] : view<[%src_elems]xf32> -> vector<4xf32>
    %lane_max = vector.reduce<maxnumf, reassoc|nnan|nsz> %v, %zero_f32 : vector<4xf32>, f32
    %neg_v = vector.subf %vzero, %v : vector<4xf32>
    %lane_neg_min = vector.reduce<maxnumf, reassoc|nnan|nsz> %neg_v, %zero_f32 : vector<4xf32>, f32
    %max_x1_peer, %max_x1_valid = kernel.subgroup.shuffle<xor> %lane_max, %xor1, %shuffle_width : f32, i32, i32
    %max_x1 = scalar.maxnumf %lane_max, %max_x1_peer : f32
    %max_x2_peer, %max_x2_valid = kernel.subgroup.shuffle<xor> %max_x1, %xor2, %shuffle_width : f32, i32, i32
    %max_x2 = scalar.maxnumf %max_x1, %max_x2_peer : f32
    %max_x4_peer, %max_x4_valid = kernel.subgroup.shuffle<xor> %max_x2, %xor4, %shuffle_width : f32, i32, i32
    %group_max = scalar.maxnumf %max_x2, %max_x4_peer : f32
    %min_x1_peer, %min_x1_valid = kernel.subgroup.shuffle<xor> %lane_neg_min, %xor1, %shuffle_width : f32, i32, i32
    %min_x1 = scalar.maxnumf %lane_neg_min, %min_x1_peer : f32
    %min_x2_peer, %min_x2_valid = kernel.subgroup.shuffle<xor> %min_x1, %xor2, %shuffle_width : f32, i32, i32
    %min_x2 = scalar.maxnumf %min_x1, %min_x2_peer : f32
    %min_x4_peer, %min_x4_valid = kernel.subgroup.shuffle<xor> %min_x2, %xor4, %shuffle_width : f32, i32, i32
    %group_neg_min = scalar.maxnumf %min_x2, %min_x4_peer : f32
    %range0 = scalar.addf %group_max, %group_neg_min : f32
    %range = scalar.maxnumf %range0, %eps : f32
    %scale = scalar.divf<reassoc|nnan|ninf|nsz> %range, %f15 : f32
    %rscale = scalar.divf<reassoc|nnan|ninf|nsz> %f15, %range : f32
    %zp_raw = scalar.mulf %group_neg_min, %rscale : f32
    %zp_round = scalar.roundf %zp_raw : f32
    %zp_clamped = scalar.clampf<number, nnan|nsz> %zp_round, %zero_f32, %f15 : f32
    %zp = scalar.fptosi %zp_clamped : f32 to i32
    scf.if %is_leader {
      view.store %scale, %ds_view[%gid] : f32, view<[%groups]xf32>
    }

    %rs = vector.splat %rscale : vector<4xf32>
    %zpv = vector.splat %zp_clamped : vector<4xf32>
    %scaled = vector.mulf %v, %rs : vector<4xf32>
    %shifted = vector.addf %scaled, %zpv : vector<4xf32>
    %rounded = vector.roundf %shifted : vector<4xf32>
    %nonnegative = vector.maxnumf %rounded, %vzero : vector<4xf32>
    %to_ceiling = vector.subf %v15, %nonnegative : vector<4xf32>
    %ceiling_nonnegative = vector.maxnumf %to_ceiling, %vzero : vector<4xf32>
    %clamped = vector.subf %v15, %ceiling_nonnegative : vector<4xf32>
    %q32_unsigned = vector.fptosi %clamped : vector<4xf32> to vector<4xi32>
    %q32 = vector.addi %q32_unsigned, %bias_neg8 : vector<4xi32>
    %qbits = vector.andi %q32, %nibble_mask : vector<4xi32>
    %q0 = vector.extract %qbits[0] : vector<4xi32> -> i32
    %q1 = vector.extract %qbits[1] : vector<4xi32> -> i32
    %q2 = vector.extract %qbits[2] : vector<4xi32> -> i32
    %q3 = vector.extract %qbits[3] : vector<4xi32> -> i32
    %q1s = scalar.shli %q1, %shift4 : i32
    %q2s = scalar.shli %q2, %shift8 : i32
    %q3s = scalar.shli %q3, %shift12 : i32
    %q01 = scalar.ori %q0, %q1s : i32
    %q23 = scalar.ori %q2s, %q3s : i32
    %qpacked32 = scalar.ori %q01, %q23 : i32
    %qpacked = scalar.trunci %qpacked32 : i32 to i16
    %zp_signed = scalar.subi %zp, %c8_i32 : i32
    %word_base = index.mul %gid, %c8 : index
    %word_index0 = index.add %word_base, %lane_in_group : index
    %word_index = index.assume %word_index0 [range(%word_index0, 0, 268435455)] : index
    view.store %qpacked, %qs_view[%word_index] : i16, view<[%qs_halfwords]xi16>

    %lane_sum = vector.reduce<addi> %q32, %zero_i32 : vector<4xi32>, i32
    %sum_x1_peer, %sum_x1_valid = kernel.subgroup.shuffle<xor> %lane_sum, %xor1, %shuffle_width : i32, i32, i32
    %sum_x1 = scalar.addi %lane_sum, %sum_x1_peer : i32
    %sum_x2_peer, %sum_x2_valid = kernel.subgroup.shuffle<xor> %sum_x1, %xor2, %shuffle_width : i32, i32, i32
    %sum_x2 = scalar.addi %sum_x1, %sum_x2_peer : i32
    %sum_x4_peer, %sum_x4_valid = kernel.subgroup.shuffle<xor> %sum_x2, %xor4, %shuffle_width : i32, i32, i32
    %group_sum = scalar.addi %sum_x2, %sum_x4_peer : i32
    scf.if %is_leader {
      %meta0 = index.mul %gid, %two : index
      %meta1 = index.add %meta0, %one : index
      view.store %group_sum, %meta_view[%meta0] : i32, view<[%meta_count]xi32>
      view.store %zp_signed, %meta_view[%meta1] : i32, view<[%meta_count]xi32>
    }
  }
  kernel.return
}

// Decode-only route that publishes normalized F32 and Q8_1 x4 rows for the following feed-forward boundary.
kernel.def target(@qwen3_moe_attention_prepare_gfx11_wave32) @qwen3_moe_dense_linear_q4k_q8_1_x4_next_q8(%token_count: index) {
