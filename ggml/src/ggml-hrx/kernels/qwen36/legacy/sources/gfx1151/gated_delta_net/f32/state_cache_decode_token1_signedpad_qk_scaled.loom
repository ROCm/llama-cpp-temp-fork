    vector.store %kh1, %km_flat[%sll1] : vector<8xf16>, view<2176xf16>
    %qvr1 = vector.load %q_view[%sgi1] : view<1073741824xf32> -> vector<8xf32>
    %qvs1 = scf.select %stk1_ok, %qvr1, %zv8 : vector<8xf32>
