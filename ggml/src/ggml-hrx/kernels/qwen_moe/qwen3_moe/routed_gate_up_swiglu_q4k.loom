// ============================================================================
// Qwen3.6 expert-stationary Q4_K routed projections
// Compile-time-specialized roots share this native semantic source family.
// ============================================================================

// Expert-stationary MMQ MUL_MAT_ID for Q4_K weights, RDNA3.5 (gfx1151).
//
// Activations are quantized to int8 once per (token, 32-value group) into LDS
// -- one thread per pair -- so the dot4 loop reads packed int8 from LDS
// instead of re-deriving the packing per row. Partial sums are loop-carried
// registers, never LDS.
//
// The loop nest is expert-stationary: workgroups(row_tiles, nexperts, 1), each
// owning one expert and a 16-row band, streaming that band once while
// accumulating against every token routed to the expert. No workgroup is
// speculative -- each finds its own matches -- unlike a (row, token, expert)
// grid where most blocks launch only to discover their expert is unused.
//
// 16 rows per workgroup, 256 threads: the main loop views them as 16 rows x
// 16 token-slot lanes with each lane walking 2 of the 32 staged tokens;
// the activation prepass views the same 256 threads as 32 tokens x 8 groups.

config.decl @hrx2_shape_mul_mat_id_k : %value: index where [range(%value, 256, 32768), mul(%value, 256)]
config.decl @hrx2_shape_mul_mat_id_rows : %value: index where [range(%value, 1, 32768)]
config.decl @hrx2_shape_mul_mat_id_nexperts : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_mul_mat_id_nselected : %value: index where [range(%value, 1, 128)]
config.decl @hrx2_shape_mul_mat_id_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_src1_selected_stride : %value: index where [range(%value, 0, 1048576)]
config.decl @hrx2_shape_mul_mat_id_src1_token_stride : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_idx_token_stride : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_mul_mat_id_dst_token_stride : %value: index where [range(%value, 1, 1048576)]

// Shared expert-stationary Q4 MMQ schedule. The two roots specialize
// only metadata placement; the hot matrix body is authored once.
// Shared expert-stationary Q4 MMQ schedule. Literal specialization
// erases the optional SwiGLU epilogue and metadata placement choices.
// Shared expert-stationary Q4 MMQ schedule. Literal specialization
// erases optional SwiGLU/Q5-qact epilogues and metadata placement.
func.template<qwen36.mmid.q4.static.body> device @qwen36_mmid_q4_static_body(%apply_swiglu: i1, %produce_qact: i1, %src0: buffer, %src1: buffer, %idx: buffer, %dst: buffer, %gate: buffer, %aq: buffer, %as: buffer, %asum: buffer, %tbl: buffer, %table_base: offset, %qact_sums_base: offset) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %thirtytwo = index.constant 32 : index
  %k_ts = index.constant 32 : index
  %sixtyfour = index.constant 64 : index
  %onetwentyeight = index.constant 128 : index
  %onehundredfortyfour = index.constant 144 : index
  %onehundredsixty = index.constant 160 : index
  %sixteen = index.constant 16 : index
  %thirtythree = index.constant 33 : index
  %qact_word_offset = index.constant 2101248 : index
  %twofiftyfive = index.constant 255 : index
  %twofiftysix = index.constant 256 : index
  %qk = index.constant 256 : index
  %rows_per_tile = index.constant 128 : index
  %slots_per_lane = index.constant 2 : index
  %block_bytes = index.constant 144 : index
  %block_f16s = index.constant 72 : index
  %scale_offset = index.constant 4 : index
  %qs_offset = index.constant 16 : index
  %k_s1 = index.constant 1 : index
  %k_s2 = index.constant 2 : index
  %k_s3 = index.constant 3 : index
  %k_s4 = index.constant 4 : index
  %k_s5 = index.constant 5 : index
  %k_s6 = index.constant 6 : index
  %k_s7 = index.constant 7 : index
  %k_pre1 = index.constant 4 : index
  %k_pre2 = index.constant 8 : index
  %k_pre3 = index.constant 12 : index
  %k_pre4 = index.constant 16 : index
  %k_pre5 = index.constant 20 : index
  %k_pre6 = index.constant 24 : index
  %k_pre7 = index.constant 28 : index
  %sh1_i32 = scalar.constant 8 : i32
  %sh2_i32 = scalar.constant 16 : i32
  %sh3_i32 = scalar.constant 24 : i32

  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %four_i32 = scalar.constant 4 : i32
  %six_i32 = scalar.constant 6 : i32
  %eight_i32 = scalar.constant 8 : i32
  %onetwentyeight_i32 = scalar.constant 128 : i32
  %mask_0f = scalar.constant 15 : i32
  %mask_3f = scalar.constant 63 : i32
  %mask_ff = scalar.constant 255 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %eps_f32 = scalar.constant 0.00000001 : f32
  %i127_f32 = scalar.constant 127.0 : f32
  %inv127_f32 = scalar.constant 0.007874015748031496 : f32
  %zero_i32v = vector.constant 0 : vector<1xi32>
  %nibble_mask_v4 = vector.constant 252645135 : vector<4xi32>
  %four_i32v4 = vector.constant 4 : vector<4xi32>
  %ones_i8_v = vector.constant 16843009 : vector<1xi32>

  %k = config.get @hrx2_shape_mul_mat_id_k : index
  %rows = config.get @hrx2_shape_mul_mat_id_rows : index
  %nexperts = config.get @hrx2_shape_mul_mat_id_nexperts : index
  %nselected = config.get @hrx2_shape_mul_mat_id_nselected : index
  %ntokens = config.get @hrx2_shape_mul_mat_id_ntokens : index
  %src1_selected_stride = config.get @hrx2_shape_mul_mat_id_src1_selected_stride : index
  %src1_token_stride = config.get @hrx2_shape_mul_mat_id_src1_token_stride : index
  %idx_token_stride = config.get @hrx2_shape_mul_mat_id_idx_token_stride : index
  %dst_token_stride = config.get @hrx2_shape_mul_mat_id_dst_token_stride : index

  %src1_selected_stride_b = index.assume %src1_selected_stride [range(%src1_selected_stride, 0, 1048576)] : index
  %src1_token_stride_b = index.assume %src1_token_stride [range(%src1_token_stride, 1, 1048576)] : index
  %idx_token_stride_b = index.assume %idx_token_stride [range(%idx_token_stride, 1, 1048576)] : index
  %dst_token_stride_b = index.assume %dst_token_stride [range(%dst_token_stride, 1, 1048576)] : index
  %k_bounded = index.assume %k [range(%k, 256, 32768)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 32768)] : index
  %nexperts_bounded = index.assume %nexperts [range(%nexperts, 1, 1024)] : index
  %nselected_bounded = index.assume %nselected [range(%nselected, 1, 128)] : index
  %ntokens_bounded = index.assume %ntokens [range(%ntokens, 1, 1048576)] : index

  %tile0 = kernel.workgroup.id<x> : index
  %tile = index.assume %tile0 [range(%tile0, 0, 32767)] : index
  %expert0 = kernel.workgroup.id<y> : index
  %expert = index.assume %expert0 [range(%expert0, 0, 1023)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %blocks_per_row = index.div %k_bounded, %qk : index
  %expert_blocks = index.mul %rows_bounded, %blocks_per_row : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %idx_global = buffer.assume.memory_space<global> %idx : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %gate_global = buffer.assume.memory_space<global> %gate : buffer
  %src0_na, %src1_na, %idx_na, %dst_na, %gate_na = buffer.assume.noalias %src0_global, %src1_global, %idx_global, %dst_global, %gate_global : buffer, buffer, buffer, buffer, buffer
  %src0_i8_view = buffer.view %src0_na[%base] : buffer -> view<2147483647xi8>
  %src0_f16_view = buffer.view %src0_na[%base] : buffer -> view<1073741824xf16>
  %src1_view = buffer.view %src1_na[%base] : buffer -> view<1073741824xf32>
  %idx_view = buffer.view %idx_na[%base] : buffer -> view<1073741824xi32>
  %tbl_g = buffer.assume.memory_space<global> %tbl : buffer
  %tbl_view = buffer.view %tbl_g[%table_base] : buffer -> view<268435456xi32>
  // The existing graph-local MMID class scratch owns both regions:
  // snapshot [0,16384), table [16384,8404992), and qact
  // [8421376,11042816). The table-relative indices stay unchanged.
  %tbl_f32_view = buffer.view %tbl_g[%table_base] : buffer -> view<268435456xf32>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<1073741824xf32>
  %aq_g = buffer.assume.memory_space<global> %aq : buffer
  %as_g = buffer.assume.memory_space<global> %as : buffer
  %asum_g = buffer.assume.memory_space<global> %asum : buffer
  %aq_na, %as_na = buffer.assume.noalias %aq_g, %as_g : buffer, buffer
  %aq_view = buffer.view %aq_na[%base] : buffer -> view<268435456xi32>
  %as_view = buffer.view %as_na[%base] : buffer -> view<33554432xf32>
  %asum_view = buffer.view %asum_g[%qact_sums_base] : buffer -> view<67108864xi32>


  // The first 13328 B of the 41488 B LDS allocation hold match metadata and
  // staged activations. The remaining bytes hold expanded weights and their
  // scale/minimum planes.
  //   0     lane_cnt    256 x i32   matches owned by each lane's token slice,
  //                                 reused as each lane's refill cursor
  //   1024  lane_incl   256 x i32   inclusive prefix, for broadcasting the total
  //   2064  match_tok   128 x i32   token id of each match
  //   2576  match_sel   128 x i32   selected-expert slot of each match
  //   3088  act_packed 2048 x i32   32 tokens x 64 packed-int8 words
  //   11280 act_scale   256 x f32   32 tokens x 8 group scales
  //   12304 act_sum     256 x i32   32 tokens x 8 int8 sums
  %lds_bytes = index.constant 41488 : offset
  %scratch = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %lane_cnt_view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %incl_off = index.constant 1024 : offset
  %lane_incl_view = buffer.view %scratch[%incl_off] : buffer -> view<256xi32>
  %tok_off = index.constant 2064 : offset
  %match_tok_view = buffer.view %scratch[%tok_off] : buffer -> view<128xi32>
  %sel_off = index.constant 2576 : offset
  %match_sel_view = buffer.view %scratch[%sel_off] : buffer -> view<128xi32>
  %act_off = index.constant 3088 : offset
  %act_packed_view = buffer.view %scratch[%act_off] : buffer -> view<2176xi32>
  // After the matrix loop this exact region is dead and is reused as
  // [match32,group4,row32+pad1] f32 for qact; total LDS is unchanged.
  %qstage_view = buffer.view %scratch[%act_off] : buffer -> view<4224xf32>
  %ascale_off = index.constant 11792 : offset
  %act_scale_view = buffer.view %scratch[%ascale_off] : buffer -> view<256xf32>
  %asum_off = index.constant 12816 : offset
  %act_sum_view = buffer.view %scratch[%asum_off] : buffer -> view<256xi32>
  %rhs_layout = encoding.layout.strided [1, 176] : encoding<layout>
  %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  // Weight band 0: 128 k x 128 rows of expanded quants, laid out so a
  // row's k values are contiguous, which is what fragment.load<rhs> wants.
  %wl_off = index.constant 13840 : offset
  %wl_view = buffer.view %scratch[%wl_off] : buffer -> view<128x128xi8, %rhs_layout>
  %wl_i32_view = buffer.view %scratch[%wl_off] : buffer -> view<5632xi32>
  %wsc_off = index.constant 36368 : offset
  %wsc_view = buffer.view %scratch[%wsc_off] : buffer -> view<640xf32>
  %wmn_off = index.constant 38928 : offset
  %wmn_view = buffer.view %scratch[%wmn_off] : buffer -> view<640xf32>
  // The staged activations, viewed as the 16 x 256 int8 matrix they already are.
  %lhs_layout = encoding.layout.strided [272, 1] : encoding<layout>
  %al_view = buffer.view %scratch[%act_off] : buffer -> view<32x256xi8, %lhs_layout>
  %fzero8 = vector.constant 0.0 : vector<8xf32>
  %izero8 = vector.constant 0 : vector<8xi32>
  %k_wmma = index.constant 16 : index
  %k_gpc = index.constant 5 : index
  %k_meta = index.constant 4 : index
  %k_wrow = index.constant 44 : index
  %k_act_row_i32 = index.constant 68 : index

  // Pass 0: count how many (token, selected) pairs route to this expert. Each
  // lane owns the strided token slice {lane, lane+256, ...}. A match is ranked
  // by (exclusive prefix over lane counts) + (position within its lane's
  // slice), a pure function of the routing table -- an atomic counter would
  // rank by arrival order, which differs between the counting pass and each
  // window refill and would shuffle matches between windows.
  //
  // The per-lane counters live in LDS, not loop-carried registers: a
  // loop-carried i32 whose trip count depends on a runtime config leaves the
  // backend unable to pick a register class for the block argument.
  // The table holds, per expert, the match count followed by the ranked
  // matches packed as token * 128 + selected slot.
  %tbl_stride0 = index.mul %ntokens_bounded, %nselected_bounded : index
  %tbl_stride = index.mul %tbl_stride0, %two : index
  %tbl_base0 = index.mul %expert, %tbl_stride : index
  %tbl_base = index.assume %tbl_base0 [range(%tbl_base0, 0, 268435455)] : index
  %total_raw = view.load %tbl_view[%tbl_base] : view<268435456xi32> -> i32
  // Broadcast through LDS: the value is workgroup-uniform by construction, but
  // a global load carries no such proof and the barriers downstream need one.
  %is_l0 = index.cmp eq, %lane, %zero : index
  scf.if %is_l0 {
    view.store %total_raw, %lane_incl_view[%twofiftyfive] : i32, view<256xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %total_i32 = view.load %lane_incl_view[%twofiftyfive] : view<256xi32> -> i32
  %total0 = index.cast %total_i32 : i32 to index
  %total = index.assume %total0 [range(%total0, 0, 1073741823)] : index

  // Thread views. Prepass: 32 tokens x 8 groups. Main: 16 rows x 16 token lanes.
  %pre_slot = index.div %lane, %eight : index
  %pre_grp = index.rem %lane, %eight : index
  %row_in_tile = index.rem %lane, %rows_per_tile : index
  %tok_lane = index.div %lane, %rows_per_tile : index
  %tslot_base = index.mul %tok_lane, %slots_per_lane : index
  %k_band = index.constant 128 : index
  %k_wave = index.constant 32 : index
  %row_base = index.mul %tile, %k_band : index
  // Wave w owns rows [16w, 16w+16) of the band. Accumulator element
  // (lane t, reg v) is (row t % 16, token 2v + t / 16).
  %wv = index.div %lane, %k_wave : index
  %lw = index.rem %lane, %k_wave : index
  %n_base = index.mul %wv, %k_wmma : index
  %n_local = index.rem %lw, %k_wmma : index
  %m_par = index.div %lw, %k_wmma : index
  %n_scale0 = index.add %n_base, %n_local : index
  %n_scale = index.mul %n_scale0, %eight : index
  %row = index.add %row_base, %row_in_tile : index
  %row_valid = index.cmp ult, %row, %rows_bounded : index
  %row_clamped = index.assume %row [range(%row, 0, 32767)] : index
  %expert_block_base = index.mul %expert, %expert_blocks : index
  %row_blk_base = index.mul %row_clamped, %blocks_per_row : index
  %rb0 = index.add %expert_block_base, %row_blk_base : index

  // Pass 1: refill the 128-slot match list for this window, then run
  // pass 2 on it. Experts with <=128 matches take exactly one window.
  scf.for %wbase = [%zero to %total step %onetwentyeight] {
   %wbase_i32 = index.cast %wbase : index to i32
   %wend_i32 = scalar.addi %wbase_i32, %onetwentyeight_i32 : i32

   // The window is reused across iterations, so no lane may overwrite it
   // until every reader of the previous one has finished.
   kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
   %fill_on = index.cmp ult, %lane, %onetwentyeight : index
   scf.if %fill_on {
     %fi = index.add %wbase, %lane : index
     %fi_ok = index.cmp ult, %fi, %total : index
     scf.if %fi_ok {
       %fs0 = index.add %tbl_base, %one : index
       %fs1 = index.add %fs0, %fi : index
       %fs = index.assume %fs1 [range(%fs1, 0, 268435455)] : index
       %pk = view.load %tbl_view[%fs] : view<268435456xi32> -> i32
       %pk_i0 = index.cast %pk : i32 to index
       %pk_i = index.assume %pk_i0 [range(%pk_i0, 0, 134217727)] : index
       %ptok = index.div %pk_i, %onetwentyeight : index
       %psel = index.rem %pk_i, %onetwentyeight : index
       %ptok_i = index.cast %ptok : index to i32
       %psel_i = index.cast %psel : index to i32
       view.store %ptok_i, %match_tok_view[%lane] : i32, view<128xi32>
       view.store %psel_i, %match_sel_view[%lane] : i32, view<128xi32>
     }
   }
   kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

   %rem0 = index.sub %total, %wbase : index
   %rem_big = index.cmp ugt, %rem0, %onetwentyeight : index
   %nmatch1 = scf.select %rem_big, %onetwentyeight, %rem0 : index
   %nmatch = index.assume %nmatch1 [range(%nmatch1, 0, 128)] : index

  // Pass 2: stage 32 tokens at a time, streaming the weight band once per stage.
  scf.for %mbase = [%zero to %nmatch step %k_ts] {

    %m_pre = index.add %mbase, %pre_slot : index
    %pre_in_stage = index.cmp ult, %pre_slot, %k_ts : index
    %pre_valid = index.cmp ult, %m_pre, %nmatch : index
    %m_pre_c = index.rem %m_pre, %onetwentyeight : index
    %pre_tok_i32 = view.load %match_tok_view[%m_pre_c] : view<128xi32> -> i32
    %pre_sel_i32 = view.load %match_sel_view[%m_pre_c] : view<128xi32> -> i32
    %pre_tok0 = index.cast %pre_tok_i32 : i32 to index
    %pre_tok = index.assume %pre_tok0 [range(%pre_tok0, 0, 1048575)] : index
    %pre_sel0 = index.cast %pre_sel_i32 : i32 to index
    %pre_sel = index.assume %pre_sel0 [range(%pre_sel0, 0, 127)] : index
    %pre_tok_base = index.mul %pre_tok, %src1_token_stride_b : index
    %pre_sel_base = index.mul %pre_sel, %src1_selected_stride_b : index
    %pre_col_base = index.add %pre_tok_base, %pre_sel_base : index
    // [group][16-token tile][lane-half][accumulator-register]
    // metadata layout, matching the RDNA3 WMMA accumulator registers.
    %pre_meta_tile = index.div %pre_slot, %k_wmma : index
    %pre_meta_local = index.rem %pre_slot, %k_wmma : index
    %pre_meta_par = index.rem %pre_meta_local, %two : index
    %pre_meta_v = index.div %pre_meta_local, %two : index
    %pre_meta_g0 = index.mul %pre_grp, %k_ts : index
    %pre_meta_t0 = index.mul %pre_meta_tile, %k_wmma : index
    %pre_meta_p0 = index.mul %pre_meta_par, %eight : index
    %pre_meta_gt = index.add %pre_meta_g0, %pre_meta_t0 : index
    %pre_meta_gp = index.add %pre_meta_gt, %pre_meta_p0 : index
    %pre_scale_idx1 = index.add %pre_meta_gp, %pre_meta_v : index
    %pre_scale_idx = index.assume %pre_scale_idx1 [range(%pre_scale_idx1, 0, 255)] : index
    %pre_word_base0 = index.mul %pre_slot, %k_act_row_i32 : index
    %pre_word_base1 = index.mul %pre_grp, %eight : index
    %pre_word_base = index.add %pre_word_base0, %pre_word_base1 : index

    // The 2 partial sums this lane owns -- (its row) x (its 2 token
    // slots) -- are loop-carried in registers across the whole k loop and
    // touch memory exactly once, at the write-out below.
    %tile1_start = index.add %mbase, %k_wmma : index
    %tile1_on = index.cmp ult, %tile1_start, %nmatch : index

    %o0, %o1 = scf.for %blk = [%zero to %blocks_per_row step %one](
        %b0 = %fzero8 : vector<8xf32>,
        %b1 = %fzero8 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {

      // ---- Activation prepass: one thread per (token, 32-value group) ----
      // Outer guard: with TS < 32 the upper lanes have no slot in act_packed.
      scf.if %pre_in_stage {
      scf.if %pre_valid {
        %pre_col0 = index.mul %blk, %qk : index
        %pre_col1 = index.mul %pre_grp, %thirtytwo : index
        %pre_col2 = index.add %pre_col0, %pre_col1 : index
        %pre_grp_base = index.add %pre_col_base, %pre_col2 : index

        // The prepass laid the tokens out exactly as src1 is: element index
        // divided by 32 is the group id, so the staging read is a straight copy.
        %pgs0 = index.div %pre_grp_base, %thirtytwo : index
        %pgs = index.assume %pgs0 [range(%pgs0, 0, 33554431)] : index
        %pgw0 = index.mul %pgs, %eight : index
        %pgw = index.assume %pgw0 [range(%pgw0, 0, 268435448)] : index
        %psb0 = index.mul %pgs, %two : index
        %psb = index.assume %psb0 [range(%psb0, 0, 67108862)] : index
        %psb1_0 = index.add %psb, %one : index
        %psb1 = index.assume %psb1_0 [range(%psb1_0, 0, 67108863)] : index
        %a_scale = view.load %as_view[%pgs] : view<33554432xf32> -> f32
        view.store %a_scale, %act_scale_view[%pre_scale_idx] : f32, view<256xf32>
        %pgl0_0 = index.add %pgw, %zero : index
        %pgl0 = index.assume %pgl0_0 [range(%pgl0_0, 0, 268435452)] : index
        %pv0 = vector.load %aq_view[%pgl0] : view<268435456xi32> -> vector<4xi32>
        %pw0 = vector.extract %pv0[0] : vector<4xi32> -> i32
        %pwi0_0 = index.add %pre_word_base, %zero : index
        %pwi0 = index.assume %pwi0_0 [range(%pwi0_0, 0, 2175)] : index
        view.store %pw0, %act_packed_view[%pwi0] : i32, view<2176xi32>
        %pw1 = vector.extract %pv0[1] : vector<4xi32> -> i32
        %pwi1_0 = index.add %pre_word_base, %k_s1 : index
        %pwi1 = index.assume %pwi1_0 [range(%pwi1_0, 0, 2175)] : index
        view.store %pw1, %act_packed_view[%pwi1] : i32, view<2176xi32>
        %pw2 = vector.extract %pv0[2] : vector<4xi32> -> i32
        %pwi2_0 = index.add %pre_word_base, %k_s2 : index
        %pwi2 = index.assume %pwi2_0 [range(%pwi2_0, 0, 2175)] : index
        view.store %pw2, %act_packed_view[%pwi2] : i32, view<2176xi32>
        %pw3 = vector.extract %pv0[3] : vector<4xi32> -> i32
        %pwi3_0 = index.add %pre_word_base, %k_s3 : index
        %pwi3 = index.assume %pwi3_0 [range(%pwi3_0, 0, 2175)] : index
        view.store %pw3, %act_packed_view[%pwi3] : i32, view<2176xi32>
        %pgl1_0 = index.add %pgw, %k_s4 : index
        %pgl1 = index.assume %pgl1_0 [range(%pgl1_0, 0, 268435452)] : index
        %pv1 = vector.load %aq_view[%pgl1] : view<268435456xi32> -> vector<4xi32>
        %pw4 = vector.extract %pv1[0] : vector<4xi32> -> i32
        %pwi4_0 = index.add %pre_word_base, %k_s4 : index
        %pwi4 = index.assume %pwi4_0 [range(%pwi4_0, 0, 2175)] : index
        view.store %pw4, %act_packed_view[%pwi4] : i32, view<2176xi32>
        %pw5 = vector.extract %pv1[1] : vector<4xi32> -> i32
        %pwi5_0 = index.add %pre_word_base, %k_s5 : index
        %pwi5 = index.assume %pwi5_0 [range(%pwi5_0, 0, 2175)] : index
        view.store %pw5, %act_packed_view[%pwi5] : i32, view<2176xi32>
        %pw6 = vector.extract %pv1[2] : vector<4xi32> -> i32
        %pwi6_0 = index.add %pre_word_base, %k_s6 : index
        %pwi6 = index.assume %pwi6_0 [range(%pwi6_0, 0, 2175)] : index
        view.store %pw6, %act_packed_view[%pwi6] : i32, view<2176xi32>
        %pw7 = vector.extract %pv1[3] : vector<4xi32> -> i32
        %pwi7_0 = index.add %pre_word_base, %k_s7 : index
        %pwi7 = index.assume %pwi7_0 [range(%pwi7_0, 0, 2175)] : index
        view.store %pw7, %act_packed_view[%pwi7] : i32, view<2176xi32>
        %slo = view.load %asum_view[%psb] : view<67108864xi32> -> i32
        %shi = view.load %asum_view[%psb1] : view<67108864xi32> -> i32
        %pre_sum_base = index.mul %pre_scale_idx, %two : index
        %ssum = scalar.addi %slo, %shi : i32
        view.store %ssum, %act_sum_view[%pre_scale_idx] : i32, view<256xi32>
      }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

      // ---- Per-chunk: expand two groups into LDS, then one wave per band ----
      // Lane l stages row l % 128; the two lanes of a row split the chunk's
      // 32 payload bytes. One 16-byte load yields 32 outputs -- low nibbles at
      // k and high nibbles at k + 32 -- so the line is consumed once, in full.
      %st_row = index.rem %lane, %k_band : index
      %st_half = index.div %lane, %k_band : index
      %st_grow0 = index.add %row_base, %st_row : index
      %rows_last = index.sub %rows_bounded, %one : index
      %st_in = index.cmp ult, %st_grow0, %rows_bounded : index
      %st_grow = scf.select %st_in, %st_grow0, %rows_last : index
      %st_rowblk = index.mul %st_grow, %blocks_per_row : index
      %st_rb = index.add %expert_block_base, %st_rowblk : index
      %st_lb = index.add %st_rb, %blk : index
      %st_byte = index.mul %st_lb, %block_bytes : index
      %st_qs = index.add %st_byte, %qs_offset : index
      %st_h16 = index.mul %st_half, %k_wmma : index
      %st_lds0 = index.mul %st_row, %k_wrow : index
      %st_ldsq = index.div %st_h16, %four : index
      %st_lds = index.add %st_lds0, %st_ldsq : index
      %sc_on = index.cmp ult, %lane, %k_band : index

      // Canonical-layout control: only lane-half zero owns metadata.
      %stw = scf.if %sc_on -> (vector<4xi32>) {
        %stw_o = index.cast %st_byte : index to offset
        %stw_v = buffer.view %src0_na[%stw_o] : buffer -> view<4xi32>
        %stw_loaded = vector.load %stw_v[%zero] : view<4xi32> -> vector<4xi32>
        scf.yield %stw_loaded : vector<4xi32>
      } else {
        %stw_zero = vector.constant 0 : vector<4xi32>
        scf.yield %stw_zero : vector<4xi32>
      }
      %stw0 = vector.extract %stw[0] : vector<4xi32> -> i32
      %stw0_v = vector.splat %stw0 : vector<1xi32>
      %st_ddm16 = vector.bitcast %stw0_v : vector<1xi32> to vector<2xf16>
      %st_d16 = vector.extract %st_ddm16[0] : vector<2xf16> -> f16
      %st_dm16 = vector.extract %st_ddm16[1] : vector<2xf16> -> f16
      %st_d = scalar.extf %st_d16 : f16 to f32
      %st_dm = scalar.extf %st_dm16 : f16 to f32
      %stw1 = vector.extract %stw[1] : vector<4xi32> -> i32
      %stw2 = vector.extract %stw[2] : vector<4xi32> -> i32
      %stw3 = vector.extract %stw[3] : vector<4xi32> -> i32
      %sc_out = index.mul %lane, %k_gpc : index
      // ---- stage chunk 0 (groups 0..3) into plane 0 ----
      %c0_0_k = index.constant 0 : index
      %c0_0_s0 = index.add %st_qs, %c0_0_k : index
      %c0_0_s1 = index.add %c0_0_s0, %st_h16 : index
      %c0_0_o = index.cast %c0_0_s1 : index to offset
      %c0_0_v = buffer.view %src0_na[%c0_0_o] : buffer -> view<4xi32>
      %c0_0_w = vector.load %c0_0_v[%zero] : view<4xi32> -> vector<4xi32>
      %c0_0_lo = vector.andi %c0_0_w, %nibble_mask_v4 : vector<4xi32>
      %c0_0_sh = vector.shrui %c0_0_w, %four_i32v4 : vector<4xi32>
      %c0_0_hi = vector.andi %c0_0_sh, %nibble_mask_v4 : vector<4xi32>
      %c0_0_bk = index.constant 0 : index
      %c0_0_dl0 = index.add %st_lds, %c0_0_bk : index
      %c0_0_dl = index.assume %c0_0_dl0 [range(%c0_0_dl0, 0, 5628)] : index
      %c0_0_dh0 = index.add %c0_0_dl, %eight : index
      %c0_0_dh = index.assume %c0_0_dh0 [range(%c0_0_dh0, 0, 5628)] : index
      vector.store %c0_0_lo, %wl_i32_view[%c0_0_dl] : vector<4xi32>, view<5632xi32>
      vector.store %c0_0_hi, %wl_i32_view[%c0_0_dh] : vector<4xi32>, view<5632xi32>
      %c0_1_k = index.constant 32 : index
      %c0_1_s0 = index.add %st_qs, %c0_1_k : index
      %c0_1_s1 = index.add %c0_1_s0, %st_h16 : index
      %c0_1_o = index.cast %c0_1_s1 : index to offset
      %c0_1_v = buffer.view %src0_na[%c0_1_o] : buffer -> view<4xi32>
      %c0_1_w = vector.load %c0_1_v[%zero] : view<4xi32> -> vector<4xi32>
      %c0_1_lo = vector.andi %c0_1_w, %nibble_mask_v4 : vector<4xi32>
      %c0_1_sh = vector.shrui %c0_1_w, %four_i32v4 : vector<4xi32>
      %c0_1_hi = vector.andi %c0_1_sh, %nibble_mask_v4 : vector<4xi32>
      %c0_1_bk = index.constant 16 : index
      %c0_1_dl0 = index.add %st_lds, %c0_1_bk : index
      %c0_1_dl = index.assume %c0_1_dl0 [range(%c0_1_dl0, 0, 5628)] : index
      %c0_1_dh0 = index.add %c0_1_dl, %eight : index
      %c0_1_dh = index.assume %c0_1_dh0 [range(%c0_1_dh0, 0, 5628)] : index
      vector.store %c0_1_lo, %wl_i32_view[%c0_1_dl] : vector<4xi32>, view<5632xi32>
      vector.store %c0_1_hi, %wl_i32_view[%c0_1_dh] : vector<4xi32>, view<5632xi32>
      scf.if %sc_on {
        %s0_0_za = scalar.andi %stw1, %mask_ff : i32
        %s0_0_zb = scalar.andi %stw2, %mask_ff : i32
        %s0_0_sc = scalar.andi %s0_0_za, %mask_3f : i32
        %s0_0_mn = scalar.andi %s0_0_zb, %mask_3f : i32
        %s0_0_scf = scalar.uitofp %s0_0_sc : i32 to f32
        %s0_0_mnf = scalar.uitofp %s0_0_mn : i32 to f32
        %s0_0_d = scalar.mulf<reassoc|nnan|ninf|nsz> %st_d, %s0_0_scf : f32
        %s0_0_m = scalar.mulf<reassoc|nnan|ninf|nsz> %st_dm, %s0_0_mnf : f32
        %s0_0_ok = index.constant 0 : index
        %s0_0_oi0 = index.add %sc_out, %s0_0_ok : index
        %s0_0_oi = index.assume %s0_0_oi0 [range(%s0_0_oi0, 0, 639)] : index
        view.store %s0_0_d, %wsc_view[%s0_0_oi] : f32, view<640xf32>
        view.store %s0_0_m, %wmn_view[%s0_0_oi] : f32, view<640xf32>
        %s0_1_za_s = scalar.shrui %stw1, %sh1_i32 : i32
        %s0_1_za = scalar.andi %s0_1_za_s, %mask_ff : i32
        %s0_1_zb_s = scalar.shrui %stw2, %sh1_i32 : i32
        %s0_1_zb = scalar.andi %s0_1_zb_s, %mask_ff : i32
        %s0_1_sc = scalar.andi %s0_1_za, %mask_3f : i32
        %s0_1_mn = scalar.andi %s0_1_zb, %mask_3f : i32
        %s0_1_scf = scalar.uitofp %s0_1_sc : i32 to f32
        %s0_1_mnf = scalar.uitofp %s0_1_mn : i32 to f32
        %s0_1_d = scalar.mulf<reassoc|nnan|ninf|nsz> %st_d, %s0_1_scf : f32
        %s0_1_m = scalar.mulf<reassoc|nnan|ninf|nsz> %st_dm, %s0_1_mnf : f32
        %s0_1_ok = index.constant 1 : index
        %s0_1_oi0 = index.add %sc_out, %s0_1_ok : index
        %s0_1_oi = index.assume %s0_1_oi0 [range(%s0_1_oi0, 0, 639)] : index
        view.store %s0_1_d, %wsc_view[%s0_1_oi] : f32, view<640xf32>
        view.store %s0_1_m, %wmn_view[%s0_1_oi] : f32, view<640xf32>
        %s0_2_za_s = scalar.shrui %stw1, %sh2_i32 : i32
        %s0_2_za = scalar.andi %s0_2_za_s, %mask_ff : i32
        %s0_2_zb_s = scalar.shrui %stw2, %sh2_i32 : i32
        %s0_2_zb = scalar.andi %s0_2_zb_s, %mask_ff : i32
        %s0_2_sc = scalar.andi %s0_2_za, %mask_3f : i32
        %s0_2_mn = scalar.andi %s0_2_zb, %mask_3f : i32
        %s0_2_scf = scalar.uitofp %s0_2_sc : i32 to f32
        %s0_2_mnf = scalar.uitofp %s0_2_mn : i32 to f32
        %s0_2_d = scalar.mulf<reassoc|nnan|ninf|nsz> %st_d, %s0_2_scf : f32
        %s0_2_m = scalar.mulf<reassoc|nnan|ninf|nsz> %st_dm, %s0_2_mnf : f32
        %s0_2_ok = index.constant 2 : index
        %s0_2_oi0 = index.add %sc_out, %s0_2_ok : index
        %s0_2_oi = index.assume %s0_2_oi0 [range(%s0_2_oi0, 0, 639)] : index
        view.store %s0_2_d, %wsc_view[%s0_2_oi] : f32, view<640xf32>
        view.store %s0_2_m, %wmn_view[%s0_2_oi] : f32, view<640xf32>
        %s0_3_za_s = scalar.shrui %stw1, %sh3_i32 : i32
        %s0_3_za = scalar.andi %s0_3_za_s, %mask_ff : i32
        %s0_3_zb_s = scalar.shrui %stw2, %sh3_i32 : i32
        %s0_3_zb = scalar.andi %s0_3_zb_s, %mask_ff : i32
        %s0_3_sc = scalar.andi %s0_3_za, %mask_3f : i32
        %s0_3_mn = scalar.andi %s0_3_zb, %mask_3f : i32
        %s0_3_scf = scalar.uitofp %s0_3_sc : i32 to f32
        %s0_3_mnf = scalar.uitofp %s0_3_mn : i32 to f32
        %s0_3_d = scalar.mulf<reassoc|nnan|ninf|nsz> %st_d, %s0_3_scf : f32
        %s0_3_m = scalar.mulf<reassoc|nnan|ninf|nsz> %st_dm, %s0_3_mnf : f32
        %s0_3_ok = index.constant 3 : index
        %s0_3_oi0 = index.add %sc_out, %s0_3_ok : index
        %s0_3_oi = index.assume %s0_3_oi0 [range(%s0_3_oi0, 0, 639)] : index
        view.store %s0_3_d, %wsc_view[%s0_3_oi] : f32, view<640xf32>
        view.store %s0_3_m, %wmn_view[%s0_3_oi] : f32, view<640xf32>
      }
