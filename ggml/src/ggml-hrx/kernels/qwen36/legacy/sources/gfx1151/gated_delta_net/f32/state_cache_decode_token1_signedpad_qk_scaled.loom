    // Raw K/Q -> normalized f16 LDS tiles. Reciprocal norms were
    // computed once by hrx2_gdn_decode_producer_prepass with the accepted
    // WG256 reduction/rsqrt DAG and are interleaved [q,k] per row.
    %stk0_r = index.add %t0, %k0 : index
    %stk0_s = index.add %stk0_r, %stokl : index
    %stk0_ok = index.cmp ult, %stk0_s, %n_tokens : index
    %stk0_c = scf.select %stk0_ok, %stk0_s, %zero : index
