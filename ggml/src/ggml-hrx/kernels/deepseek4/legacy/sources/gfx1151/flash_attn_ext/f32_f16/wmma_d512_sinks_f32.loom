config.decl @hrx2_shape_fa_dst_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_dst_stride_token : %value: index where [range(%value, 1, 16777216)]

kernel.def export("hrx2_flash_attn_ext_f32_f16_wmma_d512_sinks") @hrx2_flash_attn_ext_f32_f16_wmma_d512_sinks() {
  %one = index.constant 1 : index
  %fifteen = index.constant 15 : index
  %sixteen = index.constant 16 : index
  %threads = index.constant 128 : index
  %ntokens = config.get @hrx2_shape_fa_ntokens : index
  %nheads = config.get @hrx2_shape_fa_nheads : index
  %rounded = index.add %ntokens, %fifteen : index
  %ntiles = index.div %rounded, %sixteen : index
  %nheads_b = index.assume %nheads [range(%nheads, 1, 1024)] : index
  kernel.launch.config workgroups(%ntiles, %nheads_b, %one)
      workgroup_size(%threads, %one, %one) : index
