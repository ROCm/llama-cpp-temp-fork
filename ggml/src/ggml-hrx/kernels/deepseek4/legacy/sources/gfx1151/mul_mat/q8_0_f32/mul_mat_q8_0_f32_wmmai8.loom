    %wpp1_block = index.assume %wpp1_block1 [range(%wpp1_block1, 0, 31580640)] : index
    %wpp1_byte0 = index.mul %wpp1_block, %c34 : index
    %wpp1_byte1 = index.add %wpp1_byte0, %two : index
    %wpp1_half_bytes = index.mul %wpp1_payload_half, %sixteen : index
    %wpp1_byte2 = index.add %wpp1_byte1, %wpp1_half_bytes : index
    %wpp1_byte = index.assume %wpp1_byte2 [range(%wpp1_byte2, 0, 1073741808)] : index
    %wpp1_payload = vector.load %src0_i8[%wpp1_byte] : view<1073741824xi8, #dense> -> vector<16xi8>
    %wpp1_dst_row = index.mul %wpp1_row, %k_wstride : index
    %wpp1_dst_block = index.mul %wpp1_block_l, %c32 : index
