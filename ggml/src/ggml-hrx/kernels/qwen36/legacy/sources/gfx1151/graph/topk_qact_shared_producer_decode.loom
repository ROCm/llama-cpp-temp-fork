// Native decode prefix: TopK/Qact plus SharedP.
//
// WGs 0..rows-1 execute the existing shared dual-Q8 rows, WG rows executes its
// scalar gate, and WG rows+1 executes the one-WG TopK/Qact
// body. Shared output and raw gate use native graph-transient bindings; the
// normalized router weights retain their original graph tensor and semantics.
// The classes are independent and the following dispatch is the grid sync.

config.decl @hrx2_shape_qact_k : %value: index where [range(%value, 2048, 2048)]
config.decl @hrx2_shape_qact_cols : %value: index where [range(%value, 1, 1)]
config.decl @hrx2_shape_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 512, 512)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_tuning_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_tuning_q8_0_f32_unroll_factor : %value: index where [range(%value, 0, 16)]

kernel.def export("hrx2_topk_qact_shared_producer_decode")
    @hrx2_topk_qact_shared_producer_decode() {
  %route_one = index.constant 1 : index
  %route_two = index.constant 2 : index
  %route_rows = config.get @hrx2_shape_rows : index
  %route_workgroups = index.add %route_rows, %route_two : index
  %route_wg_size = config.get @hrx2_tuning_workgroup_size : index
  kernel.launch.config workgroups(%route_workgroups, %route_one, %route_one)
      workgroup_size(%route_wg_size, %route_one, %route_one) : index
  } launch(%tk_logits: buffer, %tk_ids: buffer, %tk_weights: buffer,
          %src1: buffer, %qa_packed: buffer, %gate_weights: buffer,
          %up_weights: buffer, %shared_gate_weight: buffer, %dst: buffer,
          %raw_gate: buffer) {
  %route_zero = index.constant 0 : index
  %route_one = index.constant 1 : index
  %route_wg0 = kernel.workgroup.id<x> : index
  %route_wg = index.assume %route_wg0 [range(%route_wg0, 0, 262145)] : index
  %route_rows = config.get @hrx2_shape_rows : index
  %route_topk_wg = index.add %route_rows, %route_one : index
  %route_is_topk = index.cmp eq, %route_wg, %route_topk_wg : index
  scf.if %route_is_topk {
      %phase_zero = index.constant 0 : index
      %phase_one = index.constant 1 : index
      %phase_three = index.constant 3 : index
      %phase_subgroup0 = kernel.subgroup.id : index
      %phase_subgroup = index.assume %phase_subgroup0
          [range(%phase_subgroup0, 0, 7)] : index
      %phase_is_topk = index.cmp eq, %phase_subgroup, %phase_zero : index
      %phase_qact_lo = index.cmp uge, %phase_subgroup, %phase_one : index
      %phase_qact_hi = index.cmp ult, %phase_subgroup, %phase_three : index
      %phase_is_qact = scalar.andi %phase_qact_lo, %phase_qact_hi : i1

      scf.if %phase_is_topk {
          %tk_base = index.constant 0 : offset
          %tk_zero = index.constant 0 : index
          %tk_one = index.constant 1 : index
          %tk_eight = index.constant 8 : index
          %tk_thirty_two = index.constant 32 : index
          %tk_sixty_four = index.constant 64 : index
          %tk_ninety_six = index.constant 96 : index
          %tk_one_twenty_eight = index.constant 128 : index
          %tk_one_sixty = index.constant 160 : index
          %tk_one_ninety_two = index.constant 192 : index
          %tk_two_twenty_four = index.constant 224 : index

          %tk_zero_i32 = scalar.constant 0 : i32
          %tk_sentinel_i32 = scalar.constant 256 : i32
          %tk_zero_f32 = scalar.constant 0.0 : f32
          %tk_neg_max_f32 = scalar.constant -3.4028234663852886e+38 : f32
          %tk_denom_min = scalar.constant 6.103515625e-5 : f32
          %tk_sentinel_i32_v = vector.constant 256 : vector<8xi32>
          %tk_empty_ids = vector.constant 256 : vector<8xi32>
          %tk_empty_probs = vector.constant 0.0 : vector<8xf32>
          %tk_neg_max_v = vector.constant -3.4028234663852886e+38 : vector<8xf32>

          %tk_lane0 = kernel.subgroup.lane.id : index
          %tk_lane = index.assume %tk_lane0 [range(%tk_lane0, 0, 31)] : index

          %tk_expert0 = index.add %tk_lane, %tk_zero : index
          %tk_expert1_0 = index.add %tk_lane, %tk_thirty_two : index
          %tk_expert1 = index.assume %tk_expert1_0 [range(%tk_expert1_0, 32, 63)] : index
          %tk_expert2_0 = index.add %tk_lane, %tk_sixty_four : index
          %tk_expert2 = index.assume %tk_expert2_0 [range(%tk_expert2_0, 64, 95)] : index
          %tk_expert3_0 = index.add %tk_lane, %tk_ninety_six : index
          %tk_expert3 = index.assume %tk_expert3_0 [range(%tk_expert3_0, 96, 127)] : index
          %tk_expert4_0 = index.add %tk_lane, %tk_one_twenty_eight : index
          %tk_expert4 = index.assume %tk_expert4_0 [range(%tk_expert4_0, 128, 159)] : index
          %tk_expert5_0 = index.add %tk_lane, %tk_one_sixty : index
          %tk_expert5 = index.assume %tk_expert5_0 [range(%tk_expert5_0, 160, 191)] : index
          %tk_expert6_0 = index.add %tk_lane, %tk_one_ninety_two : index
          %tk_expert6 = index.assume %tk_expert6_0 [range(%tk_expert6_0, 192, 223)] : index
          %tk_expert7_0 = index.add %tk_lane, %tk_two_twenty_four : index
          %tk_expert7 = index.assume %tk_expert7_0 [range(%tk_expert7_0, 224, 255)] : index

          %tk_expert0_i32 = index.cast %tk_expert0 : index to i32
          %tk_expert1_i32 = index.cast %tk_expert1 : index to i32
          %tk_expert2_i32 = index.cast %tk_expert2 : index to i32
          %tk_expert3_i32 = index.cast %tk_expert3 : index to i32
          %tk_expert4_i32 = index.cast %tk_expert4 : index to i32
          %tk_expert5_i32 = index.cast %tk_expert5 : index to i32
          %tk_expert6_i32 = index.cast %tk_expert6 : index to i32
          %tk_expert7_i32 = index.cast %tk_expert7 : index to i32
          %tk_expert_ids = vector.from_elements %tk_expert0_i32, %tk_expert1_i32, %tk_expert2_i32, %tk_expert3_i32, %tk_expert4_i32, %tk_expert5_i32, %tk_expert6_i32, %tk_expert7_i32 : vector<8xi32>

          %tk_logits_global = buffer.assume.memory_space<global> %tk_logits : buffer
          %tk_ids_global = buffer.assume.memory_space<global> %tk_ids : buffer
          %tk_weights_global = buffer.assume.memory_space<global> %tk_weights : buffer
          // Do not assert logits/weights noalias: they overlap in the live graph.
          %tk_logits_view = buffer.view %tk_logits_global[%tk_base] : buffer -> view<256xf32>
          %tk_ids_view = buffer.view %tk_ids_global[%tk_base] : buffer -> view<256xi32>
          %tk_weights_view = buffer.view %tk_weights_global[%tk_base] : buffer -> view<8xf32>

          %tk_x0 = view.load %tk_logits_view[%tk_expert0] : view<256xf32> -> f32
          %tk_x1 = view.load %tk_logits_view[%tk_expert1] : view<256xf32> -> f32
          %tk_x2 = view.load %tk_logits_view[%tk_expert2] : view<256xf32> -> f32
          %tk_x3 = view.load %tk_logits_view[%tk_expert3] : view<256xf32> -> f32
          %tk_x4 = view.load %tk_logits_view[%tk_expert4] : view<256xf32> -> f32
          %tk_x5 = view.load %tk_logits_view[%tk_expert5] : view<256xf32> -> f32
          %tk_x6 = view.load %tk_logits_view[%tk_expert6] : view<256xf32> -> f32
          %tk_x7 = view.load %tk_logits_view[%tk_expert7] : view<256xf32> -> f32
          %tk_values = vector.from_elements %tk_x0, %tk_x1, %tk_x2, %tk_x3, %tk_x4, %tk_x5, %tk_x6, %tk_x7 : vector<8xf32>

          // All 256 logits are now resident in the wave before an aliased output store.
          kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

          %tk_lane_max = vector.reduce<maxnumf> %tk_values, %tk_neg_max_f32 : vector<8xf32>, f32
          %tk_row_max = kernel.subgroup.reduce<maxnumf> %tk_lane_max : f32
          %tk_row_max_v = vector.splat %tk_row_max : vector<8xf32>
          %tk_shifted = vector.subf<nnan|ninf|nsz> %tk_values, %tk_row_max_v : vector<8xf32>
          %tk_exps = vector.expf<afn> %tk_shifted : vector<8xf32>
          %tk_lane_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %tk_exps, %tk_zero_f32 : vector<8xf32>, f32
          %tk_row_sum = kernel.subgroup.reduce<addf> %tk_lane_sum : f32
          %tk_row_sum_v = vector.splat %tk_row_sum : vector<8xf32>
          %tk_probs = vector.divf<nnan|ninf|nsz|arcp> %tk_exps, %tk_row_sum_v : vector<8xf32>

          %tk_live_final, %tk_selected_ids, %tk_selected_probs = scf.for %tk_slot = [%tk_zero to %tk_eight step %tk_one](%tk_live = %tk_probs : vector<8xf32>, %tk_ids_acc = %tk_empty_ids : vector<8xi32>, %tk_probs_acc = %tk_empty_probs : vector<8xf32>) -> (vector<8xf32>, vector<8xi32>, vector<8xf32>) unroll {
            %tk_lane_best = vector.reduce<maxnumf> %tk_live, %tk_neg_max_f32 : vector<8xf32>, f32
            %tk_winner_prob = kernel.subgroup.reduce<maxnumf> %tk_lane_best : f32
            %tk_winner_prob_v = vector.splat %tk_winner_prob : vector<8xf32>
            %tk_matching = vector.cmpf oeq, %tk_live, %tk_winner_prob_v : vector<8xf32> -> vector<8xi1>
            %tk_matching_ids = vector.select %tk_matching, %tk_expert_ids, %tk_sentinel_i32_v : vector<8xi32>
            %tk_lane_winner_id = vector.reduce<minsi> %tk_matching_ids, %tk_sentinel_i32 : vector<8xi32>, i32
            %tk_winner_id = kernel.subgroup.reduce<minsi> %tk_lane_winner_id : i32

            %tk_ids_next = vector.insert %tk_winner_id into %tk_ids_acc[%tk_slot] : i32, vector<8xi32>
            %tk_probs_next = vector.insert %tk_winner_prob into %tk_probs_acc[%tk_slot] : f32, vector<8xf32>
            %tk_winner_id_v = vector.splat %tk_winner_id : vector<8xi32>
            %tk_winner_mask = vector.cmpi eq, %tk_expert_ids, %tk_winner_id_v : vector<8xi32> -> vector<8xi1>
            %tk_live_next = vector.select %tk_winner_mask, %tk_neg_max_v, %tk_live : vector<8xf32>
            scf.yield %tk_live_next, %tk_ids_next, %tk_probs_next : vector<8xf32>, vector<8xi32>, vector<8xf32>
          }

          %tk_selected_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %tk_selected_probs, %tk_zero_f32 : vector<8xf32>, f32
          %tk_denom = scalar.maxnumf %tk_selected_sum, %tk_denom_min : f32

          %tk_lane_i32 = index.cast %tk_lane : index to i32
          %tk_lane_is_zero = scalar.cmpi eq, %tk_lane_i32, %tk_zero_i32 : i32
          scf.if %tk_lane_is_zero {
            scf.for %tk_slot = [%tk_zero to %tk_eight step %tk_one] unroll {
              %tk_winner_id = vector.extract %tk_selected_ids[%tk_slot] : vector<8xi32> -> i32
              %tk_winner_prob = vector.extract %tk_selected_probs[%tk_slot] : vector<8xf32> -> f32
              %tk_weight = scalar.divf<nnan|ninf|nsz|arcp> %tk_winner_prob, %tk_denom : f32
              view.store %tk_winner_id, %tk_ids_view[%tk_slot] : i32, view<256xi32>
              view.store %tk_weight, %tk_weights_view[%tk_slot] : f32, view<8xf32>
            }
          }
      }
      scf.if %phase_is_qact {
          %qa_base = index.constant 0 : offset
          %qa_zero = index.constant 0 : index
          %qa_c4 = index.constant 4 : index
          %qa_c8 = index.constant 8 : index
          %qa_c32 = index.constant 32 : index
          %qa_c256 = index.constant 256 : index

          %qa_zero_i32 = scalar.constant 0 : i32
          %qa_zero_f32 = scalar.constant 0.0 : f32
          %qa_amax_eps = scalar.constant 1.0e-30 : f32
          %qa_inv127 = scalar.constant 0.00787401574803149606 : f32
          %qa_f127 = scalar.constant 127.0 : f32

          %qa_k = config.get @hrx2_shape_qact_k : index
          %qa_cols = config.get @hrx2_shape_qact_cols : index
          %qa_k_b = index.assume %qa_k [range(%qa_k, 32, 65536)] : index
          %qa_cols_b = index.assume %qa_cols [range(%qa_cols, 1, 16384)] : index
          %qa_total = index.mul %qa_k_b, %qa_cols_b : index
          %qa_groups0 = index.div %qa_total, %qa_c32 : index
          %qa_groups = index.assume %qa_groups0 [range(%qa_groups0, 1, 33554432)] : index

          %qa_wgid0 = index.constant 0 : index
          %qa_tid0 = kernel.workitem.id<x> : index
          %qa_lane_shift = index.constant 32 : index
          %qa_lane0 = index.sub %qa_tid0, %qa_lane_shift : index
          %qa_wgid = index.assume %qa_wgid0 [range(%qa_wgid0, 0, 131071)] : index
          %qa_lane = index.assume %qa_lane0 [range(%qa_lane0, 0, 255)] : index
          %qa_gid0 = index.mul %qa_wgid, %qa_c256 : index
          %qa_gid1 = index.add %qa_gid0, %qa_lane : index
          %qa_gid = index.assume %qa_gid1 [range(%qa_gid1, 0, 33554431)] : index
          %qa_in_range = index.cmp ult, %qa_gid, %qa_groups : index

          %src1_g = buffer.assume.memory_space<global> %src1 : buffer
          %qa_packed_g = buffer.assume.memory_space<global> %qa_packed : buffer
          %src1_na, %qa_packed_na = buffer.assume.noalias %src1_g, %qa_packed_g : buffer, buffer
          %src1_elems = index.assume %qa_total [range(%qa_total, 32, 1073741824)] : index
          %src1_view = buffer.view %src1_na[%qa_base] : buffer -> view<[%src1_elems]xf32>
          %qa_qs_words = index.div %qa_total, %qa_c4 : index
          %qa_ds_byte_index = index.add %qa_total, %qa_zero : index
          %qa_ds_byte_offset = index.cast %qa_ds_byte_index : index to offset
          %qa_ds_bytes = index.mul %qa_groups, %qa_c4 : index
          %qa_sum_byte_index = index.add %qa_ds_byte_index, %qa_ds_bytes : index
          %qa_sum_byte_offset = index.cast %qa_sum_byte_index : index to offset
          %qa_qs_view = buffer.view %qa_packed_na[%qa_base] : buffer -> view<[%qa_qs_words]xi32>
          %qa_ds_view = buffer.view %qa_packed_na[%qa_ds_byte_offset] : buffer -> view<[%qa_groups]xf32>
          %qa_c2 = index.constant 2 : index
          %qa_sum_slots = index.mul %qa_groups, %qa_c2 : index
          %qa_sum_view = buffer.view %qa_packed_na[%qa_sum_byte_offset] : buffer -> view<[%qa_sum_slots]xi32>

          scf.if %qa_in_range {
            %qa_ebase0 = index.mul %qa_gid, %qa_c32 : index
            %qa_ebase = index.assume %qa_ebase0 [range(%qa_ebase0, 0, 1073741792)] : index

            %qa_e0 = index.add %qa_ebase, %qa_zero : index
            %qa_v0 = vector.load %src1_view[%qa_e0] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o1 = index.constant 4 : index
            %qa_e1r = index.add %qa_ebase, %qa_o1 : index
            %qa_e1 = index.assume %qa_e1r [range(%qa_e1r, 0, 1073741820)] : index
            %qa_v1 = vector.load %src1_view[%qa_e1] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o2 = index.constant 8 : index
            %qa_e2r = index.add %qa_ebase, %qa_o2 : index
            %qa_e2 = index.assume %qa_e2r [range(%qa_e2r, 0, 1073741820)] : index
            %qa_v2 = vector.load %src1_view[%qa_e2] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o3 = index.constant 12 : index
            %qa_e3r = index.add %qa_ebase, %qa_o3 : index
            %qa_e3 = index.assume %qa_e3r [range(%qa_e3r, 0, 1073741820)] : index
            %qa_v3 = vector.load %src1_view[%qa_e3] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o4 = index.constant 16 : index
            %qa_e4r = index.add %qa_ebase, %qa_o4 : index
            %qa_e4 = index.assume %qa_e4r [range(%qa_e4r, 0, 1073741820)] : index
            %qa_v4 = vector.load %src1_view[%qa_e4] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o5 = index.constant 20 : index
            %qa_e5r = index.add %qa_ebase, %qa_o5 : index
            %qa_e5 = index.assume %qa_e5r [range(%qa_e5r, 0, 1073741820)] : index
            %qa_v5 = vector.load %src1_view[%qa_e5] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o6 = index.constant 24 : index
            %qa_e6r = index.add %qa_ebase, %qa_o6 : index
            %qa_e6 = index.assume %qa_e6r [range(%qa_e6r, 0, 1073741820)] : index
            %qa_v6 = vector.load %src1_view[%qa_e6] : view<[%src1_elems]xf32> -> vector<4xf32>
            %qa_o7 = index.constant 28 : index
            %qa_e7r = index.add %qa_ebase, %qa_o7 : index
            %qa_e7 = index.assume %qa_e7r [range(%qa_e7r, 0, 1073741820)] : index
            %qa_v7 = vector.load %src1_view[%qa_e7] : view<[%src1_elems]xf32> -> vector<4xf32>

            %qa_a0 = vector.absf %qa_v0 : vector<4xf32>
            %qa_m0 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a0, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a1 = vector.absf %qa_v1 : vector<4xf32>
            %qa_m1 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a1, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a2 = vector.absf %qa_v2 : vector<4xf32>
            %qa_m2 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a2, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a3 = vector.absf %qa_v3 : vector<4xf32>
            %qa_m3 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a3, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a4 = vector.absf %qa_v4 : vector<4xf32>
            %qa_m4 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a4, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a5 = vector.absf %qa_v5 : vector<4xf32>
            %qa_m5 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a5, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a6 = vector.absf %qa_v6 : vector<4xf32>
            %qa_m6 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a6, %qa_zero_f32 : vector<4xf32>, f32
            %qa_a7 = vector.absf %qa_v7 : vector<4xf32>
            %qa_m7 = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa_a7, %qa_zero_f32 : vector<4xf32>, f32

            %qa_x1 = scalar.maxnumf %qa_m0, %qa_m1 : f32
            %qa_x2 = scalar.maxnumf %qa_x1, %qa_m2 : f32
            %qa_x3 = scalar.maxnumf %qa_x2, %qa_m3 : f32
            %qa_x4 = scalar.maxnumf %qa_x3, %qa_m4 : f32
            %qa_x5 = scalar.maxnumf %qa_x4, %qa_m5 : f32
            %qa_x6 = scalar.maxnumf %qa_x5, %qa_m6 : f32
            %qa_x7 = scalar.maxnumf %qa_x6, %qa_m7 : f32
            %qa_amax = scalar.maxnumf %qa_x7, %qa_amax_eps : f32
            %qa_a_scale = scalar.mulf<reassoc|nnan|ninf|nsz> %qa_amax, %qa_inv127 : f32
            %qa_a_rscale = scalar.divf<reassoc|nnan|ninf|nsz> %qa_f127, %qa_amax : f32
            view.store %qa_a_scale, %qa_ds_view[%qa_gid] : f32, view<[%qa_groups]xf32>

            %qa_rs = vector.splat %qa_a_rscale : vector<4xf32>
            // Packed-word slots step by one; %qa_o1..%qa_o7 are element strides for the loads
            // above and must not be reused here.
            %qa_p1 = index.constant 1 : index
            %qa_p2 = index.constant 2 : index
            %qa_p3 = index.constant 3 : index
            %qa_p4 = index.constant 4 : index
            %qa_p5 = index.constant 5 : index
            %qa_p6 = index.constant 6 : index
            %qa_p7 = index.constant 7 : index
            %qa_wbase0 = index.mul %qa_gid, %qa_c8 : index
            %qa_wbase = index.assume %qa_wbase0 [range(%qa_wbase0, 0, 268435448)] : index

            %qa_s0 = vector.mulf %qa_v0, %qa_rs : vector<4xf32>
            %qa_r0 = vector.roundf %qa_s0 : vector<4xf32>
            %qa_q0 = vector.fptosi %qa_r0 : vector<4xf32> to vector<4xi32>
            %qa_q0i8 = vector.trunci %qa_q0 : vector<4xi32> to vector<4xi8>
            %qa_q0v = vector.bitcast %qa_q0i8 : vector<4xi8> to vector<1xi32>
            %qa_q0w = vector.extract %qa_q0v[0] : vector<1xi32> -> i32
            %qa_w0i = index.add %qa_wbase, %qa_zero : index
            view.store %qa_q0w, %qa_qs_view[%qa_w0i] : i32, view<[%qa_qs_words]xi32>

            %qa_s1 = vector.mulf %qa_v1, %qa_rs : vector<4xf32>
            %qa_r1 = vector.roundf %qa_s1 : vector<4xf32>
            %qa_q1 = vector.fptosi %qa_r1 : vector<4xf32> to vector<4xi32>
            %qa_q1i8 = vector.trunci %qa_q1 : vector<4xi32> to vector<4xi8>
            %qa_q1v = vector.bitcast %qa_q1i8 : vector<4xi8> to vector<1xi32>
            %qa_q1w = vector.extract %qa_q1v[0] : vector<1xi32> -> i32
            %qa_w1r = index.add %qa_wbase, %qa_p1 : index
            %qa_w1i = index.assume %qa_w1r [range(%qa_w1r, 0, 268435455)] : index
            view.store %qa_q1w, %qa_qs_view[%qa_w1i] : i32, view<[%qa_qs_words]xi32>

            %qa_s2 = vector.mulf %qa_v2, %qa_rs : vector<4xf32>
            %qa_r2 = vector.roundf %qa_s2 : vector<4xf32>
            %qa_q2 = vector.fptosi %qa_r2 : vector<4xf32> to vector<4xi32>
            %qa_q2i8 = vector.trunci %qa_q2 : vector<4xi32> to vector<4xi8>
            %qa_q2v = vector.bitcast %qa_q2i8 : vector<4xi8> to vector<1xi32>
            %qa_q2w = vector.extract %qa_q2v[0] : vector<1xi32> -> i32
            %qa_w2r = index.add %qa_wbase, %qa_p2 : index
            %qa_w2i = index.assume %qa_w2r [range(%qa_w2r, 0, 268435455)] : index
            view.store %qa_q2w, %qa_qs_view[%qa_w2i] : i32, view<[%qa_qs_words]xi32>

            %qa_s3 = vector.mulf %qa_v3, %qa_rs : vector<4xf32>
            %qa_r3 = vector.roundf %qa_s3 : vector<4xf32>
            %qa_q3 = vector.fptosi %qa_r3 : vector<4xf32> to vector<4xi32>
            %qa_q3i8 = vector.trunci %qa_q3 : vector<4xi32> to vector<4xi8>
            %qa_q3v = vector.bitcast %qa_q3i8 : vector<4xi8> to vector<1xi32>
            %qa_q3w = vector.extract %qa_q3v[0] : vector<1xi32> -> i32
            %qa_w3r = index.add %qa_wbase, %qa_p3 : index
            %qa_w3i = index.assume %qa_w3r [range(%qa_w3r, 0, 268435455)] : index
            view.store %qa_q3w, %qa_qs_view[%qa_w3i] : i32, view<[%qa_qs_words]xi32>

            %qa_s4 = vector.mulf %qa_v4, %qa_rs : vector<4xf32>
            %qa_r4 = vector.roundf %qa_s4 : vector<4xf32>
            %qa_q4 = vector.fptosi %qa_r4 : vector<4xf32> to vector<4xi32>
            %qa_q4i8 = vector.trunci %qa_q4 : vector<4xi32> to vector<4xi8>
            %qa_q4v = vector.bitcast %qa_q4i8 : vector<4xi8> to vector<1xi32>
            %qa_q4w = vector.extract %qa_q4v[0] : vector<1xi32> -> i32
            %qa_w4r = index.add %qa_wbase, %qa_p4 : index
            %qa_w4i = index.assume %qa_w4r [range(%qa_w4r, 0, 268435455)] : index
            view.store %qa_q4w, %qa_qs_view[%qa_w4i] : i32, view<[%qa_qs_words]xi32>

            %qa_s5 = vector.mulf %qa_v5, %qa_rs : vector<4xf32>
            %qa_r5 = vector.roundf %qa_s5 : vector<4xf32>
            %qa_q5 = vector.fptosi %qa_r5 : vector<4xf32> to vector<4xi32>
            %qa_q5i8 = vector.trunci %qa_q5 : vector<4xi32> to vector<4xi8>
            %qa_q5v = vector.bitcast %qa_q5i8 : vector<4xi8> to vector<1xi32>
            %qa_q5w = vector.extract %qa_q5v[0] : vector<1xi32> -> i32
            %qa_w5r = index.add %qa_wbase, %qa_p5 : index
            %qa_w5i = index.assume %qa_w5r [range(%qa_w5r, 0, 268435455)] : index
            view.store %qa_q5w, %qa_qs_view[%qa_w5i] : i32, view<[%qa_qs_words]xi32>

            %qa_s6 = vector.mulf %qa_v6, %qa_rs : vector<4xf32>
            %qa_r6 = vector.roundf %qa_s6 : vector<4xf32>
            %qa_q6 = vector.fptosi %qa_r6 : vector<4xf32> to vector<4xi32>
            %qa_q6i8 = vector.trunci %qa_q6 : vector<4xi32> to vector<4xi8>
            %qa_q6v = vector.bitcast %qa_q6i8 : vector<4xi8> to vector<1xi32>
            %qa_q6w = vector.extract %qa_q6v[0] : vector<1xi32> -> i32
            %qa_w6r = index.add %qa_wbase, %qa_p6 : index
            %qa_w6i = index.assume %qa_w6r [range(%qa_w6r, 0, 268435455)] : index
            view.store %qa_q6w, %qa_qs_view[%qa_w6i] : i32, view<[%qa_qs_words]xi32>

            %qa_s7 = vector.mulf %qa_v7, %qa_rs : vector<4xf32>
            %qa_r7 = vector.roundf %qa_s7 : vector<4xf32>
            %qa_q7 = vector.fptosi %qa_r7 : vector<4xf32> to vector<4xi32>
            %qa_q7i8 = vector.trunci %qa_q7 : vector<4xi32> to vector<4xi8>
            %qa_q7v = vector.bitcast %qa_q7i8 : vector<4xi8> to vector<1xi32>
            %qa_q7w = vector.extract %qa_q7v[0] : vector<1xi32> -> i32
            %qa_w7r = index.add %qa_wbase, %qa_p7 : index
            %qa_w7i = index.assume %qa_w7r [range(%qa_w7r, 0, 268435455)] : index
            view.store %qa_q7w, %qa_qs_view[%qa_w7i] : i32, view<[%qa_qs_words]xi32>

            %qa_fs0 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r0, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs1 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r1, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs2 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r2, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs3 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r3, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs4 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r4, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs5 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r5, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs6 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r6, %qa_zero_f32 : vector<4xf32>, f32
            %qa_fs7 = vector.reduce<addf, reassoc|nnan|nsz> %qa_r7, %qa_zero_f32 : vector<4xf32>, f32
            %qa_lo01 = scalar.addf<reassoc|nnan|nsz> %qa_fs0, %qa_fs1 : f32
            %qa_lo23 = scalar.addf<reassoc|nnan|nsz> %qa_fs2, %qa_fs3 : f32
            %qa_lo = scalar.addf<reassoc|nnan|nsz> %qa_lo01, %qa_lo23 : f32
            %qa_hi45 = scalar.addf<reassoc|nnan|nsz> %qa_fs4, %qa_fs5 : f32
            %qa_hi67 = scalar.addf<reassoc|nnan|nsz> %qa_fs6, %qa_fs7 : f32
            %qa_hi = scalar.addf<reassoc|nnan|nsz> %qa_hi45, %qa_hi67 : f32
            %qa_slo = scalar.fptosi %qa_lo : f32 to i32
            %qa_shi = scalar.fptosi %qa_hi : f32 to i32
            %qa_sbase = index.mul %qa_gid, %qa_c2 : index
            %qa_sbase1 = index.add %qa_sbase, %qa_p1 : index
            view.store %qa_slo, %qa_sum_view[%qa_sbase] : i32, view<[%qa_sum_slots]xi32>
            view.store %qa_shi, %qa_sum_view[%qa_sbase1] : i32, view<[%qa_sum_slots]xi32>
          }
      }
  } else {
      %base = index.constant 0 : offset
      %zero = index.constant 0 : index
      %one = index.constant 1 : index
      %four = index.constant 4 : index
      %eight = index.constant 8 : index
      %qk = index.constant 32 : index
      %block_bytes = index.constant 34 : index
      %block_f16s = index.constant 17 : index
      %qs_offset = index.constant 2 : index
      %zero_f32 = scalar.constant 0.0 : f32

      %k = config.get @hrx2_shape_k : index
      %rows = config.get @hrx2_shape_rows : index
      %cols = config.get @hrx2_shape_cols : index
      %workgroup_size = config.get @hrx2_tuning_workgroup_size : index
      %unroll = config.get @hrx2_tuning_q8_0_f32_unroll_factor : index
      %k_bounded = index.assume %k [range(%k, 32, 32768)] : index
      %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
      %cols_bounded = index.assume %cols [range(%cols, 1, 4096)] : index

      %wg0 = index.assume %route_wg [range(%route_wg, 0, 512)] : index
      %wg = index.assume %wg0 [range(%wg0, 0, 262144)] : index
      %col0 = kernel.workgroup.id<y> : index
      %col = index.assume %col0 [range(%col0, 0, 4095)] : index
      %lane0 = kernel.workitem.id<x> : index
      %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

      %gate_global =
          buffer.assume.memory_space<global> %gate_weights : buffer
      %up_global = buffer.assume.memory_space<global> %up_weights : buffer
      %shared_gate_global =
          buffer.assume.memory_space<global> %shared_gate_weight : buffer
      %src1_global = buffer.assume.memory_space<global> %src1 : buffer
      %dst_global = buffer.assume.memory_space<global> %dst : buffer
      %raw_gate_global = buffer.assume.memory_space<global> %raw_gate : buffer
      %gate_noalias, %up_noalias, %shared_gate_noalias, %src1_noalias,
          %dst_noalias, %raw_gate_noalias = buffer.assume.noalias
              %gate_global, %up_global, %shared_gate_global, %src1_global,
              %dst_global, %raw_gate_global :
              buffer, buffer, buffer, buffer, buffer, buffer

      %is_scalar = index.cmp eq, %wg, %rows_bounded : index
      scf.if %is_scalar {
        // This branch is operation-for-operation identical to the accepted
        // hrx2_mul_mat_f32_f32_static K2048/R1/C1/WG256 projection.
        %shared_gate_view = buffer.view %shared_gate_noalias[%base] :
            buffer -> view<[%k_bounded]xf32>
        %scalar_src_view = buffer.view %src1_noalias[%base] :
            buffer -> view<[%k_bounded]xf32>
        %raw_gate_view = buffer.view %raw_gate_noalias[%base] :
            buffer -> view<1xf32>
        %sum = scf.for
            %i = [%lane to %k_bounded step %workgroup_size](
                %acc = %zero_f32 : f32) -> (f32) {
          %a = view.load %shared_gate_view[%i] :
              view<[%k_bounded]xf32> -> f32
          %b = view.load %scalar_src_view[%i] :
              view<[%k_bounded]xf32> -> f32
          %product = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b : f32
          %next =
              scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
          scf.yield %next : f32
        }
        %dot = kernel.workgroup.reduce<addf> %sum : f32
        %lane_i32 = index.cast %lane : index to i32
        %zero_i32 = scalar.constant 0 : i32
        %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
        scf.if %is_lane0 {
          view.store %dot, %raw_gate_view[%zero] :
              f32, view<1xf32>
        }
      } else {
        // This branch is operation-for-operation identical to the accepted dual
        // Q8 producer, including its workgroup-to-row map.
        %row = index.assume %wg [range(%wg, 0, 262143)] : index
        %blocks_per_row = index.div %k_bounded, %qk : index
        %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
        %weight_i8_count = index.mul %total_blocks, %block_bytes : index
        %weight_f16_count = index.mul %total_blocks, %block_f16s : index
        %src1_count = index.mul %cols_bounded, %k_bounded : index
        %dst_count = index.mul %cols_bounded, %rows_bounded : index

        %block_lane = index.rem %lane, %eight : index
        %block_slot = index.div %lane, %eight : index
        %in_block_base = index.mul %block_lane, %four : index
        %block_step = index.div %workgroup_size, %eight : index
        %trip_count = index.div %blocks_per_row, %block_step : index

        %gate_f16 = buffer.view %gate_noalias[%base] :
            buffer -> view<[%weight_f16_count]xf16>
        %up_f16 = buffer.view %up_noalias[%base] :
            buffer -> view<[%weight_f16_count]xf16>
        %src1_view = buffer.view %src1_noalias[%base] :
            buffer -> view<[%src1_count]xf32>
        %dst_view = buffer.view %dst_noalias[%base] :
            buffer -> view<[%dst_count]xf32>

        %row_block_base = index.mul %row, %blocks_per_row : index
        %src1_col_base = index.mul %col, %k_bounded : index
        %gate_sum, %up_sum = scf.for
            %iter = [%zero to %trip_count step %one](
                %gate_acc = %zero_f32 : f32,
                %up_acc = %zero_f32 : f32) -> (f32, f32) unroll(%unroll) {
          %iter_step = index.mul %iter, %block_step : index
          %block_raw = index.add %block_slot, %iter_step : index
          %block = index.assume %block_raw [range(%block_raw, 0, 255)] : index
          %src_base_block = index.mul %block, %qk : index
          %src_base = index.add %src_base_block, %in_block_base : index
          %src1_index = index.add %src1_col_base, %src_base : index
          %rhs = vector.load %src1_view[%src1_index] :
              view<[%src1_count]xf32> -> vector<4xf32>

          %linear_block = index.add %row_block_base, %block : index
          %block_byte_base = index.mul %linear_block, %block_bytes : index
          %q_payload = index.add %block_byte_base, %qs_offset : index
          %q_index = index.add %q_payload, %in_block_base : index
          %q_offset = index.cast %q_index : index to offset

          %gate_q_view = buffer.view %gate_noalias[%q_offset] :
              buffer -> view<1xi32>
          %gate_packed = vector.load %gate_q_view[%zero] :
              view<1xi32> -> vector<1xi32>
          %gate_i32 = vector.bitunpacks<8> %gate_packed :
              vector<1xi32> -> vector<4xi32>
          %gate_f32 = vector.sitofp %gate_i32 :
              vector<4xi32> to vector<4xf32>
          %block_f16_base = index.mul %linear_block, %block_f16s : index
          %gate_d_f16 = view.load %gate_f16[%block_f16_base] :
              view<[%weight_f16_count]xf16> -> f16
          %gate_d = scalar.extf %gate_d_f16 : f16 to f32
          %gate_d_vec = vector.splat %gate_d : vector<4xf32>
          %gate_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract>
              %gate_f32, %gate_d_vec : vector<4xf32>
          %gate_next = vector.dotf %gate_scaled, %rhs, %gate_acc :
              vector<4xf32>, vector<4xf32>, f32

          %up_q_view = buffer.view %up_noalias[%q_offset] :
              buffer -> view<1xi32>
          %up_packed = vector.load %up_q_view[%zero] :
              view<1xi32> -> vector<1xi32>
          %up_i32 = vector.bitunpacks<8> %up_packed :
              vector<1xi32> -> vector<4xi32>
          %up_f32 = vector.sitofp %up_i32 :
              vector<4xi32> to vector<4xf32>
          %up_d_f16 = view.load %up_f16[%block_f16_base] :
              view<[%weight_f16_count]xf16> -> f16
          %up_d = scalar.extf %up_d_f16 : f16 to f32
          %up_d_vec = vector.splat %up_d : vector<4xf32>
          %up_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract>
              %up_f32, %up_d_vec : vector<4xf32>
          %up_next = vector.dotf %up_scaled, %rhs, %up_acc :
              vector<4xf32>, vector<4xf32>, f32
          scf.yield %gate_next, %up_next : f32, f32
        }

        %gate_dot = kernel.workgroup.reduce<addf> %gate_sum : f32
        %up_dot = kernel.workgroup.reduce<addf> %up_sum : f32
        %dst_col_base = index.mul %col, %rows_bounded : index
        %dst_index = index.add %dst_col_base, %row : index
        %lane_i32 = index.cast %lane : index to i32
        %zero_i32 = scalar.constant 0 : i32
        %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
        scf.if %is_lane0 {
          %silu = scalar.siluf %gate_dot : f32
          %result =
              scalar.mulf<nnan|ninf|nsz> %silu, %up_dot : f32
          view.store %result, %dst_view[%dst_index] :
              f32, view<[%dst_count]xf32>
        }
      }
  }
  kernel.return
}
