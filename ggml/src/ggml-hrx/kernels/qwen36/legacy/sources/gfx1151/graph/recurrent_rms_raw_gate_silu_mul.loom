// The native RMS owner consumes the graph-backed raw gate and directly emits
// side * SiLU(raw_gate), removing the separate RMS output, SiLU, and MUL passes.
config.decl @hrx2_shape_rms_norm_mul_ncols : %value: index where [range(%value, 1, 65536)]
config.decl @hrx2_shape_rms_norm_mul_nrows : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_tuning_rms_norm_mul_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_tuning_rms_norm_mul_vector_width : %value: index where [range(%value, 1, 16)]

kernel.def export("hrx2_recurrent_rms_raw_gate_silu_mul_f32") @hrx2_recurrent_rms_raw_gate_silu_mul_f32() {
  %unit = index.constant 1 : index
  %nrows = config.get @hrx2_shape_rms_norm_mul_nrows : index
  %workgroup_size = config.get @hrx2_tuning_rms_norm_mul_workgroup_size : index
  kernel.launch.config workgroups(%nrows, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%eps: f32, %src: buffer, %weight: buffer, %raw_gate: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %ncols = config.get @hrx2_shape_rms_norm_mul_ncols : index
  %nrows = config.get @hrx2_shape_rms_norm_mul_nrows : index
  %vector_width = config.get @hrx2_tuning_rms_norm_mul_vector_width : index
  %workgroup_size = config.get @hrx2_tuning_rms_norm_mul_workgroup_size : index
  %ncols_bounded = index.assume %ncols [range(%ncols, 1, 65536)] : index
  %nrows_bounded = index.assume %nrows [range(%nrows, 1, 1048576)] : index
  %vector_width_bounded = index.assume %vector_width [range(%vector_width, 2, 16)] : index
  %logical_cols = index.div %ncols_bounded, %vector_width_bounded : index
  %tail_start = index.mul %logical_cols, %vector_width_bounded : index
  %element_count = index.mul %ncols_bounded, %nrows_bounded : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 1048575)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %src_global = buffer.assume.memory_space<global> %src : buffer
  %weight_global = buffer.assume.memory_space<global> %weight : buffer
  %raw_gate_global = buffer.assume.memory_space<global> %raw_gate : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src_noalias, %weight_noalias, %raw_gate_noalias, %dst_noalias =
      buffer.assume.noalias %src_global, %weight_global, %raw_gate_global,
      %dst_global : buffer, buffer, buffer, buffer
  %src_view = buffer.view %src_noalias[%base] : buffer -> view<[%element_count]xf32>
  %weight_view = buffer.view %weight_noalias[%base] : buffer -> view<[%ncols_bounded]xf32>
  %raw_gate_view = buffer.view %raw_gate_noalias[%base] : buffer -> view<[%element_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%element_count]xf32>
  %row_base = index.mul %row, %ncols_bounded : index

  %sum_vec = scf.for %vcol = [%lane to %logical_cols step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %col0 = index.mul %vcol, %vector_width_bounded : index
    %linear0 = index.add %row_base, %col0 : index
    %linear = index.assume %linear0 [range(%linear0, 0, 67108863)] : index
    %values = vector.load %src_view[%linear] : view<[%element_count]xf32> -> vector<[%vector_width_bounded]xf32>
    %squares = vector.mulf<reassoc|nnan|ninf|nsz> %values, %values : vector<[%vector_width_bounded]xf32>
    %next = vector.reduce<addf, reassoc|nnan|ninf|nsz> %squares, %acc : vector<[%vector_width_bounded]xf32>, f32
    scf.yield %next : f32
  }

  %tail_lane0 = index.add %tail_start, %lane : index
  %sum = scf.for %col = [%tail_lane0 to %ncols_bounded step %workgroup_size](%acc = %sum_vec : f32) -> (f32) {
    %linear0 = index.add %row_base, %col : index
    %linear = index.assume %linear0 [range(%linear0, 0, 67108863)] : index
    %value = view.load %src_view[%linear] : view<[%element_count]xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }

  %row_sum = kernel.workgroup.reduce<addf> %sum : f32
  %ncols_i32 = index.cast %ncols_bounded : index to i32
  %ncols_f32 = scalar.sitofp %ncols_i32 : i32 to f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %row_sum, %ncols_f32 : f32
  %mean_eps = scalar.addf<nnan|ninf|nsz> %mean, %eps : f32
  %scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_eps : f32
  %scale_vector = vector.splat %scale : vector<[%vector_width_bounded]xf32>

  scf.for %vcol = [%lane to %logical_cols step %workgroup_size] {
    %col0 = index.mul %vcol, %vector_width_bounded : index
    %linear0 = index.add %row_base, %col0 : index
    %linear = index.assume %linear0 [range(%linear0, 0, 67108863)] : index
    %values = vector.load %src_view[%linear] : view<[%element_count]xf32> -> vector<[%vector_width_bounded]xf32>
    %weights = vector.load %weight_view[%col0] : view<[%ncols_bounded]xf32> -> vector<[%vector_width_bounded]xf32>
    %normed = vector.mulf<nnan|ninf|nsz> %values, %scale_vector : vector<[%vector_width_bounded]xf32>
    %side = vector.mulf<nnan|ninf|nsz> %normed, %weights : vector<[%vector_width_bounded]xf32>
    %raw_gate_values = vector.load %raw_gate_view[%linear] :
        view<[%element_count]xf32> -> vector<[%vector_width_bounded]xf32>
    %activated = vector.siluf<afn> %raw_gate_values : vector<[%vector_width_bounded]xf32>
    %result = vector.mulf<nnan|ninf|nsz> %side, %activated : vector<[%vector_width_bounded]xf32>
    vector.store %result, %dst_view[%linear] : vector<[%vector_width_bounded]xf32>, view<[%element_count]xf32>
  }

  scf.for %col = [%tail_lane0 to %ncols_bounded step %workgroup_size] {
    %linear0 = index.add %row_base, %col : index
    %linear = index.assume %linear0 [range(%linear0, 0, 67108863)] : index
    %value = view.load %src_view[%linear] : view<[%element_count]xf32> -> f32
    %weight_value = view.load %weight_view[%col] : view<[%ncols_bounded]xf32> -> f32
    %normed = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
    %side = scalar.mulf<nnan|ninf|nsz> %normed, %weight_value : f32
    %raw_gate_value = view.load %raw_gate_view[%linear] :
        view<[%element_count]xf32> -> f32
    %activated = scalar.siluf<afn> %raw_gate_value : f32
    %result = scalar.mulf<nnan|ninf|nsz> %side, %activated : f32
    view.store %result, %dst_view[%linear] : f32, view<[%element_count]xf32>
  }
  kernel.return
}
