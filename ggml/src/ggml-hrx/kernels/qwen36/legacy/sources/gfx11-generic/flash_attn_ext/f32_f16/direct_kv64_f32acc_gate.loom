  %fifteen = index.constant 15 : index
  %sixteen = index.constant 16 : index
  %twofiftysix = index.constant 256 : index
  %padded_query_token_count = index.add %query_token_count, %fifteen : index
  %query_tile_count = index.div %padded_query_token_count, %sixteen : index
  %bounded_query_head_count = index.assume %query_head_count [range(%query_head_count, 1, 64)] : index
  kernel.launch.config workgroups(%query_tile_count, %bounded_query_head_count, %one) workgroup_size(%twofiftysix, %one, %one) : index
