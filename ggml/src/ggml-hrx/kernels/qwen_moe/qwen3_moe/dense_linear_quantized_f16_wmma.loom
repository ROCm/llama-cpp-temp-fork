kernel.def export("hrx2_mul_mat_q8_0_f32_wmmai8_gdn_rms_side_epilogue") @hrx2_mul_mat_q8_0_f32_wmmai8_gdn_rms_side_epilogue() {
  %unit = index.constant 1 : index
