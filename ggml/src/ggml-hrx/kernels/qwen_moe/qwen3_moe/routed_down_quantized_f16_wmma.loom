      %rd_p1_g3_own_shift = vector.shrui %rd_p1_pack1, %four_i32v4 : vector<4xi32>
      %rd_p1_g3_own_nib = vector.andi %rd_p1_g3_own_shift, %nibble_mask_v4 : vector<4xi32>
