// ============================================================================
// Qwen3.6 compile-time-specialized roots in this native semantic family
// ============================================================================

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/graph/attention_qkv_direct_v_cache_decode.loom
// ----------------------------------------------------------------------------
// Token-one Q/K/V Q8 projection co-dispatch with a direct V-cache epilogue.
//
// Each grid chunk owns 256 consecutive Q rows, then 16 consecutive K rows,
// then 16 consecutive V rows. Catalog predicates prove the 16:1:1 shape
// relationship, so the mapping is a bijection. Every row retains the accepted
// K=2048/WG=256 two-trip arithmetic and reduction order. V lane 0 performs the
// same f32-to-f16 conversion and indexed row store as SET_ROWS.
config.decl @hrx2_shape_attention_qkv_k : %value: index where [range(%value, 2048, 2048), mul(%value, 32)]
config.decl @hrx2_shape_attention_q_rows : %value: index where [range(%value, 256, 262144), mul(%value, 256)]
config.decl @hrx2_shape_attention_k_rows : %value: index where [range(%value, 16, 16384), mul(%value, 16)]
config.decl @hrx2_shape_attention_v_rows : %value: index where [range(%value, 16, 16384), mul(%value, 16)]
config.decl @hrx2_shape_attention_v_cache_rows : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_attention_v_cache_stride1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @hrx2_shape_attention_v_cache_elements : %value: index where [range(%value, 1, 1073741824)]

kernel.def export("hrx2_attention_qkv_direct_v_cache_decode") @hrx2_attention_qkv_direct_v_cache_decode() {
  %one = index.constant 1 : index
  %q_rows = config.get @hrx2_shape_attention_q_rows : index
  %k_rows = config.get @hrx2_shape_attention_k_rows : index
  %v_rows = config.get @hrx2_shape_attention_v_rows : index
  %qk_workgroups = index.add %q_rows, %k_rows : index
  %workgroups = index.add %qk_workgroups, %v_rows : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroups, %one, %one)
      workgroup_size(%workgroup_size, %one, %one) : index
} launch(%q_weight: buffer, %k_weight: buffer, %v_weight: buffer,
         %input: buffer, %input_hi: buffer, %v_index: buffer,
         %q_dst: buffer, %k_dst: buffer, %v_cache: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %qk = index.constant 32 : index
  %block_bytes = index.constant 34 : index
  %block_f16s = index.constant 17 : index
  %qs_offset = index.constant 2 : index
  %k0 = config.get @hrx2_shape_attention_qkv_k : index
  %q_rows0 = config.get @hrx2_shape_attention_q_rows : index
  %k_rows0 = config.get @hrx2_shape_attention_k_rows : index
  %v_rows0 = config.get @hrx2_shape_attention_v_rows : index
  %v_cache_rows = config.get @hrx2_shape_attention_v_cache_rows : index
  %v_cache_stride1 = config.get @hrx2_shape_attention_v_cache_stride1 : index
  %v_cache_elements0 = config.get @hrx2_shape_attention_v_cache_elements : index
  %k_bounded = index.assume %k0 [range(%k0, 2048, 2048)] : index
  %q_rows = index.assume %q_rows0 [range(%q_rows0, 256, 262144)] : index
  %k_rows = index.assume %k_rows0 [range(%k_rows0, 16, 16384)] : index
  %v_rows = index.assume %v_rows0 [range(%v_rows0, 16, 16384)] : index
  %v_cache_elements = index.assume %v_cache_elements0 [range(%v_cache_elements0, 1, 1073741824)] : index
  %cols_bounded = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %chunk_workgroups = index.constant 288 : index
  %q_rows_per_chunk = index.constant 256 : index
  %k_end = index.constant 272 : index
  %kv_rows_per_chunk = index.constant 16 : index
  %total0 = index.add %q_rows, %k_rows : index
  %total_workgroups = index.add %total0, %v_rows : index
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 294911)] : index
  %chunk = index.div %workgroup, %chunk_workgroups : index
  %slot = index.rem %workgroup, %chunk_workgroups : index
  %is_q = index.cmp ult, %slot, %q_rows_per_chunk : index
  %before_k_end = index.cmp ult, %slot, %k_end : index
  %not_q = index.cmp uge, %slot, %q_rows_per_chunk : index
  %is_k = scalar.andi %not_q, %before_k_end : i1
  %q_slot0 = index.rem %slot, %q_rows_per_chunk : index
  %q_slot = index.assume %q_slot0 [range(%q_slot0, 0, 255)] : index
  %kv_slot0 = index.rem %slot, %kv_rows_per_chunk : index
  %kv_slot = index.assume %kv_slot0 [range(%kv_slot0, 0, 15)] : index
  %q_chunk_base = index.mul %chunk, %q_rows_per_chunk : index
  %kv_chunk_base = index.mul %chunk, %kv_rows_per_chunk : index
  %q_row0 = index.add %q_chunk_base, %q_slot : index
  %k_row0 = index.add %kv_chunk_base, %kv_slot : index
  %v_row0 = index.add %kv_chunk_base, %kv_slot : index
  %q_row = index.assume %q_row0 [range(%q_row0, 0, 262143)] : index
  %k_row = index.assume %k_row0 [range(%k_row0, 0, 16383)] : index
  %v_row = index.assume %v_row0 [range(%v_row0, 0, 16383)] : index
  %kv_row = scf.select %is_k, %k_row, %v_row : index
  %row = scf.select %is_q, %q_row, %kv_row : index
  %kv_rows = scf.select %is_k, %k_rows, %v_rows : index
  %rows0 = scf.select %is_q, %q_rows, %kv_rows : index
  %rows_bounded = index.assume %rows0 [range(%rows0, 16, 262144)] : index
  %col = index.constant 0 : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %q_weight_global = buffer.assume.memory_space<global> %q_weight : buffer
  %k_weight_global = buffer.assume.memory_space<global> %k_weight : buffer
  %v_weight_global = buffer.assume.memory_space<global> %v_weight : buffer
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_hi_global = buffer.assume.memory_space<global> %input_hi : buffer
  %v_index_global = buffer.assume.memory_space<global> %v_index : buffer
  %q_dst_global = buffer.assume.memory_space<global> %q_dst : buffer
  %k_dst_global = buffer.assume.memory_space<global> %k_dst : buffer
  %v_cache_global = buffer.assume.memory_space<global> %v_cache : buffer
  %q_weight_noalias, %k_weight_noalias, %v_weight_noalias, %input_noalias,
      %v_index_noalias, %q_dst_noalias, %k_dst_noalias, %v_cache_noalias =
      buffer.assume.noalias
      %q_weight_global, %k_weight_global, %v_weight_global, %input_global,
      %v_index_global, %q_dst_global, %k_dst_global, %v_cache_global :
      buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %input_hi_same = buffer.assume.same_root %input_hi_global, %input_noalias : buffer
  %v_index_view = buffer.view %v_index_noalias[%base] : buffer -> view<2xi32>
  %q_dst_view = buffer.view %q_dst_noalias[%base] : buffer -> view<[%q_rows]xf32>
  %k_dst_view = buffer.view %k_dst_noalias[%base] : buffer -> view<[%k_rows]xf32>
  %v_cache_view = buffer.view %v_cache_noalias[%base] : buffer -> view<[%v_cache_elements]xi16>
  %kv_weight = scf.select %is_k, %k_weight_noalias, %v_weight_noalias : buffer
  %weight_selected = scf.select %is_q, %q_weight_noalias, %kv_weight : buffer

  %blocks_per_row = index.div %k_bounded, %qk : index
  %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
  %src0_i8_count = index.mul %total_blocks, %block_bytes : index
  %src0_f16_count = index.mul %total_blocks, %block_f16s : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %block_lane = index.rem %lane, %eight : index
  %block_slot = index.div %lane, %eight : index
  %in_block_base = index.mul %block_lane, %four : index
  %block_step = index.div %workgroup_size, %eight : index
  %block_idx0 = index.assume %block_slot [range(%block_slot, 0, 31)] : index
  %block_idx1_raw = index.add %block_slot, %block_step : index
  %block_idx1 = index.assume %block_idx1_raw [range(%block_idx1_raw, 32, 63)] : index
  %src0_f16_view = buffer.view %weight_selected[%base] : buffer -> view<[%src0_f16_count]xf16>
  %src1_view = buffer.view %input_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %src1_hi_view = buffer.view %input_hi_same[%base] : buffer -> view<[%src1_count]xf32>
  %row_block_base = index.mul %row, %blocks_per_row : index

  %src_base_block0 = index.mul %block_idx0, %qk : index
  %src_base0 = index.add %src_base_block0, %in_block_base : index
  %linear_block0 = index.add %row_block_base, %block_idx0 : index
  %block_byte_base0 = index.mul %linear_block0, %block_bytes : index
  %q_byte_payload0 = index.add %block_byte_base0, %qs_offset : index
  %q_byte0 = index.add %q_byte_payload0, %in_block_base : index
  %q_byte_offset0 = index.cast %q_byte0 : index to offset
  %q_word_view0 = buffer.view %weight_selected[%q_byte_offset0] : buffer -> view<1xi32>
  %q_packed0 = vector.load %q_word_view0[%zero_index] : view<1xi32> -> vector<1xi32>
  %q_i320 = vector.bitunpacks<8> %q_packed0 : vector<1xi32> -> vector<4xi32>
  %q_f320 = vector.sitofp %q_i320 : vector<4xi32> to vector<4xf32>
  %rhs0 = vector.load %src1_view[%src_base0] : view<[%src1_count]xf32> -> vector<4xf32>
  %block_f16_base0 = index.mul %linear_block0, %block_f16s : index
  %d_f160 = view.load %src0_f16_view[%block_f16_base0] : view<[%src0_f16_count]xf16> -> f16
  %d0 = scalar.extf %d_f160 : f16 to f32
  %d_vec0 = vector.splat %d0 : vector<4xf32>
  %q_scaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %q_f320, %d_vec0 : vector<4xf32>
  %sum0 = vector.dotf %q_scaled0, %rhs0, %zero_f32 : vector<4xf32>, vector<4xf32>, f32

  %src_base_block1 = index.mul %block_idx1, %qk : index
  %src_base1 = index.add %src_base_block1, %in_block_base : index
  %linear_block1 = index.add %row_block_base, %block_idx1 : index
  %block_byte_base1 = index.mul %linear_block1, %block_bytes : index
  %q_byte_payload1 = index.add %block_byte_base1, %qs_offset : index
  %q_byte1 = index.add %q_byte_payload1, %in_block_base : index
  %q_byte_offset1 = index.cast %q_byte1 : index to offset
  %q_word_view1 = buffer.view %weight_selected[%q_byte_offset1] : buffer -> view<1xi32>
  %q_packed1 = vector.load %q_word_view1[%zero_index] : view<1xi32> -> vector<1xi32>
  %q_i321 = vector.bitunpacks<8> %q_packed1 : vector<1xi32> -> vector<4xi32>
  %q_f321 = vector.sitofp %q_i321 : vector<4xi32> to vector<4xf32>
  %rhs1 = vector.load %src1_hi_view[%src_base1] : view<[%src1_count]xf32> -> vector<4xf32>
  %block_f16_base1 = index.mul %linear_block1, %block_f16s : index
  %d_f161 = view.load %src0_f16_view[%block_f16_base1] : view<[%src0_f16_count]xf16> -> f16
  %d1 = scalar.extf %d_f161 : f16 to f32
  %d_vec1 = vector.splat %d1 : vector<4xf32>
  %q_scaled1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %q_f321, %d_vec1 : vector<4xf32>
  %sum = vector.dotf %q_scaled1, %rhs1, %sum0 : vector<4xf32>, vector<4xf32>, f32

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %lane_i32 = index.cast %lane : index to i32
  %zero_i32 = scalar.constant 0 : i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    scf.if %is_q {
      view.store %dot, %q_dst_view[%q_row] : f32, view<[%q_rows]xf32>
    } else {
      scf.if %is_k {
        view.store %dot, %k_dst_view[%k_row] : f32, view<[%k_rows]xf32>
      } else {
        %cache_row_i32 = view.load %v_index_view[%zero_index] : view<2xi32> -> i32
        %cache_row = index.cast %cache_row_i32 : i32 to index
        %cache_row_in_bounds = index.cmp ult, %cache_row, %v_cache_rows : index
        scf.if %cache_row_in_bounds {
          %cache_row_base0 = index.mul %cache_row, %v_cache_stride1 : index
          %cache_row_base = index.assume %cache_row_base0 [range(%cache_row_base0, 0, 1073741823)] : index
          %cache_index0 = index.add %cache_row_base, %v_row : index
          %cache_index_in_bounds = index.cmp ult, %cache_index0, %v_cache_elements : index
          scf.if %cache_index_in_bounds {
            %cache_index = index.assume %cache_index0 [range(%cache_index0, 0, 1073741823)] : index
            %half = scalar.fptrunc %dot : f32 to f16
            %half_bits = scalar.bitcast %half : f16 to i16
            view.store %half_bits, %v_cache_view[%cache_index] : i16, view<[%v_cache_elements]xi16>
          }
        }
      }
    }
  }
  kernel.return
}
