// Token-one direct-cache Gated DeltaNet specialization with compact q/k scales.
// One read-only binding carries interleaved q/k reciprocal norms; downstream
// arithmetic is unchanged. This kernel applies only when
// hrx2_shape_gdn_n_tokens=1.
//
// The seven-buffer ABI is
//   q,k,v,g,beta,state_io,attn_dst
// All 524,288 old state elements are
// loaded into disjoint workgroup-owned register shards before the first direct
// state_io store. This removes the 2 MiB GET_ROWS and 2 MiB state-write CONT
// passes on the exact decode shape; PP is intentionally out of scope.
//
// Chunked Gated DeltaNet (linear attention) scan -- matrix-core path.
//
// One workgroup owns one (head, sequence) and 32 of the 128 state columns as
// 2 waves of 16. The state shard lives in registers -- 64 f32 per
// lane, lane L holding rows 4L..4L+3 of every column, so it loads and stores
// one f32x4 per column -- and is staged to LDS as f16 once per 16-token chunk.
//
// Per chunk a wave issues 8 WMMA for A = S^T K, 8 for B = S^T Q, 8 for the
// state update and 8 for its half of the shared G = K^T K / QK = K^T Q, then
// runs 16 scalar steps with no cross-lane traffic. The shipped scan runs two
// wave reductions per token.
//
// LDS 31808 B per workgroup, so two workgroups per CU.

config.decl @hrx2_shape_gdn_s_v : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_shape_gdn_n_heads : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_shape_gdn_n_tokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_gdn_n_seqs : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_shape_gdn_sq1 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sq2 : %value: index where [range(%value, 0, 1073741823), mul(%value, 8)]
config.decl @hrx2_shape_gdn_sq3 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sv1 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sv2 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sv3 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sb1 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sb2 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_sb3 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_gdn_neqk1 : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_shape_gdn_rq3 : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_tuning_gdn_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

kernel.def export("hrx2_gated_delta_net_f32_sv128_state_cache_decode_token1_signedpad_qk_scaled") @hrx2_gated_delta_net_f32_sv128_state_cache_decode_token1_signedpad_qk_scaled() {
  %unit = index.constant 1 : index
  %wg = index.constant 64 : index
  %blk = index.constant 32 : index
  %blk_m = index.constant 31 : index
  %s_v = config.get @hrx2_shape_gdn_s_v : index
  %n_heads = config.get @hrx2_shape_gdn_n_heads : index
  %n_seqs = config.get @hrx2_shape_gdn_n_seqs : index
  %cr = index.add %s_v, %blk_m : index
  %col_blocks = index.div %cr, %blk : index
  kernel.launch.config workgroups(%n_heads, %n_seqs, %col_blocks) workgroup_size(%wg, %unit, %unit) : index
} launch(%scale: f32, %q: buffer, %k: buffer, %v: buffer, %g: buffer, %beta: buffer, %state_io: buffer, %qk_scales: buffer, %attn_dst: buffer) {
