      %source_index0 = index.madd %source_row_b, %c256, %source_feature : index
      %source_index = index.assume %source_index0 [range(%source_index0, 0, 2047)] : index
      %x = view.load %history_v[%source_index] : view<2048xf32, #dense> -> f32
      scf.yield %x : f32
    } else {
      %x = scf.if %is_projection -> (f32) {
        %projection_row = index.sub %source_row_b, %c8 : index
        %projection_index0 = index.madd %projection_row, %c256, %source_feature : index
