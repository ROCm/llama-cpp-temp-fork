// Decode specialization for the [2048,256] x [2048,1] router.
// Eight adjacent F32 elements are loaded per lane; weights and storage remain
// unchanged. The exact production shape has no vector tail.
config.decl @hrx2_shape_k : %value: index where [range(%value, 2048, 2048), mul(%value, 2048)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 256, 256), mul(%value, 256)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 1), mul(%value, 1)]

kernel.def export("hrx2_mul_mat_f32_f32_decode_vec8") @hrx2_mul_mat_f32_f32_decode_vec8() {
  %unit = index.constant 1 : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %cols, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %eight = index.constant 8 : index
  %workgroup_size = index.constant 256 : index

  %k = config.get @hrx2_shape_k : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %k_bounded = index.assume %k [range(%k, 2048, 2048), mul(%k, 2048)] : index
  %rows_bounded = index.assume %rows [range(%rows, 256, 256), mul(%rows, 256)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 1), mul(%cols, 1)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 255)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 0)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %src0_count = index.mul %rows_bounded, %k_bounded : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %dst_count = index.mul %cols_bounded, %rows_bounded : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_count]xf32>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32>

  %src0_row_base = index.mul %row, %k_bounded : index
  %src1_col_base = index.mul %col, %k_bounded : index
  %lane_base = index.mul %lane, %eight : index
  %step = index.mul %workgroup_size, %eight : index
  %sum = scf.for %i = [%lane_base to %k_bounded step %step](%acc = %zero_f32 : f32) -> (f32) {
    %src0_index = index.add %src0_row_base, %i : index
    %src1_index = index.add %src1_col_base, %i : index
    %src0_index_bounded = index.assume %src0_index [range(%src0_index, 0, 524280)] : index
    %src1_index_bounded = index.assume %src1_index [range(%src1_index, 0, 2040)] : index
    %a = vector.load %src0_view[%src0_index_bounded] : view<[%src0_count]xf32> -> vector<8xf32>
    %b = vector.load %src1_view[%src1_index_bounded] : view<[%src1_count]xf32> -> vector<8xf32>
    %next = vector.dotf %a, %b, %acc : vector<8xf32>, vector<8xf32>, f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %sum : f32

  %dst_col_base = index.mul %col, %rows_bounded : index
  %dst_index = index.add %dst_col_base, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32>
  }
  kernel.return
}
