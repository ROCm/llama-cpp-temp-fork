  %row_sum = kernel.workgroup.reduce<addf> %sum : f32
  %c512_i32 = scalar.constant 512 : i32
  %c512_f32 = scalar.sitofp %c512_i32 : i32 to f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %row_sum, %c512_f32 : f32
  %biased = scalar.addf<nnan|ninf|nsz> %mean, %eps : f32
  %rms_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased : f32

  %cache_word = index.mul %row, %two : index
  %cache_row_i32 = view.load %cache_indices_v[%cache_word] : view<256xi32, #dense> -> i32
