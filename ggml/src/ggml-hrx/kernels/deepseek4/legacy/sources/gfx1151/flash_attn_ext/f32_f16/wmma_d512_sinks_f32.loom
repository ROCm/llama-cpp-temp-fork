// Flash attention for d=512 with matrix-core scores and output.
//
// Four waves cooperate on one 16-query tile. Each wave contributes a d=128
// quarter to Q*K^T. K and V are read directly for the matrix fragments.
// Shared Q, score/probability, and softmax state use 21440 B of LDS.

config.decl @hrx2_shape_fa_d : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_shape_fa_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_fa_nheads : %value: index where [range(%value, 1, 1024)]
