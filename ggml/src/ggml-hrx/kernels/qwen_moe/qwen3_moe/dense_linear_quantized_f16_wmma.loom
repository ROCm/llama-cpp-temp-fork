      %bounded_output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%output_token_count]x[%bounded_output_size]xf32>
      %values = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf16> -> vector<4xf16>
      %wide = vector.extf %values : vector<4xf16> to vector<4xf32>
