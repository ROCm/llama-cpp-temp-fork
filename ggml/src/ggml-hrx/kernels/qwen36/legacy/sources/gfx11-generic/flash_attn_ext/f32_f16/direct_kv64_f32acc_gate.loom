    %probability2 = vector.extract %probability_f16[2] : vector<4xf16> -> f16
    %probability3 = vector.extract %probability_f16[3] : vector<4xf16> -> f16
    view.store %probability0, %probability_stage_view[%query_row0, %lane] : f16, view<16x64xf16, %probability_transposed_layout>
    view.store %probability1, %probability_stage_view[%query_row1, %lane] : f16, view<16x64xf16, %probability_transposed_layout>
    view.store %probability2, %probability_stage_view[%query_row2, %lane] : f16, view<16x64xf16, %probability_transposed_layout>
    view.store %probability3, %probability_stage_view[%query_row3, %lane] : f16, view<16x64xf16, %probability_transposed_layout>
    // A result WMMA fragment owns rows {lane/16 + 4*i}.  The online-softmax
    // scale is row-owned instead, four consecutive rows per wave.  Publish
    // the 16 row scales into the unused score padding column; the existing
    // probability barrier is also the cross-wave scale-exchange barrier.
    %scale_publisher = index.cmp eq, %lane, %zero : index
    scf.if %scale_publisher {
      %published_scale0 = vector.extract %old_scale[0] : vector<4xf32> -> f32
      %published_scale1 = vector.extract %old_scale[1] : vector<4xf32> -> f32
      %published_scale2 = vector.extract %old_scale[2] : vector<4xf32> -> f32
      %published_scale3 = vector.extract %old_scale[3] : vector<4xf32> -> f32
      view.store %published_scale0, %score_stage_view[%query_row0, %sixteen] : f32, view<64x24xf32>
      view.store %published_scale1, %score_stage_view[%query_row1, %sixteen] : f32, view<64x24xf32>
      view.store %published_scale2, %score_stage_view[%query_row2, %sixteen] : f32, view<64x24xf32>
      view.store %published_scale3, %score_stage_view[%query_row3, %sixteen] : f32, view<64x24xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Keep each output tile in the native WMMA result ownership across KV
    // blocks.  This removes the product LDS transpose and its two workgroup
    // barriers from every output tile of every KV64 iteration.
    %fragment_scale_row0 = index.add %lane_output_tile, %zero : index
    %fragment_scale_row1 = index.add %lane_output_tile, %four : index
    %fragment_scale_row2 = index.add %fragment_scale_row1, %four : index
    %fragment_scale_row3 = index.add %fragment_scale_row2, %four : index
    %fragment_scale0 = view.load %score_stage_view[%fragment_scale_row0, %sixteen] : view<64x24xf32> -> f32
    %fragment_scale1 = view.load %score_stage_view[%fragment_scale_row1, %sixteen] : view<64x24xf32> -> f32
    %fragment_scale2 = view.load %score_stage_view[%fragment_scale_row2, %sixteen] : view<64x24xf32> -> f32
    %fragment_scale3 = view.load %score_stage_view[%fragment_scale_row3, %sixteen] : view<64x24xf32> -> f32
    %fragment_scale = vector.from_elements %fragment_scale0, %fragment_scale1, %fragment_scale2, %fragment_scale3 : vector<4xf32>
    %scaled_current_output0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output0, %fragment_scale : vector<4xf32>
    %scaled_current_output1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output1, %fragment_scale : vector<4xf32>
    %scaled_current_output2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output2, %fragment_scale : vector<4xf32>
    %scaled_current_output3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output3, %fragment_scale : vector<4xf32>
    %next_output0, %next_output1, %next_output2, %next_output3 = scf.for %output_tile = [%zero to %four step %one](%tile_output0 = %scaled_current_output0 : vector<4xf32>, %tile_output1 = %scaled_current_output1 : vector<4xf32>, %tile_output2 = %scaled_current_output2 : vector<4xf32>, %tile_output3 = %scaled_current_output3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) unroll {
      %output_tile_channel = index.mul %output_tile, %sixtyfour : index
      %value_channel0 = index.add %key_value_head_base, %output_tile_channel : index
      %value_channel = index.add %value_channel0, %subgroup_product_channel : index
      %product_init = vector.fragment<init> %zero_product_f32x4 shape [%m, %n] : vector<4xf32>
      %product_fragment = scf.for %key_tile = [%zero to %sixtyfour step %sixteen](%product_accumulator = %product_init : vector<4xf32>) -> (vector<4xf32>) unroll schedule(recurrence) {
        %value_token0 = index.add %key_origin, %key_tile : index
        %value_token = index.assume %value_token0 [lt(%value_token0, %last_full_key_tile_start)] : index
        %probability_fragment = vector.fragment.load<lhs> %probability_stage_view[%zero, %key_tile] shape [%m, %k] : view<16x64xf16, %probability_transposed_layout> -> vector<16xf16>
        %value_fragment = vector.fragment.load<rhs> %value_view[%value_token, %value_channel] shape [%k, %n] : view<[%bounded_key_value_token_count]x[%key_value_width]xf16> -> vector<16xf16>
        %next_product_accumulator = vector.mma %probability_fragment, %value_fragment, %product_accumulator : vector<16xf16>, vector<16xf16>, vector<4xf32>
        scf.yield %next_product_accumulator : vector<4xf32>
      }
      %is_output_tile0 = index.cmp eq, %output_tile, %zero : index
      %updated_output0 = scf.if %is_output_tile0 -> (vector<4xf32>) {
        %sum = vector.addf<reassoc|nnan|ninf|nsz> %tile_output0, %product_fragment : vector<4xf32>
        scf.yield %sum : vector<4xf32>
      } else {
        scf.yield %tile_output0 : vector<4xf32>
      }
      %is_output_tile1 = index.cmp eq, %output_tile, %one : index
      %updated_output1 = scf.if %is_output_tile1 -> (vector<4xf32>) {
        %sum = vector.addf<reassoc|nnan|ninf|nsz> %tile_output1, %product_fragment : vector<4xf32>
        scf.yield %sum : vector<4xf32>
      } else {
        scf.yield %tile_output1 : vector<4xf32>
      }
      %is_output_tile2 = index.cmp eq, %output_tile, %two : index
      %updated_output2 = scf.if %is_output_tile2 -> (vector<4xf32>) {
        %sum = vector.addf<reassoc|nnan|ninf|nsz> %tile_output2, %product_fragment : vector<4xf32>
        scf.yield %sum : vector<4xf32>
      } else {
        scf.yield %tile_output2 : vector<4xf32>
      }
      %is_output_tile3 = index.cmp eq, %output_tile, %three : index
      %updated_output3 = scf.if %is_output_tile3 -> (vector<4xf32>) {
        %sum = vector.addf<reassoc|nnan|ninf|nsz> %tile_output3, %product_fragment : vector<4xf32>
        scf.yield %sum : vector<4xf32>
      } else {
        scf.yield %tile_output3 : vector<4xf32>
      }
      scf.yield %updated_output0, %updated_output1, %updated_output2, %updated_output3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
      scf.yield %next_max, %next_sum, %next_output0, %next_output1, %next_output2, %next_output3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    } else {
      scf.yield %current_max, %current_sum, %current_output0, %current_output1, %current_output2, %current_output3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    scf.yield %block_max_state, %block_sum_state, %block_output0, %block_output1, %block_output2, %block_output3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  // Transpose the four completed WMMA result fragments only once, after the
  // full KV loop.  The accepted kernel performed this exchange once per
  // output tile per KV64 block.
  scf.for %final_output_tile = [%zero to %four step %one] unroll {
    %final_is_tile0 = index.cmp eq, %final_output_tile, %zero : index
    %final_fragment = scf.if %final_is_tile0 -> (vector<4xf32>) {
      scf.yield %full_output0 : vector<4xf32>
    } else {
      %final_is_tile1 = index.cmp eq, %final_output_tile, %one : index
      %final_fragment_not0 = scf.if %final_is_tile1 -> (vector<4xf32>) {
        scf.yield %full_output1 : vector<4xf32>
      } else {
        %final_is_tile2 = index.cmp eq, %final_output_tile, %two : index
        %final_fragment_not01 = scf.if %final_is_tile2 -> (vector<4xf32>) {
          scf.yield %full_output2 : vector<4xf32>
        } else {
          scf.yield %full_output3 : vector<4xf32>
        }
        scf.yield %final_fragment_not01 : vector<4xf32>
      }
      scf.yield %final_fragment_not0 : vector<4xf32>
    }
    vector.fragment.store<result> %final_fragment, %product_stage_view[%zero, %subgroup_product_channel] shape [%m, %n] : vector<4xf32>, view<16x64xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %owns_final_output_tile = index.cmp eq, %lane_output_tile, %final_output_tile : index
    scf.if %owns_final_output_tile {
      %final_row_output0 = vector.load %product_stage_view[%query_row0, %lane_product_channel] : view<16x64xf32> -> vector<4xf32>
      %final_row_output1 = vector.load %product_stage_view[%query_row1, %lane_product_channel] : view<16x64xf32> -> vector<4xf32>
      %final_row_output2 = vector.load %product_stage_view[%query_row2, %lane_product_channel] : view<16x64xf32> -> vector<4xf32>
      %final_row_output3 = vector.load %product_stage_view[%query_row3, %lane_product_channel] : view<16x64xf32> -> vector<4xf32>
      scf.if %lane_has_output {
        %sum0_scalar = vector.extract %full_sum[0] : vector<4xf32> -> f32
        %sum1_scalar = vector.extract %full_sum[1] : vector<4xf32> -> f32
        %sum2_scalar = vector.extract %full_sum[2] : vector<4xf32> -> f32
        %sum3_scalar = vector.extract %full_sum[3] : vector<4xf32> -> f32
        %inverse_sum0_f32 = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %sum0_scalar : f32
        %inverse_sum1_f32 = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %sum1_scalar : f32
        %inverse_sum2_f32 = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %sum2_scalar : f32
        %inverse_sum3_f32 = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %sum3_scalar : f32
        %inverse_sum0 = vector.splat %inverse_sum0_f32 : vector<4xf32>
        %inverse_sum1 = vector.splat %inverse_sum1_f32 : vector<4xf32>
        %inverse_sum2 = vector.splat %inverse_sum2_f32 : vector<4xf32>
        %inverse_sum3 = vector.splat %inverse_sum3_f32 : vector<4xf32>
        %normalized0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %final_row_output0, %inverse_sum0 : vector<4xf32>
        %normalized1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %final_row_output1, %inverse_sum1 : vector<4xf32>
        %normalized2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %final_row_output2, %inverse_sum2 : vector<4xf32>
        %normalized3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %final_row_output3, %inverse_sum3 : vector<4xf32>
        scf.if %query_valid0 {
          %out_token_offset0 = index.mul %query_token0, %out_stride_token : index
          %out_head_offset0 = index.mul %query_head, %out_stride_head : index
          %out_head_base0 = index.add %out_token_offset0, %out_head_offset0 : index
          %out_index0_0 = index.add %out_head_base0, %lane_output_channel : index
          %out_index0 = index.assume %out_index0_0 [range(%out_index0_0, 0, 268435452)] : index
          %gate_token_offset0 = index.mul %query_token0, %gate_stride_token : index
          %gate_head_offset0 = index.mul %query_head, %gate_stride_head : index
          %gate_head_base0 = index.add %gate_token_offset0, %gate_head_offset0 : index
          %gate_index0_0 = index.add %gate_head_base0, %lane_output_channel : index
          %gate_index0 = index.assume %gate_index0_0 [range(%gate_index0_0, 0, 268435452)] : index
          %raw_gate0 = vector.load %gate_view[%gate_index0] : view<268435456xf32> -> vector<4xf32>
          %sigmoid_gate0 = vector.logisticf<afn> %raw_gate0 : vector<4xf32>
          %gated_output0 = vector.mulf<nnan|ninf|nsz> %normalized0, %sigmoid_gate0 : vector<4xf32>
          vector.store %gated_output0, %output_view[%out_index0] : vector<4xf32>, view<268435456xf32>
        }
        scf.if %query_valid1 {
          %out_token_offset1 = index.mul %query_token1, %out_stride_token : index
          %out_head_offset1 = index.mul %query_head, %out_stride_head : index
          %out_head_base1 = index.add %out_token_offset1, %out_head_offset1 : index
          %out_index1_0 = index.add %out_head_base1, %lane_output_channel : index
          %out_index1 = index.assume %out_index1_0 [range(%out_index1_0, 0, 268435452)] : index
          %gate_token_offset1 = index.mul %query_token1, %gate_stride_token : index
          %gate_head_offset1 = index.mul %query_head, %gate_stride_head : index
          %gate_head_base1 = index.add %gate_token_offset1, %gate_head_offset1 : index
          %gate_index1_0 = index.add %gate_head_base1, %lane_output_channel : index
          %gate_index1 = index.assume %gate_index1_0 [range(%gate_index1_0, 0, 268435452)] : index
          %raw_gate1 = vector.load %gate_view[%gate_index1] : view<268435456xf32> -> vector<4xf32>
          %sigmoid_gate1 = vector.logisticf<afn> %raw_gate1 : vector<4xf32>
          %gated_output1 = vector.mulf<nnan|ninf|nsz> %normalized1, %sigmoid_gate1 : vector<4xf32>
          vector.store %gated_output1, %output_view[%out_index1] : vector<4xf32>, view<268435456xf32>
        }
        scf.if %query_valid2 {
          %out_token_offset2 = index.mul %query_token2, %out_stride_token : index
          %out_head_offset2 = index.mul %query_head, %out_stride_head : index
          %out_head_base2 = index.add %out_token_offset2, %out_head_offset2 : index
          %out_index2_0 = index.add %out_head_base2, %lane_output_channel : index
          %out_index2 = index.assume %out_index2_0 [range(%out_index2_0, 0, 268435452)] : index
          %gate_token_offset2 = index.mul %query_token2, %gate_stride_token : index
          %gate_head_offset2 = index.mul %query_head, %gate_stride_head : index
          %gate_head_base2 = index.add %gate_token_offset2, %gate_head_offset2 : index
          %gate_index2_0 = index.add %gate_head_base2, %lane_output_channel : index
          %gate_index2 = index.assume %gate_index2_0 [range(%gate_index2_0, 0, 268435452)] : index
          %raw_gate2 = vector.load %gate_view[%gate_index2] : view<268435456xf32> -> vector<4xf32>
          %sigmoid_gate2 = vector.logisticf<afn> %raw_gate2 : vector<4xf32>
          %gated_output2 = vector.mulf<nnan|ninf|nsz> %normalized2, %sigmoid_gate2 : vector<4xf32>
          vector.store %gated_output2, %output_view[%out_index2] : vector<4xf32>, view<268435456xf32>
        }
        scf.if %query_valid3 {
          %out_token_offset3 = index.mul %query_token3, %out_stride_token : index
          %out_head_offset3 = index.mul %query_head, %out_stride_head : index
          %out_head_base3 = index.add %out_token_offset3, %out_head_offset3 : index
          %out_index3_0 = index.add %out_head_base3, %lane_output_channel : index
          %out_index3 = index.assume %out_index3_0 [range(%out_index3_0, 0, 268435452)] : index
          %gate_token_offset3 = index.mul %query_token3, %gate_stride_token : index
          %gate_head_offset3 = index.mul %query_head, %gate_stride_head : index
          %gate_head_base3 = index.add %gate_token_offset3, %gate_head_offset3 : index
          %gate_index3_0 = index.add %gate_head_base3, %lane_output_channel : index
          %gate_index3 = index.assume %gate_index3_0 [range(%gate_index3_0, 0, 268435452)] : index
          %raw_gate3 = vector.load %gate_view[%gate_index3] : view<268435456xf32> -> vector<4xf32>
          %sigmoid_gate3 = vector.logisticf<afn> %raw_gate3 : vector<4xf32>
          %gated_output3 = vector.mulf<nnan|ninf|nsz> %normalized3, %sigmoid_gate3 : vector<4xf32>
          vector.store %gated_output3, %output_view[%out_index3] : vector<4xf32>, view<268435456xf32>
        }
      }
    }
    // Complete all reads before the next fragment overwrites product LDS.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}
