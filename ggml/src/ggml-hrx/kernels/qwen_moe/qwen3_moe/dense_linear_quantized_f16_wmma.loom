check.case public @qwen3_moe_dense_linear_q4k_f16_wmma_q_projection_benchmark_case {
  %token_count = check.param.choice values([1, 17, 32, 63, 128, 129, 512, 1024, 2048]) name("token_count") : index
  %input = check.generate.fill value(0.0) : tensor<[%token_count]x2048xf32>
