// Generic strided -> contiguous copy (CONT), including the flattening case.
//
// The shipped CONT route indexes i0 directly across dst->ne[0] and so only
// handles copies that keep the leading dimension. The Gated-DeltaNet attention
// path needs the flattening form -- ggml_cont_2d over the gate half of a fused
// QG projection, src f32[256,16] with a 512-float row stride, dst f32[4096] --
// which the builder rejects at `src0->ne[0] != node->ne[0]`.
//
// dst is contiguous; src is addressed by explicit per-dimension element
// strides, so any view whose strides are float-aligned can be materialised.

config.decl @hrx2_shape_contx_ne0 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_contx_ne1 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_contx_ne2 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_contx_ne3 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_contx_s0 : %value: index where [range(%value, 0, 268435456)]
config.decl @hrx2_shape_contx_s1 : %value: index where [range(%value, 0, 268435456)]
config.decl @hrx2_shape_contx_s2 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_contx_s3 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_tuning_contx_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

kernel.def export("hrx2_cont_strided_f32") @hrx2_cont_strided_f32() {
  %unit = index.constant 1 : index
  %minus_one = index.constant -1 : index
  %ne0 = config.get @hrx2_shape_contx_ne0 : index
  %ne1 = config.get @hrx2_shape_contx_ne1 : index
  %ne2 = config.get @hrx2_shape_contx_ne2 : index
  %ne3 = config.get @hrx2_shape_contx_ne3 : index
  %workgroup_size = config.get @hrx2_tuning_contx_workgroup_size : index
  %n01 = index.mul %ne0, %ne1 : index
  %n012 = index.mul %n01, %ne2 : index
  %total = index.mul %n012, %ne3 : index
  %rounding = index.add %workgroup_size, %minus_one : index
  %rounded = index.add %total, %rounding : index
  %workgroups = index.div %rounded, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %ne0 = config.get @hrx2_shape_contx_ne0 : index
  %ne1 = config.get @hrx2_shape_contx_ne1 : index
  %ne2 = config.get @hrx2_shape_contx_ne2 : index
  %ne3 = config.get @hrx2_shape_contx_ne3 : index
  %s0 = config.get @hrx2_shape_contx_s0 : index
  %s1 = config.get @hrx2_shape_contx_s1 : index
  %s2 = config.get @hrx2_shape_contx_s2 : index
  %s3 = config.get @hrx2_shape_contx_s3 : index
  %workgroup_size = config.get @hrx2_tuning_contx_workgroup_size : index

  %ne0_b = index.assume %ne0 [range(%ne0, 1, 1048576)] : index
  %ne1_b = index.assume %ne1 [range(%ne1, 1, 1048576)] : index
  %ne2_b = index.assume %ne2 [range(%ne2, 1, 1048576)] : index
  %ne3_b = index.assume %ne3 [range(%ne3, 1, 1048576)] : index

  %workgroup0 = kernel.workgroup.id<x> : index
  %lane0 = kernel.workitem.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 4194303)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index
  %lin0 = index.mul %workgroup, %workgroup_size : index
  %lin1 = index.add %lin0, %lane : index
  %linear = index.assume %lin1 [range(%lin1, 0, 1073741823)] : index

  %n01_0 = index.mul %ne0_b, %ne1_b : index
  %n01 = index.assume %n01_0 [range(%n01_0, 1, 1073741823)] : index
  %n012_0 = index.mul %n01, %ne2_b : index
  %n012 = index.assume %n012_0 [range(%n012_0, 1, 1073741823)] : index
  %total0 = index.mul %n012, %ne3_b : index
  %total = index.assume %total0 [range(%total0, 1, 1073741824)] : index
  %in_bounds = index.cmp ult, %linear, %total : index

  %src_global = buffer.assume.memory_space<global> %src0 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src_na, %dst_na = buffer.assume.noalias %src_global, %dst_global : buffer, buffer
  %src_view = buffer.view %src_na[%base] : buffer -> view<1073741824xf32, #dense>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32, #dense>

  scf.if %in_bounds {
    %i3 = index.div %linear, %n012 : index
    %r2 = index.rem %linear, %n012 : index
    %i2 = index.div %r2, %n01 : index
    %r1 = index.rem %r2, %n01 : index
    %i1 = index.div %r1, %ne0_b : index
    %i0 = index.rem %r1, %ne0_b : index

    %a0 = index.mul %i0, %s0 : index
    %a1 = index.mul %i1, %s1 : index
    %a2 = index.mul %i2, %s2 : index
    %a3 = index.mul %i3, %s3 : index
    %a01 = index.add %a0, %a1 : index
    %a012 = index.add %a01, %a2 : index
    %a0123 = index.add %a012, %a3 : index
    %si = index.assume %a0123 [range(%a0123, 0, 1073741823)] : index

    %v = view.load %src_view[%si] : view<1073741824xf32, #dense> -> f32
    view.store %v, %dst_view[%linear] : f32, view<1073741824xf32, #dense>
  }
  kernel.return
}
