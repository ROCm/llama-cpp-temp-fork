        scf.yield %p1_3_t1_acc : vector<8xf32>
      } else {
        scf.yield %tile1_c0 : vector<8xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      // ---- gate projection: same activation stage, reused weight LDS ----
      // ---- Per-chunk: expand two groups into LDS, then one wave per band ----
      // Lane l stages row l % 128; the two lanes of a row split the chunk's
      // 32 payload bytes. One 16-byte load yields 32 outputs -- low nibbles at
      // k and high nibbles at k + 32 -- so the line is consumed once, in full.
      %g_st_row = index.rem %lane, %k_band : index
      %g_st_half = index.div %lane, %k_band : index
      %g_st_grow0 = index.add %row_base, %g_st_row : index
      %g_rows_last = index.sub %rows_bounded, %one : index
      %g_st_in = index.cmp ult, %g_st_grow0, %rows_bounded : index
      %g_st_grow = scf.select %g_st_in, %g_st_grow0, %g_rows_last : index
      %g_st_rowblk = index.mul %g_st_grow, %blocks_per_row : index
      %g_st_rb = index.add %expert_block_base, %g_st_rowblk : index
      %g_st_lb = index.add %g_st_rb, %blk : index
      %g_st_byte = index.mul %g_st_lb, %block_bytes : index
      %g_st_qs = index.add %g_st_byte, %qs_offset : index
      %g_st_h16 = index.mul %g_st_half, %k_wmma : index
      %g_st_lds0 = index.mul %g_st_row, %k_wrow : index
      %g_st_ldsq = index.div %g_st_h16, %four : index
      %g_st_lds = index.add %g_st_lds0, %g_st_ldsq : index
      %g_sc_on = index.cmp ult, %lane, %k_band : index

      // Canonical-layout control: only lane-half zero owns metadata.
      %g_stw = scf.if %g_sc_on -> (vector<4xi32>) {
        %g_stw_o = index.cast %g_st_byte : index to offset
        %g_stw_v = buffer.view %gatew_na[%g_stw_o] : buffer -> view<4xi32>
        %g_stw_loaded = vector.load %g_stw_v[%zero] : view<4xi32> -> vector<4xi32>
        scf.yield %g_stw_loaded : vector<4xi32>
      } else {
        %g_stw_zero = vector.constant 0 : vector<4xi32>
        scf.yield %g_stw_zero : vector<4xi32>
      }
      %g_stw0 = vector.extract %g_stw[0] : vector<4xi32> -> i32
      %g_stw0_v = vector.splat %g_stw0 : vector<1xi32>
      %g_st_ddm16 = vector.bitcast %g_stw0_v : vector<1xi32> to vector<2xf16>
      %g_st_d16 = vector.extract %g_st_ddm16[0] : vector<2xf16> -> f16
      %g_st_dm16 = vector.extract %g_st_ddm16[1] : vector<2xf16> -> f16
      %g_st_d = scalar.extf %g_st_d16 : f16 to f32
      %g_st_dm = scalar.extf %g_st_dm16 : f16 to f32
      %g_stw1 = vector.extract %g_stw[1] : vector<4xi32> -> i32
      %g_stw2 = vector.extract %g_stw[2] : vector<4xi32> -> i32
      %g_stw3 = vector.extract %g_stw[3] : vector<4xi32> -> i32
      %g_sc_out = index.mul %lane, %k_gpc : index
      // ---- stage chunk 0 (groups 0..3) into plane 0 ----
      %g_c0_0_k = index.constant 0 : index
      %g_c0_0_s0 = index.add %g_st_qs, %g_c0_0_k : index
      %g_c0_0_s1 = index.add %g_c0_0_s0, %g_st_h16 : index
      %g_c0_0_o = index.cast %g_c0_0_s1 : index to offset
      %g_c0_0_v = buffer.view %gatew_na[%g_c0_0_o] : buffer -> view<4xi32>
      %g_c0_0_w = vector.load %g_c0_0_v[%zero] : view<4xi32> -> vector<4xi32>
      %g_c0_0_lo = vector.andi %g_c0_0_w, %nibble_mask_v4 : vector<4xi32>
      %g_c0_0_sh = vector.shrui %g_c0_0_w, %four_i32v4 : vector<4xi32>
      %g_c0_0_hi = vector.andi %g_c0_0_sh, %nibble_mask_v4 : vector<4xi32>
      %g_c0_0_bk = index.constant 0 : index
      %g_c0_0_dl0 = index.add %g_st_lds, %g_c0_0_bk : index
      %g_c0_0_dl = index.assume %g_c0_0_dl0 [range(%g_c0_0_dl0, 0, 5628)] : index
      %g_c0_0_dh0 = index.add %g_c0_0_dl, %eight : index
      %g_c0_0_dh = index.assume %g_c0_0_dh0 [range(%g_c0_0_dh0, 0, 5628)] : index
      vector.store %g_c0_0_lo, %wl_i32_view[%g_c0_0_dl] : vector<4xi32>, view<5632xi32>
      vector.store %g_c0_0_hi, %wl_i32_view[%g_c0_0_dh] : vector<4xi32>, view<5632xi32>
      %g_c0_1_k = index.constant 32 : index
      %g_c0_1_s0 = index.add %g_st_qs, %g_c0_1_k : index
      %g_c0_1_s1 = index.add %g_c0_1_s0, %g_st_h16 : index
