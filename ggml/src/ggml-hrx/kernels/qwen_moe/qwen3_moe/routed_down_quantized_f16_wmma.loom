  kernel.launch.config workgroups(%output_tiles, %route_tiles, %expert_count) workgroup_size(%c128, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %expert_table: buffer, %weight: buffer, %output: buffer) {
