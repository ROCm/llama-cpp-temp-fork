    %source_index0 = index.madd %selected_b, %c1024, %feature : index
    %source_index = index.assume %source_index0 [range(%source_index0, 0, 524287)] : index
    %dst_row_i32 = view.load %update_indices_v[%source_slot] : view<8xi32, #dense> -> i32
    %dst_row = index.cast %dst_row_i32 : i32 to index
    %dst_row_b = index.assume %dst_row [range(%dst_row, 0, 7)] : index
    %dst_index0 = index.madd %dst_row_b, %c1024, %feature : index
    %dst_index = index.assume %dst_index0 [range(%dst_index0, 0, 8191)] : index
    %value0 = view.load %state0_v[%source_index] : view<524288xf32, #dense> -> f32
    %value1 = view.load %state1_v[%source_index] : view<524288xf32, #dense> -> f32
    view.store %value0, %state_dst0_v[%dst_index] : f32, view<8192xf32, #dense>
    view.store %value1, %state_dst1_v[%dst_index] : f32, view<8192xf32, #dense>
