        %ot1v5_qsr = index.rem %n_scale0, %thirtytwo : index
        %ot1v5_qsm0 = index.mul %ot1v5_m, %four : index
        %ot1v5_qsm = index.add %ot1v5_qsm0, %ot1v5_qsg : index
        %ot1v5_qsp = index.mul %ot1v5_qsm, %thirtythree : index
        %ot1v5_qs0 = index.add %ot1v5_qsp, %ot1v5_qsr : index
        %ot1v5_qs = index.assume %ot1v5_qs0 [range(%ot1v5_qs0, 0, 4222)] : index
        view.store %ot1v5_val, %qstage_view[%ot1v5_qs] : f32, view<4224xf32>
      }
    }
    %ot1v6_k = index.constant 28 : index
    %ot1v6_m = index.add %m_par, %ot1v6_k : index
    %ot1v6_s = index.add %mbase, %ot1v6_m : index
    %ot1v6_ok = index.cmp ult, %ot1v6_s, %nmatch : index
    %ot1v6_c = index.rem %ot1v6_s, %onetwentyeight : index
    %ot1v6_ti = view.load %match_tok_view[%ot1v6_c] : view<128xi32> -> i32
    %ot1v6_si = view.load %match_sel_view[%ot1v6_c] : view<128xi32> -> i32
    %ot1v6_t0 = index.cast %ot1v6_ti : i32 to index
    %ot1v6_t = index.assume %ot1v6_t0 [range(%ot1v6_t0, 0, 1048575)] : index
    %ot1v6_l0 = index.cast %ot1v6_si : i32 to index
    %ot1v6_l = index.assume %ot1v6_l0 [range(%ot1v6_l0, 0, 127)] : index
    %ot1v6_tb = index.mul %ot1v6_t, %dst_token_stride_b : index
    %ot1v6_sb = index.mul %ot1v6_l, %rows_bounded : index
    %ot1v6_bb = index.add %ot1v6_tb, %ot1v6_sb : index
    %ot1v6_d0 = index.add %ot1v6_bb, %o_row : index
    %ot1v6_d = index.assume %ot1v6_d0 [range(%ot1v6_d0, 0, 1073741823)] : index
    %ot1v6_val0 = vector.extract %uo1[6] : vector<8xf32> -> f32
    scf.if %ot1v6_ok {
      scf.if %o_rowok {
        %ot1v6_gate = vector.extract %go1[6] : vector<8xf32> -> f32
        %ot1v6_silu = scalar.siluf %ot1v6_gate : f32
        %ot1v6_val = scalar.mulf<nnan|ninf|nsz> %ot1v6_silu, %ot1v6_val0 : f32
        %ot1v6_qsg = index.div %n_scale0, %thirtytwo : index
        %ot1v6_qsr = index.rem %n_scale0, %thirtytwo : index
        %ot1v6_qsm0 = index.mul %ot1v6_m, %four : index
        %ot1v6_qsm = index.add %ot1v6_qsm0, %ot1v6_qsg : index
        %ot1v6_qsp = index.mul %ot1v6_qsm, %thirtythree : index
        %ot1v6_qs0 = index.add %ot1v6_qsp, %ot1v6_qsr : index
        %ot1v6_qs = index.assume %ot1v6_qs0 [range(%ot1v6_qs0, 0, 4222)] : index
        view.store %ot1v6_val, %qstage_view[%ot1v6_qs] : f32, view<4224xf32>
      }
    }
    %ot1v7_k = index.constant 30 : index
    %ot1v7_m = index.add %m_par, %ot1v7_k : index
    %ot1v7_s = index.add %mbase, %ot1v7_m : index
    %ot1v7_ok = index.cmp ult, %ot1v7_s, %nmatch : index
    %ot1v7_c = index.rem %ot1v7_s, %onetwentyeight : index
    %ot1v7_ti = view.load %match_tok_view[%ot1v7_c] : view<128xi32> -> i32
    %ot1v7_si = view.load %match_sel_view[%ot1v7_c] : view<128xi32> -> i32
    %ot1v7_t0 = index.cast %ot1v7_ti : i32 to index
    %ot1v7_t = index.assume %ot1v7_t0 [range(%ot1v7_t0, 0, 1048575)] : index
    %ot1v7_l0 = index.cast %ot1v7_si : i32 to index
    %ot1v7_l = index.assume %ot1v7_l0 [range(%ot1v7_l0, 0, 127)] : index
    %ot1v7_tb = index.mul %ot1v7_t, %dst_token_stride_b : index
    %ot1v7_sb = index.mul %ot1v7_l, %rows_bounded : index
    %ot1v7_bb = index.add %ot1v7_tb, %ot1v7_sb : index
    %ot1v7_d0 = index.add %ot1v7_bb, %o_row : index
    %ot1v7_d = index.assume %ot1v7_d0 [range(%ot1v7_d0, 0, 1073741823)] : index
    %ot1v7_val0 = vector.extract %uo1[7] : vector<8xf32> -> f32
    scf.if %ot1v7_ok {
      scf.if %o_rowok {
        %ot1v7_gate = vector.extract %go1[7] : vector<8xf32> -> f32
        %ot1v7_silu = scalar.siluf %ot1v7_gate : f32
        %ot1v7_val = scalar.mulf<nnan|ninf|nsz> %ot1v7_silu, %ot1v7_val0 : f32
        %ot1v7_qsg = index.div %n_scale0, %thirtytwo : index
        %ot1v7_qsr = index.rem %n_scale0, %thirtytwo : index
        %ot1v7_qsm0 = index.mul %ot1v7_m, %four : index
        %ot1v7_qsm = index.add %ot1v7_qsm0, %ot1v7_qsg : index
        %ot1v7_qsp = index.mul %ot1v7_qsm, %thirtythree : index
        %ot1v7_qs0 = index.add %ot1v7_qsp, %ot1v7_qsr : index
        %ot1v7_qs = index.assume %ot1v7_qs0 [range(%ot1v7_qs0, 0, 4222)] : index
        view.store %ot1v7_val, %qstage_view[%ot1v7_qs] : f32, view<4224xf32>
      }
    }

    // Cooperative exact Q5-qact tail.  Each aligned cluster of eight
    // lanes owns one 32-value record; lane c retains the accepted values
    // [4*c,4*c+4), writes packed word c, and contributes its exact i32 sum.
    // The max reduction is over abs(f32), so its finite-input result is the
    // same bit pattern as the accepted sequential maxnumf chain.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %q_wave0 = kernel.subgroup.id : index
    %q_sublane0 = kernel.subgroup.lane.id : index
    %q_wave = index.assume %q_wave0 [range(%q_wave0, 0, 7)] : index
    %q_sublane = index.assume %q_sublane0 [range(%q_sublane0, 0, 31)] : index
    // One match per wave; four aligned lane clusters own its four K32 groups.
    %q_match_local = index.add %q_wave, %zero : index
    %q_group = index.div %q_sublane, %eight : index
    %q_chunk = index.rem %q_sublane, %eight : index
    %q_meta_lane = index.add %zero, %zero : index
    %q_meta_leader = index.cmp eq, %q_sublane, %q_meta_lane : index
    %q_match0 = index.add %mbase, %q_match_local : index
    %q_match_ok = index.cmp ult, %q_match0, %nmatch : index
    scf.if %q_match_ok {
      %q_match_c = index.rem %q_match0, %onetwentyeight : index
      %q_token_local = scf.if %q_meta_leader -> (i32) {
        %q_token_loaded = view.load %match_tok_view[%q_match_c] : view<128xi32> -> i32
        scf.yield %q_token_loaded : i32
      } else {
        scf.yield %zero_i32 : i32
      }
      %q_sel_local = scf.if %q_meta_leader -> (i32) {
        %q_sel_loaded = view.load %match_sel_view[%q_match_c] : view<128xi32> -> i32
        scf.yield %q_sel_loaded : i32
      } else {
        scf.yield %zero_i32 : i32
      }
      %q_meta_lane_i32 = index.cast %q_meta_lane : index to i32
      %q_token_i32 = kernel.subgroup.broadcast %q_token_local from %q_meta_lane_i32 : i32, i32
      %q_sel_i32 = kernel.subgroup.broadcast %q_sel_local from %q_meta_lane_i32 : i32, i32
      %q_token0 = index.cast %q_token_i32 : i32 to index
      %q_token = index.assume %q_token0 [range(%q_token0, 0, 511)] : index
      %q_sel0 = index.cast %q_sel_i32 : i32 to index
      %q_sel = index.assume %q_sel0 [range(%q_sel0, 0, 7)] : index
      %q_pair0 = index.mul %q_token, %eight : index
      %q_pair1 = index.add %q_pair0, %q_sel : index
      %q_pair = index.assume %q_pair1 [range(%q_pair1, 0, 4095)] : index

      %q_tile_group = index.mul %tile, %four : index
      %q_global_group0 = index.add %q_tile_group, %q_group : index
      %q_global_group = index.assume %q_global_group0 [range(%q_global_group0, 0, 15)] : index
      %q_owner_match0 = index.mul %q_match_local, %four : index
      %q_owner0 = index.add %q_owner_match0, %q_group : index
      %qstage_base0 = index.mul %q_owner0, %thirtythree : index
      %qstage_base = index.assume %qstage_base0 [range(%qstage_base0, 0, 4191)] : index
      %q_chunk_off = index.mul %q_chunk, %four : index
      %qv_i0 = index.add %qstage_base, %q_chunk_off : index
      %qv_i = index.assume %qv_i0 [range(%qv_i0, 0, 4220)] : index
      %qv = vector.load %qstage_view[%qv_i] : view<4224xf32> -> vector<4xf32>
      %qa = vector.absf %qv : vector<4xf32>
      %q_lane_max = vector.reduce<maxnumf, reassoc|nnan|nsz> %qa, %zero_f32 : vector<4xf32>, f32
      %q_group_max = kernel.subgroup.reduce<maxnumf> %q_lane_max {cluster_size = 8} : f32
      %qamax0 = scalar.maxnumf %q_group_max, %zero_f32 : f32
      %qamax = scalar.maxnumf %qamax0, %eps_f32 : f32
      %qscale = scalar.mulf<reassoc|nnan|ninf|nsz> %qamax, %inv127_f32 : f32
      %qrscale = scalar.divf<reassoc|nnan|ninf|nsz> %i127_f32, %qamax : f32
      %qrscale_v = vector.splat %qrscale : vector<4xf32>

      %qpair_words0 = index.mul %q_pair, %onehundredsixty : index
      %qrecord0 = index.add %qpair_words0, %qact_word_offset : index
      %qrecord = index.assume %qrecord0 [range(%qrecord0, 0, 1120)] : index
      %qpayload_group = index.mul %q_global_group, %eight : index
      %qpayload_base0 = index.add %qrecord, %qpayload_group : index
      %qpayload_base = index.assume %qpayload_base0 [range(%qpayload_base0, 0, 1240)] : index
      %qword_i0 = index.add %qpayload_base, %q_chunk : index
      %qword_i = index.assume %qword_i0 [range(%qword_i0, 0, 1279)] : index

      %qscaled = vector.mulf %qv, %qrscale_v : vector<4xf32>
      %qround = vector.roundf %qscaled : vector<4xf32>
      %qi = vector.fptosi %qround : vector<4xf32> to vector<4xi32>
      %qi8 = vector.trunci %qi : vector<4xi32> to vector<4xi8>
      %qbits = vector.bitcast %qi8 : vector<4xi8> to vector<1xi32>
      %qword = vector.extract %qbits[0] : vector<1xi32> -> i32
      view.store %qword, %down_qact_view[%qword_i] : i32, view<2048xi32>

      %q_lane_sum = vector.reduce<addi> %qi, %zero_i32 : vector<4xi32>, i32
      %q_group_sum = kernel.subgroup.reduce<addi> %q_lane_sum {cluster_size = 8} : i32
      %q_is_leader = index.cmp eq, %q_chunk, %zero : index
      scf.if %q_is_leader {
        %qscale_base0 = index.add %qrecord, %onetwentyeight : index
        %qscale_i0 = index.add %qscale_base0, %q_global_group : index
        %qscale_i = index.assume %qscale_i0 [range(%qscale_i0, 128, 1263)] : index
        view.store %qscale, %down_qact_f32_view[%qscale_i] : f32, view<2048xf32>
        %qsum_base0 = index.add %qrecord, %onehundredfortyfour : index
        %qsum_i0 = index.add %qsum_base0, %q_global_group : index
        %qsum_i = index.assume %qsum_i0 [range(%qsum_i0, 144, 1279)] : index
        view.store %q_group_sum, %down_qact_view[%qsum_i] : i32, view<2048xi32>
      }
    }
    // Preserve the accepted overwrite boundary for the next matrix stage.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  }
  kernel.return
}
