// Production MoE router snapshot + deterministic weighted reducer.
//
// The route matcher admits only the topology-proven decode1 and PP512 config
// tuples.  There are no quant-format variants or alternate arithmetic paths.

config.decl @hrx2_shape_sumslices_n : %value: index where [range(%value, 2048, 2048), mul(%value, 2048)]
config.decl @hrx2_shape_sumslices_ntokens : %value: index where [range(%value, 1, 512)]
config.decl @hrx2_shape_sumslices_nslices : %value: index where [range(%value, 8, 8), mul(%value, 8)]
config.decl @hrx2_shape_sumslices_src_slice_stride : %value: index where [range(%value, 2048, 2048), mul(%value, 2048)]
config.decl @hrx2_shape_sumslices_src_token_stride : %value: index where [range(%value, 16384, 16384), mul(%value, 16384)]
config.decl @hrx2_shape_sumslices_dst_token_stride : %value: index where [range(%value, 2048, 2048), mul(%value, 2048)]
config.decl @hrx2_shape_sumslices_router_source_stride : %value: index where [range(%value, 8, 256), mul(%value, 8)]
config.decl @hrx2_shape_sumslices_router_source_offset : %value: index where [range(%value, 0, 8), mul(%value, 8)]
config.decl @hrx2_tuning_sumslices_workgroup_size : %value: index where [range(%value, 256, 256), mul(%value, 256)]

// Copy the live router weights to stable, dense [ntokens,8] scratch.
// Decode specializes source[token*8+0]; PP512 specializes
// argsort_owner[token*256+8].  The snapshot dispatch completes before the
// final destination (which may share the source owner) is overwritten.
kernel.def export("hrx2_moe_router_snapshot_f32")
    @hrx2_moe_router_snapshot_f32() {
  %one = index.constant 1 : index
  %minus_one = index.constant -1 : index
  %ntokens = config.get @hrx2_shape_sumslices_ntokens : index
  %threads = config.get @hrx2_tuning_sumslices_workgroup_size : index
  %rounding = index.add %threads, %minus_one : index
  %rounded = index.add %ntokens, %rounding : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one)
      workgroup_size(%threads, %one, %one) : index
} launch(%router_source: buffer, %snapshot: buffer) {
  %base = index.constant 0 : offset
  %threads = config.get @hrx2_tuning_sumslices_workgroup_size : index
  %ntokens0 = config.get @hrx2_shape_sumslices_ntokens : index
  %source_stride0 =
      config.get @hrx2_shape_sumslices_router_source_stride : index
  %source_offset0 =
      config.get @hrx2_shape_sumslices_router_source_offset : index
  %ntokens = index.assume %ntokens0 [range(%ntokens0, 1, 512)] : index
  %source_stride = index.assume %source_stride0
      [range(%source_stride0, 8, 256), mul(%source_stride0, 8)] : index
  %source_offset = index.assume %source_offset0
      [range(%source_offset0, 0, 8), mul(%source_offset0, 8)] : index
  %wg0 = kernel.workgroup.id<x> : index
  %wg = index.assume %wg0 [range(%wg0, 0, 1)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %token_base = index.mul %wg, %threads : index
  %token0 = index.add %token_base, %lane : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %active = index.cmp ult, %token, %ntokens : index

  %router_g = buffer.assume.memory_space<global> %router_source : buffer
  %snapshot_g = buffer.assume.memory_space<global> %snapshot : buffer
  %router_na, %snapshot_na = buffer.assume.noalias
      %router_g, %snapshot_g : buffer, buffer
  %router_v = buffer.view %router_na[%base] :
      buffer -> view<131072xf32>
  %snapshot_v = buffer.view %snapshot_na[%base] :
      buffer -> view<4096xf32>

  scf.if %active {
    %source_row0 = index.mul %token, %source_stride : index
    %source_row = index.assume %source_row0
        [range(%source_row0, 0, 130816), mul(%source_row0, 8)] : index
    %source_index0 = index.add %source_row, %source_offset : index
    %source_index = index.assume %source_index0
        [range(%source_index0, 0, 130824), mul(%source_index0, 8)] : index
    %eight = index.constant 8 : index
    %snapshot_index0 = index.mul %token, %eight : index
    %snapshot_index = index.assume %snapshot_index0
        [range(%snapshot_index0, 0, 4088), mul(%snapshot_index0, 8)] : index
    %weights = vector.load %router_v[%source_index] :
        view<131072xf32> -> vector<8xf32>
    vector.store %weights, %snapshot_v[%snapshot_index] :
        vector<8xf32>, view<4096xf32>
  }
  kernel.return
}

// Exact replacement for router MUL plus its seven ADD-chain nodes.
// One 256-thread workgroup owns one token.  Each lane computes eight adjacent
// rows.  The arithmetic sequence is the accepted graph's sequence:
//   p0=mul(x0,w0); p1=mul(x1,w1); a1=add(p0,p1);
//   p2=mul(x2,w2); a2=add(a1,p2); ...; a7=add(a6,p7).
// The third direct binding is intentionally unused: it is the snapshot source
// and may share an allocation with dst.  Only selected, dst, and the appended
// stable snapshot participate in the main-kernel noalias contract.
kernel.def export("hrx2_sum_slices_f32") @hrx2_sum_slices_f32() {
  %one = index.constant 1 : index
  %groups = config.get @hrx2_shape_sumslices_ntokens : index
  %threads = config.get @hrx2_tuning_sumslices_workgroup_size : index
  kernel.launch.config workgroups(%groups, %one, %one)
      workgroup_size(%threads, %one, %one) : index
} launch(%selected: buffer, %dst: buffer, %router_source_unused: buffer,
          %snapshot: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %eight = index.constant 8 : index
  %rows = index.constant 2048 : index
  %selected_token_stride = index.constant 16384 : index
  %lds_bytes = index.constant 32 : offset
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %row0 = index.mul %lane, %eight : index
  %row = index.assume %row0
      [range(%row0, 0, 2040), mul(%row0, 8)] : index
  %snapshot_base0 = index.mul %token, %eight : index
  %snapshot_base = index.assume %snapshot_base0
      [range(%snapshot_base0, 0, 4088), mul(%snapshot_base0, 8)] : index
  %selected_base0 = index.mul %token, %selected_token_stride : index
  %selected_base = index.assume %selected_base0
      [range(%selected_base0, 0, 8372224),
       mul(%selected_base0, 16384)] : index
  %dst_base0 = index.mul %token, %rows : index
  %dst_base = index.assume %dst_base0
      [range(%dst_base0, 0, 1046528),
       mul(%dst_base0, 2048)] : index
  %dst_index0 = index.add %dst_base, %row : index
  %dst_index = index.assume %dst_index0
      [range(%dst_index0, 0, 1048568)] : index

  %selected_g = buffer.assume.memory_space<global> %selected : buffer
  %dst_g = buffer.assume.memory_space<global> %dst : buffer
  %snapshot_g = buffer.assume.memory_space<global> %snapshot : buffer
  %selected_na, %dst_na, %snapshot_na = buffer.assume.noalias
      %selected_g, %dst_g, %snapshot_g : buffer, buffer, buffer
  %selected_v = buffer.view %selected_na[%base] :
      buffer -> view<8388608xf32>
  %dst_v = buffer.view %dst_na[%base] :
      buffer -> view<1048576xf32>
  %snapshot_v = buffer.view %snapshot_na[%base] :
      buffer -> view<4096xf32>
  %scratch = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %weights_lds = buffer.view %scratch[%base] :
      buffer -> view<8xf32>

  %is_owner = index.cmp eq, %lane, %zero : index
  scf.if %is_owner {
    %snapshot_weights = vector.load %snapshot_v[%snapshot_base] :
        view<4096xf32> -> vector<8xf32>
    vector.store %snapshot_weights, %weights_lds[%zero] :
        vector<8xf32>, view<8xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %weights = vector.load %weights_lds[%zero] :
      view<8xf32> -> vector<8xf32>

  %slot0_offset = index.constant 0 : index
  %x0_base0 = index.add %selected_base, %slot0_offset : index
  %x0_index0 = index.add %x0_base0, %row : index
  %x0_index = index.assume %x0_index0
      [range(%x0_index0, 0, 8388600)] : index
  %x0 = vector.load %selected_v[%x0_index] :
      view<8388608xf32> -> vector<8xf32>
  %w0 = vector.extract %weights[0] : vector<8xf32> -> f32
  %wv0 = vector.splat %w0 : vector<8xf32>
  %p0 = vector.mulf<nnan|ninf|nsz> %x0, %wv0 : vector<8xf32>
  %slot1_offset = index.constant 2048 : index
  %x1_base0 = index.add %selected_base, %slot1_offset : index
  %x1_index0 = index.add %x1_base0, %row : index
  %x1_index = index.assume %x1_index0
      [range(%x1_index0, 0, 8388600)] : index
  %x1 = vector.load %selected_v[%x1_index] :
      view<8388608xf32> -> vector<8xf32>
  %w1 = vector.extract %weights[1] : vector<8xf32> -> f32
  %wv1 = vector.splat %w1 : vector<8xf32>
  %p1 = vector.mulf<nnan|ninf|nsz> %x1, %wv1 : vector<8xf32>
  %a1 = vector.addf<nnan|ninf|nsz> %p0, %p1 : vector<8xf32>
  %slot2_offset = index.constant 4096 : index
  %x2_base0 = index.add %selected_base, %slot2_offset : index
  %x2_index0 = index.add %x2_base0, %row : index
  %x2_index = index.assume %x2_index0
      [range(%x2_index0, 0, 8388600)] : index
  %x2 = vector.load %selected_v[%x2_index] :
      view<8388608xf32> -> vector<8xf32>
  %w2 = vector.extract %weights[2] : vector<8xf32> -> f32
  %wv2 = vector.splat %w2 : vector<8xf32>
  %p2 = vector.mulf<nnan|ninf|nsz> %x2, %wv2 : vector<8xf32>
  %a2 = vector.addf<nnan|ninf|nsz> %a1, %p2 : vector<8xf32>
  %slot3_offset = index.constant 6144 : index
  %x3_base0 = index.add %selected_base, %slot3_offset : index
  %x3_index0 = index.add %x3_base0, %row : index
  %x3_index = index.assume %x3_index0
      [range(%x3_index0, 0, 8388600)] : index
  %x3 = vector.load %selected_v[%x3_index] :
      view<8388608xf32> -> vector<8xf32>
  %w3 = vector.extract %weights[3] : vector<8xf32> -> f32
  %wv3 = vector.splat %w3 : vector<8xf32>
  %p3 = vector.mulf<nnan|ninf|nsz> %x3, %wv3 : vector<8xf32>
  %a3 = vector.addf<nnan|ninf|nsz> %a2, %p3 : vector<8xf32>
  %slot4_offset = index.constant 8192 : index
  %x4_base0 = index.add %selected_base, %slot4_offset : index
  %x4_index0 = index.add %x4_base0, %row : index
  %x4_index = index.assume %x4_index0
      [range(%x4_index0, 0, 8388600)] : index
  %x4 = vector.load %selected_v[%x4_index] :
      view<8388608xf32> -> vector<8xf32>
  %w4 = vector.extract %weights[4] : vector<8xf32> -> f32
  %wv4 = vector.splat %w4 : vector<8xf32>
  %p4 = vector.mulf<nnan|ninf|nsz> %x4, %wv4 : vector<8xf32>
  %a4 = vector.addf<nnan|ninf|nsz> %a3, %p4 : vector<8xf32>
  %slot5_offset = index.constant 10240 : index
  %x5_base0 = index.add %selected_base, %slot5_offset : index
  %x5_index0 = index.add %x5_base0, %row : index
  %x5_index = index.assume %x5_index0
      [range(%x5_index0, 0, 8388600)] : index
  %x5 = vector.load %selected_v[%x5_index] :
      view<8388608xf32> -> vector<8xf32>
  %w5 = vector.extract %weights[5] : vector<8xf32> -> f32
  %wv5 = vector.splat %w5 : vector<8xf32>
  %p5 = vector.mulf<nnan|ninf|nsz> %x5, %wv5 : vector<8xf32>
  %a5 = vector.addf<nnan|ninf|nsz> %a4, %p5 : vector<8xf32>
  %slot6_offset = index.constant 12288 : index
  %x6_base0 = index.add %selected_base, %slot6_offset : index
  %x6_index0 = index.add %x6_base0, %row : index
  %x6_index = index.assume %x6_index0
      [range(%x6_index0, 0, 8388600)] : index
  %x6 = vector.load %selected_v[%x6_index] :
      view<8388608xf32> -> vector<8xf32>
  %w6 = vector.extract %weights[6] : vector<8xf32> -> f32
  %wv6 = vector.splat %w6 : vector<8xf32>
  %p6 = vector.mulf<nnan|ninf|nsz> %x6, %wv6 : vector<8xf32>
  %a6 = vector.addf<nnan|ninf|nsz> %a5, %p6 : vector<8xf32>
  %slot7_offset = index.constant 14336 : index
  %x7_base0 = index.add %selected_base, %slot7_offset : index
  %x7_index0 = index.add %x7_base0, %row : index
  %x7_index = index.assume %x7_index0
      [range(%x7_index0, 0, 8388600)] : index
  %x7 = vector.load %selected_v[%x7_index] :
      view<8388608xf32> -> vector<8xf32>
  %w7 = vector.extract %weights[7] : vector<8xf32> -> f32
  %wv7 = vector.splat %w7 : vector<8xf32>
  %p7 = vector.mulf<nnan|ninf|nsz> %x7, %wv7 : vector<8xf32>
  %a7 = vector.addf<nnan|ninf|nsz> %a6, %p7 : vector<8xf32>
  vector.store %a7, %dst_v[%dst_index] :
      vector<8xf32>, view<1048576xf32>
  kernel.return
}
