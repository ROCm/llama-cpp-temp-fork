// Each chunk contains 256 contiguous QKV rows followed by 128 contiguous
// raw-gate rows. The 2:1 schedule covers both matrices exactly, removes the
// raw-gate tail launch, and distributes that formerly slower class
// throughout the dominant QKV service without changing either dot-product.
config.decl @hrx2_shape_recurrent_pair_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @hrx2_shape_recurrent_pair_qkv_rows : %value: index where [range(%value, 256, 262144), mul(%value, 256)]
config.decl @hrx2_shape_recurrent_pair_gate_rows : %value: index where [range(%value, 128, 131072), mul(%value, 128)]
config.decl @hrx2_tuning_recurrent_pair_workgroup_size : %value: index where [range(%value, 32, 256), mul(%value, 32)]

kernel.def export("hrx2_mul_mat_q8_0_f32_recurrent_pair_k2048_chunk256_128") @hrx2_mul_mat_q8_0_f32_recurrent_pair_k2048_chunk256_128() {
  %unit = index.constant 1 : index
  %qkv_rows = config.get @hrx2_shape_recurrent_pair_qkv_rows : index
  %gate_rows = config.get @hrx2_shape_recurrent_pair_gate_rows : index
  %total_workgroups = index.add %qkv_rows, %gate_rows : index
  %workgroup_size = config.get @hrx2_tuning_recurrent_pair_workgroup_size : index
  kernel.launch.config workgroups(%total_workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%qkv_weight: buffer, %gate_weight: buffer,
         %input: buffer, %input_hi: buffer,
         %qkv_dst: buffer, %gate_dst: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %qk = index.constant 32 : index
  %block_bytes = index.constant 34 : index
  %block_f16s = index.constant 17 : index
  %qs_offset = index.constant 2 : index
  %k = config.get @hrx2_shape_recurrent_pair_k : index
  %qkv_rows = config.get @hrx2_shape_recurrent_pair_qkv_rows : index
  %gate_rows = config.get @hrx2_shape_recurrent_pair_gate_rows : index
  %workgroup_size = config.get @hrx2_tuning_recurrent_pair_workgroup_size : index
  %k_bounded = index.assume %k [range(%k, 2048, 2048)] : index
  %qkv_rows_bounded = index.assume %qkv_rows [range(%qkv_rows, 256, 262144)] : index
  %gate_rows_bounded = index.assume %gate_rows [range(%gate_rows, 128, 131072)] : index
  %cols_bounded = index.constant 1 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %chunk_workgroups = index.constant 384 : index
  %qkv_rows_per_chunk = index.constant 256 : index
  %gate_rows_per_chunk = index.constant 128 : index
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 393215)] : index
  %chunk = index.div %workgroup, %chunk_workgroups : index
  %slot = index.rem %workgroup, %chunk_workgroups : index
  %is_qkv = index.cmp ult, %slot, %qkv_rows_per_chunk : index
  %qkv_slot0 = index.rem %slot, %qkv_rows_per_chunk : index
  %qkv_slot = index.assume %qkv_slot0 [range(%qkv_slot0, 0, 255)] : index
  %gate_slot0 = index.rem %slot, %gate_rows_per_chunk : index
  %gate_slot = index.assume %gate_slot0 [range(%gate_slot0, 0, 127)] : index
  %qkv_row_chunk_base = index.mul %chunk, %qkv_rows_per_chunk : index
  %gate_row_chunk_base = index.mul %chunk, %gate_rows_per_chunk : index
  %qkv_row0 = index.add %qkv_row_chunk_base, %qkv_slot : index
  %gate_row0 = index.add %gate_row_chunk_base, %gate_slot : index
  %qkv_row = index.assume %qkv_row0 [range(%qkv_row0, 0, 262143)] : index
  %gate_row = index.assume %gate_row0 [range(%gate_row0, 0, 131071)] : index
  %row = scf.select %is_qkv, %qkv_row, %gate_row : index
  %rows0 = scf.select %is_qkv, %qkv_rows_bounded, %gate_rows_bounded : index
  %rows_bounded = index.assume %rows0 [range(%rows0, 128, 262144)] : index
  %col = index.constant 0 : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %qkv_weight_global = buffer.assume.memory_space<global> %qkv_weight : buffer
  %gate_weight_global = buffer.assume.memory_space<global> %gate_weight : buffer
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_hi_global = buffer.assume.memory_space<global> %input_hi : buffer
  %qkv_dst_global = buffer.assume.memory_space<global> %qkv_dst : buffer
  %gate_dst_global = buffer.assume.memory_space<global> %gate_dst : buffer
  %qkv_weight_noalias, %gate_weight_noalias, %input_noalias,
      %qkv_dst_noalias, %gate_dst_noalias = buffer.assume.noalias
      %qkv_weight_global, %gate_weight_global, %input_global,
      %qkv_dst_global, %gate_dst_global :
      buffer, buffer, buffer, buffer, buffer
  %src1_hi_same = buffer.assume.same_root %input_hi_global, %input_noalias : buffer
  %qkv_dst_view = buffer.view %qkv_dst_noalias[%base] : buffer -> view<[%qkv_rows_bounded]xf32>
  %gate_dst_view = buffer.view %gate_dst_noalias[%base] : buffer -> view<[%gate_rows_bounded]xf32>
  // Runtime-uniform buffer selection is a native Loom HAL ABI operation.
  // The selected weight feeds one unchanged arithmetic and reduction body;
  // destination ownership remains explicit below.
  %weight_selected = scf.select %is_qkv, %qkv_weight_noalias, %gate_weight_noalias : buffer
  %blocks_per_row = index.div %k_bounded, %qk : index
  %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
  %src0_i8_count = index.mul %total_blocks, %block_bytes : index
  %src0_f16_count = index.mul %total_blocks, %block_f16s : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %dst_count = index.mul %cols_bounded, %rows_bounded : index

  %block_lane = index.rem %lane, %eight : index
  %block_slot = index.div %lane, %eight : index
  %in_block_base = index.mul %block_lane, %four : index
  %block_step = index.div %workgroup_size, %eight : index
  %block_idx0 = index.assume %block_slot [range(%block_slot, 0, 31)] : index
  %block_idx1_raw = index.add %block_slot, %block_step : index
  %block_idx1 = index.assume %block_idx1_raw [range(%block_idx1_raw, 32, 63)] : index

  %src0_i8_view = buffer.view %weight_selected[%base] : buffer -> view<[%src0_i8_count]xi8>
  %src0_f16_view = buffer.view %weight_selected[%base] : buffer -> view<[%src0_f16_count]xf16>
  %src1_view = buffer.view %input_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %src1_hi_view = buffer.view %src1_hi_same[%base] : buffer -> view<[%src1_count]xf32>

  %row_block_base = index.mul %row, %blocks_per_row : index
  %src1_col_base = index.mul %col, %k_bounded : index

  %src_base_block0 = index.mul %block_idx0, %qk : index
  %src_base0 = index.add %src_base_block0, %in_block_base : index
  %linear_block0 = index.add %row_block_base, %block_idx0 : index
  %block_byte_base0 = index.mul %linear_block0, %block_bytes : index
  %q_byte_payload0 = index.add %block_byte_base0, %qs_offset : index
  %q_byte0 = index.add %q_byte_payload0, %in_block_base : index
  %q_byte_offset0 = index.cast %q_byte0 : index to offset
  %q_word_view0 = buffer.view %weight_selected[%q_byte_offset0] : buffer -> view<1xi32>
  %q_packed0 = vector.load %q_word_view0[%zero_index] : view<1xi32> -> vector<1xi32>
  %q_i320 = vector.bitunpacks<8> %q_packed0 : vector<1xi32> -> vector<4xi32>
  %q_f320 = vector.sitofp %q_i320 : vector<4xi32> to vector<4xf32>
  %src1_index0 = index.add %src1_col_base, %src_base0 : index
  %rhs0 = vector.load %src1_view[%src1_index0] : view<[%src1_count]xf32> -> vector<4xf32>
  %block_f16_base0 = index.mul %linear_block0, %block_f16s : index
  %d_f160 = view.load %src0_f16_view[%block_f16_base0] : view<[%src0_f16_count]xf16> -> f16
  %d0 = scalar.extf %d_f160 : f16 to f32
  %d_vec0 = vector.splat %d0 : vector<4xf32>
  %q_scaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %q_f320, %d_vec0 : vector<4xf32>
  %sum0 = vector.dotf %q_scaled0, %rhs0, %zero_f32 : vector<4xf32>, vector<4xf32>, f32

  %src_base_block1 = index.mul %block_idx1, %qk : index
  %src_base1 = index.add %src_base_block1, %in_block_base : index
  %linear_block1 = index.add %row_block_base, %block_idx1 : index
  %block_byte_base1 = index.mul %linear_block1, %block_bytes : index
  %q_byte_payload1 = index.add %block_byte_base1, %qs_offset : index
  %q_byte1 = index.add %q_byte_payload1, %in_block_base : index
  %q_byte_offset1 = index.cast %q_byte1 : index to offset
  %q_word_view1 = buffer.view %weight_selected[%q_byte_offset1] : buffer -> view<1xi32>
  %q_packed1 = vector.load %q_word_view1[%zero_index] : view<1xi32> -> vector<1xi32>
  %q_i321 = vector.bitunpacks<8> %q_packed1 : vector<1xi32> -> vector<4xi32>
  %q_f321 = vector.sitofp %q_i321 : vector<4xi32> to vector<4xf32>
  %src1_index1 = index.add %src1_col_base, %src_base1 : index
  %rhs1 = vector.load %src1_hi_view[%src1_index1] : view<[%src1_count]xf32> -> vector<4xf32>
  %block_f16_base1 = index.mul %linear_block1, %block_f16s : index
  %d_f161 = view.load %src0_f16_view[%block_f16_base1] : view<[%src0_f16_count]xf16> -> f16
  %d1 = scalar.extf %d_f161 : f16 to f32
  %d_vec1 = vector.splat %d1 : vector<4xf32>
  %q_scaled1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %q_f321, %d_vec1 : vector<4xf32>

  %sum = vector.dotf %q_scaled1, %rhs1, %sum0 : vector<4xf32>, vector<4xf32>, f32

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %lane_i32 = index.cast %lane : index to i32
  %zero_i32 = scalar.constant 0 : i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    scf.if %is_qkv {
      view.store %dot, %qkv_dst_view[%qkv_row] : f32, view<[%qkv_rows_bounded]xf32>
    } else {
      view.store %dot, %gate_dst_view[%gate_row] : f32, view<[%gate_rows_bounded]xf32>
    }
  }
  kernel.return
}
