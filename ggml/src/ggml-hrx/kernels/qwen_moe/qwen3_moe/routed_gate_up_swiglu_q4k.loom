  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %configured_route_count0 = config.get @qwen3_moe.routed_gate_up.route_count : index
  %configured_expert_count0 = config.get @qwen3_moe.routed_gate_up.expert_count : index
  %configured_output_size0 = config.get @qwen3_moe.routed_gate_up.output_size : index
