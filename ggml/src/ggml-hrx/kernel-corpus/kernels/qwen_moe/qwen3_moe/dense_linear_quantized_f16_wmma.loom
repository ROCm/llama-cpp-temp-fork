// Token-128 and token-256 share one body; a compile-time selector removes the unused statically bounded LDS view.
func.def inline @qwen3_moe_dense_q8_wmmai8_stage_values(%token256: i1, %scratch: buffer, %base: offset, %adbase: index, %ad1: index, %values0: vector<32xi8>, %values1: vector<32xi8>) {
