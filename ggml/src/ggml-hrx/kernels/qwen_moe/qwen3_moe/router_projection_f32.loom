  %col_tile0 = kernel.workgroup.id<x> : index
  %row_tile0 = kernel.workgroup.id<y> : index
  %tid0 = kernel.workitem.id<x> : index
  %col_tile = index.assume %col_tile0 [range(%col_tile0, 0, 32767)] : index
  %row_tile = index.assume %row_tile0 [range(%row_tile0, 0, 262143)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 1023)] : index
  %k_slice = index.div %tid, %k_wg : index
  %sub = index.rem %tid, %k_wg : index


  %src0_g = buffer.assume.memory_space<global> %src0 : buffer
  %src1_g = buffer.assume.memory_space<global> %src1 : buffer
  %dst_g = buffer.assume.memory_space<global> %dst : buffer
  %src0_na, %src1_na, %dst_na = buffer.assume.noalias %src0_g, %src1_g, %dst_g : buffer, buffer, buffer
  %src1_view = buffer.view %src1_na[%base] : buffer -> view<1073741824xf32>
  %src0_view = buffer.view %src0_na[%base] : buffer -> view<1073741824xf32>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32>

  %lds_bytes = index.constant 49152 : offset
  %scratch = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %av_e = index.mul %k_slice, %k_act_elems : index
  %av_b = index.mul %av_e, %four : index
  %av_o = index.cast %av_b : index to offset
  %act_view = buffer.view %scratch[%av_o] : buffer -> view<2048xf32>

  // Lane owns one row and 4 columns. Keeping a wave on one column group makes
  // every LDS activation read wave-uniform, i.e. a broadcast.
  %lane_row = index.rem %sub, %k_rt : index
  %col_grp = index.div %sub, %k_rt : index
  %row_base = index.mul %row_tile, %k_rt : index
  %row_raw = index.add %row_base, %lane_row : index
  %row_valid = index.cmp ult, %row_raw, %rows_b : index
  %row_safe = index.rem %row_raw, %rows_b : index
  %w_row_base = index.mul %row_safe, %k_b : index
