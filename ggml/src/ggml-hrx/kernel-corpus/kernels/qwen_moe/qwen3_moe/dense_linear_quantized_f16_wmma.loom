  // The waves own 32-token blocks and share one 64-row weight tile.
  %wcol = index.rem %wave, %k_wm : index
  %wrow = index.div %wave, %k_wm : index
  %k_mspan = index.constant 32 : index
  %k_nspan = index.constant 64 : index
  %wm_off = index.mul %wcol, %k_mspan : index
  %wn_off = index.mul %wrow, %k_nspan : index
  %m_out = index.add %col_base, %wm_off : index
  %n_out = index.add %row_base, %wn_off : index
  %lm0 = index.add %wm_off, %zero : index
  %gm0 = index.add %m_out, %zero : index
  %k_ma1 = index.constant 16 : index
  %lm1 = index.add %wm_off, %k_ma1 : index
  %gm1 = index.add %m_out, %k_ma1 : index
  %ln0 = index.add %wn_off, %zero : index
  %gn0 = index.add %n_out, %zero : index
  %k_nb1 = index.constant 16 : index
  %ln1 = index.add %wn_off, %k_nb1 : index
  %gn1 = index.add %n_out, %k_nb1 : index
  %k_nb2 = index.constant 32 : index
  %ln2 = index.add %wn_off, %k_nb2 : index
  %gn2 = index.add %n_out, %k_nb2 : index
  %k_nb3 = index.constant 48 : index
  %ln3 = index.add %wn_off, %k_nb3 : index
  %gn3 = index.add %n_out, %k_nb3 : index
  %lane = index.rem %tid, %k_wave : index
  %lane_lo = index.rem %lane, %sixteen : index
  %lane_hi = index.div %lane, %sixteen : index
