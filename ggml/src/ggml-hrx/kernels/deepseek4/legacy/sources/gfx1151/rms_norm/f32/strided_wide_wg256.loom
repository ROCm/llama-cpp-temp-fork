// Row-wise RMS_NORM and L2_NORM over a *strided* source into a dense dst.
//
// The shipped rms_norm / l2_norm kernels take only (ncols, nrows) and read the
// source as a dense [nrows][ncols] block. In the Qwen3.6 graph both norms are
// applied to per-head slices of a fused projection, so the source has padding
// between rows and, for the Gated-DeltaNet q/k tensors, between ne2 planes as
// well:
//
//   RMS_NORM src ne=[256,16,512] nb=[4,2048,32768,16777216]   row padding
//   L2_NORM  src ne=[128,16,512] nb=[4, 512,32768, 4194304]   plane padding
//
// Neither is expressible as a single row stride, so those nodes were falling
// back to the CPU. This kernel decomposes the row index into (i1,i2,i3) and
// applies s1/s2/s3 independently, exactly like cont_strided_f32, while the
// destination stays dense so it can be written at row*ncols.
//
// One workgroup per row with a strided reduction, so a single wide route covers
// every shape the graph uses.

config.decl @hrx2_shape_normx_ncols : %value: index where [range(%value, 1, 65536)]
config.decl @hrx2_shape_normx_ne1 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_normx_ne2 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_normx_ne3 : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_normx_s1 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_normx_s2 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_shape_normx_s3 : %value: index where [range(%value, 0, 1073741823)]
config.decl @hrx2_tuning_normx_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

kernel.def export("hrx2_rms_norm_strided_f32") @hrx2_rms_norm_strided_f32() {
  %unit = index.constant 1 : index
  %ne1 = config.get @hrx2_shape_normx_ne1 : index
  %ne2 = config.get @hrx2_shape_normx_ne2 : index
  %ne3 = config.get @hrx2_shape_normx_ne3 : index
  %workgroup_size = config.get @hrx2_tuning_normx_workgroup_size : index
  %n12 = index.mul %ne1, %ne2 : index
  %nrows = index.mul %n12, %ne3 : index
  kernel.launch.config workgroups(%nrows, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%eps: f32, %src0: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %ncols = config.get @hrx2_shape_normx_ncols : index
  %ne1 = config.get @hrx2_shape_normx_ne1 : index
  %ne2 = config.get @hrx2_shape_normx_ne2 : index
  %s1 = config.get @hrx2_shape_normx_s1 : index
  %s2 = config.get @hrx2_shape_normx_s2 : index
  %s3 = config.get @hrx2_shape_normx_s3 : index
  %workgroup_size = config.get @hrx2_tuning_normx_workgroup_size : index
  %ncols_b = index.assume %ncols [range(%ncols, 1, 65536)] : index
  %ne1_b = index.assume %ne1 [range(%ne1, 1, 1048576)] : index
  %ne2_b = index.assume %ne2 [range(%ne2, 1, 1048576)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 1073741823)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %src_global = buffer.assume.memory_space<global> %src0 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src_na, %dst_na = buffer.assume.noalias %src_global, %dst_global : buffer, buffer
  %src_view = buffer.view %src_na[%base] : buffer -> view<1073741824xf32, #dense>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32, #dense>

  // row -> (i1, i2, i3), then the strided source base for that row.
  %n12 = index.mul %ne1_b, %ne2_b : index
  %i3 = index.div %row, %n12 : index
  %r12 = index.rem %row, %n12 : index
  %i2 = index.div %r12, %ne1_b : index
  %i1 = index.rem %r12, %ne1_b : index
  %o1 = index.mul %i1, %s1 : index
  %o2 = index.mul %i2, %s2 : index
  %o3 = index.mul %i3, %s3 : index
  %o12 = index.add %o1, %o2 : index
  %src_base0 = index.add %o12, %o3 : index
  %src_base = index.assume %src_base0 [range(%src_base0, 0, 1073741823)] : index
  %dst_base0 = index.mul %row, %ncols_b : index
  %dst_base = index.assume %dst_base0 [range(%dst_base0, 0, 1073741823)] : index

  %sum = scf.for %col = [%lane to %ncols_b step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %si0 = index.add %src_base, %col : index
    %si = index.assume %si0 [range(%si0, 0, 1073741823)] : index
    %value = view.load %src_view[%si] : view<1073741824xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }

  %row_sum = kernel.workgroup.reduce<addf> %sum : f32
  %ncols_i32 = index.cast %ncols_b : index to i32
  %ncols_f32 = scalar.sitofp %ncols_i32 : i32 to f32
  %mean = scalar.divf<reassoc|nnan|ninf|nsz> %row_sum, %ncols_f32 : f32
  %biased = scalar.addf<nnan|ninf|nsz> %mean, %eps : f32
  %scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased : f32

  scf.for %col = [%lane to %ncols_b step %workgroup_size] {
    %si0 = index.add %src_base, %col : index
    %si = index.assume %si0 [range(%si0, 0, 1073741823)] : index
    %value = view.load %src_view[%si] : view<1073741824xf32, #dense> -> f32
    %result = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
    %di0 = index.add %dst_base, %col : index
    %di = index.assume %di0 [range(%di0, 0, 1073741823)] : index
    view.store %result, %dst_view[%di] : f32, view<1073741824xf32, #dense>
  }
  kernel.return
}

kernel.def export("hrx2_l2_norm_strided_f32") @hrx2_l2_norm_strided_f32() {
  %unit = index.constant 1 : index
  %ne1 = config.get @hrx2_shape_normx_ne1 : index
  %ne2 = config.get @hrx2_shape_normx_ne2 : index
  %ne3 = config.get @hrx2_shape_normx_ne3 : index
  %workgroup_size = config.get @hrx2_tuning_normx_workgroup_size : index
  %n12 = index.mul %ne1, %ne2 : index
  %nrows = index.mul %n12, %ne3 : index
  kernel.launch.config workgroups(%nrows, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%eps: f32, %src0: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %ncols = config.get @hrx2_shape_normx_ncols : index
  %ne1 = config.get @hrx2_shape_normx_ne1 : index
  %ne2 = config.get @hrx2_shape_normx_ne2 : index
  %s1 = config.get @hrx2_shape_normx_s1 : index
  %s2 = config.get @hrx2_shape_normx_s2 : index
  %s3 = config.get @hrx2_shape_normx_s3 : index
  %workgroup_size = config.get @hrx2_tuning_normx_workgroup_size : index
  %ncols_b = index.assume %ncols [range(%ncols, 1, 65536)] : index
  %ne1_b = index.assume %ne1 [range(%ne1, 1, 1048576)] : index
  %ne2_b = index.assume %ne2 [range(%ne2, 1, 1048576)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 1073741823)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %src_global = buffer.assume.memory_space<global> %src0 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src_na, %dst_na = buffer.assume.noalias %src_global, %dst_global : buffer, buffer
  %src_view = buffer.view %src_na[%base] : buffer -> view<1073741824xf32, #dense>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<1073741824xf32, #dense>

  %n12 = index.mul %ne1_b, %ne2_b : index
  %i3 = index.div %row, %n12 : index
  %r12 = index.rem %row, %n12 : index
  %i2 = index.div %r12, %ne1_b : index
  %i1 = index.rem %r12, %ne1_b : index
  %o1 = index.mul %i1, %s1 : index
  %o2 = index.mul %i2, %s2 : index
  %o3 = index.mul %i3, %s3 : index
  %o12 = index.add %o1, %o2 : index
  %src_base0 = index.add %o12, %o3 : index
  %src_base = index.assume %src_base0 [range(%src_base0, 0, 1073741823)] : index
  %dst_base0 = index.mul %row, %ncols_b : index
  %dst_base = index.assume %dst_base0 [range(%dst_base0, 0, 1073741823)] : index

  %sum = scf.for %col = [%lane to %ncols_b step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %si0 = index.add %src_base, %col : index
    %si = index.assume %si0 [range(%si0, 0, 1073741823)] : index
    %value = view.load %src_view[%si] : view<1073741824xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }

  %row_sum = kernel.workgroup.reduce<addf> %sum : f32
  // torch.nn.functional.normalize clamps the *squared* norm against eps^2.
  %eps_sq = scalar.mulf<nnan|ninf|nsz> %eps, %eps : f32
  %clamped = scalar.maxnumf %row_sum, %eps_sq : f32
  %scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %clamped : f32

  scf.for %col = [%lane to %ncols_b step %workgroup_size] {
    %si0 = index.add %src_base, %col : index
    %si = index.assume %si0 [range(%si0, 0, 1073741823)] : index
    %value = view.load %src_view[%si] : view<1073741824xf32, #dense> -> f32
    %result = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
    %di0 = index.add %dst_base, %col : index
    %di = index.assume %di0 [range(%di0, 0, 1073741823)] : index
    view.store %result, %dst_view[%di] : f32, view<1073741824xf32, #dense>
  }
  kernel.return
}
