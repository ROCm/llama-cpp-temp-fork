    %wsp1_slot0 = index.add %tid, %wsp1_off : index
    %wsp1_slot = index.assume %wsp1_slot0 [range(%wsp1_slot0, 0, 127)] : index
    %wsp1_row = index.div %wsp1_slot, %k_blocks : index
    %wsp1_block_l = index.rem %wsp1_slot, %k_blocks : index
    %wsp1_row_g0 = index.add %weight_row_base, %wsp1_row : index
    %wsp1_row_g = index.assume %wsp1_row_g0 [range(%wsp1_row_g0, 0, 262143)] : index
    %wsp1_block_g = index.add %chunk_blk, %wsp1_block_l : index
    %wsp1_block0 = index.mul %wsp1_row_g, %kblocks : index
    %wsp1_block1 = index.add %wsp1_block0, %wsp1_block_g : index
    %wsp1_block = index.assume %wsp1_block1 [range(%wsp1_block1, 0, 31580640)] : index
    %wsp1_scale_i0 = index.mul %wsp1_block, %c17 : index
    %wsp1_scale_i = index.assume %wsp1_scale_i0 [range(%wsp1_scale_i0, 0, 536870911)] : index
