  %slot_segment = index.assume %slot_segment0 [range(%slot_segment0, 0, 42)] : index
  %slot_group0 = index.div %slot_segment, %eight : index
  %slot_group = index.assume %slot_group0 [range(%slot_group0, 0, 5)] : index
  %slot_in_group0 = index.rem %slot_segment, %eight : index
