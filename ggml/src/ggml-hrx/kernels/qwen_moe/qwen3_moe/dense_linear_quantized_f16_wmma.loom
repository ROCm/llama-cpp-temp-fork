    %addend_value = view.load %addend_view[%dst_index] : view<[%dst_count]xf32> -> f32
    %scaled = scalar.mulf<nnan|ninf|nsz> %dot, %gate : f32
    %result = scalar.addf<nnan|ninf|nsz> %addend_value, %scaled : f32
    view.store %result, %dst_view[%dst_index] : f32, view<[%dst_count]xf32>
  }
  kernel.return
}
