// Direct-global grouped-query FlashAttention for the F32-query/F16-cache path.
//
// One four-wave workgroup computes 16 query rows for one query head against
// 64 KV rows at a time. The ownership changes mirror the cooperative-matrix
// schedule used by llama.cpp's Vulkan CM1 kernel:
//
//   1. All workitems stage an unscaled 16x256 F16 query tile.
//   2. Each wave computes one 16x16 QK score slice.
//   3. Scores cross LDS so each wave can normalize four complete query rows.
//   4. F16 probabilities cross LDS for four P*V WMMA steps.
//   5. Each active lane retains one four-channel F32 packet for each of its
//      four query rows across subsequent 64-row KV blocks.
//
// K and V remain in the row-major llama.cpp cache layout
// [KV token][KV head][256]. Their aligned F16 fragments load directly from
// global memory; there is no expanded or repacked persistent allocation. QK
// and the online-softmax statistics remain F32. P*V and carried output
// remain F32 to match the accepted gfx1151 numerical policy.
amdgpu.target<gfx11-generic> @hrx2_fa_direct_kv64_f32acc_gate_gfx11_wave64 {subgroup_size = 64}

config.decl @hrx2_shape_fa_d : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_shape_fa_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_fa_nheads : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_fa_nkv : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_fa_gqa : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_fa_q_stride_token : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_q_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_k_stride_pos : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_k_stride_head : %value: index where [range(%value, 0, 16777216)]
config.decl @hrx2_shape_fa_v_stride_pos : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_v_stride_head : %value: index where [range(%value, 0, 16777216)]
config.decl @hrx2_shape_fa_mask_stride_token : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_dst_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_dst_stride_token : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_gate_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_gate_stride_token : %value: index where [range(%value, 1, 16777216)]

