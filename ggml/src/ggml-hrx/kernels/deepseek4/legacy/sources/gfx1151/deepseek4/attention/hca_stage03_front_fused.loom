      %r1_cache_base0 = index.mul %r1_cache_row, %c512 : index
      %r1_cache_index0_0 = index.add %r1_cache_base0,
          %r1_col0_out : index
      %r1_cache_index1_0 = index.add %r1_cache_base0,
          %r1_col1_out : index
      %r1_cache_index0 = index.assume %r1_cache_index0_0
          [range(%r1_cache_index0_0, 0, 131071)] : index
      %r1_cache_index1 = index.assume %r1_cache_index1_0
          [range(%r1_cache_index1_0, 0, 131071)] : index
      %r1_half0 = scalar.fptrunc %r1_value0 : f32 to f16
      %r1_half1 = scalar.fptrunc %r1_value1 : f32 to f16
      %r1_half_bits0 = scalar.bitcast %r1_half0 : f16 to i16
      %r1_half_bits1 = scalar.bitcast %r1_half1 : f16 to i16
      view.store %r1_half_bits0, %cache_v[%r1_cache_index0] :
          i16, view<131072xi16, #dense>
      view.store %r1_half_bits1, %cache_v[%r1_cache_index1] :
          i16, view<131072xi16, #dense>
    }
  }
  %r1_acc0 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r0_acc1, %r1_value0 : f32
  %r1_acc1 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r1_acc0, %r1_value1 : f32

  %r2_base = index.constant 1024 : index
  // Preserve the accepted strided RMS kernel's reduction recurrence exactly:
  // each of 256 lanes accumulates col=lane, then col=lane+256, before the
  // workgroup reduction.  A 32-lane vector reduction changes association and
  // can cross an F16 rounding boundary in the recurrent cache publication.
  %r2_index0_0 = index.add %r2_base, %lane : index
  %r2_index1_0 = index.add %r2_index0_0, %c256 : index
  %r2_index0 = index.assume %r2_index0_0
      [range(%r2_index0_0, 1024, 1279)] : index
  %r2_index1 = index.assume %r2_index1_0
      [range(%r2_index1_0, 1280, 1535)] : index
  %r2_src0 = view.load %src_v[%r2_index0] :
      view<2048xf32, #dense> -> f32
  %r2_src1 = view.load %src_v[%r2_index1] :
      view<2048xf32, #dense> -> f32
  %r2_square0 = scalar.mulf<reassoc|nnan|ninf|nsz>
      %r2_src0, %r2_src0 : f32
  %r2_square1 = scalar.mulf<reassoc|nnan|ninf|nsz>
      %r2_src1, %r2_src1 : f32
  %r2_lane_sum0 = scalar.addf<reassoc|nnan|ninf|nsz>
      %zero_f32, %r2_square0 : f32
  %r2_lane_sum = scalar.addf<reassoc|nnan|ninf|nsz>
      %r2_lane_sum0, %r2_square1 : f32
  %r2_sum = kernel.workgroup.reduce<addf> %r2_lane_sum : f32
  %r2_mean = scalar.divf<reassoc|nnan|ninf|nsz>
      %r2_sum, %ncols_f32 : f32
  %r2_biased = scalar.addf<nnan|ninf|nsz> %r2_mean, %eps : f32
  %r2_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %r2_biased : f32
  %r2_row = index.constant 2 : index
  %r2_col0_out0 = index.add %lane, %zero : index
  %r2_col0_out = index.assume %r2_col0_out0
      [range(%r2_col0_out0, 0, 255)] : index
  %r2_col1_out0 = index.add %lane, %c256 : index
  %r2_col1_out = index.assume %r2_col1_out0
      [range(%r2_col1_out0, 256, 511)] : index
  %r2_value0 = func.call inline @dsv4_hca_stage03_value_f32(
      %src_na, %weight_na, %pos_na, %r2_row, %r2_col0_out,
      %r2_scale, %attn_factor, %beta_fast, %beta_slow, %ext_factor,
      %freq_base, %freq_scale, %n_ctx_orig)
      : (buffer, buffer, buffer, index, index, f32, f32, f32, f32, f32,
         f32, f32, index) -> (f32)
  %r2_value1 = func.call inline @dsv4_hca_stage03_value_f32(
      %src_na, %weight_na, %pos_na, %r2_row, %r2_col1_out,
      %r2_scale, %attn_factor, %beta_fast, %beta_slow, %ext_factor,
      %freq_base, %freq_scale, %n_ctx_orig)
      : (buffer, buffer, buffer, index, index, f32, f32, f32, f32, f32,
         f32, f32, index) -> (f32)
  %r2_index_word0 = index.constant 4 : index
  %r2_cache_row_i32 = view.load %indices_v[%r2_index_word0] :
      view<8xi32, #dense> -> i32
  %r2_cache_row_nonnegative = scalar.cmpi sge, %r2_cache_row_i32,
      %zero_i32 : i32
  scf.if %r2_cache_row_nonnegative {
    %r2_cache_row = index.cast %r2_cache_row_i32 : i32 to index
    %r2_cache_row_valid = index.cmp ult, %r2_cache_row, %c256 : index
    scf.if %r2_cache_row_valid {
      %r2_cache_base0 = index.mul %r2_cache_row, %c512 : index
      %r2_cache_index0_0 = index.add %r2_cache_base0,
          %r2_col0_out : index
      %r2_cache_index1_0 = index.add %r2_cache_base0,
          %r2_col1_out : index
      %r2_cache_index0 = index.assume %r2_cache_index0_0
          [range(%r2_cache_index0_0, 0, 131071)] : index
      %r2_cache_index1 = index.assume %r2_cache_index1_0
          [range(%r2_cache_index1_0, 0, 131071)] : index
      %r2_half0 = scalar.fptrunc %r2_value0 : f32 to f16
      %r2_half1 = scalar.fptrunc %r2_value1 : f32 to f16
      %r2_half_bits0 = scalar.bitcast %r2_half0 : f16 to i16
      %r2_half_bits1 = scalar.bitcast %r2_half1 : f16 to i16
      view.store %r2_half_bits0, %cache_v[%r2_cache_index0] :
          i16, view<131072xi16, #dense>
      view.store %r2_half_bits1, %cache_v[%r2_cache_index1] :
          i16, view<131072xi16, #dense>
    }
  }
  %r2_acc0 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r1_acc1, %r2_value0 : f32
  %r2_acc1 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r2_acc0, %r2_value1 : f32

  %r3_base = index.constant 1536 : index
  // Preserve the accepted strided RMS kernel's reduction recurrence exactly:
  // each of 256 lanes accumulates col=lane, then col=lane+256, before the
  // workgroup reduction.  A 32-lane vector reduction changes association and
  // can cross an F16 rounding boundary in the recurrent cache publication.
  %r3_index0_0 = index.add %r3_base, %lane : index
  %r3_index1_0 = index.add %r3_index0_0, %c256 : index
  %r3_index0 = index.assume %r3_index0_0
      [range(%r3_index0_0, 1536, 1791)] : index
  %r3_index1 = index.assume %r3_index1_0
      [range(%r3_index1_0, 1792, 2047)] : index
  %r3_src0 = view.load %src_v[%r3_index0] :
      view<2048xf32, #dense> -> f32
  %r3_src1 = view.load %src_v[%r3_index1] :
      view<2048xf32, #dense> -> f32
  %r3_square0 = scalar.mulf<reassoc|nnan|ninf|nsz>
      %r3_src0, %r3_src0 : f32
  %r3_square1 = scalar.mulf<reassoc|nnan|ninf|nsz>
      %r3_src1, %r3_src1 : f32
  %r3_lane_sum0 = scalar.addf<reassoc|nnan|ninf|nsz>
      %zero_f32, %r3_square0 : f32
  %r3_lane_sum = scalar.addf<reassoc|nnan|ninf|nsz>
      %r3_lane_sum0, %r3_square1 : f32
  %r3_sum = kernel.workgroup.reduce<addf> %r3_lane_sum : f32
  %r3_mean = scalar.divf<reassoc|nnan|ninf|nsz>
      %r3_sum, %ncols_f32 : f32
  %r3_biased = scalar.addf<nnan|ninf|nsz> %r3_mean, %eps : f32
  %r3_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %r3_biased : f32
  %r3_row = index.constant 3 : index
  %r3_col0_out0 = index.add %lane, %zero : index
  %r3_col0_out = index.assume %r3_col0_out0
      [range(%r3_col0_out0, 0, 255)] : index
  %r3_col1_out0 = index.add %lane, %c256 : index
  %r3_col1_out = index.assume %r3_col1_out0
      [range(%r3_col1_out0, 256, 511)] : index
  %r3_value0 = func.call inline @dsv4_hca_stage03_value_f32(
      %src_na, %weight_na, %pos_na, %r3_row, %r3_col0_out,
      %r3_scale, %attn_factor, %beta_fast, %beta_slow, %ext_factor,
      %freq_base, %freq_scale, %n_ctx_orig)
      : (buffer, buffer, buffer, index, index, f32, f32, f32, f32, f32,
         f32, f32, index) -> (f32)
  %r3_value1 = func.call inline @dsv4_hca_stage03_value_f32(
      %src_na, %weight_na, %pos_na, %r3_row, %r3_col1_out,
      %r3_scale, %attn_factor, %beta_fast, %beta_slow, %ext_factor,
      %freq_base, %freq_scale, %n_ctx_orig)
      : (buffer, buffer, buffer, index, index, f32, f32, f32, f32, f32,
         f32, f32, index) -> (f32)
  %r3_index_word0 = index.constant 6 : index
  %r3_cache_row_i32 = view.load %indices_v[%r3_index_word0] :
      view<8xi32, #dense> -> i32
  %r3_cache_row_nonnegative = scalar.cmpi sge, %r3_cache_row_i32,
      %zero_i32 : i32
  scf.if %r3_cache_row_nonnegative {
    %r3_cache_row = index.cast %r3_cache_row_i32 : i32 to index
    %r3_cache_row_valid = index.cmp ult, %r3_cache_row, %c256 : index
    scf.if %r3_cache_row_valid {
      %r3_cache_base0 = index.mul %r3_cache_row, %c512 : index
      %r3_cache_index0_0 = index.add %r3_cache_base0,
          %r3_col0_out : index
      %r3_cache_index1_0 = index.add %r3_cache_base0,
          %r3_col1_out : index
      %r3_cache_index0 = index.assume %r3_cache_index0_0
          [range(%r3_cache_index0_0, 0, 131071)] : index
      %r3_cache_index1 = index.assume %r3_cache_index1_0
          [range(%r3_cache_index1_0, 0, 131071)] : index
      %r3_half0 = scalar.fptrunc %r3_value0 : f32 to f16
      %r3_half1 = scalar.fptrunc %r3_value1 : f32 to f16
      %r3_half_bits0 = scalar.bitcast %r3_half0 : f16 to i16
      %r3_half_bits1 = scalar.bitcast %r3_half1 : f16 to i16
      view.store %r3_half_bits0, %cache_v[%r3_cache_index0] :
          i16, view<131072xi16, #dense>
      view.store %r3_half_bits1, %cache_v[%r3_cache_index1] :
          i16, view<131072xi16, #dense>
    }
  }
  %r3_acc0 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r2_acc1, %r3_value0 : f32
  %r3_acc1 = scalar.addf<reassoc|nnan|ninf|nsz>
      %r3_acc0, %r3_value1 : f32

  %total_sum = kernel.workgroup.reduce<addf> %r3_acc1 : f32
  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %total_sum, %sum_v[%zero] : f32, view<1xf32, #dense>
  }
  kernel.return
}
