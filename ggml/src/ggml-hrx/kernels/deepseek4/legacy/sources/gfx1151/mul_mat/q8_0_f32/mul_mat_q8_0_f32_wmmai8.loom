    %wpp0_block0 = index.mul %wpp0_row_g, %kblocks : index
    %wpp0_block1 = index.add %wpp0_block0, %wpp0_block_g : index
    %wpp0_block = index.assume %wpp0_block1 [range(%wpp0_block1, 0, 31580640)] : index
    %wpp0_byte0 = index.mul %wpp0_block, %c34 : index
    %wpp0_byte1 = index.add %wpp0_byte0, %two : index
    %wpp0_half_bytes = index.mul %wpp0_payload_half, %sixteen : index
    %wpp0_byte2 = index.add %wpp0_byte1, %wpp0_half_bytes : index
