      %p0_3_t1_rb_words = vector.bitcast %p0_3_t1_rb_raw : vector<16xi8> to vector<4xi32>
      %p0_3_t1_rb = vector.fragment<rhs> %p0_3_t1_rb_words shape [%k_wmma, %k_wmma] using {schema = %rd_i8_schema : encoding<schema>} : vector<4xi32>
