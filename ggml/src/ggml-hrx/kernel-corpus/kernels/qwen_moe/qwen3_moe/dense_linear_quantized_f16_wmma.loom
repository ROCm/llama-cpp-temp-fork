        %iq4_scale1 = func.call @qwen3_moe_dense_iq4xs_wmma_scale(%src0_na, %iq4_row_byte_base, %iq4_block, %iq4_group1) : (buffer, offset, index, index) -> (f32)
        %iq4_meta0_0 = index.mul %iq4_weight_tid, %two : index
