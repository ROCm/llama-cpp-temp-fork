  %secondary_v = buffer.view %secondary_g[%base] : buffer -> view<262144xf32, #dense>
  %secondary_weight_v = buffer.view %secondary_weight_g[%base] : buffer -> view<512xf32, #dense>
  %pos_v = buffer.view %pos_g[%base] : buffer -> view<512xi32, #dense>
  %cache_indices_v = buffer.view %cache_indices_g[%base] : buffer -> view<1024xi32, #dense>
  %cache_dst_v = buffer.view %cache_dst_g[%base] : buffer -> view<262144xi16, #dense>
  %primary_base0 = index.mul %row, %c512 : index
  %primary_base = index.assume %primary_base0 [range(%primary_base0, 0, 16776704)] : index
  %primary_sum = scf.for %col = [%lane to %c512 step %c256]
      (%acc = %zero_f32 : f32) -> (f32) {
    %index0 = index.add %primary_base, %col : index
    %index = index.assume %index0 [range(%index0, 0, 16777215)] : index
    %value = view.load %primary_v[%index] : view<16777216xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %primary_total = kernel.workgroup.reduce<addf> %primary_sum : f32
  %c512_i32 = scalar.constant 512 : i32
  %c512_f32 = scalar.sitofp %c512_i32 : i32 to f32
  %primary_mean = scalar.divf<reassoc|nnan|ninf|nsz> %primary_total, %c512_f32 : f32
  %primary_biased = scalar.addf<nnan|ninf|nsz> %primary_mean, %eps : f32
  %primary_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %primary_biased : f32
  scf.for %col = [%lane to %c448 step %c256] {
