  %cache_base0 = index.mul %cache_row_b, %c512 : index
  %cache_base = index.assume %cache_base0 [range(%cache_base0, 0, 130560)] : index

  scf.for %col = [%lane to %c448 step %c256] {
    %index = index.add %row_base, %col : index
    %raw = view.load %src_v[%index] : view<65536xf32, #dense> -> f32
    %normed = scalar.mulf<nnan|ninf|nsz> %raw, %rms_scale : f32
    %w = view.load %weight_v[%col] : view<512xf32, #dense> -> f32
    %value = scalar.mulf<nnan|ninf|nsz> %normed, %w : f32
    view.store %value, %projection_v[%index] : f32, view<65536xf32, #dense>
    scf.if %cache_valid {
      %half = scalar.fptrunc %value : f32 to f16
      %bits = scalar.bitcast %half : f16 to i16
      %cache_index = index.add %cache_base, %col : index
      view.store %bits, %cache_dst_v[%cache_index] : i16, view<131072xi16, #dense>
    }
  }

  %is_pair_lane = index.cmp ult, %lane, %c32 : index
  scf.if %is_pair_lane {
    %pair2 = index.mul %lane, %two : index
    %col0 = index.add %c448, %pair2 : index
    %col1 = index.add %col0, %one : index
    %index0 = index.add %row_base, %col0 : index
    %index1 = index.add %row_base, %col1 : index
    %raw0 = view.load %src_v[%index0] : view<65536xf32, #dense> -> f32
    %raw1 = view.load %src_v[%index1] : view<65536xf32, #dense> -> f32
    %norm0 = scalar.mulf<nnan|ninf|nsz> %raw0, %rms_scale : f32
    %norm1 = scalar.mulf<nnan|ninf|nsz> %raw1, %rms_scale : f32
    %w0 = view.load %weight_v[%col0] : view<512xf32, #dense> -> f32
    %w1 = view.load %weight_v[%col1] : view<512xf32, #dense> -> f32
    %x0 = scalar.mulf<nnan|ninf|nsz> %norm0, %w0 : f32
    %x1 = scalar.mulf<nnan|ninf|nsz> %norm1, %w1 : f32
    %pos_i32 = view.load %pos_v[%row] : view<128xi32, #dense> -> i32
    %out0, %out1 = func.call inline @dsv4_yarn_normal_pair_f32(
        %x0, %x1, %lane, %pos_i32, %attn_factor, %beta_fast, %beta_slow,
        %ext_factor, %freq_base, %freq_scale, %n_ctx_orig)
        : (f32, f32, index, i32, f32, f32, f32, f32, f32, f32, index) -> (f32, f32)
    view.store %out0, %projection_v[%index0] : f32, view<65536xf32, #dense>
    view.store %out1, %projection_v[%index1] : f32, view<65536xf32, #dense>
    scf.if %cache_valid {
      %half0 = scalar.fptrunc %out0 : f32 to f16
      %half1 = scalar.fptrunc %out1 : f32 to f16
      %bits0 = scalar.bitcast %half0 : f16 to i16
      %bits1 = scalar.bitcast %half1 : f16 to i16
      %cache_index0 = index.add %cache_base, %col0 : index
      %cache_index1 = index.add %cache_base, %col1 : index
      view.store %bits0, %cache_dst_v[%cache_index0] : i16, view<131072xi16, #dense>
      view.store %bits1, %cache_dst_v[%cache_index1] : i16, view<131072xi16, #dense>
