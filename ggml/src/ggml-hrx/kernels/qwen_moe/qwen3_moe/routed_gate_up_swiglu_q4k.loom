      %p1_2_t1_aui = vector.load %act_sum_view[%p1_2_t1_mb] : view<256xi32> -> vector<8xi32>
      %p1_2_t1_auv = vector.sitofp %p1_2_t1_aui : vector<8xi32> to vector<8xf32>
      %p1_2_t1_f = vector.sitofp %p1_2_t1_i1 : vector<8xi32> to vector<8xf32>
      %p1_2_t1_u = vector.mulf %p1_2_t1_f, %p1_2_t1_dv : vector<8xf32>
      %p1_2_t1_c = vector.mulf %p1_2_t1_auv, %p1_2_t1_mv : vector<8xf32>
      %p1_2_t1_y = vector.subf %p1_2_t1_u, %p1_2_t1_c : vector<8xf32>
