      %rd_p1_g0_own_i32 = vector.ori %rd_p1_g0_own_nib, %rd_p1_g0_qh_masked : vector<4xi32>
      %rd_p1_g1_own_shift = vector.shrui %rd_p1_pack0, %four_i32v4 : vector<4xi32>
      %rd_p1_g1_own_nib = vector.andi %rd_p1_g1_own_shift, %nibble_mask_v4 : vector<4xi32>
      %rd_p1_g1_qh_masked = vector.andi %rd_qh, %rd_qh_mask5 : vector<4xi32>
      %rd_p1_g1_qh_hi = vector.shrui %rd_p1_g1_qh_masked, %rd_qh_shift1 : vector<4xi32>
      %rd_p1_g1_own_i32 = vector.ori %rd_p1_g1_own_nib, %rd_p1_g1_qh_hi : vector<4xi32>
      %rd_p1_g2_own_nib = vector.andi %rd_p1_pack1, %nibble_mask_v4 : vector<4xi32>
      %rd_p1_g2_qh_masked = vector.andi %rd_qh, %rd_qh_mask6 : vector<4xi32>
      %rd_p1_g2_qh_hi = vector.shrui %rd_p1_g2_qh_masked, %rd_qh_shift2 : vector<4xi32>
      %rd_p1_g2_own_i32 = vector.ori %rd_p1_g2_own_nib, %rd_p1_g2_qh_hi : vector<4xi32>
