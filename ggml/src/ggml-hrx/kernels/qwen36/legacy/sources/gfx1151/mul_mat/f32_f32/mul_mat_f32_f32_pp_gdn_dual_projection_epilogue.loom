// PP GDN alpha/beta projections with exact epilogues.
//
// This is the accepted 32-row x 16-column x K64 F32 projection topology with
// two independent weight streams. Both projections retain the accepted
// vector-FMA sequence and split-K reduction tree, while one activation LDS
// stage feeds both. Separate alpha/beta reduction regions keep one barrier and
// raise LDS from 24,576 B to exactly 32,768 B, which retains two WG1024
// workgroups per CU on gfx1151.
//
// The final stores fold:
//   gate = softplus(alpha + bias) * a_scale
//   beta = sigmoid(beta_raw)

config.decl @hrx2_gdn_pp_dual_projection_k : %value: index where [range(%value, 4, 32768), mul(%value, 4)]
config.decl @hrx2_gdn_pp_dual_projection_rows : %value: index where [range(%value, 1, 262144)]
config.decl @hrx2_gdn_pp_dual_projection_cols : %value: index where [range(%value, 1, 32768)]

kernel.def export("hrx2_mul_mat_f32_f32_pp_gdn_dual_projection_epilogue")
    @hrx2_mul_mat_f32_f32_pp_gdn_dual_projection_epilogue() {
  %unit = index.constant 1 : index
  %rt = index.constant 32 : index
  %rt_m1 = index.constant 31 : index
  %ct = index.constant 16 : index
  %ct_m1 = index.constant 15 : index
  %wg = index.constant 1024 : index
  %rows = config.get @hrx2_gdn_pp_dual_projection_rows : index
  %cols = config.get @hrx2_gdn_pp_dual_projection_cols : index
  %rows_up = index.add %rows, %rt_m1 : index
  %row_tiles = index.div %rows_up, %rt : index
  %cols_up = index.add %cols, %ct_m1 : index
  %col_tiles = index.div %cols_up, %ct : index
  kernel.launch.config workgroups(%col_tiles, %row_tiles, %unit)
      workgroup_size(%wg, %unit, %unit) : index
} launch(
    %alpha_weight: buffer,
    %beta_weight: buffer,
    %input: buffer,
    %bias: buffer,
    %a_scale: buffer,
    %gate_dst: buffer,
    %beta_dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %k_cpl_c = index.constant 2 : index
  %k_quads = index.constant 16 : index
  %k_wg = index.constant 256 : index
  %k_sk = index.constant 4 : index
  %k_sk_m1 = index.constant 3 : index
  %k_sl0 = index.constant 0 : index
  %k_sl1 = index.constant 512 : index
  %k_sl2 = index.constant 1024 : index
  %k_sl3 = index.constant 1536 : index
  %k_act_elems = index.constant 1024 : index
  %k_ac1 = index.constant 64 : index
  %k_col1 = index.constant 1 : index
  %k_rt = index.constant 32 : index
  %k_ct = index.constant 16 : index
  %k_kc = index.constant 64 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %zero_v4 = vector.constant 0.0 : vector<4xf32>

  %k = config.get @hrx2_gdn_pp_dual_projection_k : index
  %rows = config.get @hrx2_gdn_pp_dual_projection_rows : index
  %cols = config.get @hrx2_gdn_pp_dual_projection_cols : index
  %k_b = index.assume %k [range(%k, 4, 32768)] : index
  %rows_b = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 32768)] : index
  %nchunks = index.div %k_b, %k_kc : index

  %col_tile0 = kernel.workgroup.id<x> : index
  %row_tile0 = kernel.workgroup.id<y> : index
  %tid0 = kernel.workitem.id<x> : index
  %col_tile =
      index.assume %col_tile0 [range(%col_tile0, 0, 32767)] : index
  %row_tile =
      index.assume %row_tile0 [range(%row_tile0, 0, 262143)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 1023)] : index
  %k_slice = index.div %tid, %k_wg : index
  %sub = index.rem %tid, %k_wg : index

  %alpha_weight_g =
      buffer.assume.memory_space<global> %alpha_weight : buffer
  %beta_weight_g =
      buffer.assume.memory_space<global> %beta_weight : buffer
  %input_g = buffer.assume.memory_space<global> %input : buffer
  %bias_g = buffer.assume.memory_space<global> %bias : buffer
  %a_scale_g = buffer.assume.memory_space<global> %a_scale : buffer
  %gate_dst_g = buffer.assume.memory_space<global> %gate_dst : buffer
  %beta_dst_g = buffer.assume.memory_space<global> %beta_dst : buffer
  %alpha_weight_na, %beta_weight_na, %input_na, %bias_na, %a_scale_na,
      %gate_dst_na, %beta_dst_na = buffer.assume.noalias
      %alpha_weight_g, %beta_weight_g, %input_g, %bias_g, %a_scale_g,
      %gate_dst_g, %beta_dst_g :
      buffer, buffer, buffer, buffer, buffer, buffer, buffer

  %input_view =
      buffer.view %input_na[%base] :
      buffer -> view<1073741824xf32>
  %bias_view =
      buffer.view %bias_na[%base] :
      buffer -> view<1073741824xf32>
  %a_scale_view =
      buffer.view %a_scale_na[%base] :
      buffer -> view<1073741824xf32>
  %gate_dst_view =
      buffer.view %gate_dst_na[%base] :
      buffer -> view<1073741824xf32>
  %beta_dst_view =
      buffer.view %beta_dst_na[%base] :
      buffer -> view<1073741824xf32>

  %lds_bytes = index.constant 32768 : offset
  %scratch =
      buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %av_e = index.mul %k_slice, %k_act_elems : index
  %av_b = index.mul %av_e, %four : index
  %av_o = index.cast %av_b : index to offset
  %act_view =
      buffer.view %scratch[%av_o] :
      buffer -> view<1024xf32>

  %lane_row = index.rem %sub, %k_rt : index
  %col_grp = index.div %sub, %k_rt : index
  %row_base = index.mul %row_tile, %k_rt : index
  %row_raw = index.add %row_base, %lane_row : index
  %row_valid = index.cmp ult, %row_raw, %rows_b : index
  %row_safe = index.rem %row_raw, %rows_b : index
  %w_row_base = index.mul %row_safe, %k_b : index
  %col_tile_base = index.mul %col_tile, %k_ct : index
  %lane_col_l = index.mul %col_grp, %k_cpl_c : index
  %lane_col_g = index.add %col_tile_base, %lane_col_l : index

  %lane_col_l_kc = index.mul %lane_col_l, %k_kc : index
  %niter_r = index.add %nchunks, %k_sk_m1 : index
  %niter = index.div %niter_r, %k_sk : index
  %ao0, %ao1, %bo0, %bo1 =
      scf.for %iter = [%zero to %niter step %one](
          %ab0 = %zero_v4 : vector<4xf32>,
          %ab1 = %zero_v4 : vector<4xf32>,
          %bb0 = %zero_v4 : vector<4xf32>,
          %bb1 = %zero_v4 : vector<4xf32>) ->
          (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %chunk_m = index.mul %iter, %k_sk : index
    %chunk_r = index.add %chunk_m, %k_slice : index
    %chunk_ok = index.cmp ult, %chunk_r, %nchunks : index
    %chunk = index.rem %chunk_r, %nchunks : index
    %chunk_k = index.mul %chunk, %k_kc : index

    // One accepted 16-column x K64 activation stage feeds both projections.
    %sc0_l = index.div %sub, %k_quads : index
    %sq0 = index.rem %sub, %k_quads : index
    %sc0_g0 = index.add %col_tile_base, %sc0_l : index
    %sc0_ok = index.cmp ult, %sc0_g0, %cols_b : index
    %sc0_g = index.rem %sc0_g0, %cols_b : index
    %ss0_0 = index.mul %sc0_g, %k_b : index
    %ss0_1 = index.add %ss0_0, %chunk_k : index
    %ss0_2 = index.mul %sq0, %four : index
    %ss0_r = index.add %ss0_1, %ss0_2 : index
    %ss0 = index.assume %ss0_r [range(%ss0_r, 0, 1073741820)] : index
    %sv0_0 =
        vector.load %input_view[%ss0] :
        view<1073741824xf32> -> vector<4xf32>
    %sv0_c =
        scf.select %sc0_ok, %sv0_0, %zero_v4 : vector<4xf32>
    %sv0 =
        scf.select %chunk_ok, %sv0_c, %zero_v4 : vector<4xf32>
    %sd0_0 = index.mul %sc0_l, %k_kc : index
    %sd0_1 = index.mul %sq0, %four : index
    %sd0_r = index.add %sd0_0, %sd0_1 : index
    %sd0 = index.assume %sd0_r [range(%sd0_r, 0, 1020)] : index
    vector.store %sv0, %act_view[%sd0] :
        vector<4xf32>, view<1024xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %an0, %an1, %bn0, %bn1 =
        scf.for %q = [%zero to %k_quads step %one](
            %ac0 = %ab0 : vector<4xf32>,
            %ac1 = %ab1 : vector<4xf32>,
            %bc0 = %bb0 : vector<4xf32>,
            %bc1 = %bb1 : vector<4xf32>) ->
            (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %qk = index.mul %q, %four : index
      %wg_0 = index.add %w_row_base, %chunk_k : index
      %wg_1 = index.add %wg_0, %qk : index
      %wg_i =
          index.assume %wg_1 [range(%wg_1, 0, 1073741820)] : index
      %wg_by = index.mul %wg_i, %four : index
      %wv_off = index.cast %wg_by : index to offset
      %aw_view =
          buffer.view %alpha_weight_na[%wv_off] :
          buffer -> view<4xf32>
      %bw_view =
          buffer.view %beta_weight_na[%wv_off] :
          buffer -> view<4xf32>
      %aw =
          vector.load %aw_view[%zero] :
          view<4xf32> -> vector<4xf32>
      %bw =
          vector.load %bw_view[%zero] :
          view<4xf32> -> vector<4xf32>
      %al_base = index.add %lane_col_l_kc, %qk : index
      %ai0 = index.assume %al_base [range(%al_base, 0, 1020)] : index
      %av0 =
          vector.load %act_view[%ai0] :
          view<1024xf32> -> vector<4xf32>
      %an0 = vector.fmaf %aw, %av0, %ac0 :
          vector<4xf32>
      %bn0 = vector.fmaf %bw, %av0, %bc0 :
          vector<4xf32>
      %ai1_r = index.add %al_base, %k_ac1 : index
      %ai1 =
          index.assume %ai1_r [range(%ai1_r, 0, 1020)] : index
      %av1 =
          vector.load %act_view[%ai1] :
          view<1024xf32> -> vector<4xf32>
      %an1 = vector.fmaf %aw, %av1, %ac1 :
          vector<4xf32>
      %bn1 = vector.fmaf %bw, %av1, %bc1 :
          vector<4xf32>
      scf.yield %an0, %an1, %bn0, %bn1 :
          vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %an0, %an1, %bn0, %bn1 :
        vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }

  // Preserve the accepted per-projection split-K tree in disjoint LDS regions.
  %red_e = index.constant 4096 : index
  %red_b = index.mul %red_e, %four : index
  %red_a_o = index.cast %red_b : index to offset
  %red_a_view =
      buffer.view %scratch[%red_a_o] :
      buffer -> view<2048xf32>
  %red_b_e = index.constant 6144 : index
  %red_b_b = index.mul %red_b_e, %four : index
  %red_b_o = index.cast %red_b_b : index to offset
  %red_b_view =
      buffer.view %scratch[%red_b_o] :
      buffer -> view<2048xf32>
  %k_wgcpl = index.constant 512 : index
  %slot_s = index.mul %k_slice, %k_wgcpl : index
  %slot_t = index.mul %sub, %k_cpl_c : index
  %slot = index.add %slot_s, %slot_t : index

  %app0 =
      vector.reduce<addf, reassoc|nnan|nsz> %ao0, %zero_f32 :
      vector<4xf32>, f32
  %sl0 = index.add %slot, %zero : index
  view.store %app0, %red_a_view[%sl0] :
      f32, view<2048xf32>
  %app1 =
      vector.reduce<addf, reassoc|nnan|nsz> %ao1, %zero_f32 :
      vector<4xf32>, f32
  %sl1 = index.add %slot, %k_col1 : index
  view.store %app1, %red_a_view[%sl1] :
      f32, view<2048xf32>
  %bpp0 =
      vector.reduce<addf, reassoc|nnan|nsz> %bo0, %zero_f32 :
      vector<4xf32>, f32
  view.store %bpp0, %red_b_view[%sl0] :
      f32, view<2048xf32>
  %bpp1 =
      vector.reduce<addf, reassoc|nnan|nsz> %bo1, %zero_f32 :
      vector<4xf32>, f32
  view.store %bpp1, %red_b_view[%sl1] :
      f32, view<2048xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %is_s0 = index.cmp eq, %k_slice, %zero : index
  %rb0 = index.add %slot_t, %zero : index
  %rr0_0 = index.add %rb0, %k_sl0 : index
  %rr0_1 = index.add %rb0, %k_sl1 : index
  %rr0_2 = index.add %rb0, %k_sl2 : index
  %rr0_3 = index.add %rb0, %k_sl3 : index
  %arv0_0 =
      view.load %red_a_view[%rr0_0] :
      view<2048xf32> -> f32
  %arv0_1 =
      view.load %red_a_view[%rr0_1] :
      view<2048xf32> -> f32
  %arv0_2 =
      view.load %red_a_view[%rr0_2] :
      view<2048xf32> -> f32
  %arv0_3 =
      view.load %red_a_view[%rr0_3] :
      view<2048xf32> -> f32
  %ara0_1 = scalar.addf<nnan|nsz> %arv0_0, %arv0_1 : f32
  %ara0_2 = scalar.addf<nnan|nsz> %ara0_1, %arv0_2 : f32
  %ara0_3 = scalar.addf<nnan|nsz> %ara0_2, %arv0_3 : f32
  %brv0_0 =
      view.load %red_b_view[%rr0_0] :
      view<2048xf32> -> f32
  %brv0_1 =
      view.load %red_b_view[%rr0_1] :
      view<2048xf32> -> f32
  %brv0_2 =
      view.load %red_b_view[%rr0_2] :
      view<2048xf32> -> f32
  %brv0_3 =
      view.load %red_b_view[%rr0_3] :
      view<2048xf32> -> f32
  %bra0_1 = scalar.addf<nnan|nsz> %brv0_0, %brv0_1 : f32
  %bra0_2 = scalar.addf<nnan|nsz> %bra0_1, %brv0_2 : f32
  %bra0_3 = scalar.addf<nnan|nsz> %bra0_2, %brv0_3 : f32

  %rb1 = index.add %slot_t, %k_col1 : index
  %rr1_0 = index.add %rb1, %k_sl0 : index
  %rr1_1 = index.add %rb1, %k_sl1 : index
  %rr1_2 = index.add %rb1, %k_sl2 : index
  %rr1_3 = index.add %rb1, %k_sl3 : index
  %arv1_0 =
      view.load %red_a_view[%rr1_0] :
      view<2048xf32> -> f32
  %arv1_1 =
      view.load %red_a_view[%rr1_1] :
      view<2048xf32> -> f32
  %arv1_2 =
      view.load %red_a_view[%rr1_2] :
      view<2048xf32> -> f32
  %arv1_3 =
      view.load %red_a_view[%rr1_3] :
      view<2048xf32> -> f32
  %ara1_1 = scalar.addf<nnan|nsz> %arv1_0, %arv1_1 : f32
  %ara1_2 = scalar.addf<nnan|nsz> %ara1_1, %arv1_2 : f32
  %ara1_3 = scalar.addf<nnan|nsz> %ara1_2, %arv1_3 : f32
  %brv1_0 =
      view.load %red_b_view[%rr1_0] :
      view<2048xf32> -> f32
  %brv1_1 =
      view.load %red_b_view[%rr1_1] :
      view<2048xf32> -> f32
  %brv1_2 =
      view.load %red_b_view[%rr1_2] :
      view<2048xf32> -> f32
  %brv1_3 =
      view.load %red_b_view[%rr1_3] :
      view<2048xf32> -> f32
  %bra1_1 = scalar.addf<nnan|nsz> %brv1_0, %brv1_1 : f32
  %bra1_2 = scalar.addf<nnan|nsz> %bra1_1, %brv1_2 : f32
  %bra1_3 = scalar.addf<nnan|nsz> %bra1_2, %brv1_3 : f32

  scf.if %is_s0 {
    %bias_value =
        view.load %bias_view[%row_safe] :
        view<1073741824xf32> -> f32
    %a_value =
        view.load %a_scale_view[%row_safe] :
        view<1073741824xf32> -> f32

    %dc0_r = index.add %lane_col_g, %zero : index
    %dc0_ok = index.cmp ult, %dc0_r, %cols_b : index
    %dc0 = index.rem %dc0_r, %cols_b : index
    %di0_0 = index.mul %dc0, %rows_b : index
    %di0_r = index.add %di0_0, %row_raw : index
    %di0 =
        index.assume %di0_r [range(%di0_r, 0, 1073741823)] : index

    %alpha_raw0 =
        scalar.addf<nnan|nsz> %ara0_3, %zero_f32 : f32
    %biased0 =
        scalar.addf<nnan|ninf|nsz> %alpha_raw0, %bias_value : f32
    %abs0 = scalar.absf %biased0 : f32
    %neg_abs0 = scalar.negf %abs0 : f32
    %exp0 = scalar.expf<afn> %neg_abs0 : f32
    %one_plus0 =
        scalar.addf<nnan|ninf|nsz> %one_f32, %exp0 : f32
    %log0 = scalar.logf<afn> %one_plus0 : f32
    %pos0 = scalar.maxnumf %biased0, %zero_f32 : f32
    %softplus0 =
        scalar.addf<nnan|ninf|nsz> %pos0, %log0 : f32
    %gate0 =
        scalar.mulf<nnan|ninf|nsz> %softplus0, %a_value : f32
    %beta_raw0 =
        scalar.addf<nnan|nsz> %bra0_3, %zero_f32 : f32
    %beta0 = scalar.logisticf<afn> %beta_raw0 : f32
    scf.if %dc0_ok {
      scf.if %row_valid {
        view.store %gate0, %gate_dst_view[%di0] :
            f32, view<1073741824xf32>
        view.store %beta0, %beta_dst_view[%di0] :
            f32, view<1073741824xf32>
      }
    }

    %dc1_r = index.add %lane_col_g, %k_col1 : index
    %dc1_ok = index.cmp ult, %dc1_r, %cols_b : index
    %dc1 = index.rem %dc1_r, %cols_b : index
    %di1_0 = index.mul %dc1, %rows_b : index
    %di1_r = index.add %di1_0, %row_raw : index
    %di1 =
        index.assume %di1_r [range(%di1_r, 0, 1073741823)] : index

    %alpha_raw1 =
        scalar.addf<nnan|nsz> %ara1_3, %zero_f32 : f32
    %biased1 =
        scalar.addf<nnan|ninf|nsz> %alpha_raw1, %bias_value : f32
    %abs1 = scalar.absf %biased1 : f32
    %neg_abs1 = scalar.negf %abs1 : f32
    %exp1 = scalar.expf<afn> %neg_abs1 : f32
    %one_plus1 =
        scalar.addf<nnan|ninf|nsz> %one_f32, %exp1 : f32
    %log1 = scalar.logf<afn> %one_plus1 : f32
    %pos1 = scalar.maxnumf %biased1, %zero_f32 : f32
    %softplus1 =
        scalar.addf<nnan|ninf|nsz> %pos1, %log1 : f32
    %gate1 =
        scalar.mulf<nnan|ninf|nsz> %softplus1, %a_value : f32
    %beta_raw1 =
        scalar.addf<nnan|nsz> %bra1_3, %zero_f32 : f32
    %beta1 = scalar.logisticf<afn> %beta_raw1 : f32
    scf.if %dc1_ok {
      scf.if %row_valid {
        view.store %gate1, %gate_dst_view[%di1] :
            f32, view<1073741824xf32>
        view.store %beta1, %beta_dst_view[%di1] :
            f32, view<1073741824xf32>
      }
    }
  }
  kernel.return
}
