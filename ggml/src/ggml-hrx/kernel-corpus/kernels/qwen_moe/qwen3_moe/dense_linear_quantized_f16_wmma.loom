// Prompt-specialized raw-Q5_K contraction against a shared native Q8_1_x4
// alternate. C++ admits only complete 128-token and 64-channel tiles.
kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_q5k_q8_1_x4_wmmai8(%token_count: index) {
  %unit = index.constant 1 : index
  %tile_rows = index.constant 64 : index
  %tile_tokens = index.constant 128 : index
  %workgroup_size = index.constant 128 : index
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %row_tiles = index.div %output_size, %tile_rows : index
  %token_tiles = index.div %token_capacity, %tile_tokens : index
  kernel.launch.config workgroups(%token_tiles, %row_tiles, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
