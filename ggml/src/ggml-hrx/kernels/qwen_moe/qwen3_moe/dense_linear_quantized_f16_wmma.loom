// Q4_K entry point. Its literal format selection specializes the shared body
// before target lowering.
kernel.def target(@qwen3_moe_dense_gfx11_wave64) @qwen3_moe_dense_linear_q4k_f16_wmma(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %c1 = index.constant 1 : index
  %c127 = index.constant 127 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c512 = index.constant 512 : index
  %padded_output_size = index.add %output_size, %c127 : index
  %output_tiles = index.div %padded_output_size, %c128 : index
  %padded_token_count = index.add %token_capacity, %c63 : index
  %token_tiles = index.div %padded_token_count, %c64 : index
  kernel.launch.config workgroups(%output_tiles, %token_tiles, %c1) workgroup_size(%c512, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_tile = kernel.workgroup.id<y> : index
  %q4 = index.constant 4 : index
  func.apply<qwen3_moe.dense_quantized.body>(%q4, %bounded_token_count, %input_size, %output_size, %channel_tile, %token_tile, %input, %weight, %output) : (index, index, index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

// Q6_K entry point. It shares every matrix scheduling and publication choice
// with Q4_K while selecting only the Q6_K physical decoder.
kernel.def target(@qwen3_moe_dense_gfx11_wave64) @qwen3_moe_dense_linear_q6k_f16_wmma(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %c1 = index.constant 1 : index
  %c127 = index.constant 127 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c512 = index.constant 512 : index
  %padded_output_size = index.add %output_size, %c127 : index
  %output_tiles = index.div %padded_output_size, %c128 : index
  %uses_token128 = index.cmp uge, %token_capacity, %c128 : index
  %token_padding = scf.select %uses_token128, %c127, %c63 : index
  %token_span = scf.select %uses_token128, %c128, %c64 : index
  %padded_token_count = index.add %token_capacity, %token_padding : index
  %token_tiles = index.div %padded_token_count, %token_span : index
  kernel.launch.config workgroups(%output_tiles, %token_tiles, %c1) workgroup_size(%c512, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_tile = kernel.workgroup.id<y> : index
  %c128 = index.constant 128 : index
  %q6 = index.constant 6 : index
  %input_is_f16 = scalar.constant false : i1
  %uses_token128 = index.cmp uge, %token_capacity, %c128 : index
  scf.if %uses_token128 {
    func.apply<qwen3_moe.dense_q6k.token128.body>(%input_is_f16, %bounded_token_count, %input_size, %output_size, %channel_tile, %token_tile, %input, %weight, %output) : (i1, index, index, index, index, index, buffer, buffer, buffer)
  } else {
    func.apply<qwen3_moe.dense_quantized.body>(%q6, %bounded_token_count, %input_size, %output_size, %channel_tile, %token_tile, %input, %weight, %output) : (index, index, index, index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

// PP128+ wave32 specialization for ordinary F32 activations. Keeping this as
// a separate provider leaves the wave64 decode schedule and ABI unchanged.
kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_q6k_f16_wmma_pp_wave32(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
