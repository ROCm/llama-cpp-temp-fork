// Native packed-Q8 shared terminal plus exact MoE reduction.
//
// The Q8 reduction is copied from the accepted shared terminal. Lane zero
// then executes the accepted eight-slice left-associated MoE sum, adds the
// gated shared result in the existing operand order, and writes ffn_out.
// Router weights retain the exact TopK output tensor. Shared state uses the
// same native graph-transient mechanism as the accepted shared route.

config.decl @hrx2_shape_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 1, 262144)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_tuning_workgroup_size : %value: index where [range(%value, 32, 256), mul(%value, 32)]

kernel.def export("hrx2_mul_mat_q8_0_f32_decode_shared_moe_terminal")
    @hrx2_mul_mat_q8_0_f32_decode_shared_moe_terminal() {
  %unit = index.constant 1 : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %workgroup_size = config.get @hrx2_tuning_workgroup_size : index
  kernel.launch.config workgroups(%rows, %cols, %unit)
      workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %raw_gate: buffer,
         %selected: buffer, %router_weights: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %qk = index.constant 32 : index
  %block_bytes = index.constant 34 : index
  %block_f16s = index.constant 17 : index
  %qs_offset = index.constant 2 : index
  %k = config.get @hrx2_shape_k : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %workgroup_size = config.get @hrx2_tuning_workgroup_size : index
  %k_bounded = index.assume %k [range(%k, 32, 32768)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 4096)] : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 262143)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 4095)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %blocks_per_row = index.div %k_bounded, %qk : index
  %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
  %src0_f16_count = index.mul %total_blocks, %block_f16s : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %dst_count = index.mul %cols_bounded, %rows_bounded : index

  %block_lane = index.rem %lane, %eight : index
  %block_slot = index.div %lane, %eight : index
  %in_block_base = index.mul %block_lane, %four : index
  %block_step = index.div %workgroup_size, %eight : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %raw_gate_global =
      buffer.assume.memory_space<global> %raw_gate : buffer
  %selected_global = buffer.assume.memory_space<global> %selected : buffer
  %router_weights_global =
      buffer.assume.memory_space<global> %router_weights : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_noalias, %src1_noalias, %raw_gate_noalias, %selected_noalias,
      %router_weights_noalias, %dst_noalias =
      buffer.assume.noalias
          %src0_global, %src1_global, %raw_gate_global, %selected_global,
          %router_weights_global, %dst_global :
          buffer, buffer, buffer, buffer, buffer, buffer
  %src0_f16_view = buffer.view %src0_noalias[%base] :
      buffer -> view<[%src0_f16_count]xf16>
  %src1_view = buffer.view %src1_noalias[%base] :
      buffer -> view<[%src1_count]xf32>
  %raw_gate_view = buffer.view %raw_gate_noalias[%base] :
      buffer -> view<[%cols_bounded]xf32>
  %selected_count = index.mul %rows_bounded, %eight : index
  %selected_view = buffer.view %selected_noalias[%base] :
      buffer -> view<[%selected_count]xf32>
  %router_weights_view = buffer.view %router_weights_noalias[%base] :
      buffer -> view<8xf32>
  %dst_view = buffer.view %dst_noalias[%base] :
      buffer -> view<[%dst_count]xf32>

  %row_block_base = index.mul %row, %blocks_per_row : index
  %src1_col_base = index.mul %col, %k_bounded : index
  %sum = scf.for
      %block_idx = [%block_slot to %blocks_per_row step %block_step](
          %acc = %zero_f32 : f32) -> (f32) {
    %src_base_block = index.mul %block_idx, %qk : index
    %src_base = index.add %src_base_block, %in_block_base : index
    %linear_block = index.add %row_block_base, %block_idx : index
    %block_byte_base = index.mul %linear_block, %block_bytes : index
    %q_byte_payload = index.add %block_byte_base, %qs_offset : index
    %q_byte = index.add %q_byte_payload, %in_block_base : index
    %q_byte_offset = index.cast %q_byte : index to offset
    %q_word_view = buffer.view %src0_noalias[%q_byte_offset] :
        buffer -> view<1xi32>
    %q_packed = vector.load %q_word_view[%zero_index] :
        view<1xi32> -> vector<1xi32>
    %q_i32 = vector.bitunpacks<8> %q_packed :
        vector<1xi32> -> vector<4xi32>
    %q_f32 = vector.sitofp %q_i32 :
        vector<4xi32> to vector<4xf32>
    %src1_index = index.add %src1_col_base, %src_base : index
    %rhs = vector.load %src1_view[%src1_index] :
        view<[%src1_count]xf32> -> vector<4xf32>
    %block_f16_base = index.mul %linear_block, %block_f16s : index
    %d_f16 = view.load %src0_f16_view[%block_f16_base] :
        view<[%src0_f16_count]xf16> -> f16
    %d = scalar.extf %d_f16 : f16 to f32
    %d_vec = vector.splat %d : vector<4xf32>
    %q_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract>
        %q_f32, %d_vec : vector<4xf32>
    %next = vector.dotf %q_scaled, %rhs, %acc :
        vector<4xf32>, vector<4xf32>, f32
    scf.yield %next : f32
  }

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %dst_col_base = index.mul %col, %rows_bounded : index
  %dst_index = index.add %dst_col_base, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %zero_i32 = scalar.constant 0 : i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    %raw_gate_value = view.load %raw_gate_view[%col] :
        view<[%cols_bounded]xf32> -> f32
    %gate = scalar.logisticf<afn> %raw_gate_value : f32
    %weights = vector.load %router_weights_view[%zero_index] :
        view<8xf32> -> vector<8xf32>
    %w0 = vector.extract %weights[0] : vector<8xf32> -> f32
    %w1 = vector.extract %weights[1] : vector<8xf32> -> f32
    %w2 = vector.extract %weights[2] : vector<8xf32> -> f32
    %w3 = vector.extract %weights[3] : vector<8xf32> -> f32
    %w4 = vector.extract %weights[4] : vector<8xf32> -> f32
    %w5 = vector.extract %weights[5] : vector<8xf32> -> f32
    %w6 = vector.extract %weights[6] : vector<8xf32> -> f32
    %w7 = vector.extract %weights[7] : vector<8xf32> -> f32
    %slot1 = index.add %row, %rows_bounded : index
    %rows2 = index.mul %rows_bounded, %two : index
    %slot2 = index.add %row, %rows2 : index
    %rows3 = index.add %rows2, %rows_bounded : index
    %slot3 = index.add %row, %rows3 : index
    %rows4 = index.mul %rows_bounded, %four : index
    %slot4 = index.add %row, %rows4 : index
    %rows5 = index.add %rows4, %rows_bounded : index
    %slot5 = index.add %row, %rows5 : index
    %rows6 = index.add %rows4, %rows2 : index
    %slot6 = index.add %row, %rows6 : index
    %rows7 = index.add %rows6, %rows_bounded : index
    %slot7 = index.add %row, %rows7 : index
    %x0 = view.load %selected_view[%row] : view<[%selected_count]xf32> -> f32
    %x1 = view.load %selected_view[%slot1] : view<[%selected_count]xf32> -> f32
    %x2 = view.load %selected_view[%slot2] : view<[%selected_count]xf32> -> f32
    %x3 = view.load %selected_view[%slot3] : view<[%selected_count]xf32> -> f32
    %x4 = view.load %selected_view[%slot4] : view<[%selected_count]xf32> -> f32
    %x5 = view.load %selected_view[%slot5] : view<[%selected_count]xf32> -> f32
    %x6 = view.load %selected_view[%slot6] : view<[%selected_count]xf32> -> f32
    %x7 = view.load %selected_view[%slot7] : view<[%selected_count]xf32> -> f32
    %p0 = scalar.mulf<nnan|ninf|nsz> %x0, %w0 : f32
    %p1 = scalar.mulf<nnan|ninf|nsz> %x1, %w1 : f32
    %a1 = scalar.addf<nnan|ninf|nsz> %p0, %p1 : f32
    %p2 = scalar.mulf<nnan|ninf|nsz> %x2, %w2 : f32
    %a2 = scalar.addf<nnan|ninf|nsz> %a1, %p2 : f32
    %p3 = scalar.mulf<nnan|ninf|nsz> %x3, %w3 : f32
    %a3 = scalar.addf<nnan|ninf|nsz> %a2, %p3 : f32
    %p4 = scalar.mulf<nnan|ninf|nsz> %x4, %w4 : f32
    %a4 = scalar.addf<nnan|ninf|nsz> %a3, %p4 : f32
    %p5 = scalar.mulf<nnan|ninf|nsz> %x5, %w5 : f32
    %a5 = scalar.addf<nnan|ninf|nsz> %a4, %p5 : f32
    %p6 = scalar.mulf<nnan|ninf|nsz> %x6, %w6 : f32
    %a6 = scalar.addf<nnan|ninf|nsz> %a5, %p6 : f32
    %p7 = scalar.mulf<nnan|ninf|nsz> %x7, %w7 : f32
    %a7 = scalar.addf<nnan|ninf|nsz> %a6, %p7 : f32
    %scaled = scalar.mulf<nnan|ninf|nsz> %dot, %gate : f32
    %result = scalar.addf<nnan|ninf|nsz> %a7, %scaled : f32
    view.store %result, %dst_view[%dst_index] :
        f32, view<[%dst_count]xf32>
  }
  kernel.return
}
