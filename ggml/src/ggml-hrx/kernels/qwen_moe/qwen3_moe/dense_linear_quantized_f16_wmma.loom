kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_q6k_f16_input_wmma_pp_wave32(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
