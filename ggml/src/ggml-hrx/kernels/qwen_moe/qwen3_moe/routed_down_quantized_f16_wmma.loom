      %p1_0_t0_la_raw = vector.fragment.load<lhs> %al_view[%p1_0_t0_tb, %p1_0_t0_aa] shape [%k_wmma, %k_wmma] : view<32x256xi8, %lhs_layout> -> vector<16xi8>
      %p1_0_t0_la_words = vector.bitcast %p1_0_t0_la_raw : vector<16xi8> to vector<4xi32>
