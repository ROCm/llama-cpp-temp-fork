      %p1_3_t1_ra_raw = vector.fragment.load<rhs> %wl_view[%p1_3_t1_ka, %n_base] shape [%k_wmma, %k_wmma] : view<128x128xi8, %rhs_layout> -> vector<16xi8>
      %p1_3_t1_ra_words = vector.bitcast %p1_3_t1_ra_raw : vector<16xi8> to vector<4xi32>
