      view.store %bits0, %cache_dst_v[%dst_index0] : i16, view<262144xi16, #dense>
      view.store %bits1, %cache_dst_v[%dst_index1] : i16, view<262144xi16, #dense>
    }
  }
  kernel.return
}

// CSA stage 3 has a 512-wide RMS/MUL projection whose last 64 elements are
// immediately RoPE transformed, cached as F16, and then reused by two zero-
// scaled state updates. One workgroup owns one token row. The RMS reduction
// retains the accepted wide-wg256 vector-16 reduction order.
kernel.def export("hrx2_dsv4_csa_stage3_rms_rope_state_f32_f16") @hrx2_dsv4_csa_stage3_rms_rope_state_f32_f16() {
  %one = index.constant 1 : index
  %rows = index.constant 128 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %one, %one)
      workgroup_size(%threads, %one, %one) : index
} launch(%eps: f32, %attn_factor: f32, %beta_fast: f32, %beta_slow: f32,
         %ext_factor: f32, %freq_base: f32, %freq_scale: f32,
         %src: buffer, %weight: buffer, %pos: buffer,
         %cache_indices: buffer, %cache_dst: buffer,
         %state0: buffer, %select_indices: buffer, %update_indices: buffer,
         %state_dst0: buffer, %state1: buffer, %state_dst1: buffer,
         %projection: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c448 = index.constant 448 : index
  %c512 = index.constant 512 : index
  %c1024 = index.constant 1024 : index
  %c8192 = index.constant 8192 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_v16 = vector.constant 0.0 : vector<16xf32>
  %n_ctx_orig = index.constant 65536 : index

