      %scaled = vector.mulf %v, %rs : vector<4xf32>
      %rounded = vector.roundf %scaled : vector<4xf32>
      %q32 = vector.fptosi %rounded : vector<4xf32> to vector<4xi32>
      %q8 = vector.trunci %q32 : vector<4xi32> to vector<4xi8>
      %qwordv = vector.bitcast %q8 : vector<4xi8> to vector<1xi32>
      %qword = vector.extract %qwordv[0] : vector<1xi32> -> i32
      %word_base = index.mul %gid, %c8 : index
      %word_index0 = index.add %word_base, %lane_in_group : index
      %word_index = index.assume %word_index0 [range(%word_index0, 0, 524287)] : index
      view.store %qword, %qs_v[%word_index] : i32, view<524288xi32, #dense>
    }
  }
  kernel.return
}

kernel.def export("hrx2_dsv4_csa_stage3_gather_f32") @hrx2_dsv4_csa_stage3_gather_f32() {
  %one = index.constant 1 : index
  %groups = index.constant 512 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one)
      workgroup_size(%threads, %one, %one) : index
} launch(%scale: f32, %bias: f32, %history: buffer, %projection: buffer,
         %indices: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %four = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c520 = index.constant 520 : index
  %c1024 = index.constant 1024 : index
  %wg0 = kernel.workgroup.id<x> : index
  %wg = index.assume %wg0 [range(%wg0, 0, 511)] : index
  %tid0 = kernel.workitem.id<x> : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %linear0 = index.madd %wg, %c256, %tid : index
  %linear = index.assume %linear0 [range(%linear0, 0, 131071)] : index
  %history_g = buffer.assume.memory_space<global> %history : buffer
  %projection_g = buffer.assume.memory_space<global> %projection : buffer
  %indices_g = buffer.assume.memory_space<global> %indices : buffer
  %dst_g = buffer.assume.memory_space<global> %dst : buffer
  %history_na, %projection_na, %indices_na, %dst_na = buffer.assume.noalias
      %history_g, %projection_g, %indices_g, %dst_g : buffer, buffer, buffer, buffer
  %history_v = buffer.view %history_na[%base] : buffer -> view<2048xf32, #dense>
  %projection_v = buffer.view %projection_na[%base] : buffer -> view<131072xf32, #dense>
  %indices_v = buffer.view %indices_na[%base] : buffer -> view<1024xi32, #dense>
  %dst_v = buffer.view %dst_na[%base] : buffer -> view<131072xf32, #dense>
  %feature_half = index.rem %linear, %c128 : index
  %head_linear = index.div %linear, %c128 : index
  %head = index.rem %head_linear, %c8 : index
  %plane = index.div %head_linear, %c8 : index
  %upper = index.cmp ult, %head, %four : index
  %source_feature = scf.if %upper -> (index) {
    scf.yield %feature_half : index
  } else {
    %x = index.add %feature_half, %c128 : index
    scf.yield %x : index
  }
  %head_half = index.rem %head, %four : index
  %plane_rows = index.mul %plane, %four : index
  %row_half = index.add %plane_rows, %head_half : index
  %get_row = scf.if %upper -> (index) {
    scf.yield %row_half : index
  } else {
    %x = index.add %row_half, %c512 : index
    scf.yield %x : index
  }
  %get_row_b = index.assume %get_row [range(%get_row, 0, 1023)] : index
  %source_row_i32 = view.load %indices_v[%get_row_b] : view<1024xi32, #dense> -> i32
  %source_row = index.cast %source_row_i32 : i32 to index
  %source_valid = index.cmp ule, %source_row, %c520 : index
  scf.if %source_valid {
    %source_row_b = index.assume %source_row [range(%source_row, 0, 520)] : index
    %is_history = index.cmp ult, %source_row_b, %c8 : index
