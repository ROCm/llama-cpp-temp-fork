  %ic13_r = index.add %wcol, %k13 : index
  %ic13 = index.assume %ic13_r [range(%ic13_r, 0, 127)] : index
  %icb13_m = index.mul %ic13, %s_v : index
  %icb13_a = index.add %state_offset, %icb13_m : index
  %icb13_r = index.add %icb13_a, %row0 : index
  %icb13 = index.assume %icb13_r [range(%icb13_r, 0, 1073741820)] : index
  %s13_init = vector.load %si_view[%icb13] : view<1073741824xf32> -> vector<4xf32>
  %ic14_r = index.add %wcol, %k14 : index
  %ic14 = index.assume %ic14_r [range(%ic14_r, 0, 127)] : index
  %icb14_m = index.mul %ic14, %s_v : index
  %icb14_a = index.add %state_offset, %icb14_m : index
  %icb14_r = index.add %icb14_a, %row0 : index
  %icb14 = index.assume %icb14_r [range(%icb14_r, 0, 1073741820)] : index
  %s14_init = vector.load %si_view[%icb14] : view<1073741824xf32> -> vector<4xf32>
  %ic15_r = index.add %wcol, %k15 : index
  %ic15 = index.assume %ic15_r [range(%ic15_r, 0, 127)] : index
  %icb15_m = index.mul %ic15, %s_v : index
  %icb15_a = index.add %state_offset, %icb15_m : index
  %icb15_r = index.add %icb15_a, %row0 : index
  %icb15 = index.assume %icb15_r [range(%icb15_r, 0, 1073741820)] : index
  %s15_init = vector.load %si_view[%icb15] : view<1073741824xf32> -> vector<4xf32>
  %ch_r = index.add %n_tokens, %k15 : index
