      %published = scf.if %accumulates_output -> (vector<4xf32>) {
        %residual = vector.load.mask %bounded_output_view[%bounded_token, %channel0], %mask, %c0_f32x4 : view<[%output_token_count]x[%bounded_output_size]xf32>, vector<4xi1>, vector<4xf32>
        %sum = vector.addf %residual, %wide : vector<4xf32>
        scf.yield %sum : vector<4xf32>
      } else {
