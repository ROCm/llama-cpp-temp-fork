        %row_valid = index.cmp ult, %row, %rows : index
        %output_valid = scalar.andi %match_valid, %row_valid : i1
        %fused_weighted = scf.if %output_valid -> (f32) {
          %token_i32 = view.load %w4_tok_view[%match] : view<64xi32, #dense> -> i32
          %selected_i32 = view.load %w4_sel_view[%match] : view<64xi32, #dense> -> i32
          %token0 = index.cast %token_i32 : i32 to index
          %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
          %selected0 = index.cast %selected_i32 : i32 to index
          %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
          %up_row_local = index.add %row_local, %sixtyfour : index
          %gate_raw = view.load %w4_result_view[%match_in_window, %row_local] : view<16x128xf32, #dense> -> f32
          %up_raw = view.load %w4_result_view[%match_in_window, %up_row_local] : view<16x128xf32, #dense> -> f32
          %gate_clamped = scalar.minnumf %gate_raw, %gate_clamp_max : f32
          %gate_silu = scalar.siluf %gate_clamped : f32
          %up_hi = scalar.minnumf %up_raw, %up_clamp_max : f32
          %up_clamped = scalar.maxnumf %up_hi, %up_clamp_min : f32
          %fused = scalar.mulf %gate_silu, %up_clamped : f32
          %router_token_base = index.mul %token, %router_token_stride : index
          %router_index0 = index.add %router_token_base, %selected : index
          %router_index = index.assume %router_index0 [range(%router_index0, 0, 268435455)] : index
          %route_weight = view.load %router_view[%router_index] : view<268435456xf32, #dense> -> f32
          %weighted = scalar.mulf %fused, %route_weight : f32
          scf.yield %weighted : f32
        } else {
          scf.yield %zero_f32 : f32
        }

        %absolute = scalar.absf %fused_weighted : f32
        %max1_peer, %max1_valid = kernel.subgroup.shuffle<xor> %absolute, %shuffle_xor1, %shuffle_width : f32, i32, i32
        %max1 = scalar.maxnumf %absolute, %max1_peer : f32
        %max2_peer, %max2_valid = kernel.subgroup.shuffle<xor> %max1, %shuffle_xor2, %shuffle_width : f32, i32, i32
        %max2 = scalar.maxnumf %max1, %max2_peer : f32
        %max4_peer, %max4_valid = kernel.subgroup.shuffle<xor> %max2, %shuffle_xor4, %shuffle_width : f32, i32, i32
        %max4 = scalar.maxnumf %max2, %max4_peer : f32
        %max8_peer, %max8_valid = kernel.subgroup.shuffle<xor> %max4, %shuffle_xor8, %shuffle_width : f32, i32, i32
        %max8 = scalar.maxnumf %max4, %max8_peer : f32
        %max16_peer, %max16_valid = kernel.subgroup.shuffle<xor> %max8, %shuffle_xor16, %shuffle_width : f32, i32, i32
        %group_max = scalar.maxnumf %max8, %max16_peer : f32
        %amax = scalar.maxnumf %group_max, %qact_amax_eps : f32
        %scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %qact_inv127 : f32
        %rscale = scalar.divf<reassoc|nnan|ninf|nsz> %qact_f127, %amax : f32
        %scaled = scalar.mulf %fused_weighted, %rscale : f32
        %rounded = scalar.roundf %scaled : f32
        %q32 = scalar.fptosi %rounded : f32 to i32
        %q8 = scalar.trunci %q32 : i32 to i8

        %token_i32 = view.load %w4_tok_view[%match] : view<64xi32, #dense> -> i32
        %selected_i32 = view.load %w4_sel_view[%match] : view<64xi32, #dense> -> i32
        %token0 = index.cast %token_i32 : i32 to index
        %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
        %selected0 = index.cast %selected_i32 : i32 to index
        %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
        %token_base = index.mul %token, %dst_token_stride : index
        %selected_base = index.mul %selected, %rows : index
        %destination0 = index.add %token_base, %selected_base : index
        %destination1 = index.add %destination0, %row : index
        %destination = index.assume %destination1 [range(%destination1, 0, 1073741823)] : index
        scf.if %output_valid {
          view.store %q8, %out_qs_view[%destination] : i8, view<1073741824xi8, #dense>
        }

        // The token/selected strides and row tile are all K32 aligned.  Build
        // the metadata group index from those uniform group strides instead of
        // dividing the lane-varying byte destination.
        %dst_token_group_stride = index.div %dst_token_stride, %thirtytwo : index
        %selected_group_stride = index.div %rows, %thirtytwo : index
        %token_group_base = index.mul %token, %dst_token_group_stride : index
        %selected_group_base = index.mul %selected, %selected_group_stride : index
        %row_tile_group_base = index.mul %tile, %two : index
        %group_index_a = index.add %token_group_base, %selected_group_base : index
        %group_index_b = index.add %group_index_a, %row_tile_group_base : index
        %group_index0 = index.add %group_index_b, %row_block : index
        %group_index = index.assume %group_index0 [range(%group_index0, 0, 33554431)] : index
        %is_scale_leader = index.cmp eq, %wave_lane, %zero : index
        %store_scale = scalar.andi %output_valid, %is_scale_leader : i1
        scf.if %store_scale {
          view.store %scale, %out_scale_view[%group_index] : f32, view<33554432xf32, #dense>
        }

      }
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
      }

      %w3_output_window = index.constant 3 : index
      %w3_window_active = index.cmp ult, %w3_output_window, %window_count : index
      scf.if %w3_window_active {
      vector.fragment.store<result> %accumulator3, %w4_result_view[%zero, %wave_row_base] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x128xf32, #dense>
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

      // Eight waves quantize 32 (match, K32) groups in four passes. Down consumes
      // only the payload and scale; do not materialize the unused Q8 half sums.
      scf.for %output_pass = [%zero to %four step %one] {
        %pass_base = index.mul %output_pass, %eight : index
        %output_group = index.add %pass_base, %wave : index
        %match_in_window = index.div %output_group, %two : index
        %window_match_base = index.constant 48 : index
        %match = index.add %window_match_base, %match_in_window : index
        %row_block = index.rem %output_group, %two : index
        %match_valid = index.cmp ult, %match, %group_count : index
        %row_block_base = index.mul %row_block, %thirtytwo : index
        %row_local = index.add %row_block_base, %wave_lane : index
        %row = index.add %row_tile_base, %row_local : index
        %row_valid = index.cmp ult, %row, %rows : index
        %output_valid = scalar.andi %match_valid, %row_valid : i1
        %fused_weighted = scf.if %output_valid -> (f32) {
          %token_i32 = view.load %w4_tok_view[%match] : view<64xi32, #dense> -> i32
          %selected_i32 = view.load %w4_sel_view[%match] : view<64xi32, #dense> -> i32
          %token0 = index.cast %token_i32 : i32 to index
          %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
          %selected0 = index.cast %selected_i32 : i32 to index
          %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
          %up_row_local = index.add %row_local, %sixtyfour : index
          %gate_raw = view.load %w4_result_view[%match_in_window, %row_local] : view<16x128xf32, #dense> -> f32
          %up_raw = view.load %w4_result_view[%match_in_window, %up_row_local] : view<16x128xf32, #dense> -> f32
          %gate_clamped = scalar.minnumf %gate_raw, %gate_clamp_max : f32
          %gate_silu = scalar.siluf %gate_clamped : f32
          %up_hi = scalar.minnumf %up_raw, %up_clamp_max : f32
          %up_clamped = scalar.maxnumf %up_hi, %up_clamp_min : f32
          %fused = scalar.mulf %gate_silu, %up_clamped : f32
          %router_token_base = index.mul %token, %router_token_stride : index
          %router_index0 = index.add %router_token_base, %selected : index
          %router_index = index.assume %router_index0 [range(%router_index0, 0, 268435455)] : index
          %route_weight = view.load %router_view[%router_index] : view<268435456xf32, #dense> -> f32
          %weighted = scalar.mulf %fused, %route_weight : f32
          scf.yield %weighted : f32
        } else {
          scf.yield %zero_f32 : f32
        }

        %absolute = scalar.absf %fused_weighted : f32
        %max1_peer, %max1_valid = kernel.subgroup.shuffle<xor> %absolute, %shuffle_xor1, %shuffle_width : f32, i32, i32
        %max1 = scalar.maxnumf %absolute, %max1_peer : f32
        %max2_peer, %max2_valid = kernel.subgroup.shuffle<xor> %max1, %shuffle_xor2, %shuffle_width : f32, i32, i32
        %max2 = scalar.maxnumf %max1, %max2_peer : f32
        %max4_peer, %max4_valid = kernel.subgroup.shuffle<xor> %max2, %shuffle_xor4, %shuffle_width : f32, i32, i32
        %max4 = scalar.maxnumf %max2, %max4_peer : f32
        %max8_peer, %max8_valid = kernel.subgroup.shuffle<xor> %max4, %shuffle_xor8, %shuffle_width : f32, i32, i32
        %max8 = scalar.maxnumf %max4, %max8_peer : f32
        %max16_peer, %max16_valid = kernel.subgroup.shuffle<xor> %max8, %shuffle_xor16, %shuffle_width : f32, i32, i32
        %group_max = scalar.maxnumf %max8, %max16_peer : f32
        %amax = scalar.maxnumf %group_max, %qact_amax_eps : f32
        %scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %qact_inv127 : f32
        %rscale = scalar.divf<reassoc|nnan|ninf|nsz> %qact_f127, %amax : f32
        %scaled = scalar.mulf %fused_weighted, %rscale : f32
        %rounded = scalar.roundf %scaled : f32
        %q32 = scalar.fptosi %rounded : f32 to i32
        %q8 = scalar.trunci %q32 : i32 to i8

        %token_i32 = view.load %w4_tok_view[%match] : view<64xi32, #dense> -> i32
        %selected_i32 = view.load %w4_sel_view[%match] : view<64xi32, #dense> -> i32
        %token0 = index.cast %token_i32 : i32 to index
        %token = index.assume %token0 [range(%token0, 0, 1048575)] : index
        %selected0 = index.cast %selected_i32 : i32 to index
        %selected = index.assume %selected0 [range(%selected0, 0, 127)] : index
        %token_base = index.mul %token, %dst_token_stride : index
        %selected_base = index.mul %selected, %rows : index
        %destination0 = index.add %token_base, %selected_base : index
        %destination1 = index.add %destination0, %row : index
        %destination = index.assume %destination1 [range(%destination1, 0, 1073741823)] : index
        scf.if %output_valid {
          view.store %q8, %out_qs_view[%destination] : i8, view<1073741824xi8, #dense>
        }

        // The token/selected strides and row tile are all K32 aligned.  Build
        // the metadata group index from those uniform group strides instead of
        // dividing the lane-varying byte destination.
        %dst_token_group_stride = index.div %dst_token_stride, %thirtytwo : index
        %selected_group_stride = index.div %rows, %thirtytwo : index
        %token_group_base = index.mul %token, %dst_token_group_stride : index
        %selected_group_base = index.mul %selected, %selected_group_stride : index
        %row_tile_group_base = index.mul %tile, %two : index
        %group_index_a = index.add %token_group_base, %selected_group_base : index
        %group_index_b = index.add %group_index_a, %row_tile_group_base : index
        %group_index0 = index.add %group_index_b, %row_block : index
        %group_index = index.assume %group_index0 [range(%group_index0, 0, 33554431)] : index
        %is_scale_leader = index.cmp eq, %wave_lane, %zero : index
        %store_scale = scalar.andi %output_valid, %is_scale_leader : i1
        scf.if %store_scale {
          view.store %scale, %out_scale_view[%group_index] : f32, view<33554432xf32, #dense>
        }

      }
      kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
      }
    }
  }
  }
  kernel.return
}
