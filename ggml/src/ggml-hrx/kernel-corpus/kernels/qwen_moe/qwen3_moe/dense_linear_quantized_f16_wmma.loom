        %input_k_next = index.add %input_k0, %activation_k_next : index
        %loaded0 = vector.load %input_view[%bounded_token, %input_k] : view<[%bounded_token_count]x[%bounded_input_size]xf32> -> vector<4xf32>
        %loaded1 = vector.load %input_view[%bounded_token, %input_k_next] : view<[%bounded_token_count]x[%bounded_input_size]xf32> -> vector<4xf32>
        %narrow0 = vector.fptrunc %loaded0 : vector<4xf32> to vector<4xf16>
        %narrow1 = vector.fptrunc %loaded1 : vector<4xf32> to vector<4xf16>
