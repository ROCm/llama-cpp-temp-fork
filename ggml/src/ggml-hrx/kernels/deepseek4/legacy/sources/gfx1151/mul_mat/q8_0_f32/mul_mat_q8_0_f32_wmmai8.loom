// int8 WMMA Q8_0 x F32 matrix multiply -- 64 rows x 64 cols per
// workgroup, 2x4 16x16 tiles per wave, 64 k staged per round.
// Physical LDS strides are activation=80, weight=80 bytes.
//
// Weights arrive in native 34-byte Q8_0 blocks and are decoded directly into LDS;
// activations arrive int8 with per-32 scales from
// the shared quantisation prepass. lhs is the activations so the 8-per-lane
// scale index falls on them, where it is shared across every weight tile.

config.decl @hrx2_shape_k : %value: index where [range(%value, 64, 32768), mul(%value, 64)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 1, 262144)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 32768)]
config.decl @hrx2_shape_batch2 : %value: index where [range(%value, 1, 64)]

kernel.def export("hrx2_mul_mat_q8_0_f32_wmmai8_64x64x64") @hrx2_mul_mat_q8_0_f32_wmmai8_64x64x64() {
  %unit = index.constant 1 : index
  %k_n = index.constant 64 : index
  %k_m = index.constant 64 : index
  %n_m1 = index.constant 63 : index
  %m_m1 = index.constant 63 : index
  %wg = index.constant 64 : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %batch2 = config.get @hrx2_shape_batch2 : index
  %rows_up = index.add %rows, %n_m1 : index
  %row_tiles = index.div %rows_up, %k_n : index
  %cols_up = index.add %cols, %m_m1 : index
  %col_tiles = index.div %cols_up, %k_m : index
  kernel.launch.config workgroups(%col_tiles, %row_tiles, %batch2) workgroup_size(%wg, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer, %aq: buffer, %as: buffer, %asum: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c17 = index.constant 17 : index
  %c34 = index.constant 34 : index
  %k_kc = index.constant 64 : index
  %k_astride = index.constant 80 : index
  %k_wstride = index.constant 80 : index
  %k_m = index.constant 64 : index
  %k_n = index.constant 64 : index
  %k_blocks = index.constant 2 : index
  %k_wave = index.constant 32 : index
  %k_wm = index.constant 2 : index
  %fzero = vector.constant 0.0 : vector<8xf32>
  %izero = vector.constant 0 : vector<8xi32>

  %k = config.get @hrx2_shape_k : index
  %rows = config.get @hrx2_shape_rows : index
  %cols = config.get @hrx2_shape_cols : index
  %batch2 = config.get @hrx2_shape_batch2 : index
  %k_b = index.assume %k [range(%k, 64, 32768)] : index
  %rows_b = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_b = index.assume %cols [range(%cols, 1, 32768)] : index
  %batch2_b = index.assume %batch2 [range(%batch2, 1, 64)] : index
  %flat_cols0 = index.mul %cols_b, %batch2_b : index
  %flat_cols = index.assume %flat_cols0 [range(%flat_cols0, 1, 2097152)] : index
  %nchunks = index.div %k_b, %k_kc : index
  %kblocks = index.div %k_b, %c32 : index

  %col_tile0 = kernel.workgroup.id<x> : index
  %row_tile0 = kernel.workgroup.id<y> : index
  %batch0 = kernel.workgroup.id<z> : index
  %tid0 = kernel.workitem.id<x> : index
  %col_tile = index.assume %col_tile0 [range(%col_tile0, 0, 511)] : index
  %row_tile = index.assume %row_tile0 [range(%row_tile0, 0, 4095)] : index
  %batch = index.assume %batch0 [range(%batch0, 0, 63)] : index
  %tid = index.assume %tid0 [range(%tid0, 0, 63)] : index
  %wave = index.div %tid, %k_wave : index

  %src0_g = buffer.assume.memory_space<global> %src0 : buffer
  %dst_g = buffer.assume.memory_space<global> %dst : buffer
  %aq_g = buffer.assume.memory_space<global> %aq : buffer
  %as_g = buffer.assume.memory_space<global> %as : buffer
  %src0_na, %dst_na, %aq_na, %as_na = buffer.assume.noalias %src0_g, %dst_g, %aq_g, %as_g : buffer, buffer, buffer, buffer

  %src0_i8 = buffer.view %src0_na[%base] : buffer -> view<1073741824xi8, #dense>
  %src0_f16 = buffer.view %src0_na[%base] : buffer -> view<536870912xf16, #dense>
  %aq_flat = buffer.view %aq_na[%base] : buffer -> view<1073741824xi8, #dense>
  %as_flat = buffer.view %as_na[%base] : buffer -> view<33554432xf32, #dense>
  // dst is [rows, cols] with rows contiguous, and C is [cols, rows].
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<[%flat_cols]x[%rows_b]xf32, #dense>

  // LDS: padded activations 5120 B, padded weights 5120 B, then
  // the two scale planes.
  %lds_bytes = index.constant 11264 : offset
  %scratch = buffer.alloca %lds_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %lhs_layout = encoding.layout.strided [80, 1] : encoding<layout>
  %i8_schema = encoding.define #matrix_operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %al_view = buffer.view %scratch[%base] : buffer -> view<64x64xi8, %lhs_layout>
  %al_flat = buffer.view %scratch[%base] : buffer -> view<5120xi8, #dense>
  %w_off = index.constant 5120 : offset
  %rhs_layout = encoding.layout.strided [1, 80] : encoding<layout>
  %wl_view = buffer.view %scratch[%w_off] : buffer -> view<64x64xi8, %rhs_layout>
  %wl_flat = buffer.view %scratch[%w_off] : buffer -> view<5120xi8, #dense>
  %as_off = index.constant 10240 : offset
  %asl_view = buffer.view %scratch[%as_off] : buffer -> view<128xf32, #dense>
  %ws_off = index.constant 10752 : offset
  %wsl_view = buffer.view %scratch[%ws_off] : buffer -> view<128xf32, #dense>

  %col_base = index.mul %col_tile, %k_m : index
  %row_base = index.mul %row_tile, %k_n : index
  %weight_batch_rows = index.mul %batch, %rows_b : index
  %weight_row_base = index.add %weight_batch_rows, %row_base : index
  %dst_batch_cols = index.mul %batch, %cols_b : index

  // Staging shares.
  %k_aper = index.constant 64 : index
  %k_wper = index.constant 64 : index
  %ashare = index.mul %tid, %k_aper : index
  %ascol = index.div %ashare, %k_kc : index
  %asoff = index.rem %ashare, %k_kc : index
  %adbase0 = index.mul %ascol, %k_astride : index
  %adbase = index.add %adbase0, %asoff : index
  %ascol_g = index.add %col_base, %ascol : index
  // Quantized activations are flattened in their physical token-major,
