kernel.def export("dsv4_csa_top_k_256_rank_wg256") @dsv4_csa_top_k_256_rank_wg256() {
  %one = index.constant 1 : index
  %rows = index.constant 512 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%src: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %cols = index.constant 256 : index
  %lds_bytes = index.constant 1024 : offset
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 511)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %src_global = buffer.assume.memory_space<global> %src : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src_na, %dst_na = buffer.assume.noalias %src_global, %dst_global : buffer, buffer
  %src_view = buffer.view %src_na[%base] : buffer -> view<131072xf32, #dense>
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<131072xi32, #dense>
  %scratch = buffer.alloca %lds_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scores = buffer.view %scratch[%base] : buffer -> view<256xf32, #dense>

  %row_base0 = index.mul %row, %cols : index
  %row_base = index.assume %row_base0 [range(%row_base0, 0, 130816)] : index
  %input_index0 = index.add %row_base, %lane : index
  %input_index = index.assume %input_index0 [range(%input_index0, 0, 131071)] : index
  %score = view.load %src_view[%input_index] : view<131072xf32, #dense> -> f32
  view.store %score, %scores[%lane] : f32, view<256xf32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

  %rank = scf.for %other = [%zero to %cols step %one](%count = %zero : index) -> (index) {
    %other_score = view.load %scores[%other] : view<256xf32, #dense> -> f32
    %greater = scalar.cmpf ogt, %other_score, %score : f32
    %equal = scalar.cmpf oeq, %other_score, %score : f32
    %lower = index.cmp ult, %other, %lane : index
    %equal_lower = scalar.andi %equal, %lower : i1
    %precedes = scalar.ori %greater, %equal_lower : i1
    %increment = scf.select %precedes, %one, %zero : index
    %next0 = index.add %count, %increment : index
    %next = index.assume %next0 [range(%next0, 0, 256)] : index
    scf.yield %next : index
  }
  %rank_bounded = index.assume %rank [range(%rank, 0, 255)] : index
  %lane_i32 = index.cast %lane : index to i32
  %output_index0 = index.add %row_base, %rank_bounded : index
  %output_index = index.assume %output_index0 [range(%output_index0, 0, 131071)] : index
  view.store %lane_i32, %dst_view[%output_index] : i32, view<131072xi32, #dense>
  kernel.return
}



// One workgroup owns one token. Four 64-lane cohorts reproduce four accepted
// Lightning workgroups at a time; each cohort retains the accepted per-head
// vector.dotf recurrence and two-wave reduction tree. Scores stay in LDS and
// feed the exact all-256 rank transform without a global score tensor.
