      %pg9 = view.load %gs_flat[%k73] : view<80xf32> -> f32
      %pg10 = view.load %gs_flat[%k74] : view<80xf32> -> f32
      %pg11 = view.load %gs_flat[%k75] : view<80xf32> -> f32
      %pg12 = view.load %gs_flat[%k76] : view<80xf32> -> f32
      %pg13 = view.load %gs_flat[%k77] : view<80xf32> -> f32
      %pg14 = view.load %gs_flat[%k78] : view<80xf32> -> f32
      %pg15 = view.load %gs_flat[%k79] : view<80xf32> -> f32
      %ple0 = index.cmp ule, %k0, %tid : index
      %pm0 = scf.select %ple0, %pg0, %f1 : f32
      %ple1 = index.cmp ule, %k1, %tid : index
      %pm1 = scf.select %ple1, %pg1, %f1 : f32
      %pp1 = scalar.mulf<nnan|ninf|nsz> %pm0, %pm1 : f32
      %pt1 = scalar.mulf<nnan|ninf|nsz> %pg0, %pg1 : f32
      %ple2 = index.cmp ule, %k2, %tid : index
      %pm2 = scf.select %ple2, %pg2, %f1 : f32
      %pp2 = scalar.mulf<nnan|ninf|nsz> %pp1, %pm2 : f32
      %pt2 = scalar.mulf<nnan|ninf|nsz> %pt1, %pg2 : f32
      %ple3 = index.cmp ule, %k3, %tid : index
      %pm3 = scf.select %ple3, %pg3, %f1 : f32
      %pp3 = scalar.mulf<nnan|ninf|nsz> %pp2, %pm3 : f32
      %pt3 = scalar.mulf<nnan|ninf|nsz> %pt2, %pg3 : f32
      %ple4 = index.cmp ule, %k4, %tid : index
      %pm4 = scf.select %ple4, %pg4, %f1 : f32
      %pp4 = scalar.mulf<nnan|ninf|nsz> %pp3, %pm4 : f32
