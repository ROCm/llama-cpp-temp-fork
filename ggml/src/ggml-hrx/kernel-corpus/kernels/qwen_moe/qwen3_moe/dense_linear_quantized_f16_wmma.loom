// Public roots select the format at compile time.
template.def<@qwen3_moe.dense_q5_iq4.lowrow.body> device @qwen3_moe_dense_linear_q5_iq4_lowrow_body(%is_iq4xs: i1, %token_count: index, %channel_tile: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size0 = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size0 = config.get @qwen3_moe.dense_quantized.output_size : index
  %output_accumulation = config.get @qwen3_moe.dense_quantized.output_accumulation : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 16)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %c136_bytes = index.constant 136 : offset
  %c176_bytes = index.constant 176 : offset
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %weight_stage_bytes = index.constant 2304 : offset
  %activation_stage_bytes = index.constant 2304 : offset
  %result_stage_bytes = index.constant 512 : offset
  %zero_accumulator = vector.constant 0.0 : vector<16xf16>
  %zero4 = vector.constant 0.0 : vector<4xf16>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  %quant_block_count = index.div %input_size, %c256 : index
  %weight_block_bytes = scf.select %is_iq4xs, %c136_bytes, %c176_bytes : offset
  %weight_row_bytes = index.scale %quant_block_count, %weight_block_bytes : index, offset -> offset
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%input_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %weight_stage_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<16x72xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<16x72xf16>
  %activation_layout = encoding.layout.strided [1, %c72] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<64x16xf16, %activation_layout>

  %channel_tile_base = index.mul %channel_tile, %c16 : index
  %weight_half = index.rem %workitem, %c2 : index
  %weight_local_row0 = index.div %workitem, %c2 : index
  %weight_local_row = index.assume %weight_local_row0 [range(%weight_local_row0, 0, 15)] : index
  %channel = index.add %channel_tile_base, %weight_local_row : index
  %valid_channel = index.cmp ult, %channel, %output_size : index
  %weight_k = index.mul %weight_half, %c16 : index
  %weight_k_next = index.add %weight_k, %c32 : index
  %packet_base = index.mul %weight_half, %c4 : index
  %packet0 = index.assume %packet_base [range(%packet_base, 0, 4)] : index
  %packet1_0 = index.add %packet_base, %c1 : index
  %packet1 = index.assume %packet1_0 [range(%packet1_0, 1, 5)] : index
  %packet2_0 = index.add %packet_base, %c2 : index
  %packet2 = index.assume %packet2_0 [range(%packet2_0, 2, 6)] : index
  %packet3_0 = index.add %packet_base, %c1 : index
  %packet3_1 = index.add %packet3_0, %c2 : index
  %packet3 = index.assume %packet3_1 [range(%packet3_1, 3, 7)] : index
  %activation_lane_row0 = index.div %workitem, %c8 : index
  %activation_lane_row = index.assume %activation_lane_row0 [range(%activation_lane_row0, 0, 3)] : index
  %activation_packet = index.rem %workitem, %c8 : index
  %activation_k = index.mul %activation_packet, %c4 : index
  %activation_k_next = index.add %activation_k, %c32 : index
  %init = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<16xf16>

  %result = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc = %init : vector<16xf16>) -> (vector<16xf16>) {
    %block_result = scf.for %quant_group = [%c0 to %c8 step %c2](%acc = %block_acc : vector<16xf16>) -> (vector<16xf16>) {
      %quant_group_next = index.add %quant_group, %c1 : index
      %row_byte_base = index.scale %channel, %weight_row_bytes : index, offset -> offset
      %w00, %w01, %w02, %w03, %w10, %w11, %w12, %w13 = scf.if %valid_channel -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) {
        %v00, %v01, %v02, %v03, %v10, %v11, %v12, %v13 = scf.if %is_iq4xs -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) {
          %a00 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet0) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a01 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet1) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a02 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet2) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a03 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet3) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a10 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet0) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a11 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet1) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a12 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet2) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %a13 = func.call @qwen3_moe_dense_iq4xs_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet3) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          scf.yield %a00, %a01, %a02, %a03, %a10, %a11, %a12, %a13 : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
        } else {
          %b00 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet0) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b01 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet1) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b02 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet2) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b03 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %packet3) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b10 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet0) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b11 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet1) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b12 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet2) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          %b13 = func.call @qwen3_moe_dense_q5k_wmma_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group_next, %packet3) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          scf.yield %b00, %b01, %b02, %b03, %b10, %b11, %b12, %b13 : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
        }
        scf.yield %v00, %v01, %v02, %v03, %v10, %v11, %v12, %v13 : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
      } else {
        scf.yield %zero4, %zero4, %zero4, %zero4, %zero4, %zero4, %zero4, %zero4 : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
      }
      vector.store %w00, %weight_stage_view[%weight_local_row, %weight_k] : vector<4xf16>, view<16x72xf16>
      %wk4 = index.add %weight_k, %c4 : index
      vector.store %w01, %weight_stage_view[%weight_local_row, %wk4] : vector<4xf16>, view<16x72xf16>
      %wk8 = index.add %weight_k, %c8 : index
      vector.store %w02, %weight_stage_view[%weight_local_row, %wk8] : vector<4xf16>, view<16x72xf16>
      %wk12 = index.add %weight_k, %c12 : index
      vector.store %w03, %weight_stage_view[%weight_local_row, %wk12] : vector<4xf16>, view<16x72xf16>
      vector.store %w10, %weight_stage_view[%weight_local_row, %weight_k_next] : vector<4xf16>, view<16x72xf16>
      %wkn4 = index.add %weight_k_next, %c4 : index
      vector.store %w11, %weight_stage_view[%weight_local_row, %wkn4] : vector<4xf16>, view<16x72xf16>
      %wkn8 = index.add %weight_k_next, %c8 : index
      vector.store %w12, %weight_stage_view[%weight_local_row, %wkn8] : vector<4xf16>, view<16x72xf16>
      %wkn12 = index.add %weight_k_next, %c12 : index
      vector.store %w13, %weight_stage_view[%weight_local_row, %wkn12] : vector<4xf16>, view<16x72xf16>

      scf.for %activation_batch = [%c0 to %bounded_token_count step %c4] {
        %activation_row0 = index.add %activation_batch, %activation_lane_row : index
        %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 15)] : index
        %valid_token = index.cmp ult, %activation_row, %bounded_token_count : index
        scf.if %valid_token {
          %bounded_token, %input_token_count = index.assume %activation_row, %bounded_token_count [lt(%activation_row, %bounded_token_count)] : index, index
          %block_k_base = index.mul %quant_block, %c256 : index
          %group_k_add = index.mul %quant_group, %c32 : index
          %input_k0 = index.add %block_k_base, %group_k_add : index
          %input_k = index.add %input_k0, %activation_k : index
          %input_k_next = index.add %input_k0, %activation_k_next : index
          %loaded0 = vector.load %input_view[%bounded_token, %input_k] : view<[%bounded_token_count]x[%input_size]xf32> -> vector<4xf32>
          %loaded1 = vector.load %input_view[%bounded_token, %input_k_next] : view<[%bounded_token_count]x[%input_size]xf32> -> vector<4xf32>
          %narrow0 = vector.fptrunc %loaded0 : vector<4xf32> to vector<4xf16>
          %narrow1 = vector.fptrunc %loaded1 : vector<4xf32> to vector<4xf16>
          vector.store %narrow0, %activation_stage_physical_view[%bounded_token, %activation_k] : vector<4xf16>, view<16x72xf16>
          vector.store %narrow1, %activation_stage_physical_view[%bounded_token, %activation_k_next] : vector<4xf16>, view<16x72xf16>
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next = scf.for %k_half = [%c0 to %c64 step %c16](%half_acc = %acc : vector<16xf16>) -> (vector<16xf16>) unroll {
        %lhs = vector.fragment.load<lhs> %weight_stage_view[%c0, %k_half] shape [%m, %k] : view<16x72xf16> -> vector<16xf16>
        %rhs = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %c0] shape [%k, %n] : view<64x16xf16, %activation_layout> -> vector<16xf16>
        %half_next = vector.mma %lhs, %rhs, %half_acc : vector<16xf16>, vector<16xf16>, vector<16xf16>
        scf.yield %half_next : vector<16xf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next : vector<16xf16>
    }
    scf.yield %block_result : vector<16xf16>
  }

  template.apply<@qwen3_moe.dense_quantized.publish_f16.wave32>(%result, %c0, %c0, %bounded_token_count, %output_size, %channel_tile_base, %c0, %result_stage, %output_noalias, %output_accumulation) : (vector<16xf16>, index, index, index, index, index, index, buffer, buffer, index)
  template.return
}

// Q5_K low-row schedule keeps one 16-value payload and its header live across four group pairs.
template.def<@qwen3_moe.dense_q5k.lowrow.vector.body> device @qwen3_moe_dense_linear_q5k_lowrow_vector_body(%token_count: index, %channel_tile: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size0 = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size0 = config.get @qwen3_moe.dense_quantized.output_size : index
  %output_accumulation = config.get @qwen3_moe.dense_quantized.output_accumulation : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 64, 262144), mul(%output_size0, 64)] : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 16)] : index
  %workitem0 = kernel.subgroup.lane.id : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 31)] : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 1)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %c176_bytes = index.constant 176 : offset
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %c16_bytes = index.constant 16 : offset
  %c48_bytes = index.constant 48 : offset
  %weight_stage_bytes = index.constant 2304 : offset
  %activation_stage_bytes = index.constant 2304 : offset
  %result_stage_bytes = index.constant 512 : offset
  %zero_accumulator = vector.constant 0.0 : vector<16xf16>
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %byte_ones = vector.constant 16843009 : vector<4xi32>
  %shift4 = vector.constant 4 : vector<4xi32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  %quant_block_count = index.div %input_size, %c256 : index
  %weight_row_bytes = index.scale %quant_block_count, %c176_bytes : index, offset -> offset
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%input_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %wave_weight_stage_offset = index.scale %subgroup, %weight_stage_bytes : index, offset -> offset
  %weight_stage_view = buffer.view %weight_stage[%wave_weight_stage_offset] : buffer -> view<16x72xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<16x72xf16>
  %activation_layout = encoding.layout.strided [1, %c72] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<64x16xf16, %activation_layout>

  %channel_group_base = index.mul %channel_tile, %c16 : index
  %subgroup_channel_add = index.mul %subgroup, %c16 : index
  %channel_tile_base = index.add %channel_group_base, %subgroup_channel_add : index
  %weight_half = index.rem %workitem, %c2 : index
  %weight_local_row0 = index.div %workitem, %c2 : index
  %weight_local_row = index.assume %weight_local_row0 [range(%weight_local_row0, 0, 15)] : index
  %channel0 = index.add %channel_tile_base, %weight_local_row : index
  %channel, %bounded_output_size = index.assume %channel0, %output_size [lt(%channel0, %output_size)] : index, index
  %weight_k = index.mul %weight_half, %c16 : index
  %weight_k_next = index.add %weight_k, %c32 : index
  %high_word_index0 = index.mul %weight_half, %c4 : index
  %high_word_index = index.assume %high_word_index0 [range(%high_word_index0, 0, 4)] : index
  %activation_lane_row0 = index.div %workitem, %c8 : index
  %activation_lane_row = index.assume %activation_lane_row0 [range(%activation_lane_row0, 0, 3)] : index
  %activation_packet = index.rem %workitem, %c8 : index
  %activation_k = index.mul %activation_packet, %c4 : index
  %activation_k_next = index.add %activation_k, %c32 : index
  %row_byte_base = index.scale %channel, %weight_row_bytes : index, offset -> offset
  %init = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<16xf16>

  %result = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc = %init : vector<16xf16>) -> (vector<16xf16>) {
    %raw_block_byte_add = index.scale %quant_block, %c176_bytes : index, offset -> offset
    %raw_block_byte_base = index.add %row_byte_base, %raw_block_byte_add : offset
    %raw_high_byte_base = index.add %raw_block_byte_base, %c16_bytes : offset
    %raw_code_byte_base = index.add %raw_block_byte_base, %c48_bytes : offset
    %header_view = buffer.view %weight_noalias[%raw_block_byte_base] : buffer -> view<4xi32>
    %header = vector.load %header_view[%c0] : view<4xi32> -> vector<4xi32>
    %header_halves = vector.bitcast %header : vector<4xi32> to vector<8xf16>
    %d_f16 = vector.extract %header_halves[0] : vector<8xf16> -> f16
    %dmin_f16 = vector.extract %header_halves[1] : vector<8xf16> -> f16
    %scale0 = vector.extract %header[1] : vector<4xi32> -> i32
    %scale1 = vector.extract %header[2] : vector<4xi32> -> i32
    %scale2 = vector.extract %header[3] : vector<4xi32> -> i32
    %d = scalar.extf %d_f16 : f16 to f32
    %dmin = scalar.extf %dmin_f16 : f16 to f32
    %raw_high_view = buffer.view %weight_noalias[%raw_high_byte_base] : buffer -> view<8xi32>
    %high_words = vector.load %raw_high_view[%high_word_index] : view<8xi32> -> vector<4xi32>

    %block_result = scf.for %quant_pair = [%c0 to %c4 step %c1](%acc = %block_acc : vector<16xf16>) -> (vector<16xf16>) {
      %group0 = index.mul %quant_pair, %c2 : index
      %group1 = index.add %group0, %c1 : index
      %pair_word_base0 = index.mul %quant_pair, %c8 : index
      %pair_word_index0 = index.add %pair_word_base0, %high_word_index : index
      %pair_word_index = index.assume %pair_word_index0 [range(%pair_word_index0, 0, 28)] : index
      %raw_code_view = buffer.view %weight_noalias[%raw_code_byte_base] : buffer -> view<32xi32>
      %code_words = vector.load %raw_code_view[%pair_word_index] : view<32xi32> -> vector<4xi32>
      %low_codes = vector.andi %code_words, %nibble_mask : vector<4xi32>
      %high_codes0 = vector.shrui %code_words, %shift4 : vector<4xi32>
      %high_codes = vector.andi %high_codes0, %nibble_mask : vector<4xi32>
      %group0_i32 = index.cast %group0 : index to i32
      %group1_i32 = index.cast %group1 : index to i32
      %group0_shift = vector.splat %group0_i32 : vector<4xi32>
      %group1_shift = vector.splat %group1_i32 : vector<4xi32>
      %fifth0_shifted = vector.shrui %high_words, %group0_shift : vector<4xi32>
      %fifth0_bits = vector.andi %fifth0_shifted, %byte_ones : vector<4xi32>
      %fifth0 = vector.shli %fifth0_bits, %shift4 : vector<4xi32>
      %fifth1_shifted = vector.shrui %high_words, %group1_shift : vector<4xi32>
      %fifth1_bits = vector.andi %fifth1_shifted, %byte_ones : vector<4xi32>
      %fifth1 = vector.shli %fifth1_bits, %shift4 : vector<4xi32>
      %codes0_words = vector.ori %low_codes, %fifth0 : vector<4xi32>
      %codes1_words = vector.ori %high_codes, %fifth1 : vector<4xi32>
      %codes0 = vector.bitcast %codes0_words : vector<4xi32> to vector<16xi8>
      %codes1 = vector.bitcast %codes1_words : vector<4xi32> to vector<16xi8>
      %codes0_f32 = vector.uitofp %codes0 : vector<16xi8> to vector<16xf32>
      %codes1_f32 = vector.uitofp %codes1 : vector<16xi8> to vector<16xf32>
      %group_scale0, %group_min0 = func.call @qwen3_moe_q4k_scale_from_header(%scale0, %scale1, %scale2, %group0) : (i32, i32, i32, index) -> (i32, i32)
      %group_scale1, %group_min1 = func.call @qwen3_moe_q4k_scale_from_header(%scale0, %scale1, %scale2, %group1) : (i32, i32, i32, index) -> (i32, i32)
      %group_scale0_f32 = scalar.uitofp %group_scale0 : i32 to f32
      %group_scale1_f32 = scalar.uitofp %group_scale1 : i32 to f32
      %group_min0_f32 = scalar.uitofp %group_min0 : i32 to f32
      %group_min1_f32 = scalar.uitofp %group_min1 : i32 to f32
      %d_scale0 = scalar.mulf %d, %group_scale0_f32 : f32
      %d_scale1 = scalar.mulf %d, %group_scale1_f32 : f32
      %minimum0 = scalar.mulf %dmin, %group_min0_f32 : f32
      %minimum1 = scalar.mulf %dmin, %group_min1_f32 : f32
      %negative_minimum0 = scalar.negf %minimum0 : f32
      %negative_minimum1 = scalar.negf %minimum1 : f32
      %d_scale0_vector = vector.splat %d_scale0 : vector<16xf32>
      %d_scale1_vector = vector.splat %d_scale1 : vector<16xf32>
      %negative_minimum0_vector = vector.splat %negative_minimum0 : vector<16xf32>
      %negative_minimum1_vector = vector.splat %negative_minimum1 : vector<16xf32>
      %values0_f32 = vector.fmaf %codes0_f32, %d_scale0_vector, %negative_minimum0_vector : vector<16xf32>
      %values1_f32 = vector.fmaf %codes1_f32, %d_scale1_vector, %negative_minimum1_vector : vector<16xf32>
      %values0 = vector.fptrunc %values0_f32 : vector<16xf32> to vector<16xf16>
      %values1 = vector.fptrunc %values1_f32 : vector<16xf32> to vector<16xf16>
      vector.store %values0, %weight_stage_view[%weight_local_row, %weight_k] : vector<16xf16>, view<16x72xf16>
      vector.store %values1, %weight_stage_view[%weight_local_row, %weight_k_next] : vector<16xf16>, view<16x72xf16>

      %loads_activations = index.cmp eq, %subgroup, %c0 : index
      scf.if %loads_activations {
        scf.for %activation_batch = [%c0 to %bounded_token_count step %c4] {
          %activation_row0 = index.add %activation_batch, %activation_lane_row : index
          %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 15)] : index
          %valid_token = index.cmp ult, %activation_row, %bounded_token_count : index
          scf.if %valid_token {
            %bounded_token, %input_token_count = index.assume %activation_row, %bounded_token_count [lt(%activation_row, %bounded_token_count)] : index, index
            %block_k_base = index.mul %quant_block, %c256 : index
            %group_k_add = index.mul %group0, %c32 : index
            %input_k0 = index.add %block_k_base, %group_k_add : index
            %input_k = index.add %input_k0, %activation_k : index
            %input_k_next = index.add %input_k0, %activation_k_next : index
            %input_mask0 = vector.mask.range [%input_k to %input_size step %c1] : index -> vector<4xi1>
            %input_mask1 = vector.mask.range [%input_k_next to %input_size step %c1] : index -> vector<4xi1>
            %zero4_f32 = vector.constant 0.0 : vector<4xf32>
            %loaded0 = vector.load.mask %input_view[%bounded_token, %input_k], %input_mask0, %zero4_f32 : view<[%bounded_token_count]x[%input_size]xf32>, vector<4xi1>, vector<4xf32>
            %loaded1 = vector.load.mask %input_view[%bounded_token, %input_k_next], %input_mask1, %zero4_f32 : view<[%bounded_token_count]x[%input_size]xf32>, vector<4xi1>, vector<4xf32>
            %narrow0 = vector.fptrunc %loaded0 : vector<4xf32> to vector<4xf16>
            %narrow1 = vector.fptrunc %loaded1 : vector<4xf32> to vector<4xf16>
            vector.store %narrow0, %activation_stage_physical_view[%bounded_token, %activation_k] : vector<4xf16>, view<16x72xf16>
            vector.store %narrow1, %activation_stage_physical_view[%bounded_token, %activation_k_next] : vector<4xf16>, view<16x72xf16>
          }
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next = scf.for %k_half = [%c0 to %c64 step %c16](%half_acc = %acc : vector<16xf16>) -> (vector<16xf16>) unroll {
        %lhs = vector.fragment.load<lhs> %weight_stage_view[%c0, %k_half] shape [%m, %k] : view<16x72xf16> -> vector<16xf16>
        %rhs = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %c0] shape [%k, %n] : view<64x16xf16, %activation_layout> -> vector<16xf16>
        %half_next = vector.mma %lhs, %rhs, %half_acc : vector<16xf16>, vector<16xf16>, vector<16xf16>
        scf.yield %half_next : vector<16xf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next : vector<16xf16>
    }
    scf.yield %block_result : vector<16xf16>
  }

  template.apply<@qwen3_moe.dense_quantized.publish_f16.wave32>(%result, %c0, %c0, %bounded_token_count, %bounded_output_size, %channel_group_base, %subgroup_channel_add, %result_stage, %output_noalias, %output_accumulation) : (vector<16xf16>, index, index, index, index, index, index, buffer, buffer, index)
  template.return
}

// Low-row IQ4_XS loads each scale header once and decodes 16 table values per lane without changing GGUF layout.
template.def<@qwen3_moe.dense_iq4xs.lowrow.vector.body> device @qwen3_moe_dense_linear_iq4xs_lowrow_vector_body(%token_count: index, %channel_tile: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size0 = config.get @qwen3_moe.dense_quantized.input_size : index
  %output_size0 = config.get @qwen3_moe.dense_quantized.output_size : index
  %output_accumulation = config.get @qwen3_moe.dense_quantized.output_accumulation : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 64, 262144), mul(%output_size0, 64)] : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 16)] : index
  %workitem0 = kernel.subgroup.lane.id : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 31)] : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 1)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %c136_bytes = index.constant 136 : offset
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %c2_bytes = index.constant 2 : offset
  %c4_bytes = index.constant 4 : offset
  %c8_bytes = index.constant 8 : offset
  %wave_weight_stage_bytes = index.constant 2304 : offset
  %weight_stage_bytes = index.constant 4608 : offset
  %activation_stage_bytes = index.constant 2304 : offset
  %result_stage_bytes = index.constant 1024 : offset
  %zero_accumulator = vector.constant 0.0 : vector<16xf16>
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %c3_i32 = scalar.constant 3 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c32_i32 = scalar.constant 32 : i32
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  %quant_block_count = index.div %input_size, %c256 : index
  %weight_row_bytes = index.scale %quant_block_count, %c136_bytes : index, offset -> offset
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%input_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %wave_weight_stage_offset = index.scale %subgroup, %wave_weight_stage_bytes : index, offset -> offset
  %weight_stage_view = buffer.view %weight_stage[%wave_weight_stage_offset] : buffer -> view<16x72xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<16x72xf16>
  %activation_layout = encoding.layout.strided [1, %c72] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<64x16xf16, %activation_layout>

  %channel_group_base = index.mul %channel_tile, %c32 : index
  %subgroup_channel_add = index.mul %subgroup, %c16 : index
  %channel_tile_base = index.add %channel_group_base, %subgroup_channel_add : index
  %weight_half = index.rem %workitem, %c2 : index
  %weight_local_row0 = index.div %workitem, %c2 : index
  %weight_local_row = index.assume %weight_local_row0 [range(%weight_local_row0, 0, 15)] : index
  %channel0 = index.add %channel_tile_base, %weight_local_row : index
  %channel, %bounded_output_size = index.assume %channel0, %output_size [lt(%channel0, %output_size)] : index, index
  %weight_k = index.mul %weight_half, %c32 : index
  %weight_k_next = index.add %weight_k, %c16 : index
  %activation_lane_row0 = index.div %workitem, %c8 : index
  %activation_lane_row = index.assume %activation_lane_row0 [range(%activation_lane_row0, 0, 3)] : index
  %activation_packet = index.rem %workitem, %c8 : index
  %activation_k = index.mul %activation_packet, %c4 : index
  %activation_k_next = index.add %activation_k, %c32 : index
  %row_byte_base = index.scale %channel, %weight_row_bytes : index, offset -> offset
  %init = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<16xf16>

  %result = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc = %init : vector<16xf16>) -> (vector<16xf16>) {
    %block_byte_add = index.scale %quant_block, %c136_bytes : index, offset -> offset
    %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
    %code_byte_base = index.add %block_byte_base, %c8_bytes : offset
    %scale_high_byte_base = index.add %block_byte_base, %c2_bytes : offset
    %scale_low_byte_base = index.add %block_byte_base, %c4_bytes : offset
    %d_view = buffer.view %weight_noalias[%block_byte_base] : buffer -> view<1xf16>
    %scale_high_view = buffer.view %weight_noalias[%scale_high_byte_base] : buffer -> view<1xi16>
    %scale_low_view = buffer.view %weight_noalias[%scale_low_byte_base] : buffer -> view<4xi8>
    %d_f16 = view.load %d_view[%c0] : view<1xf16> -> f16
    %d = scalar.extf %d_f16 : f16 to f32
    %scale_high_i16 = view.load %scale_high_view[%c0] : view<1xi16> -> i16
    %scale_high_i32 = scalar.extui %scale_high_i16 : i16 to i32

    %block_result = scf.for %quant_pair = [%c0 to %c4 step %c1](%acc = %block_acc : vector<16xf16>) -> (vector<16xf16>) {
      %group0 = index.mul %quant_pair, %c2 : index
      %group = index.add %group0, %weight_half : index
      %scale_low_i8 = view.load %scale_low_view[%quant_pair] : view<4xi8> -> i8
      %scale_low_i32 = scalar.extui %scale_low_i8 : i8 to i32
      %scale_low_shift_index = index.mul %weight_half, %c4 : index
      %scale_low_shift = index.cast %scale_low_shift_index : index to i32
      %scale_low_shifted = scalar.shrui %scale_low_i32, %scale_low_shift : i32
      %scale_low = scalar.andi %scale_low_shifted, %c15_i32 : i32
      %group_high_shift_index = index.mul %group, %c2 : index
      %group_high_shift = index.cast %group_high_shift_index : index to i32
      %scale_high0 = scalar.shrui %scale_high_i32, %group_high_shift : i32
      %scale_high_bits = scalar.andi %scale_high0, %c3_i32 : i32
      %scale_high = scalar.shli %scale_high_bits, %c4_i32 : i32
      %scale_unsigned = scalar.ori %scale_low, %scale_high : i32
      %scale_signed = scalar.subi %scale_unsigned, %c32_i32 : i32
      %scale_f32 = scalar.sitofp %scale_signed : i32 to f32
      %d_scale = scalar.mulf %d, %scale_f32 : f32
      %group_word_base0 = index.mul %group, %c4 : index
      %group_word_base = index.assume %group_word_base0 [range(%group_word_base0, 0, 28)] : index
      %code_view = buffer.view %weight_noalias[%code_byte_base] : buffer -> view<32xi32>
      %code_words = vector.load %code_view[%group_word_base] : view<32xi32> -> vector<4xi32>
      %codes00, %codes01, %codes02, %codes03 = func.call @qwen3_moe_dense_iq4xs_wmmai8_signed_values16(%code_words, %false) : (vector<4xi32>, i1) -> (vector<4xi8>, vector<4xi8>, vector<4xi8>, vector<4xi8>)
      %codes10, %codes11, %codes12, %codes13 = func.call @qwen3_moe_dense_iq4xs_wmmai8_signed_values16(%code_words, %true) : (vector<4xi32>, i1) -> (vector<4xi8>, vector<4xi8>, vector<4xi8>, vector<4xi8>)
      %codes00_01 = vector.concat<0> %codes00, %codes01 : vector<4xi8>, vector<4xi8> -> vector<8xi8>
      %codes02_03 = vector.concat<0> %codes02, %codes03 : vector<4xi8>, vector<4xi8> -> vector<8xi8>
      %codes0 = vector.concat<0> %codes00_01, %codes02_03 : vector<8xi8>, vector<8xi8> -> vector<16xi8>
      %codes10_11 = vector.concat<0> %codes10, %codes11 : vector<4xi8>, vector<4xi8> -> vector<8xi8>
      %codes12_13 = vector.concat<0> %codes12, %codes13 : vector<4xi8>, vector<4xi8> -> vector<8xi8>
      %codes1 = vector.concat<0> %codes10_11, %codes12_13 : vector<8xi8>, vector<8xi8> -> vector<16xi8>
      %codes0_f32 = vector.sitofp %codes0 : vector<16xi8> to vector<16xf32>
      %codes1_f32 = vector.sitofp %codes1 : vector<16xi8> to vector<16xf32>
      %d_scale_vector = vector.splat %d_scale : vector<16xf32>
      %values0_f32 = vector.mulf %codes0_f32, %d_scale_vector : vector<16xf32>
      %values1_f32 = vector.mulf %codes1_f32, %d_scale_vector : vector<16xf32>
      %values0 = vector.fptrunc %values0_f32 : vector<16xf32> to vector<16xf16>
      %values1 = vector.fptrunc %values1_f32 : vector<16xf32> to vector<16xf16>
      vector.store %values0, %weight_stage_view[%weight_local_row, %weight_k] : vector<16xf16>, view<16x72xf16>
      vector.store %values1, %weight_stage_view[%weight_local_row, %weight_k_next] : vector<16xf16>, view<16x72xf16>

      %loads_activations = index.cmp eq, %subgroup, %c0 : index
      scf.if %loads_activations {
        scf.for %activation_batch = [%c0 to %bounded_token_count step %c4] {
          %activation_row0 = index.add %activation_batch, %activation_lane_row : index
          %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 15)] : index
          %valid_token = index.cmp ult, %activation_row, %bounded_token_count : index
          scf.if %valid_token {
            %bounded_token, %input_token_count = index.assume %activation_row, %bounded_token_count [lt(%activation_row, %bounded_token_count)] : index, index
            %block_k_base = index.mul %quant_block, %c256 : index
            %group_k_add = index.mul %group0, %c32 : index
            %input_k0 = index.add %block_k_base, %group_k_add : index
            %input_k = index.add %input_k0, %activation_k : index
            %input_k_next = index.add %input_k0, %activation_k_next : index
            %loaded0 = vector.load %input_view[%bounded_token, %input_k] : view<[%bounded_token_count]x[%input_size]xf32> -> vector<4xf32>
            %loaded1 = vector.load %input_view[%bounded_token, %input_k_next] : view<[%bounded_token_count]x[%input_size]xf32> -> vector<4xf32>
            %narrow0 = vector.fptrunc %loaded0 : vector<4xf32> to vector<4xf16>
            %narrow1 = vector.fptrunc %loaded1 : vector<4xf32> to vector<4xf16>
            vector.store %narrow0, %activation_stage_physical_view[%bounded_token, %activation_k] : vector<4xf16>, view<16x72xf16>
            vector.store %narrow1, %activation_stage_physical_view[%bounded_token, %activation_k_next] : vector<4xf16>, view<16x72xf16>
          }
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next = scf.for %k_half = [%c0 to %c64 step %c16](%half_acc = %acc : vector<16xf16>) -> (vector<16xf16>) unroll {
        %lhs = vector.fragment.load<lhs> %weight_stage_view[%c0, %k_half] shape [%m, %k] : view<16x72xf16> -> vector<16xf16>
        %rhs = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %c0] shape [%k, %n] : view<64x16xf16, %activation_layout> -> vector<16xf16>
        %half_next = vector.mma %lhs, %rhs, %half_acc : vector<16xf16>, vector<16xf16>, vector<16xf16>
        scf.yield %half_next : vector<16xf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next : vector<16xf16>
    }
    scf.yield %block_result : vector<16xf16>
  }

  template.apply<@qwen3_moe.dense_quantized.publish_f16.wave32>(%result, %c0, %c0, %bounded_token_count, %bounded_output_size, %channel_group_base, %subgroup_channel_add, %result_stage, %output_noalias, %output_accumulation) : (vector<16xf16>, index, index, index, index, index, index, buffer, buffer, index)
  template.return
}

kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_q5k_f16_wmma_lowrow(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %padded_output_size = index.add %output_size, %c15 : index
  %output_tiles = index.div %padded_output_size, %c16 : index
  kernel.launch.config workgroups(%output_tiles, %c1, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 16)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  template.apply<@qwen3_moe.dense_q5k.lowrow.vector.body>(%bounded_token_count, %channel_tile, %input, %weight, %output) : (index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_iq4xs_f16_wmma_lowrow(%token_count: index) {
  %output_size = config.get @qwen3_moe.dense_quantized.output_size : index
