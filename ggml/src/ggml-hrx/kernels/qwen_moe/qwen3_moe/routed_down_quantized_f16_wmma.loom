        %s1_1_sl = scalar.andi %s1_1_zh, %mask_0f : i32
        %s1_1_s0 = scalar.shrui %s1_1_zl, %six_i32 : i32
        %s1_1_s1 = scalar.shli %s1_1_s0, %four_i32 : i32
        %s1_1_sc = scalar.ori %s1_1_sl, %s1_1_s1 : i32
        %s1_1_ml = scalar.shrui %s1_1_zh, %four_i32 : i32
        %s1_1_m0 = scalar.shrui %s1_1_zm, %six_i32 : i32
