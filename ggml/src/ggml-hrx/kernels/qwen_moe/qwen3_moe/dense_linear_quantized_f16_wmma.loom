    %packed, %header, %q8_ds, %q8_low, %q8_high = func.call @qwen3_moe_q4k_tensor_plane_load_lane(%input_size, %output_size, %output_row, %q4_block_a, %block_lane, %weight, %q8_input, %q8_row_byte_base) : (index, index, index, index, index, buffer, buffer, offset) -> (vector<4xi32>, vector<4xi32>, vector<4xf16>, vector<4xi32>, vector<4xi32>)
    scf.yield %packed, %header, %q8_ds, %q8_low, %q8_high : vector<4xi32>, vector<4xi32>, vector<4xf16>, vector<4xi32>, vector<4xi32>
  } else {
