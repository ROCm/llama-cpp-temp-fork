      %scas1_meta0 = index.assume %scas1_meta0_0 [range(%scas1_meta0_0, 0, 67108862)] : index
      %scas1_meta1_0 = index.add %scas1_meta0, %one : index
      %scas1_meta1 = index.assume %scas1_meta1_0 [range(%scas1_meta1_0, 1, 67108863)] : index
      %scas1_sum = view.load %asum_flat[%scas1_meta0] : view<67108864xi32> -> i32
