  %full_key_value_token_count0 = index.mul %full_key_value_block_count, %sixtyfour : index
  %full_key_value_token_count = index.assume %full_key_value_token_count0 [range(%full_key_value_token_count0, 0, 32768), mul(%full_key_value_token_count0, 64)] : index
