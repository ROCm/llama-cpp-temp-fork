    }
    %load_scale_row = scalar.andi %valid_channel, %use_scale_row_layout : i1
    %scale_bytes = scf.if %load_scale_row -> (vector<8xi8>) {
      %loaded_scale_bytes = vector.load %scale_row_view[%weight_local_row, %weight_half, %c0] : view<64x2x8xi8> -> vector<8xi8>
