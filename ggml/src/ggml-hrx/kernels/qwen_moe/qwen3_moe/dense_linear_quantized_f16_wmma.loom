  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  vector.fragment.store<result> %result03, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf16>, view<16x16xf16, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %valid_token3 {
    scf.if %valid_channel0 {
