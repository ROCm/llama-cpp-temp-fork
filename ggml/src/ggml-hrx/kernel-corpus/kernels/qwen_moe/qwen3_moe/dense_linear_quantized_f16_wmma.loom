    %values = vector.fragment.load<lhs> %al_view[%row, %column] shape [%sixteen, %sixteen] : view<128x64xi8, %lhs_layout> -> vector<16xi8>
    scf.yield %values : vector<16xi8>
  }
  func.return %result : vector<16xi8>
}

func.def inline @qwen3_moe_dense_q8_wmmai8_load_metadata(%token256: i1, %scratch: buffer, %as_off: offset, %asum_off: offset, %index: index) -> (vector<8xf32>, vector<8xf32>) {
