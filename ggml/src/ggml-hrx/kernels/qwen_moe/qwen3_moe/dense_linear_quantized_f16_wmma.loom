      }
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value : f32
      scf.yield %next : f32
    }
    scf.yield %sum : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %dot = kernel.subgroup.reduce<addf> %lane_sum : f32
  %lane_i32 = index.cast %lane : index to i32
  %lane_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
