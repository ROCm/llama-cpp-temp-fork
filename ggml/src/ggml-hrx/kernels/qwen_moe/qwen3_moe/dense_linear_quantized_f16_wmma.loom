  %k_aper = index.constant 32 : index
  %k_wper = index.constant 32 : index
  %ashare = index.mul %tid, %k_aper : index
  %ascol = index.div %ashare, %k_kc : index
  %asoff = index.rem %ashare, %k_kc : index
  %adbase0 = index.mul %ascol, %k_astride : index
  %adbase = index.add %adbase0, %asoff : index
  %ascol_g = index.add %col_base, %ascol : index
  %asbase = index.mul %ascol_g, %k_b : index
  %wshare = index.mul %tid, %k_wper : index
  %wsrow = index.div %wshare, %k_kc : index
  %wsoff = index.rem %wshare, %k_kc : index
  %wdbase0 = index.mul %wsrow, %k_wstride : index
  %wdbase = index.add %wdbase0, %wsoff : index
  %wsrow_g = index.add %row_base, %wsrow : index
  %wsbase = index.mul %wsrow_g, %k_b : index
  %wblk_l = index.div %wsoff, %c32 : index

  // Scale staging: scalar legacy order or eight-scale WMMA-native vectors.
  %k_asn = index.constant 128 : index
  %k_aspan = index.constant 32 : index
  %k_wsn = index.constant 128 : index
  %sc_col = index.div %tid, %k_blocks : index
  %sc_blk = index.rem %tid, %k_blocks : index

  // Wave w owns column-tile block w % 2 and row-tile block w / 2.
  %wcol = index.rem %wave, %k_wm : index
  %wrow = index.div %wave, %k_wm : index
  %k_mspan = index.constant 32 : index
  %k_nspan = index.constant 32 : index
  %wm_off = index.mul %wcol, %k_mspan : index
  %wn_off = index.mul %wrow, %k_nspan : index
  %m_out = index.add %col_base, %wm_off : index
  %n_out = index.add %row_base, %wn_off : index
  %lm0 = index.add %wm_off, %zero : index
  %gm0 = index.add %m_out, %zero : index
  %k_ma1 = index.constant 16 : index
  %lm1 = index.add %wm_off, %k_ma1 : index
  %gm1 = index.add %m_out, %k_ma1 : index
  %ln0 = index.add %wn_off, %zero : index
  %gn0 = index.add %n_out, %zero : index
  %k_nb1 = index.constant 16 : index
  %ln1 = index.add %wn_off, %k_nb1 : index
  %gn1 = index.add %n_out, %k_nb1 : index
  %lane = index.rem %tid, %k_wave : index
  %lane_lo = index.rem %lane, %sixteen : index
  %lane_hi = index.div %lane, %sixteen : index
  %wsb0_0 = index.add %ln0, %lane_lo : index
  %wsb0 = index.mul %wsb0_0, %k_blocks : index
  %wsb1_0 = index.add %ln1, %lane_lo : index
  %wsb1 = index.mul %wsb1_0, %k_blocks : index
  // Activation scale metadata is [tile][block][lane-half][register].
  %as_tile0 = index.div %lm0, %sixteen : index
  %asb0 = index.mul %as_tile0, %k_blocks : index
  // Activation scale metadata is [tile][block][lane-half][register].
  %as_tile1 = index.div %lm1, %sixteen : index
  %asb1 = index.mul %as_tile1, %k_blocks : index

  %f0_0, %f0_1, %f1_0, %f1_1 = scf.for %chunk = [%zero to %nchunks step %one](%fc0_0 = %fzero : vector<8xf32>, %fc0_1 = %fzero : vector<8xf32>, %fc1_0 = %fzero : vector<8xf32>, %fc1_1 = %fzero : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %chunk_k = index.mul %chunk, %k_kc : index
    %chunk_blk = index.mul %chunk, %k_blocks : index

    // ---- stage activations, weights and both scale planes ----
    %sa0_0 = index.add %asbase, %chunk_k : index
    %sa0_1 = index.add %sa0_0, %asoff : index
    %sa0_2 = index.add %sa0_1, %zero : index
    %sa0 = index.assume %sa0_2 [range(%sa0_2, 0, 1073741808)] : index
    %av0 = vector.load %aq_flat[%sa0] : view<1073741824xi8> -> vector<16xi8>
    %ad0_0 = index.add %adbase, %zero : index
    %ad0 = index.assume %ad0_0 [range(%ad0_0, 0, 5104)] : index
    vector.store %av0, %al_flat[%ad0] : vector<16xi8>, view<5120xi8>
    %k_sa1 = index.constant 16 : index
    %sa1_0 = index.add %asbase, %chunk_k : index
    %sa1_1 = index.add %sa1_0, %asoff : index
    %sa1_2 = index.add %sa1_1, %k_sa1 : index
    %sa1 = index.assume %sa1_2 [range(%sa1_2, 0, 1073741808)] : index
    %av1 = vector.load %aq_flat[%sa1] : view<1073741824xi8> -> vector<16xi8>
    %ad1_0 = index.add %adbase, %k_sa1 : index
    %ad1 = index.assume %ad1_0 [range(%ad1_0, 0, 5104)] : index
    vector.store %av1, %al_flat[%ad1] : vector<16xi8>, view<5120xi8>
    %wblk_g = index.add %chunk_blk, %wblk_l : index
    %wblock0 = index.mul %wsrow_g, %kblocks : index
    %wblock1 = index.add %wblock0, %wblk_g : index
    %wblock = index.assume %wblock1 [range(%wblock1, 0, 31580640)] : index
    %wscale_i0 = index.mul %wblock, %c17 : index
    %wscale_i = index.assume %wscale_i0 [range(%wscale_i0, 0, 536870911)] : index
    %wscale_h = view.load %src0_f16[%wscale_i] : view<536870912xf16> -> f16
    %wscale = scalar.extf %wscale_h : f16 to f32
    view.store %wscale, %wsl_view[%tid] : f32, view<128xf32>
    %wbyte0 = index.mul %wblock, %c34 : index
    %wbyte1 = index.add %wbyte0, %two : index
    %wbyte = index.assume %wbyte1 [range(%wbyte1, 0, 1073741792)] : index
    %wv0 = vector.load %src0_i8[%wbyte] : view<1073741824xi8> -> vector<16xi8>
    %wbyte16_0 = index.add %wbyte, %sixteen : index
    %wbyte16 = index.assume %wbyte16_0 [range(%wbyte16_0, 0, 1073741808)] : index
    %wv1 = vector.load %src0_i8[%wbyte16] : view<1073741824xi8> -> vector<16xi8>
    %wd0 = index.assume %wdbase [range(%wdbase, 0, 5104)] : index
    vector.store %wv0, %wl_flat[%wd0] : vector<16xi8>, view<5120xi8>
    %wd1_0 = index.add %wdbase, %sixteen : index
    %wd1 = index.assume %wd1_0 [range(%wd1_0, 0, 5104)] : index
    vector.store %wv1, %wl_flat[%wd1] : vector<16xi8>, view<5120xi8>
    // Scale planes: 128 activation and 128 weight entries.
    %scin_a = index.cmp ult, %tid, %k_asn : index
    scf.if %scin_a {
      %sca_c = index.add %col_base, %sc_col : index
      %sca_0 = index.mul %sca_c, %kblocks : index
      %sca_1 = index.add %sca_0, %chunk_blk : index
      %sca_2 = index.add %sca_1, %sc_blk : index
      %sca = index.assume %sca_2 [range(%sca_2, 0, 33554431)] : index
      %scav = view.load %as_flat[%sca] : view<33554432xf32> -> f32
      %sca_tile = index.div %sc_col, %sixteen : index
      %sca_inner = index.rem %sc_col, %sixteen : index
      %sca_par = index.rem %sca_inner, %two : index
      %sca_v = index.div %sca_inner, %two : index
      %sca_dst0 = index.mul %sca_tile, %k_blocks : index
      %sca_dst1 = index.add %sca_dst0, %sc_blk : index
      %sca_dst2 = index.mul %sca_dst1, %two : index
      %sca_dst3 = index.add %sca_dst2, %sca_par : index
      %sca_dst4 = index.mul %sca_dst3, %eight : index
      %sca_dst5 = index.add %sca_dst4, %sca_v : index
      %sca_dst = index.assume %sca_dst5 [range(%sca_dst5, 0, 127)] : index
      view.store %scav, %asl_view[%sca_dst] : f32, view<128xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %fn0_0, %fn0_1, %fn1_0, %fn1_1 = scf.for %blk = [%zero to %k_blocks step %one](%fb0_0 = %fc0_0 : vector<8xf32>, %fb0_1 = %fc0_1 : vector<8xf32>, %fb1_0 = %fc1_0 : vector<8xf32>, %fb1_1 = %fc1_1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %blk_k = index.mul %blk, %c32 : index
      %blk_k16 = index.add %blk_k, %sixteen : index
      %iz = vector.fragment<init> %izero shape [%sixteen, %sixteen] : vector<8xi32>
      %wsi0_2 = index.add %wsb0, %blk : index
      %wsi0 = index.assume %wsi0_2 [range(%wsi0_2, 0, 127)] : index
      %wsc0 = view.load %wsl_view[%wsi0] : view<128xf32> -> f32
      %wsv0 = vector.splat %wsc0 : vector<8xf32>
      %wsi1_2 = index.add %wsb1, %blk : index
      %wsi1 = index.assume %wsi1_2 [range(%wsi1_2, 0, 127)] : index
      %wsc1 = view.load %wsl_view[%wsi1] : view<128xf32> -> f32
      %wsv1 = vector.splat %wsc1 : vector<8xf32>
      %lf0_0_raw = vector.fragment.load<lhs> %al_view[%lm0, %blk_k] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
      %lf0_0_words = vector.bitcast %lf0_0_raw : vector<16xi8> to vector<4xi32>
      %lf0_0 = vector.fragment<lhs> %lf0_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %lf0_1_raw = vector.fragment.load<lhs> %al_view[%lm0, %blk_k16] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
      %lf0_1_words = vector.bitcast %lf0_1_raw : vector<16xi8> to vector<4xi32>
      %lf0_1 = vector.fragment<lhs> %lf0_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %asi0_0 = index.add %asb0, %blk : index
      %asi0_1 = index.mul %asi0_0, %two : index
      %asi0_2 = index.add %asi0_1, %lane_hi : index
      %asi0_3 = index.mul %asi0_2, %eight : index
      %asi0 = index.assume %asi0_3 [range(%asi0_3, 0, 120)] : index
      %asv0 = vector.load %asl_view[%asi0] : view<128xf32> -> vector<8xf32>
      %rfs0_0_0_raw = vector.fragment.load<rhs> %wl_view[%blk_k, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs0_0_0_words = vector.bitcast %rfs0_0_0_raw : vector<16xi8> to vector<4xi32>
      %rfs0_0_0 = vector.fragment<rhs> %rfs0_0_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rfs0_0_1_raw = vector.fragment.load<rhs> %wl_view[%blk_k16, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs0_0_1_words = vector.bitcast %rfs0_0_1_raw : vector<16xi8> to vector<4xi32>
      %rfs0_0_1 = vector.fragment<rhs> %rfs0_0_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %i0_0_0 = vector.mma %lf0_0, %rfs0_0_0, %iz : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %i1_0_0 = vector.mma %lf0_1, %rfs0_0_1, %i0_0_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %ff0_0 = vector.sitofp %i1_0_0 : vector<8xi32> to vector<8xf32>
      %sv0_0 = vector.mulf %asv0, %wsv0 : vector<8xf32>
      %fn0_0 = vector.fmaf %ff0_0, %sv0_0, %fb0_0 : vector<8xf32>
      %rfs0_1_0_raw = vector.fragment.load<rhs> %wl_view[%blk_k, %ln1] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs0_1_0_words = vector.bitcast %rfs0_1_0_raw : vector<16xi8> to vector<4xi32>
      %rfs0_1_0 = vector.fragment<rhs> %rfs0_1_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rfs0_1_1_raw = vector.fragment.load<rhs> %wl_view[%blk_k16, %ln1] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs0_1_1_words = vector.bitcast %rfs0_1_1_raw : vector<16xi8> to vector<4xi32>
      %rfs0_1_1 = vector.fragment<rhs> %rfs0_1_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %i0_0_1 = vector.mma %lf0_0, %rfs0_1_0, %iz : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %i1_0_1 = vector.mma %lf0_1, %rfs0_1_1, %i0_0_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %ff0_1 = vector.sitofp %i1_0_1 : vector<8xi32> to vector<8xf32>
      %sv0_1 = vector.mulf %asv0, %wsv1 : vector<8xf32>
      %fn0_1 = vector.fmaf %ff0_1, %sv0_1, %fb0_1 : vector<8xf32>
      %lf1_0_raw = vector.fragment.load<lhs> %al_view[%lm1, %blk_k] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
      %lf1_0_words = vector.bitcast %lf1_0_raw : vector<16xi8> to vector<4xi32>
      %lf1_0 = vector.fragment<lhs> %lf1_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %lf1_1_raw = vector.fragment.load<lhs> %al_view[%lm1, %blk_k16] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
      %lf1_1_words = vector.bitcast %lf1_1_raw : vector<16xi8> to vector<4xi32>
      %lf1_1 = vector.fragment<lhs> %lf1_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %asi1_0 = index.add %asb1, %blk : index
      %asi1_1 = index.mul %asi1_0, %two : index
      %asi1_2 = index.add %asi1_1, %lane_hi : index
      %asi1_3 = index.mul %asi1_2, %eight : index
      %asi1 = index.assume %asi1_3 [range(%asi1_3, 0, 120)] : index
      %asv1 = vector.load %asl_view[%asi1] : view<128xf32> -> vector<8xf32>
      %rfs1_0_0_raw = vector.fragment.load<rhs> %wl_view[%blk_k, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs1_0_0_words = vector.bitcast %rfs1_0_0_raw : vector<16xi8> to vector<4xi32>
      %rfs1_0_0 = vector.fragment<rhs> %rfs1_0_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rfs1_0_1_raw = vector.fragment.load<rhs> %wl_view[%blk_k16, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs1_0_1_words = vector.bitcast %rfs1_0_1_raw : vector<16xi8> to vector<4xi32>
      %rfs1_0_1 = vector.fragment<rhs> %rfs1_0_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %i0_1_0 = vector.mma %lf1_0, %rfs1_0_0, %iz : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %i1_1_0 = vector.mma %lf1_1, %rfs1_0_1, %i0_1_0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %ff1_0 = vector.sitofp %i1_1_0 : vector<8xi32> to vector<8xf32>
      %sv1_0 = vector.mulf %asv1, %wsv0 : vector<8xf32>
      %fn1_0 = vector.fmaf %ff1_0, %sv1_0, %fb1_0 : vector<8xf32>
      %rfs1_1_0_raw = vector.fragment.load<rhs> %wl_view[%blk_k, %ln1] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs1_1_0_words = vector.bitcast %rfs1_1_0_raw : vector<16xi8> to vector<4xi32>
      %rfs1_1_0 = vector.fragment<rhs> %rfs1_1_0_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %rfs1_1_1_raw = vector.fragment.load<rhs> %wl_view[%blk_k16, %ln1] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
      %rfs1_1_1_words = vector.bitcast %rfs1_1_1_raw : vector<16xi8> to vector<4xi32>
      %rfs1_1_1 = vector.fragment<rhs> %rfs1_1_1_words shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %i0_1_1 = vector.mma %lf1_0, %rfs1_1_0, %iz : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %i1_1_1 = vector.mma %lf1_1, %rfs1_1_1, %i0_1_1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
      %ff1_1 = vector.sitofp %i1_1_1 : vector<8xi32> to vector<8xf32>
      %sv1_1 = vector.mulf %asv1, %wsv1 : vector<8xf32>
      %fn1_1 = vector.fmaf %ff1_1, %sv1_1, %fb1_1 : vector<8xf32>
      scf.yield %fn0_0, %fn0_1, %fn1_0, %fn1_1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    // On the final K-chunk only, 64 threads stage the raw token gate over the
    // activation LDS tile after its final use. The pre-existing loop barrier
    // makes the tile visible to every result-fragment owner.
    %sep_chunk_next = index.add %chunk, %one : index
    %sep_last_chunk = index.cmp eq, %sep_chunk_next, %nchunks : index
    scf.if %sep_last_chunk {
      %sep_gate_lane = index.cmp ult, %tid, %k_m : index
      scf.if %sep_gate_lane {
        %sep_gate_global0 = index.add %col_base, %tid : index
        %sep_gate_global = index.assume %sep_gate_global0 [range(%sep_gate_global0, 0, 32767)] : index
        %sep_gate_value = view.load %raw_gate_view[%sep_gate_global] : view<[%cols_b]xf32> -> f32
        view.store %sep_gate_value, %gate_lds_view[%tid] : f32, view<64xf32>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %fn0_0, %fn0_1, %fn1_0, %fn1_1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  // Result fragment lane t owns M values 2*v+(t>>4), v=0..7. Read
  // those eight values from the final-chunk gate staging tile. This
  // is the legal equivalent of the compiler-rejected zero-row-stride
  // result-fragment load.
  %sep0_gate_i0_0 = index.add %lm0, %lane_hi : index
  %sep0_gate_i0 = index.assume %sep0_gate_i0_0 [range(%sep0_gate_i0_0, 0, 63)] : index
  %sep0_gate_e0 = view.load %gate_lds_view[%sep0_gate_i0] : view<64xf32> -> f32
  %sep0_gate_i1_0 = index.add %sep0_gate_i0, %two : index
  %sep0_gate_i1 = index.assume %sep0_gate_i1_0 [range(%sep0_gate_i1_0, 0, 63)] : index
  %sep0_gate_e1 = view.load %gate_lds_view[%sep0_gate_i1] : view<64xf32> -> f32
  %sep0_gate_i2_0 = index.add %sep0_gate_i1, %two : index
  %sep0_gate_i2 = index.assume %sep0_gate_i2_0 [range(%sep0_gate_i2_0, 0, 63)] : index
  %sep0_gate_e2 = view.load %gate_lds_view[%sep0_gate_i2] : view<64xf32> -> f32
  %sep0_gate_i3_0 = index.add %sep0_gate_i2, %two : index
  %sep0_gate_i3 = index.assume %sep0_gate_i3_0 [range(%sep0_gate_i3_0, 0, 63)] : index
  %sep0_gate_e3 = view.load %gate_lds_view[%sep0_gate_i3] : view<64xf32> -> f32
  %sep0_gate_i4_0 = index.add %sep0_gate_i3, %two : index
  %sep0_gate_i4 = index.assume %sep0_gate_i4_0 [range(%sep0_gate_i4_0, 0, 63)] : index
  %sep0_gate_e4 = view.load %gate_lds_view[%sep0_gate_i4] : view<64xf32> -> f32
  %sep0_gate_i5_0 = index.add %sep0_gate_i4, %two : index
  %sep0_gate_i5 = index.assume %sep0_gate_i5_0 [range(%sep0_gate_i5_0, 0, 63)] : index
  %sep0_gate_e5 = view.load %gate_lds_view[%sep0_gate_i5] : view<64xf32> -> f32
  %sep0_gate_i6_0 = index.add %sep0_gate_i5, %two : index
  %sep0_gate_i6 = index.assume %sep0_gate_i6_0 [range(%sep0_gate_i6_0, 0, 63)] : index
  %sep0_gate_e6 = view.load %gate_lds_view[%sep0_gate_i6] : view<64xf32> -> f32
  %sep0_gate_i7_0 = index.add %sep0_gate_i6, %two : index
  %sep0_gate_i7 = index.assume %sep0_gate_i7_0 [range(%sep0_gate_i7_0, 0, 63)] : index
  %sep0_gate_e7 = view.load %gate_lds_view[%sep0_gate_i7] : view<64xf32> -> f32
  %sep0_raw_gate = vector.from_elements %sep0_gate_e0, %sep0_gate_e1, %sep0_gate_e2, %sep0_gate_e3, %sep0_gate_e4, %sep0_gate_e5, %sep0_gate_e6, %sep0_gate_e7 : vector<8xf32>
  %sep0_sigmoid = vector.logisticf<afn> %sep0_raw_gate : vector<8xf32>
  %sep0_0_mul = vector.mulf<nnan|ninf|nsz> %f0_0, %sep0_sigmoid : vector<8xf32>
  %sep0_0_addend = vector.fragment.load<result> %addend_view[%gm0, %gn0] shape [%sixteen, %sixteen] : view<[%cols_b]x[%rows_b]xf32> -> vector<8xf32>
  %sep0_0_out = vector.addf<nnan|ninf|nsz> %sep0_0_addend, %sep0_0_mul : vector<8xf32>
  vector.fragment.store<result> %sep0_0_out, %dst_view[%gm0, %gn0] shape [%sixteen, %sixteen] : vector<8xf32>, view<[%cols_b]x[%rows_b]xf32>
  %sep0_1_mul = vector.mulf<nnan|ninf|nsz> %f0_1, %sep0_sigmoid : vector<8xf32>
  %sep0_1_addend = vector.fragment.load<result> %addend_view[%gm0, %gn1] shape [%sixteen, %sixteen] : view<[%cols_b]x[%rows_b]xf32> -> vector<8xf32>
  %sep0_1_out = vector.addf<nnan|ninf|nsz> %sep0_1_addend, %sep0_1_mul : vector<8xf32>
  vector.fragment.store<result> %sep0_1_out, %dst_view[%gm0, %gn1] shape [%sixteen, %sixteen] : vector<8xf32>, view<[%cols_b]x[%rows_b]xf32>
  %sep1_gate_i0_0 = index.add %lm1, %lane_hi : index
  %sep1_gate_i0 = index.assume %sep1_gate_i0_0 [range(%sep1_gate_i0_0, 0, 63)] : index
  %sep1_gate_e0 = view.load %gate_lds_view[%sep1_gate_i0] : view<64xf32> -> f32
  %sep1_gate_i1_0 = index.add %sep1_gate_i0, %two : index
  %sep1_gate_i1 = index.assume %sep1_gate_i1_0 [range(%sep1_gate_i1_0, 0, 63)] : index
  %sep1_gate_e1 = view.load %gate_lds_view[%sep1_gate_i1] : view<64xf32> -> f32
  %sep1_gate_i2_0 = index.add %sep1_gate_i1, %two : index
  %sep1_gate_i2 = index.assume %sep1_gate_i2_0 [range(%sep1_gate_i2_0, 0, 63)] : index
  %sep1_gate_e2 = view.load %gate_lds_view[%sep1_gate_i2] : view<64xf32> -> f32
  %sep1_gate_i3_0 = index.add %sep1_gate_i2, %two : index
  %sep1_gate_i3 = index.assume %sep1_gate_i3_0 [range(%sep1_gate_i3_0, 0, 63)] : index
  %sep1_gate_e3 = view.load %gate_lds_view[%sep1_gate_i3] : view<64xf32> -> f32
  %sep1_gate_i4_0 = index.add %sep1_gate_i3, %two : index
  %sep1_gate_i4 = index.assume %sep1_gate_i4_0 [range(%sep1_gate_i4_0, 0, 63)] : index
  %sep1_gate_e4 = view.load %gate_lds_view[%sep1_gate_i4] : view<64xf32> -> f32
  %sep1_gate_i5_0 = index.add %sep1_gate_i4, %two : index
  %sep1_gate_i5 = index.assume %sep1_gate_i5_0 [range(%sep1_gate_i5_0, 0, 63)] : index
  %sep1_gate_e5 = view.load %gate_lds_view[%sep1_gate_i5] : view<64xf32> -> f32
  %sep1_gate_i6_0 = index.add %sep1_gate_i5, %two : index
  %sep1_gate_i6 = index.assume %sep1_gate_i6_0 [range(%sep1_gate_i6_0, 0, 63)] : index
  %sep1_gate_e6 = view.load %gate_lds_view[%sep1_gate_i6] : view<64xf32> -> f32
