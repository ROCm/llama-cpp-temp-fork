  %rv3_0 = view.load %red_view[%rr3_0] : view<4096xf32> -> f32
  %rr3_1 = index.add %rb3, %k_sl1 : index
  %rv3_1 = view.load %red_view[%rr3_1] : view<4096xf32> -> f32
  %rr3_2 = index.add %rb3, %k_sl2 : index
  %rv3_2 = view.load %red_view[%rr3_2] : view<4096xf32> -> f32
  %rr3_3 = index.add %rb3, %k_sl3 : index
