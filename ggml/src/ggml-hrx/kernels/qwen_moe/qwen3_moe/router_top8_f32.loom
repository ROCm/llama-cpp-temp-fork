// Deterministic Qwen MoE routing from F32 expert logits.
//
// One wave owns one token row. Lanes load adjacent expert packets, repeatedly
// select the largest remaining logit, and break equal-logit ties in favor of
// the lower expert ordinal. Route IDs use an explicit physical row stride so
// the same kernel can publish either compact `[token][route]` rows or the
// `[token][expert]` argsort storage exposed by GGML views.
//
// Qwen applies a full expert softmax, selects the top-k probabilities, and
// renormalizes those selected probabilities. The full-softmax denominator
// cancels during renormalization:
//
//   (exp(x_i) / sum_all) / sum_topk(exp(x_j) / sum_all)
//       = exp(x_i) / sum_topk(exp(x_j))
//
// Selection therefore operates directly on logits and only the selected
// values reach the exponential. This preserves the model contract while
// avoiding exponentials for experts that cannot contribute to the result.
amdgpu.target<gfx11-generic> @qwen3_moe_router_gfx11_wave64 {subgroup_size = 64}

config.decl @qwen3_moe.router.expert_count : %value: index where [range(%value, 32, 512), mul(%value, 32)]

config.decl @qwen3_moe.router.route_count : %value: index where [range(%value, 1, 32)]

config.decl @qwen3_moe.workload.token_capacity : %value: index where [range(%value, 1, 2048)]

// Selects and normalizes one logical router row. The caller owns mapping a
// subgroup to a safe physical row and tells the helper whether that row should
// publish. Keeping row semantics independent of launch geometry lets fused
// producers consume this exact tie-breaking and normalization contract.
func.template<qwen3_moe.router.top8.row> device @qwen3_moe_router_top8_row_f32(%valid_token: i1, %token: index, %token_count: index, %route_id_stride: index, %logits: buffer, %route_ids: buffer, %route_weights: buffer) {
  %expert_count0 = config.get @qwen3_moe.router.expert_count : index
  %route_count0 = config.get @qwen3_moe.router.route_count : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_route_id_stride0 = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %expert_count, %route_count, %bounded_route_id_stride = index.assume %expert_count0, %route_count0, %bounded_route_id_stride0 [range(%expert_count0, 32, 512), mul(%expert_count0, 32), range(%route_count0, 1, 32), le(%route_count0, %expert_count0), le(%route_count0, %bounded_route_id_stride0)] : index, index, index
  %safe_token, %launch_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %wave_size = index.constant 64 : index
  %negative_large = scalar.constant -3.4028234663852885e+38 : f32
  %largest_i32 = scalar.constant 2147483647 : i32
  %c0_offset = index.constant 0 : offset
  %experts_per_lane0 = index.div %expert_count, %wave_size : index
  %experts_per_lane = index.assume %experts_per_lane0 [range(%experts_per_lane0, 1, 16)] : index
  %lane_expert_base = index.mul %lane, %experts_per_lane : index
  %route_id_storage_count = index.mul %launch_token_count, %bounded_route_id_stride : index
  %route_weight_storage_count = index.mul %launch_token_count, %route_count : index
  %logits_noalias, %route_ids_noalias, %route_weights_noalias = buffer.assume.noalias %logits, %route_ids, %route_weights : buffer, buffer, buffer
  %logits_view = buffer.view %logits_noalias[%c0_offset] : buffer -> view<[%launch_token_count]x[%expert_count]xf32>
  %route_ids_view = buffer.view %route_ids_noalias[%c0_offset] : buffer -> view<[%route_id_storage_count]xi32>
  %route_weights_view = buffer.view %route_weights_noalias[%c0_offset] : buffer -> view<[%route_weight_storage_count]xf32>
  %initial_logits = vector.load %logits_view[%safe_token, %lane_expert_base] : view<[%launch_token_count]x[%expert_count]xf32> -> vector<[%experts_per_lane]xf32>
  %remaining_final, %selected_logit = scf.for %route = [%c0 to %route_count step %c1](%remaining_logits = %initial_logits : vector<[%experts_per_lane]xf32>, %lane_selected_logit = %negative_large : f32) -> (vector<[%experts_per_lane]xf32>, f32) {
    %local_value, %local_id = scf.for %slot = [%c0 to %experts_per_lane step %c1](%best_value = %negative_large : f32, %best_id = %largest_i32 : i32) -> (f32, i32) unroll {
      %candidate_value = vector.extract %remaining_logits[%slot] : vector<[%experts_per_lane]xf32> -> f32
      %candidate_expert = index.add %lane_expert_base, %slot : index
      %candidate_id = index.cast %candidate_expert : index to i32
      %is_greater = scalar.cmpf ogt, %candidate_value, %best_value : f32
      %is_equal = scalar.cmpf oeq, %candidate_value, %best_value : f32
      %is_lower_id = scalar.cmpi ult, %candidate_id, %best_id : i32
      %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
      %is_better = scalar.ori %is_greater, %is_lower_tie : i1
      %next_value, %next_id = scf.if %is_better -> (f32, i32) {
        scf.yield %candidate_value, %candidate_id : f32, i32
      } else {
        scf.yield %best_value, %best_id : f32, i32
      }
      scf.yield %next_value, %next_id : f32, i32
    }
    %winner_value = kernel.subgroup.reduce<maxnumf> %local_value : f32
    %matches_winner = scalar.cmpf oeq, %local_value, %winner_value : f32
    %winner_lane_mask = kernel.subgroup.vote.ballot %matches_winner : i1 -> i64
    %nonzero_winner_lane_mask = scalar.assume %winner_lane_mask [ne(%winner_lane_mask, 0)] : i64
    %winner_lane_i64 = scalar.cttzi %nonzero_winner_lane_mask : i64
    %winner_lane0 = index.cast %winner_lane_i64 : i64 to index
    %winner_lane = index.assume %winner_lane0 [range(%winner_lane0, 0, 63)] : index
    %local_expert0 = index.cast %local_id : i32 to index
    %local_expert = index.assume %local_expert0 [range(%local_expert0, 0, 511)] : index
    %winner_slot = index.rem %local_expert, %experts_per_lane : index
    %owns_winner = index.cmp eq, %lane, %winner_lane : index
    %next_remaining_logits = scf.if %owns_winner -> (vector<[%experts_per_lane]xf32>) {
      %removed = vector.insert %negative_large into %remaining_logits[%winner_slot] : f32, vector<[%experts_per_lane]xf32>
      scf.yield %removed : vector<[%experts_per_lane]xf32>
    } else {
      scf.yield %remaining_logits : vector<[%experts_per_lane]xf32>
    }
    %publishes_route_id = scalar.andi %valid_token, %owns_winner : i1
    scf.if %publishes_route_id {
      %route_id_token_base = index.mul %safe_token, %bounded_route_id_stride : index
      %route_id_index = index.add %route_id_token_base, %route : index
      view.store %local_id, %route_ids_view[%route_id_index] : i32, view<[%route_id_storage_count]xi32>
    }
    %lane_publishes_route = index.cmp eq, %lane, %route : index
    %publishes_route = scalar.andi %valid_token, %lane_publishes_route : i1
    %next_lane_selected_logit = scf.if %publishes_route -> (f32) {
      scf.yield %winner_value : f32
    } else {
      scf.yield %lane_selected_logit : f32
    }
    scf.yield %next_remaining_logits, %next_lane_selected_logit : vector<[%experts_per_lane]xf32>, f32
  }
  %selected_max = kernel.subgroup.reduce<maxnumf> %selected_logit : f32
  %selected_delta = scalar.subf<reassoc|nnan|ninf|nsz> %selected_logit, %selected_max : f32
  %unnormalized_weight = scalar.expf<afn> %selected_delta : f32
  %selected_sum = kernel.subgroup.reduce<addf> %unnormalized_weight : f32
  %route_weight = scalar.divf<reassoc|nnan|ninf|nsz|afn> %unnormalized_weight, %selected_sum : f32
  %lane_publishes_weight = index.cmp ult, %lane, %route_count : index
  %publishes_weight = scalar.andi %valid_token, %lane_publishes_weight : i1
  scf.if %publishes_weight {
    %route_weight_token_base = index.mul %safe_token, %route_count : index
    %route_weight_index = index.add %route_weight_token_base, %lane : index
    view.store %route_weight, %route_weights_view[%route_weight_index] : f32, view<[%route_weight_storage_count]xf32>
  }
  func.return
}

kernel.def target(@qwen3_moe_router_gfx11_wave64) @qwen3_moe_router_top8_f32(%token_count: index, %route_id_stride: index) {
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %wave_size = index.constant 64 : index
  %wide_workgroup_size = index.constant 256 : index
  %uses_decode_geometry = index.cmp eq, %token_capacity, %c1 : index
  %subgroup_count = scf.select %uses_decode_geometry, %c1, %c4 : index
  %workgroup_size = scf.select %uses_decode_geometry, %wave_size, %wide_workgroup_size : index
  %padded_token_count = index.add %token_capacity, %c3 : index
  %wide_workgroup_count = index.div %padded_token_count, %c4 : index
  %workgroup_count = scf.select %uses_decode_geometry, %token_capacity, %wide_workgroup_count : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %route_id_stride: index, %logits: buffer, %route_ids: buffer, %route_weights: buffer) {
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %token_workgroup = kernel.workgroup.id<x> : index
  %subgroup = kernel.subgroup.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %uses_decode_geometry = index.cmp eq, %token_capacity, %c1 : index
  %subgroup_count = scf.select %uses_decode_geometry, %c1, %c4 : index
  %token_base = index.mul %token_workgroup, %subgroup_count : index
  %token0 = index.add %token_base, %subgroup : index
  %valid_token = index.cmp ult, %token0, %bounded_token_count : index
  %safe_token = scf.select %valid_token, %token0, %c0 : index
  func.apply<qwen3_moe.router.top8.row>(%valid_token, %safe_token, %bounded_token_count, %route_id_stride, %logits, %route_ids, %route_weights) : (i1, index, index, index, buffer, buffer, buffer)
  kernel.return
}

// Builds the deterministic route-ID oracle for two physical rows with eight
// published IDs and eight untouched padding slots per row.
kernel.def @qwen3_moe_router_top8_wide_stride_reference() {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%route_ids: buffer) {
  %element = kernel.workitem.id<x> : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c0_offset = index.constant 0 : offset
  %slot = index.rem %element, %c16 : index
  %publishes_id = index.cmp ult, %slot, %c8 : index
  %route_ids_view = buffer.view %route_ids[%c0_offset] : buffer -> view<32xi32>
  scf.if %publishes_id {
    %scaled_slot = index.mul %slot, %c8 : index
    %route_id_index = index.add %scaled_slot, %c7 : index
    %route_id = index.cast %route_id_index : index to i32
    view.store %route_id, %route_ids_view[%element] : i32, view<32xi32>
  }
  kernel.return
}

// Period-eight logits place sixteen equal maxima in different lane-local
// slots. Repeated selection must remove each winner and retain the lower-ID
// half of that tie set. Two rows leave two inactive waves in the four-wave
// production workgroup and exercise guarded tail publication. A second call
// proves that a wider physical route-ID stride preserves its padding.
check.case public @qwen3_moe_router_top8_f32_repeated_maxima_case {
  %token_count = check.literal value(2) : index
  %route_id_stride = check.literal value(8) : index
  %wide_route_id_stride = check.literal value(16) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(8) : tensor<2x128xf32>
  %route_ids = check.generate.fill value(-1) : tensor<2x8xi32>
  %route_weights = check.generate.fill value(0.0) : tensor<2x8xf32>
  %wide_route_ids = check.generate.fill value(-1) : tensor<2x16xi32>
  %wide_route_weights = check.generate.fill value(0.0) : tensor<2x8xf32>
  %expected_ids = check.generate.iota offset(7) step(8) period(8) : tensor<2x8xi32>
  %expected_wide_ids = check.generate.fill value(-1) : tensor<2x16xi32>
  %expected_weights = check.generate.fill value(0.125) : tensor<2x8xf32>
  kernel.launch @qwen3_moe_router_top8_f32[%token_count, %route_id_stride](%token_count, %route_id_stride, %logits, %route_ids, %route_weights) : [index, index](index, index, tensor<2x128xf32>, tensor<2x8xi32>, tensor<2x8xf32>)
  kernel.launch @qwen3_moe_router_top8_wide_stride_reference[](%expected_wide_ids) : [](tensor<2x16xi32>)
  kernel.launch @qwen3_moe_router_top8_f32[%token_count, %wide_route_id_stride](%token_count, %wide_route_id_stride, %logits, %wide_route_ids, %wide_route_weights) : [index, index](index, index, tensor<2x128xf32>, tensor<2x16xi32>, tensor<2x8xf32>)
  check.expect.equal actual(%route_ids) expected(%expected_ids) : tensor<2x8xi32>
  check.expect.close actual(%route_weights) expected(%expected_weights) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<2x8xf32>
  check.expect.equal actual(%wide_route_ids) expected(%expected_wide_ids) : tensor<2x16xi32>
  check.expect.close actual(%wide_route_weights) expected(%expected_weights) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<2x8xf32>
  check.return
}

check.case public @qwen3_moe_router_top8_f32_benchmark_case {
  %token_count = check.param.choice values([1, 32, 128, 512]) name("token_count") : index
  %route_id_stride = check.literal value(8) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(8) : tensor<[%token_count]x128xf32>
  %route_ids = check.generate.fill value(-1) : tensor<[%token_count]x8xi32>
  %route_weights = check.generate.fill value(0.0) : tensor<[%token_count]x8xf32>
  %expected_ids = check.generate.iota offset(7) step(8) period(8) : tensor<[%token_count]x8xi32>
  %expected_weights = check.generate.fill value(0.125) : tensor<[%token_count]x8xf32>
  kernel.launch @qwen3_moe_router_top8_f32[%token_count, %route_id_stride](%token_count, %route_id_stride, %logits, %route_ids, %route_weights) : [index, index](index, index, tensor<[%token_count]x128xf32>, tensor<[%token_count]x8xi32>, tensor<[%token_count]x8xf32>)
  check.expect.equal actual(%route_ids) expected(%expected_ids) : tensor<[%token_count]x8xi32>
  check.expect.close actual(%route_weights) expected(%expected_weights) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<[%token_count]x8xf32>
  check.return
}

check.benchmark<@qwen3_moe_router_top8_f32_repeated_maxima_case> @qwen3_moe_router_top8_f32_repeated_maxima

check.benchmark<@qwen3_moe_router_top8_f32_benchmark_case> @qwen3_moe_router_top8_f32_decode {token_count = 1}

check.benchmark<@qwen3_moe_router_top8_f32_benchmark_case> @qwen3_moe_router_top8_f32_prefill_32 {token_count = 32}

check.benchmark<@qwen3_moe_router_top8_f32_benchmark_case> @qwen3_moe_router_top8_f32_prefill_128 {token_count = 128}

check.benchmark<@qwen3_moe_router_top8_f32_benchmark_case> @qwen3_moe_router_top8_f32_prefill_512 {token_count = 512}

// ============================================================================
// Qwen3.6 compile-time-specialized roots in this native semantic family
// ============================================================================

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/graph/topk_moe_softmax_norm_decode.loom
// ----------------------------------------------------------------------------
// Exact one-wave Qwen MoE router tail for decode (one token).
//
// The live allocator aliases the 8-f32 terminal weights output with part of the
// 256-f32 logits allocation. Every lane therefore loads all eight logits it
// owns before the first store, and a workgroup barrier separates the global
// reads from lane 0's writes. The full 256-i32 ARGSORT backing is a separate
// allocation; only words 0..7 are materialized because its sole live view is
// the top-8 prefix.
//
// Ranking is performed on the rounded full-softmax probabilities, not logits.
// Repeated argmax plus the lower expert id tie break exactly implements stable
// descending ARGSORT for the first eight entries.

kernel.def export("hrx2_topk_moe_softmax_norm_decode_f32") @hrx2_topk_moe_softmax_norm_decode_f32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit)
      workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%logits: buffer, %ids: buffer, %weights: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eight = index.constant 8 : index
  %thirty_two = index.constant 32 : index
  %sixty_four = index.constant 64 : index
  %ninety_six = index.constant 96 : index
  %one_twenty_eight = index.constant 128 : index
  %one_sixty = index.constant 160 : index
  %one_ninety_two = index.constant 192 : index
  %two_twenty_four = index.constant 224 : index

  %zero_i32 = scalar.constant 0 : i32
  %sentinel_i32 = scalar.constant 256 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %neg_max_f32 = scalar.constant -3.4028234663852886e+38 : f32
  %denom_min = scalar.constant 6.103515625e-5 : f32
  %sentinel_i32_v = vector.constant 256 : vector<8xi32>
  %empty_ids = vector.constant 256 : vector<8xi32>
  %empty_probs = vector.constant 0.0 : vector<8xf32>
  %neg_max_v = vector.constant -3.4028234663852886e+38 : vector<8xf32>

  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index

  %expert0 = index.add %lane, %zero : index
  %expert1_0 = index.add %lane, %thirty_two : index
  %expert1 = index.assume %expert1_0 [range(%expert1_0, 32, 63)] : index
  %expert2_0 = index.add %lane, %sixty_four : index
  %expert2 = index.assume %expert2_0 [range(%expert2_0, 64, 95)] : index
  %expert3_0 = index.add %lane, %ninety_six : index
  %expert3 = index.assume %expert3_0 [range(%expert3_0, 96, 127)] : index
  %expert4_0 = index.add %lane, %one_twenty_eight : index
  %expert4 = index.assume %expert4_0 [range(%expert4_0, 128, 159)] : index
  %expert5_0 = index.add %lane, %one_sixty : index
  %expert5 = index.assume %expert5_0 [range(%expert5_0, 160, 191)] : index
  %expert6_0 = index.add %lane, %one_ninety_two : index
  %expert6 = index.assume %expert6_0 [range(%expert6_0, 192, 223)] : index
  %expert7_0 = index.add %lane, %two_twenty_four : index
  %expert7 = index.assume %expert7_0 [range(%expert7_0, 224, 255)] : index

  %expert0_i32 = index.cast %expert0 : index to i32
  %expert1_i32 = index.cast %expert1 : index to i32
  %expert2_i32 = index.cast %expert2 : index to i32
  %expert3_i32 = index.cast %expert3 : index to i32
  %expert4_i32 = index.cast %expert4 : index to i32
  %expert5_i32 = index.cast %expert5 : index to i32
  %expert6_i32 = index.cast %expert6 : index to i32
  %expert7_i32 = index.cast %expert7 : index to i32
  %expert_ids = vector.from_elements %expert0_i32, %expert1_i32, %expert2_i32, %expert3_i32, %expert4_i32, %expert5_i32, %expert6_i32, %expert7_i32 : vector<8xi32>

  %logits_global = buffer.assume.memory_space<global> %logits : buffer
  %ids_global = buffer.assume.memory_space<global> %ids : buffer
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  // Do not assert logits/weights noalias: they overlap in the live graph.
  %logits_view = buffer.view %logits_global[%base] : buffer -> view<256xf32>
  %ids_view = buffer.view %ids_global[%base] : buffer -> view<256xi32>
  %weights_view = buffer.view %weights_global[%base] : buffer -> view<8xf32>

  %x0 = view.load %logits_view[%expert0] : view<256xf32> -> f32
  %x1 = view.load %logits_view[%expert1] : view<256xf32> -> f32
  %x2 = view.load %logits_view[%expert2] : view<256xf32> -> f32
  %x3 = view.load %logits_view[%expert3] : view<256xf32> -> f32
  %x4 = view.load %logits_view[%expert4] : view<256xf32> -> f32
  %x5 = view.load %logits_view[%expert5] : view<256xf32> -> f32
  %x6 = view.load %logits_view[%expert6] : view<256xf32> -> f32
  %x7 = view.load %logits_view[%expert7] : view<256xf32> -> f32
  %values = vector.from_elements %x0, %x1, %x2, %x3, %x4, %x5, %x6, %x7 : vector<8xf32>

  // All 256 logits are now resident in the wave before an aliased output store.
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %lane_max = vector.reduce<maxnumf> %values, %neg_max_f32 : vector<8xf32>, f32
  %row_max = kernel.subgroup.reduce<maxnumf> %lane_max : f32
  %row_max_v = vector.splat %row_max : vector<8xf32>
  %shifted = vector.subf<nnan|ninf|nsz> %values, %row_max_v : vector<8xf32>
  %exps = vector.expf<afn> %shifted : vector<8xf32>
  %lane_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %exps, %zero_f32 : vector<8xf32>, f32
  %row_sum = kernel.subgroup.reduce<addf> %lane_sum : f32
  %row_sum_v = vector.splat %row_sum : vector<8xf32>
  %probs = vector.divf<nnan|ninf|nsz|arcp> %exps, %row_sum_v : vector<8xf32>

  %live_final, %selected_ids, %selected_probs = scf.for %slot = [%zero to %eight step %one](%live = %probs : vector<8xf32>, %ids_acc = %empty_ids : vector<8xi32>, %probs_acc = %empty_probs : vector<8xf32>) -> (vector<8xf32>, vector<8xi32>, vector<8xf32>) unroll {
    %lane_best = vector.reduce<maxnumf> %live, %neg_max_f32 : vector<8xf32>, f32
    %winner_prob = kernel.subgroup.reduce<maxnumf> %lane_best : f32
    %winner_prob_v = vector.splat %winner_prob : vector<8xf32>
    %matching = vector.cmpf oeq, %live, %winner_prob_v : vector<8xf32> -> vector<8xi1>
    %matching_ids = vector.select %matching, %expert_ids, %sentinel_i32_v : vector<8xi32>
    %lane_winner_id = vector.reduce<minsi> %matching_ids, %sentinel_i32 : vector<8xi32>, i32
    %winner_id = kernel.subgroup.reduce<minsi> %lane_winner_id : i32

    %ids_next = vector.insert %winner_id into %ids_acc[%slot] : i32, vector<8xi32>
    %probs_next = vector.insert %winner_prob into %probs_acc[%slot] : f32, vector<8xf32>
    %winner_id_v = vector.splat %winner_id : vector<8xi32>
    %winner_mask = vector.cmpi eq, %expert_ids, %winner_id_v : vector<8xi32> -> vector<8xi1>
    %live_next = vector.select %winner_mask, %neg_max_v, %live : vector<8xf32>
    scf.yield %live_next, %ids_next, %probs_next : vector<8xf32>, vector<8xi32>, vector<8xf32>
  }

  %selected_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %selected_probs, %zero_f32 : vector<8xf32>, f32
  %denom = scalar.maxnumf %selected_sum, %denom_min : f32

  %lane_i32 = index.cast %lane : index to i32
  %lane_is_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %lane_is_zero {
    scf.for %slot = [%zero to %eight step %one] unroll {
      %winner_id = vector.extract %selected_ids[%slot] : vector<8xi32> -> i32
      %winner_prob = vector.extract %selected_probs[%slot] : vector<8xf32> -> f32
      %weight = scalar.divf<nnan|ninf|nsz|arcp> %winner_prob, %denom : f32
      view.store %winner_id, %ids_view[%slot] : i32, view<256xi32>
      view.store %weight, %weights_view[%slot] : f32, view<8xf32>
    }
  }
  kernel.return
}

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/graph/topk_moe_softmax_norm_pp512.loom
// ----------------------------------------------------------------------------
// Alias-safe fused Qwen MoE router tail for the production pp512 shape.
//
// Input logits are dense [256 experts, 512 tokens]. Each 256-thread
// workgroup contains eight wave32 subgroups, and each subgroup owns one token.
// A lane owns experts lane + 32*k for k=0..7, so all eight global load
// instructions are full, coalesced 128-byte transactions.
//
// The kernel computes the complete max-subtracted softmax before ranking.
// Eight stable argmax iterations select the winners from the rounded softmax
// probabilities; equal probabilities are ordered by lower expert id. This
// exactly matches the stable descending ARGSORT contract while materializing
// only ranks 0..7.
// Selected probabilities are summed, clamped to the smallest normal f16 value,
// and normalized. The first dispatch writes IDs to words 0..7 and stages the
// final f32 weights bitwise in otherwise-unused words 8..15 of each 256-word
// ARGSORT row. A second dispatch copies those staged weights to the dense
// [8, 512] output. Keeping the final destination out of the logits-reading
// dispatch makes allocator reuse between logits and weights safe.
//
// No LDS is required: max, sum, rank, and selected-sum communication all use
// subgroup collectives.

config.decl @hrx2_shape_topk_moe_nexperts : %value: index where [range(%value, 256, 256)]
config.decl @hrx2_shape_topk_moe_ntokens : %value: index where [range(%value, 512, 512)]
config.decl @hrx2_shape_topk_moe_nselected : %value: index where [range(%value, 8, 8)]
config.decl @hrx2_shape_topk_moe_logits_token_stride : %value: index where [range(%value, 256, 256)]
config.decl @hrx2_shape_topk_moe_ids_token_stride : %value: index where [range(%value, 256, 256)]
config.decl @hrx2_shape_topk_moe_weights_token_stride : %value: index where [range(%value, 8, 8)]

kernel.def export("hrx2_topk_moe_softmax_norm_stage_f32") @hrx2_topk_moe_softmax_norm_stage_f32() {
  %unit = index.constant 1 : index
  %eight = index.constant 8 : index
  %workgroup_size = index.constant 256 : index
  %ntokens0 = config.get @hrx2_shape_topk_moe_ntokens : index
  %ntokens = index.assume %ntokens0 [range(%ntokens0, 512, 512), mul(%ntokens0, 8)] : index
  %workgroups = index.div %ntokens, %eight : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%logits: buffer, %ids: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eight = index.constant 8 : index
  %thirty_two = index.constant 32 : index
  %sixty_four = index.constant 64 : index
  %ninety_six = index.constant 96 : index
  %one_twenty_eight = index.constant 128 : index
  %one_sixty = index.constant 160 : index
  %one_ninety_two = index.constant 192 : index
  %two_twenty_four = index.constant 224 : index

  %zero_i32 = scalar.constant 0 : i32
  %sentinel_i32 = scalar.constant 256 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %neg_max_f32 = scalar.constant -3.4028234663852886e+38 : f32
  %denom_min = scalar.constant 6.103515625e-5 : f32
  %sentinel_i32_v = vector.constant 256 : vector<8xi32>
  %empty_ids = vector.constant 256 : vector<8xi32>
  %empty_probs = vector.constant 0.0 : vector<8xf32>
  %neg_max_v = vector.constant -3.4028234663852886e+38 : vector<8xf32>

  %nselected0 = config.get @hrx2_shape_topk_moe_nselected : index
  %nselected = index.assume %nselected0 [range(%nselected0, 8, 8)] : index
  %logits_stride0 = config.get @hrx2_shape_topk_moe_logits_token_stride : index
  %logits_stride = index.assume %logits_stride0 [range(%logits_stride0, 256, 256)] : index
  %ids_stride0 = config.get @hrx2_shape_topk_moe_ids_token_stride : index
  %ids_stride = index.assume %ids_stride0 [range(%ids_stride0, 256, 256)] : index
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 63)] : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index

  %token_base0 = index.mul %workgroup, %eight : index
  %token0 = index.add %token_base0, %subgroup : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index

  %expert0 = index.add %lane, %zero : index
  %expert1_0 = index.add %lane, %thirty_two : index
  %expert1 = index.assume %expert1_0 [range(%expert1_0, 32, 63)] : index
  %expert2_0 = index.add %lane, %sixty_four : index
  %expert2 = index.assume %expert2_0 [range(%expert2_0, 64, 95)] : index
  %expert3_0 = index.add %lane, %ninety_six : index
  %expert3 = index.assume %expert3_0 [range(%expert3_0, 96, 127)] : index
  %expert4_0 = index.add %lane, %one_twenty_eight : index
  %expert4 = index.assume %expert4_0 [range(%expert4_0, 128, 159)] : index
  %expert5_0 = index.add %lane, %one_sixty : index
  %expert5 = index.assume %expert5_0 [range(%expert5_0, 160, 191)] : index
  %expert6_0 = index.add %lane, %one_ninety_two : index
  %expert6 = index.assume %expert6_0 [range(%expert6_0, 192, 223)] : index
  %expert7_0 = index.add %lane, %two_twenty_four : index
  %expert7 = index.assume %expert7_0 [range(%expert7_0, 224, 255)] : index

  %expert0_i32 = index.cast %expert0 : index to i32
  %expert1_i32 = index.cast %expert1 : index to i32
  %expert2_i32 = index.cast %expert2 : index to i32
  %expert3_i32 = index.cast %expert3 : index to i32
  %expert4_i32 = index.cast %expert4 : index to i32
  %expert5_i32 = index.cast %expert5 : index to i32
  %expert6_i32 = index.cast %expert6 : index to i32
  %expert7_i32 = index.cast %expert7 : index to i32
  %expert_ids = vector.from_elements %expert0_i32, %expert1_i32, %expert2_i32, %expert3_i32, %expert4_i32, %expert5_i32, %expert6_i32, %expert7_i32 : vector<8xi32>

  %logits_global = buffer.assume.memory_space<global> %logits : buffer
  %ids_global = buffer.assume.memory_space<global> %ids : buffer
  %logits_na, %ids_na = buffer.assume.noalias %logits_global, %ids_global : buffer, buffer
  %logits_view = buffer.view %logits_na[%base] : buffer -> view<131072xf32>
  %ids_view = buffer.view %ids_na[%base] : buffer -> view<131072xi32>
  %staged_weights_view = buffer.view %ids_na[%base] : buffer -> view<131072xf32>

  %logits_base0 = index.mul %token, %logits_stride : index
  %logits_base = index.assume %logits_base0 [range(%logits_base0, 0, 130816), mul(%logits_base0, 256)] : index
  %li0_0 = index.add %logits_base, %expert0 : index
  %li0 = index.assume %li0_0 [range(%li0_0, 0, 131071)] : index
  %li1_0 = index.add %logits_base, %expert1 : index
  %li1 = index.assume %li1_0 [range(%li1_0, 0, 131071)] : index
  %li2_0 = index.add %logits_base, %expert2 : index
  %li2 = index.assume %li2_0 [range(%li2_0, 0, 131071)] : index
  %li3_0 = index.add %logits_base, %expert3 : index
  %li3 = index.assume %li3_0 [range(%li3_0, 0, 131071)] : index
  %li4_0 = index.add %logits_base, %expert4 : index
  %li4 = index.assume %li4_0 [range(%li4_0, 0, 131071)] : index
  %li5_0 = index.add %logits_base, %expert5 : index
  %li5 = index.assume %li5_0 [range(%li5_0, 0, 131071)] : index
  %li6_0 = index.add %logits_base, %expert6 : index
  %li6 = index.assume %li6_0 [range(%li6_0, 0, 131071)] : index
  %li7_0 = index.add %logits_base, %expert7 : index
  %li7 = index.assume %li7_0 [range(%li7_0, 0, 131071)] : index

  %x0 = view.load %logits_view[%li0] : view<131072xf32> -> f32
  %x1 = view.load %logits_view[%li1] : view<131072xf32> -> f32
  %x2 = view.load %logits_view[%li2] : view<131072xf32> -> f32
  %x3 = view.load %logits_view[%li3] : view<131072xf32> -> f32
  %x4 = view.load %logits_view[%li4] : view<131072xf32> -> f32
  %x5 = view.load %logits_view[%li5] : view<131072xf32> -> f32
  %x6 = view.load %logits_view[%li6] : view<131072xf32> -> f32
  %x7 = view.load %logits_view[%li7] : view<131072xf32> -> f32
  %values = vector.from_elements %x0, %x1, %x2, %x3, %x4, %x5, %x6, %x7 : vector<8xf32>

  // Full max-subtracted softmax over all 256 experts.
  %lane_max = vector.reduce<maxnumf> %values, %neg_max_f32 : vector<8xf32>, f32
  %row_max = kernel.subgroup.reduce<maxnumf> %lane_max : f32
  %row_max_v = vector.splat %row_max : vector<8xf32>
  %shifted = vector.subf<nnan|ninf|nsz> %values, %row_max_v : vector<8xf32>
  %exps = vector.expf<afn> %shifted : vector<8xf32>
  %lane_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %exps, %zero_f32 : vector<8xf32>, f32
  %row_sum = kernel.subgroup.reduce<addf> %lane_sum : f32
  %row_sum_v = vector.splat %row_sum : vector<8xf32>
  %probs = vector.divf<nnan|ninf|nsz|arcp> %exps, %row_sum_v : vector<8xf32>

  // Repeated stable argmax. Every lane receives the same subgroup maximum and
  // winner id, records the same selected vectors, then masks its local copy of
  // that expert. Selecting the minimum matching id implements the lower-id
  // tie rule without LDS.
  %live_final, %selected_ids, %selected_probs = scf.for %slot = [%zero to %nselected step %one](%live = %probs : vector<8xf32>, %ids_acc = %empty_ids : vector<8xi32>, %probs_acc = %empty_probs : vector<8xf32>) -> (vector<8xf32>, vector<8xi32>, vector<8xf32>) unroll {
    %lane_best = vector.reduce<maxnumf> %live, %neg_max_f32 : vector<8xf32>, f32
    %winner_prob = kernel.subgroup.reduce<maxnumf> %lane_best : f32
    %winner_prob_v = vector.splat %winner_prob : vector<8xf32>
    %matching = vector.cmpf oeq, %live, %winner_prob_v : vector<8xf32> -> vector<8xi1>
    %matching_ids = vector.select %matching, %expert_ids, %sentinel_i32_v : vector<8xi32>
    %lane_winner_id = vector.reduce<minsi> %matching_ids, %sentinel_i32 : vector<8xi32>, i32
    %winner_id = kernel.subgroup.reduce<minsi> %lane_winner_id : i32

    %ids_next = vector.insert %winner_id into %ids_acc[%slot] : i32, vector<8xi32>
    %probs_next = vector.insert %winner_prob into %probs_acc[%slot] : f32, vector<8xf32>
    %winner_id_v = vector.splat %winner_id : vector<8xi32>
    %winner_mask = vector.cmpi eq, %expert_ids, %winner_id_v : vector<8xi32> -> vector<8xi1>
    %live_next = vector.select %winner_mask, %neg_max_v, %live : vector<8xf32>
    scf.yield %live_next, %ids_next, %probs_next : vector<8xf32>, vector<8xi32>, vector<8xf32>
  }

  %selected_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %selected_probs, %zero_f32 : vector<8xf32>, f32
  %denom = scalar.maxnumf %selected_sum, %denom_min : f32

  // Selected vectors are subgroup-uniform, so lane 0 alone materializes the
  // top-k view and stages normalized weights in words 8..15 of the same row.
  %lane_i32 = index.cast %lane : index to i32
  %lane_is_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %lane_is_zero {
    scf.for %slot = [%zero to %nselected step %one] unroll {
      %winner_id = vector.extract %selected_ids[%slot] : vector<8xi32> -> i32
      %winner_prob = vector.extract %selected_probs[%slot] : vector<8xf32> -> f32
      %ids_base0 = index.mul %token, %ids_stride : index
      %ids_base = index.assume %ids_base0 [range(%ids_base0, 0, 130816), mul(%ids_base0, 256)] : index
      %ids_index0 = index.add %ids_base, %slot : index
      %ids_index = index.assume %ids_index0 [range(%ids_index0, 0, 130823)] : index
      view.store %winner_id, %ids_view[%ids_index] : i32, view<131072xi32>

      %staged_slot0 = index.add %eight, %slot : index
      %staged_slot = index.assume %staged_slot0 [range(%staged_slot0, 8, 15)] : index
      %weights_index0 = index.add %ids_base, %staged_slot : index
      %weights_index = index.assume %weights_index0 [range(%weights_index0, 8, 130831)] : index
      %weight = scalar.divf<nnan|ninf|nsz|arcp> %winner_prob, %denom : f32
      view.store %weight, %staged_weights_view[%weights_index] : f32, view<131072xf32>
    }
  }
  kernel.return
}

// Copies the staged words to the terminal dense weights tensor. Each wave
// handles four tokens in four 8-lane groups, so all lanes participate and each
// token's 32-byte staged segment remains contiguous.
kernel.def export("hrx2_topk_moe_weights_copy_f32") @hrx2_topk_moe_weights_copy_f32() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size = index.constant 256 : index
  %ntokens0 = config.get @hrx2_shape_topk_moe_ntokens : index
  %ntokens = index.assume %ntokens0 [range(%ntokens0, 512, 512), mul(%ntokens0, 32)] : index
  %workgroups = index.div %ntokens, %thirty_two : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%ids: buffer, %weights: buffer) {
  %base = index.constant 0 : offset
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %thirty_two = index.constant 32 : index

  %ids_stride0 = config.get @hrx2_shape_topk_moe_ids_token_stride : index
  %ids_stride = index.assume %ids_stride0 [range(%ids_stride0, 256, 256)] : index
  %weights_stride0 = config.get @hrx2_shape_topk_moe_weights_token_stride : index
  %weights_stride = index.assume %weights_stride0 [range(%weights_stride0, 8, 8)] : index

  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 15)] : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index

  %token_group = index.div %lane, %eight : index
  %slot0 = index.rem %lane, %eight : index
  %slot = index.assume %slot0 [range(%slot0, 0, 7)] : index
  %workgroup_token_base0 = index.mul %workgroup, %thirty_two : index
  %subgroup_token_base0 = index.mul %subgroup, %four : index
  %token_base0 = index.add %workgroup_token_base0, %subgroup_token_base0 : index
  %token0 = index.add %token_base0, %token_group : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index

  %ids_global = buffer.assume.memory_space<global> %ids : buffer
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %ids_na, %weights_na = buffer.assume.noalias %ids_global, %weights_global : buffer, buffer
  %staged_weights_view = buffer.view %ids_na[%base] : buffer -> view<131072xf32>
  %weights_view = buffer.view %weights_na[%base] : buffer -> view<4096xf32>

  %ids_base0 = index.mul %token, %ids_stride : index
  %ids_base = index.assume %ids_base0 [range(%ids_base0, 0, 130816), mul(%ids_base0, 256)] : index
  %staged_slot0 = index.add %eight, %slot : index
  %staged_slot = index.assume %staged_slot0 [range(%staged_slot0, 8, 15)] : index
  %src_index0 = index.add %ids_base, %staged_slot : index
  %src_index = index.assume %src_index0 [range(%src_index0, 8, 130831)] : index
  %weight = view.load %staged_weights_view[%src_index] : view<131072xf32> -> f32

  %weights_base0 = index.mul %token, %weights_stride : index
  %weights_base = index.assume %weights_base0 [range(%weights_base0, 0, 4088), mul(%weights_base0, 8)] : index
  %dst_index0 = index.add %weights_base, %slot : index
  %dst_index = index.assume %dst_index0 [range(%dst_index0, 0, 4095)] : index
  view.store %weight, %weights_view[%dst_index] : f32, view<4096xf32>
  kernel.return
}

// ----------------------------------------------------------------------------
// Specialized root formerly in qwen36/legacy/sources/gfx1151/graph/topk_qact_shared_producer_decode.loom
// ----------------------------------------------------------------------------
// Native decode prefix: TopK/Qact plus SharedP.
//
// WGs 0..rows-1 execute the existing shared dual-Q8 rows, WG rows executes its
// scalar gate, and WG rows+1 executes the one-WG TopK/Qact
// body. Shared output and raw gate use native graph-transient bindings; the
// normalized router weights retain their original graph tensor and semantics.
// The classes are independent and the following dispatch is the grid sync.

config.decl @hrx2_shape_qact_k : %value: index where [range(%value, 32, 65536), mul(%value, 32)]
config.decl @hrx2_shape_qact_cols : %value: index where [range(%value, 1, 16384)]
config.decl @hrx2_shape_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]
config.decl @hrx2_shape_rows : %value: index where [range(%value, 512, 512)]
config.decl @hrx2_shape_cols : %value: index where [range(%value, 1, 4096)]
config.decl @hrx2_tuning_workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_tuning_q8_0_f32_unroll_factor : %value: index where [range(%value, 0, 16)]

kernel.def export("hrx2_topk_qact_shared_producer_decode")
    @hrx2_topk_qact_shared_producer_decode() {
  %route_one = index.constant 1 : index
  %route_two = index.constant 2 : index
  %route_rows = config.get @hrx2_shape_rows : index
  %route_workgroups = index.add %route_rows, %route_two : index
  %route_wg_size = config.get @hrx2_tuning_workgroup_size : index
  kernel.launch.config workgroups(%route_workgroups, %route_one, %route_one)
      workgroup_size(%route_wg_size, %route_one, %route_one) : index
  } launch(%tk_logits: buffer, %tk_ids: buffer, %tk_weights: buffer,
          %src1: buffer, %qa_packed: buffer, %gate_weights: buffer,
          %up_weights: buffer, %shared_gate_weight: buffer, %dst: buffer,
          %raw_gate: buffer) {
  %route_zero = index.constant 0 : index
  %route_one = index.constant 1 : index
  %route_wg0 = kernel.workgroup.id<x> : index
  %route_wg = index.assume %route_wg0 [range(%route_wg0, 0, 262145)] : index
  %route_rows = config.get @hrx2_shape_rows : index
  %route_topk_wg = index.add %route_rows, %route_one : index
  %route_is_topk = index.cmp eq, %route_wg, %route_topk_wg : index
  scf.if %route_is_topk {
      %phase_zero = index.constant 0 : index
      %phase_one = index.constant 1 : index
      %phase_three = index.constant 3 : index
      %phase_subgroup0 = kernel.subgroup.id : index
      %phase_subgroup = index.assume %phase_subgroup0
          [range(%phase_subgroup0, 0, 7)] : index
      %phase_is_topk = index.cmp eq, %phase_subgroup, %phase_zero : index
      %phase_qact_lo = index.cmp uge, %phase_subgroup, %phase_one : index
      %phase_qact_hi = index.cmp ult, %phase_subgroup, %phase_three : index
      %phase_is_qact = scalar.andi %phase_qact_lo, %phase_qact_hi : i1

      scf.if %phase_is_topk {
          %tk_base = index.constant 0 : offset
          %tk_zero = index.constant 0 : index
          %tk_one = index.constant 1 : index
          %tk_eight = index.constant 8 : index
          %tk_thirty_two = index.constant 32 : index
          %tk_sixty_four = index.constant 64 : index
          %tk_ninety_six = index.constant 96 : index
          %tk_one_twenty_eight = index.constant 128 : index
          %tk_one_sixty = index.constant 160 : index
          %tk_one_ninety_two = index.constant 192 : index
          %tk_two_twenty_four = index.constant 224 : index

          %tk_zero_i32 = scalar.constant 0 : i32
          %tk_sentinel_i32 = scalar.constant 256 : i32
          %tk_zero_f32 = scalar.constant 0.0 : f32
          %tk_neg_max_f32 = scalar.constant -3.4028234663852886e+38 : f32
          %tk_denom_min = scalar.constant 6.103515625e-5 : f32
          %tk_sentinel_i32_v = vector.constant 256 : vector<8xi32>
          %tk_empty_ids = vector.constant 256 : vector<8xi32>
          %tk_empty_probs = vector.constant 0.0 : vector<8xf32>
          %tk_neg_max_v = vector.constant -3.4028234663852886e+38 : vector<8xf32>

          %tk_lane0 = kernel.subgroup.lane.id : index
          %tk_lane = index.assume %tk_lane0 [range(%tk_lane0, 0, 31)] : index

          %tk_expert0 = index.add %tk_lane, %tk_zero : index
          %tk_expert1_0 = index.add %tk_lane, %tk_thirty_two : index
          %tk_expert1 = index.assume %tk_expert1_0 [range(%tk_expert1_0, 32, 63)] : index
          %tk_expert2_0 = index.add %tk_lane, %tk_sixty_four : index
          %tk_expert2 = index.assume %tk_expert2_0 [range(%tk_expert2_0, 64, 95)] : index
          %tk_expert3_0 = index.add %tk_lane, %tk_ninety_six : index
          %tk_expert3 = index.assume %tk_expert3_0 [range(%tk_expert3_0, 96, 127)] : index
          %tk_expert4_0 = index.add %tk_lane, %tk_one_twenty_eight : index
          %tk_expert4 = index.assume %tk_expert4_0 [range(%tk_expert4_0, 128, 159)] : index
          %tk_expert5_0 = index.add %tk_lane, %tk_one_sixty : index
          %tk_expert5 = index.assume %tk_expert5_0 [range(%tk_expert5_0, 160, 191)] : index
          %tk_expert6_0 = index.add %tk_lane, %tk_one_ninety_two : index
          %tk_expert6 = index.assume %tk_expert6_0 [range(%tk_expert6_0, 192, 223)] : index
          %tk_expert7_0 = index.add %tk_lane, %tk_two_twenty_four : index
          %tk_expert7 = index.assume %tk_expert7_0 [range(%tk_expert7_0, 224, 255)] : index

          %tk_expert0_i32 = index.cast %tk_expert0 : index to i32
          %tk_expert1_i32 = index.cast %tk_expert1 : index to i32
          %tk_expert2_i32 = index.cast %tk_expert2 : index to i32
          %tk_expert3_i32 = index.cast %tk_expert3 : index to i32
          %tk_expert4_i32 = index.cast %tk_expert4 : index to i32
          %tk_expert5_i32 = index.cast %tk_expert5 : index to i32
          %tk_expert6_i32 = index.cast %tk_expert6 : index to i32
          %tk_expert7_i32 = index.cast %tk_expert7 : index to i32
          %tk_expert_ids = vector.from_elements %tk_expert0_i32, %tk_expert1_i32, %tk_expert2_i32, %tk_expert3_i32, %tk_expert4_i32, %tk_expert5_i32, %tk_expert6_i32, %tk_expert7_i32 : vector<8xi32>

