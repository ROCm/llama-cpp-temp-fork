    %contribution = func.call @qwen3_moe_q4k_tensor_plane_block_lane(%input_size, %output_size, %output_row, %tail_block, %block_lane, %weight, %q8_input, %q8_row_byte_base) : (index, index, index, index, index, buffer, buffer, offset) -> (f32)
    scf.yield %contribution : f32
  } else {
    scf.yield %zero : f32
  }
  %sum = scalar.addf<reassoc|nnan|ninf|nsz> %paired_sum, %tail : f32
  func.return %sum : f32
}

// Decode-only contraction over the compact tensor-plane symmetric-I4/K64
// layout. Eight wave32 subgroups own eight output rows and keep both operands
// packed through gfx11's native signed-I4 dot product.
func.def inline @qwen3_moe_symi4_tensor_plane_block_lane(%input_size0: index, %output_size0: index, %output_row0: index, %q4_block0: index, %block_lane0: index, %weight: buffer, %qact: buffer, %qact_scales: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %zero_i32 = scalar.constant 0 : i32
  %zero_i32x4 = vector.constant 0 : vector<4xi32>
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %output_row = index.assume %output_row0 [range(%output_row0, 0, 262143)] : index
  %block_count = index.div %input_size, %c256 : index
  %q4_block, %bounded_block_count = index.assume %q4_block0, %block_count [lt(%q4_block0, %block_count)] : index, index
  %block_lane = index.assume %block_lane0 [range(%block_lane0, 0, 7)] : index

  %payload_row_bytes = index.mul %bounded_block_count, %c128 : index
  %payload_tensor_bytes = index.mul %output_size, %payload_row_bytes : index
  %payload_row_add = index.mul %output_row, %payload_row_bytes : index
  %payload_block_add = index.mul %q4_block, %c128 : index
  %payload_lane_add = index.mul %block_lane, %c16 : index
  %payload_byte_index0 = index.add %payload_row_add, %payload_block_add : index
  %payload_byte_index = index.add %payload_byte_index0, %payload_lane_add : index
  %payload_byte_base = index.cast %payload_byte_index : index to offset
  %weight_view = buffer.view %weight[%payload_byte_base] : buffer -> view<4xi32>
  %weight_i4 = vector.load %weight_view[%c0] : view<4xi32> -> vector<4xi32>

  %header_row_group = index.div %output_row, %c8 : index
  %header_row_lane = index.rem %output_row, %c8 : index
  %header_group_bytes = index.mul %bounded_block_count, %c64 : index
  %header_group_add = index.mul %header_row_group, %header_group_bytes : index
  %header_block_add = index.mul %q4_block, %c64 : index
  %header_lane_add = index.mul %header_row_lane, %c8 : index
  %header_byte_index0 = index.add %payload_tensor_bytes, %header_group_add : index
  %header_byte_index1 = index.add %header_byte_index0, %header_block_add : index
  %header_byte_index = index.add %header_byte_index1, %header_lane_add : index
  %header_byte_base = index.cast %header_byte_index : index to offset
  %weight_scale_view = buffer.view %weight[%header_byte_base] : buffer -> view<4xf16>
  %scale_index = index.div %block_lane, %c2 : index
  %weight_scale_f16 = view.load %weight_scale_view[%scale_index] : view<4xf16> -> f16
  %weight_scale = scalar.extf %weight_scale_f16 : f16 to f32

  %qact_group_base = index.mul %q4_block, %c8 : index
  %qact_group0 = index.add %qact_group_base, %block_lane : index
  %scale_count = index.div %input_size, %c32 : index
  %qact_group, %bounded_scale_count = index.assume %qact_group0, %scale_count [lt(%qact_group0, %scale_count)] : index, index
  %qact_byte_index = index.mul %qact_group, %c16 : index
  %qact_byte_base = index.cast %qact_byte_index : index to offset
  %qact_view = buffer.view %qact[%qact_byte_base] : buffer -> view<4xi32>
  %activation_i4 = vector.load %qact_view[%c0] : view<4xi32> -> vector<4xi32>
  %qact_scale_view = buffer.view %qact_scales[%base] : buffer -> view<[%bounded_scale_count]xf32>
  %activation_scale = view.load %qact_scale_view[%qact_group] : view<[%bounded_scale_count]xf32> -> f32

  %partial = vector.dot8i4<s4s4> %weight_i4, %activation_i4, %zero_i32x4 : vector<4xi32>
  %dot_i32 = vector.reduce<addi> %partial, %zero_i32 : vector<4xi32>, i32
  %dot_f32 = scalar.sitofp %dot_i32 : i32 to f32
  %scale = scalar.mulf %weight_scale, %activation_scale : f32
  %result = scalar.mulf %dot_f32, %scale : f32
  func.return %result : f32
}

kernel.def target(@qwen3_moe_dense_gfx11_wave32) @qwen3_moe_dense_linear_q4k_symi4_i4_tensor_plane() {
