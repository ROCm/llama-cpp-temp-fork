} launch(%token_count: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = config.get @qwen3_moe.workload.token_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %token0 = kernel.workgroup.id<y> : index
  %c0 = index.constant 0 : index
  %tensor_plane_layout = scalar.constant false : i1
  %valid_token = index.cmp ult, %token0, %bounded_token_count : index
  %safe_token = scf.select %valid_token, %token0, %c0 : index
  func.apply<qwen3_moe.dense.q4k_q8_1_x4.body>(%tensor_plane_layout, %valid_token, %bounded_token_count, %safe_token, %q8_input, %weight, %output) : (i1, i1, index, index, buffer, buffer, buffer)
  kernel.return
}

// Decode-only tensor-plane specialization. The archive linker erases the raw
