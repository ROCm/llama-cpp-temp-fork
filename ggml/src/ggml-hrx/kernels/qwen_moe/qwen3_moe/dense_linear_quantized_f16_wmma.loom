  %src0_f16 = buffer.view %src0_na[%base] : buffer -> view<536870912xf16>
  %aq_flat = buffer.view %aq_na[%base] : buffer -> view<1073741824xi8>
  %as_flat = buffer.view %as_na[%qact_scale_base] : buffer -> view<33554432xf32>
  // dst is [rows, cols] with rows contiguous, and C is [cols, rows].
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<[%cols_b]x[%rows_b]xf32>

  // LDS: padded activations 5120 B, padded weights 5120 B, then
  // the two scale planes.
  %lds_bytes = index.constant 11264 : offset
  %scratch = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %lhs_layout = encoding.layout.strided [80, 1] : encoding<layout>
  %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %al_view = buffer.view %scratch[%base] : buffer -> view<64x64xi8, %lhs_layout>
  %al_flat = buffer.view %scratch[%base] : buffer -> view<5120xi8>
  %w_off = index.constant 5120 : offset
  %rhs_layout = encoding.layout.strided [1, 80] : encoding<layout>
  %wl_view = buffer.view %scratch[%w_off] : buffer -> view<64x64xi8, %rhs_layout>
  %wl_flat = buffer.view %scratch[%w_off] : buffer -> view<5120xi8>
  %as_off = index.constant 10240 : offset
  %asl_view = buffer.view %scratch[%as_off] : buffer -> view<128xf32>
  %ws_off = index.constant 10752 : offset
  %wsl_view = buffer.view %scratch[%ws_off] : buffer -> view<128xf32>

  %col_base = index.mul %col_tile, %k_m : index
  %row_base = index.mul %row_tile, %k_n : index

  // Staging shares.
  %k_aper = index.constant 64 : index
  %k_wper = index.constant 64 : index
  %ashare = index.mul %tid, %k_aper : index
  %ascol = index.div %ashare, %k_kc : index
  %asoff = index.rem %ashare, %k_kc : index
  %adbase0 = index.mul %ascol, %k_astride : index
  %adbase = index.add %adbase0, %asoff : index
  %ascol_g = index.add %col_base, %ascol : index
  %asbase = index.mul %ascol_g, %k_b : index
  // WG64 ILP8 staging maps the complete native-Q8 tile in explicit passes.
  // Two scale passes cover 128 K32 blocks; four payload passes cover 256 halves.
  // Scale staging: scalar legacy order or eight-scale WMMA-native vectors.
  %k_asn = index.constant 128 : index
  %k_aspan = index.constant 32 : index
  %k_wsn = index.constant 128 : index
  %k_lanes0 = index.constant 0 : index
  %k_lanes1 = index.constant 64 : index

  // Wave w owns column-tile block w % 2 and row-tile block w / 2.
  %wcol = index.rem %wave, %k_wm : index
  %wrow = index.div %wave, %k_wm : index
  %k_mspan = index.constant 32 : index
  %k_nspan = index.constant 64 : index
  %wm_off = index.mul %wcol, %k_mspan : index
  %wn_off = index.mul %wrow, %k_nspan : index
  %m_out = index.add %col_base, %wm_off : index
  %n_out = index.add %row_base, %wn_off : index
  %lm0 = index.add %wm_off, %zero : index
  %gm0 = index.add %m_out, %zero : index
  %k_ma1 = index.constant 16 : index
  %lm1 = index.add %wm_off, %k_ma1 : index
  %gm1 = index.add %m_out, %k_ma1 : index
  %ln0 = index.add %wn_off, %zero : index
  %gn0 = index.add %n_out, %zero : index
  %k_nb1 = index.constant 16 : index
  %ln1 = index.add %wn_off, %k_nb1 : index
  %gn1 = index.add %n_out, %k_nb1 : index
  %k_nb2 = index.constant 32 : index
  %ln2 = index.add %wn_off, %k_nb2 : index
  %gn2 = index.add %n_out, %k_nb2 : index
  %k_nb3 = index.constant 48 : index
  %ln3 = index.add %wn_off, %k_nb3 : index
  %gn3 = index.add %n_out, %k_nb3 : index
  %lane = index.rem %tid, %k_wave : index
  %lane_lo = index.rem %lane, %sixteen : index
  %lane_hi = index.div %lane, %sixteen : index
  %wsb0_0 = index.add %ln0, %lane_lo : index
  %wsb0 = index.mul %wsb0_0, %k_blocks : index
  %wsb1_0 = index.add %ln1, %lane_lo : index
  %wsb1 = index.mul %wsb1_0, %k_blocks : index
  %wsb2_0 = index.add %ln2, %lane_lo : index
  %wsb2 = index.mul %wsb2_0, %k_blocks : index
  %wsb3_0 = index.add %ln3, %lane_lo : index
  %wsb3 = index.mul %wsb3_0, %k_blocks : index
  // Activation scale metadata is [tile][block][lane-half][register].
  %as_tile0 = index.div %lm0, %sixteen : index
  %asb0 = index.mul %as_tile0, %k_blocks : index
  // Activation scale metadata is [tile][block][lane-half][register].
  %as_tile1 = index.div %lm1, %sixteen : index
  %asb1 = index.mul %as_tile1, %k_blocks : index

  %f0_0, %f0_1, %f0_2, %f0_3, %f1_0, %f1_1, %f1_2, %f1_3 = scf.for %chunk = [%zero to %nchunks step %one](%fc0_0 = %fzero : vector<8xf32>, %fc0_1 = %fzero : vector<8xf32>, %fc0_2 = %fzero : vector<8xf32>, %fc0_3 = %fzero : vector<8xf32>, %fc1_0 = %fzero : vector<8xf32>, %fc1_1 = %fzero : vector<8xf32>, %fc1_2 = %fzero : vector<8xf32>, %fc1_3 = %fzero : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %chunk_k = index.mul %chunk, %k_kc : index
    %chunk_blk = index.mul %chunk, %k_blocks : index

    // ---- stage activations, weights and both scale planes ----
    %sa0_0 = index.add %asbase, %chunk_k : index
    %sa0_1 = index.add %sa0_0, %asoff : index
    %sa0_2 = index.add %sa0_1, %zero : index
    %sa0 = index.assume %sa0_2 [range(%sa0_2, 0, 1073741808)] : index
    %av0 = vector.load %aq_flat[%sa0] : view<1073741824xi8> -> vector<16xi8>
    %ad0_0 = index.add %adbase, %zero : index
    %ad0 = index.assume %ad0_0 [range(%ad0_0, 0, 5104)] : index
    vector.store %av0, %al_flat[%ad0] : vector<16xi8>, view<5120xi8>
    %k_sa1 = index.constant 16 : index
    %sa1_0 = index.add %asbase, %chunk_k : index
    %sa1_1 = index.add %sa1_0, %asoff : index
    %sa1_2 = index.add %sa1_1, %k_sa1 : index
    %sa1 = index.assume %sa1_2 [range(%sa1_2, 0, 1073741808)] : index
    %av1 = vector.load %aq_flat[%sa1] : view<1073741824xi8> -> vector<16xi8>
    %ad1_0 = index.add %adbase, %k_sa1 : index
    %ad1 = index.assume %ad1_0 [range(%ad1_0, 0, 5104)] : index
    vector.store %av1, %al_flat[%ad1] : vector<16xi8>, view<5120xi8>
    %k_sa2 = index.constant 32 : index
    %sa2_0 = index.add %asbase, %chunk_k : index
    %sa2_1 = index.add %sa2_0, %asoff : index
    %sa2_2 = index.add %sa2_1, %k_sa2 : index
    %sa2 = index.assume %sa2_2 [range(%sa2_2, 0, 1073741808)] : index
    %av2 = vector.load %aq_flat[%sa2] : view<1073741824xi8> -> vector<16xi8>
    %ad2_0 = index.add %adbase, %k_sa2 : index
    %ad2 = index.assume %ad2_0 [range(%ad2_0, 0, 5104)] : index
    vector.store %av2, %al_flat[%ad2] : vector<16xi8>, view<5120xi8>
    %k_sa3 = index.constant 48 : index
    %sa3_0 = index.add %asbase, %chunk_k : index
    %sa3_1 = index.add %sa3_0, %asoff : index
    %sa3_2 = index.add %sa3_1, %k_sa3 : index
    %sa3 = index.assume %sa3_2 [range(%sa3_2, 0, 1073741808)] : index
    %av3 = vector.load %aq_flat[%sa3] : view<1073741824xi8> -> vector<16xi8>
    %ad3_0 = index.add %adbase, %k_sa3 : index
    %ad3 = index.assume %ad3_0 [range(%ad3_0, 0, 5104)] : index
    vector.store %av3, %al_flat[%ad3] : vector<16xi8>, view<5120xi8>
    // Tile-native persistent layout: one capacity-identical 4352-byte
    // record per [64 rows, K64]. The first 256 bytes hold 128 f16 scales;
    // four 1024-byte planes then hold the exact four 16-byte payload passes.
    %wt_tile_row = index.mul %row_tile, %nchunks : index
    %wt_tile0 = index.add %wt_tile_row, %chunk : index
    %wt_tile = index.assume %wt_tile0 [range(%wt_tile0, 0, 262143)] : index
    %wt_f16_base = index.mul %wt_tile, %c2176 : index
    %wt_byte_base = index.mul %wt_tile, %c4352 : index

    // Both scale passes are contiguous across the 64 lanes.
    %wsp0_scale_i0 = index.add %wt_f16_base, %tid : index
    %wsp0_scale_i = index.assume %wsp0_scale_i0 [range(%wsp0_scale_i0, 0, 536870911)] : index
    %wsp0_scale_h = view.load %src0_f16[%wsp0_scale_i] : view<536870912xf16> -> f16
    %wsp0_scale = scalar.extf %wsp0_scale_h : f16 to f32
    view.store %wsp0_scale, %wsl_view[%tid] : f32, view<128xf32>
    %wsp1_slot0 = index.add %tid, %k_lanes1 : index
    %wsp1_slot = index.assume %wsp1_slot0 [range(%wsp1_slot0, 0, 127)] : index
    %wsp1_scale_i0 = index.add %wt_f16_base, %wsp1_slot : index
    %wsp1_scale_i = index.assume %wsp1_scale_i0 [range(%wsp1_scale_i0, 0, 536870911)] : index
    %wsp1_scale_h = view.load %src0_f16[%wsp1_scale_i] : view<536870912xf16> -> f16
    %wsp1_scale = scalar.extf %wsp1_scale_h : f16 to f32
    view.store %wsp1_scale, %wsl_view[%wsp1_slot] : f32, view<128xf32>

    // Payload pass p is one contiguous 1024-byte plane. Lane-local LDS
    // destinations are the same as the accepted kernel.
    %wpp_lane_row = index.div %tid, %four : index
    %wpp_lane_half = index.rem %tid, %four : index
    %wpp_dst_row = index.mul %wpp_lane_row, %k_wstride : index
    %wpp_dst_half = index.mul %wpp_lane_half, %sixteen : index
    %wpp_dst0_raw = index.add %wpp_dst_row, %wpp_dst_half : index
    %wpp_dst0 = index.assume %wpp_dst0_raw [range(%wpp_dst0_raw, 0, 1264)] : index
    %wpp_lane_byte = index.mul %tid, %sixteen : index

    %wpp0_src0 = index.add %wt_byte_base, %c256 : index
    %wpp0_src1 = index.add %wpp0_src0, %wpp_lane_byte : index
    %wpp0_src = index.assume %wpp0_src1 [range(%wpp0_src1, 0, 1073741808)] : index
    %wpp0_payload = vector.load %src0_i8[%wpp0_src] : view<1073741824xi8> -> vector<16xi8>
    vector.store %wpp0_payload, %wl_flat[%wpp_dst0] : vector<16xi8>, view<5120xi8>

    %wpp1_src0 = index.add %wt_byte_base, %c1280 : index
    %wpp1_src1 = index.add %wpp1_src0, %wpp_lane_byte : index
    %wpp1_src = index.assume %wpp1_src1 [range(%wpp1_src1, 0, 1073741808)] : index
    %wpp1_payload = vector.load %src0_i8[%wpp1_src] : view<1073741824xi8> -> vector<16xi8>
    %wpp_dst1_raw = index.add %wpp_dst0, %c1280 : index
    %wpp_dst1 = index.assume %wpp_dst1_raw [range(%wpp_dst1_raw, 1280, 2544)] : index
    vector.store %wpp1_payload, %wl_flat[%wpp_dst1] : vector<16xi8>, view<5120xi8>

    %wpp2_src0 = index.add %wt_byte_base, %c2304 : index
    %wpp2_src1 = index.add %wpp2_src0, %wpp_lane_byte : index
    %wpp2_src = index.assume %wpp2_src1 [range(%wpp2_src1, 0, 1073741808)] : index
    %wpp2_payload = vector.load %src0_i8[%wpp2_src] : view<1073741824xi8> -> vector<16xi8>
    %wpp_dst2_raw = index.add %wpp_dst0, %c2560 : index
    %wpp_dst2 = index.assume %wpp_dst2_raw [range(%wpp_dst2_raw, 2560, 3824)] : index
    vector.store %wpp2_payload, %wl_flat[%wpp_dst2] : vector<16xi8>, view<5120xi8>

    %wpp3_src0 = index.add %wt_byte_base, %c3328 : index
    %wpp3_src1 = index.add %wpp3_src0, %wpp_lane_byte : index
    %wpp3_src = index.assume %wpp3_src1 [range(%wpp3_src1, 0, 1073741808)] : index
    %wpp3_payload = vector.load %src0_i8[%wpp3_src] : view<1073741824xi8> -> vector<16xi8>
    %wpp_dst3_raw = index.add %wpp_dst0, %c3840 : index
    %wpp_dst3 = index.assume %wpp_dst3_raw [range(%wpp_dst3_raw, 3840, 5104)] : index
    vector.store %wpp3_payload, %wl_flat[%wpp_dst3] : vector<16xi8>, view<5120xi8>
    // Scale planes: 128 activation and 128 weight entries.
    %sca0_slot0 = index.add %tid, %k_lanes0 : index
    %sca0_slot = index.assume %sca0_slot0 [range(%sca0_slot0, 0, 127)] : index
    %scin_a0 = index.cmp ult, %sca0_slot, %k_asn : index
    scf.if %scin_a0 {
      %sc0_col = index.div %sca0_slot, %k_blocks : index
      %sc0_blk = index.rem %sca0_slot, %k_blocks : index
      %sca0_c = index.add %col_base, %sc0_col : index
      %sca0_0 = index.mul %sca0_c, %kblocks : index
      %sca0_1 = index.add %sca0_0, %chunk_blk : index
      %sca0_2 = index.add %sca0_1, %sc0_blk : index
      %sca0 = index.assume %sca0_2 [range(%sca0_2, 0, 33554431)] : index
      %scav0 = view.load %as_flat[%sca0] : view<33554432xf32> -> f32
      %sca0_tile = index.div %sc0_col, %sixteen : index
      %sca0_inner = index.rem %sc0_col, %sixteen : index
      %sca0_par = index.rem %sca0_inner, %two : index
      %sca0_v = index.div %sca0_inner, %two : index
      %sca0_dst0 = index.mul %sca0_tile, %k_blocks : index
      %sca0_dst1 = index.add %sca0_dst0, %sc0_blk : index
      %sca0_dst2 = index.mul %sca0_dst1, %two : index
      %sca0_dst3 = index.add %sca0_dst2, %sca0_par : index
      %sca0_dst4 = index.mul %sca0_dst3, %eight : index
      %sca0_dst5 = index.add %sca0_dst4, %sca0_v : index
      %sca0_dst = index.assume %sca0_dst5 [range(%sca0_dst5, 0, 127)] : index
      view.store %scav0, %asl_view[%sca0_dst] : f32, view<128xf32>
    }
    %sca1_slot0 = index.add %tid, %k_lanes1 : index
    %sca1_slot = index.assume %sca1_slot0 [range(%sca1_slot0, 0, 127)] : index
    %scin_a1 = index.cmp ult, %sca1_slot, %k_asn : index
    scf.if %scin_a1 {
      %sc1_col = index.div %sca1_slot, %k_blocks : index
      %sc1_blk = index.rem %sca1_slot, %k_blocks : index
      %sca1_c = index.add %col_base, %sc1_col : index
      %sca1_0 = index.mul %sca1_c, %kblocks : index
      %sca1_1 = index.add %sca1_0, %chunk_blk : index
      %sca1_2 = index.add %sca1_1, %sc1_blk : index
      %sca1 = index.assume %sca1_2 [range(%sca1_2, 0, 33554431)] : index
      %scav1 = view.load %as_flat[%sca1] : view<33554432xf32> -> f32
      %sca1_tile = index.div %sc1_col, %sixteen : index
      %sca1_inner = index.rem %sc1_col, %sixteen : index
      %sca1_par = index.rem %sca1_inner, %two : index
      %sca1_v = index.div %sca1_inner, %two : index
      %sca1_dst0 = index.mul %sca1_tile, %k_blocks : index
      %sca1_dst1 = index.add %sca1_dst0, %sc1_blk : index
      %sca1_dst2 = index.mul %sca1_dst1, %two : index
      %sca1_dst3 = index.add %sca1_dst2, %sca1_par : index
      %sca1_dst4 = index.mul %sca1_dst3, %eight : index
      %sca1_dst5 = index.add %sca1_dst4, %sca1_v : index
      %sca1_dst = index.assume %sca1_dst5 [range(%sca1_dst5, 0, 127)] : index
      view.store %scav1, %asl_view[%sca1_dst] : f32, view<128xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    // Two K32 blocks explicitly unrolled. Arithmetic order and the
    // enclosing K64 staging/barrier cadence are unchanged.
    %blk_k_u0 = index.mul %zero, %c32 : index
    %blk_k16_u0 = index.add %blk_k_u0, %sixteen : index
    %iz_u0 = vector.fragment<init> %izero shape [%sixteen, %sixteen] : vector<8xi32>
    %wsi0_2_u0 = index.add %wsb0, %zero : index
    %wsi0_u0 = index.assume %wsi0_2_u0 [range(%wsi0_2_u0, 0, 127)] : index
    %wsc0_u0 = view.load %wsl_view[%wsi0_u0] : view<128xf32> -> f32
    %wsv0_u0 = vector.splat %wsc0_u0 : vector<8xf32>
    %wsi1_2_u0 = index.add %wsb1, %zero : index
    %wsi1_u0 = index.assume %wsi1_2_u0 [range(%wsi1_2_u0, 0, 127)] : index
    %wsc1_u0 = view.load %wsl_view[%wsi1_u0] : view<128xf32> -> f32
    %wsv1_u0 = vector.splat %wsc1_u0 : vector<8xf32>
    %wsi2_2_u0 = index.add %wsb2, %zero : index
    %wsi2_u0 = index.assume %wsi2_2_u0 [range(%wsi2_2_u0, 0, 127)] : index
    %wsc2_u0 = view.load %wsl_view[%wsi2_u0] : view<128xf32> -> f32
    %wsv2_u0 = vector.splat %wsc2_u0 : vector<8xf32>
    %wsi3_2_u0 = index.add %wsb3, %zero : index
    %wsi3_u0 = index.assume %wsi3_2_u0 [range(%wsi3_2_u0, 0, 127)] : index
    %wsc3_u0 = view.load %wsl_view[%wsi3_u0] : view<128xf32> -> f32
    %wsv3_u0 = vector.splat %wsc3_u0 : vector<8xf32>
    %lf0_0_raw_u0 = vector.fragment.load<lhs> %al_view[%lm0, %blk_k_u0] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
    %lf0_0_words_u0 = vector.bitcast %lf0_0_raw_u0 : vector<16xi8> to vector<4xi32>
    %lf0_0_u0 = vector.fragment<lhs> %lf0_0_words_u0 shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %lf0_1_raw_u0 = vector.fragment.load<lhs> %al_view[%lm0, %blk_k16_u0] shape [%sixteen, %sixteen] : view<64x64xi8, %lhs_layout> -> vector<16xi8>
    %lf0_1_words_u0 = vector.bitcast %lf0_1_raw_u0 : vector<16xi8> to vector<4xi32>
    %lf0_1_u0 = vector.fragment<lhs> %lf0_1_words_u0 shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %asi0_0_u0 = index.add %asb0, %zero : index
    %asi0_1_u0 = index.mul %asi0_0_u0, %two : index
    %asi0_2_u0 = index.add %asi0_1_u0, %lane_hi : index
    %asi0_3_u0 = index.mul %asi0_2_u0, %eight : index
    %asi0_u0 = index.assume %asi0_3_u0 [range(%asi0_3_u0, 0, 120)] : index
    %asv0_u0 = vector.load %asl_view[%asi0_u0] : view<128xf32> -> vector<8xf32>
    %rfs0_0_0_raw_u0 = vector.fragment.load<rhs> %wl_view[%blk_k_u0, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
    %rfs0_0_0_words_u0 = vector.bitcast %rfs0_0_0_raw_u0 : vector<16xi8> to vector<4xi32>
    %rfs0_0_0_u0 = vector.fragment<rhs> %rfs0_0_0_words_u0 shape [%sixteen, %sixteen] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %rfs0_0_1_raw_u0 = vector.fragment.load<rhs> %wl_view[%blk_k16_u0, %ln0] shape [%sixteen, %sixteen] : view<64x64xi8, %rhs_layout> -> vector<16xi8>
