  %rr2_0 = index.add %rb2, %k_sl0 : index
  %rv2_0 = view.load %red_view[%rr2_0] : view<4096xf32> -> f32
  %rr2_1 = index.add %rb2, %k_sl1 : index
  %rv2_1 = view.load %red_view[%rr2_1] : view<4096xf32> -> f32
  %rr2_2 = index.add %rb2, %k_sl2 : index
  %rv2_2 = view.load %red_view[%rr2_2] : view<4096xf32> -> f32
  %rr2_3 = index.add %rb2, %k_sl3 : index
