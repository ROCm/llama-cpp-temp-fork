      // Register-direct Q5_K payload: each wave owns the accepted
      // 16 rows; m_par lanes split the two canonical 16-byte halves.
      %rd_p1_row0 = index.add %row_base, %n_scale0 : index
      %rd_p1_row_in = index.cmp ult, %rd_p1_row0, %rows_bounded : index
      %rd_p1_row = scf.select %rd_p1_row_in, %rd_p1_row0, %rows_last : index
      %rd_p1_group = index.div %rd_p1_row, %pk_group_rows : index
      %rd_p1_row4 = index.rem %rd_p1_row, %pk_group_rows : index
      %rd_p1_group_off = index.mul %rd_p1_group, %pk_group_record_bytes : index
      %rd_p1_block_off = index.mul %blk, %pk_block_record_bytes : index
