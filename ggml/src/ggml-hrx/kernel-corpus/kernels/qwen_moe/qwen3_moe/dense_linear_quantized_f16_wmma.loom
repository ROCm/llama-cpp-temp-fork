    %al_flat = buffer.view %scratch[%base] : buffer -> view<10240xi8>
    %ad0_bounded = index.assume %adbase [range(%adbase, 0, 10160)] : index
    %ad1_bounded = index.assume %ad1 [range(%ad1, 32, 10192)] : index
    vector.store %values0, %al_flat[%ad0_bounded] : vector<32xi8>, view<10240xi8>
    vector.store %values1, %al_flat[%ad1_bounded] : vector<32xi8>, view<10240xi8>
  }
  func.return
}

func.def inline @qwen3_moe_dense_q8_wmmai8_stage_metadata(%token256: i1, %scratch: buffer, %as_off: offset, %asum_off: offset, %dst0: index, %dst1: index, %d0: f32, %d1: f32, %sum0: f32, %sum1: f32) {
