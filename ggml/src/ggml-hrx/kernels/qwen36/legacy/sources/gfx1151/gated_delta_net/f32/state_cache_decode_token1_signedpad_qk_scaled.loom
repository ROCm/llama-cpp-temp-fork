    %sqi1_r = index.div %sgi1_a, %k128 : index
    %sqi1_q0 = index.mul %sqi1_r, %k2 : index
    %sqi1_q = index.assume %sqi1_q0 [range(%sqi1_q0, 0, 1073741822)] : index
