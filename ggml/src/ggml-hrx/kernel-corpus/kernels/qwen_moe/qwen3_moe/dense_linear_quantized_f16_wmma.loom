// Register-resident top-64 selection for draft-vocabulary refinement.
// Stage one selects four winners from each of 128 partitions; stage two selects and publishes the final 64.
kernel.def target(@qwen3_moe_dense_gfx11_wave32) export("ggml_top_k64_f32_partitions_register") @ggml_top_k64_f32_partitions_register(%element_count: index) {
  %c1 = index.constant 1 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%c128, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%element_count: index, %logits: buffer, %partial_values: buffer, %partial_ids: buffer) {
  %count = index.assume %element_count [range(%element_count, 64, 262144)] : index
  %partition = kernel.workgroup.id<x> : index
  %tid = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %candidate_count = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %negative_large = scalar.constant -3.4028234663852886e+38 : f32
  %largest_i32 = scalar.constant 2147483647 : i32
  %negative_values = vector.splat %negative_large : vector<8xf32>
  %invalid_ids = vector.splat %largest_i32 : vector<8xi32>
  %logits_noalias, %partial_values_noalias, %partial_ids_noalias = buffer.assume.noalias %logits, %partial_values, %partial_ids : buffer, buffer, buffer
  %logits_view = buffer.view %logits_noalias[%c0_offset] : buffer -> view<[%count]xf32>
  %partial_values_view = buffer.view %partial_values_noalias[%c0_offset] : buffer -> view<512xf32>
  %partial_ids_view = buffer.view %partial_ids_noalias[%c0_offset] : buffer -> view<512xi32>

  %rounded_count = index.add %count, %c127 : index
  %partition_span = index.div %rounded_count, %c128 : index
  %partition_begin = index.mul %partition, %partition_span : index
  %partition_end_unbounded = index.add %partition_begin, %partition_span : index
  %end_exceeds_count = index.cmp ugt, %partition_end_unbounded, %count : index
  %partition_end = scf.select %end_exceeds_count, %count, %partition_end_unbounded : index
  %thread_begin = index.add %partition_begin, %tid : index
  %partial_base = index.mul %partition, %candidate_count : index

  %loaded_values, %loaded_ids = scf.for %slot = [%c0 to %c8 step %c1](%values = %negative_values : vector<8xf32>, %ids = %invalid_ids : vector<8xi32>) -> (vector<8xf32>, vector<8xi32>) unroll {
    %slot_stride = index.mul %slot, %c256 : index
    %candidate_index = index.add %thread_begin, %slot_stride : index
    %valid = index.cmp ult, %candidate_index, %partition_end : index
    %candidate_value, %candidate_id = scf.if %valid -> (f32, i32) {
      %bounded_index = index.assume %candidate_index [lt(%candidate_index, %count)] : index
      %value = view.load %logits_view[%bounded_index] : view<[%count]xf32> -> f32
      %id = index.cast %bounded_index : index to i32
      scf.yield %value, %id : f32, i32
    } else {
      scf.yield %negative_large, %largest_i32 : f32, i32
    }
    %next_values = vector.insert %candidate_value into %values[%slot] : f32, vector<8xf32>
    %next_ids = vector.insert %candidate_id into %ids[%slot] : i32, vector<8xi32>
    scf.yield %next_values, %next_ids : vector<8xf32>, vector<8xi32>
  }

  %remaining_final = scf.for %rank = [%c0 to %candidate_count step %c1](%remaining = %loaded_values : vector<8xf32>) -> (vector<8xf32>) unroll {
    %local_value, %local_id = scf.for %slot = [%c0 to %c8 step %c1](%best_value = %negative_large : f32, %best_id = %largest_i32 : i32) -> (f32, i32) unroll {
      %candidate_value = vector.extract %remaining[%slot] : vector<8xf32> -> f32
      %candidate_id = vector.extract %loaded_ids[%slot] : vector<8xi32> -> i32
      %is_greater = scalar.cmpf ogt, %candidate_value, %best_value : f32
      %is_equal = scalar.cmpf oeq, %candidate_value, %best_value : f32
      %is_lower_id = scalar.cmpi ult, %candidate_id, %best_id : i32
      %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
      %is_better = scalar.ori %is_greater, %is_lower_tie : i1
      %next_value = scf.select %is_better, %candidate_value, %best_value : f32
      %next_id = scf.select %is_better, %candidate_id, %best_id : i32
      scf.yield %next_value, %next_id : f32, i32
    }
    %winner_value = kernel.workgroup.reduce<maxnumf> %local_value : f32
    %matches_winner = scalar.cmpf oeq, %local_value, %winner_value : f32
    %winner_id_candidate = scf.select %matches_winner, %local_id, %largest_i32 : i32
    %winner_id = kernel.workgroup.reduce<minui> %winner_id_candidate : i32
    %is_tid_zero = index.cmp eq, %tid, %c0 : index
    scf.if %is_tid_zero {
      %partial_index = index.add %partial_base, %rank : index
      view.store %winner_value, %partial_values_view[%partial_index] : f32, view<512xf32>
      view.store %winner_id, %partial_ids_view[%partial_index] : i32, view<512xi32>
    }
    %next_remaining = scf.for %slot = [%c0 to %c8 step %c1](%values = %remaining : vector<8xf32>) -> (vector<8xf32>) unroll {
      %candidate_id = vector.extract %loaded_ids[%slot] : vector<8xi32> -> i32
      %is_winner = scalar.cmpi eq, %candidate_id, %winner_id : i32
      %old_value = vector.extract %values[%slot] : vector<8xf32> -> f32
      %next_value = scf.select %is_winner, %negative_large, %old_value : f32
      %updated = vector.insert %next_value into %values[%slot] : f32, vector<8xf32>
      scf.yield %updated : vector<8xf32>
    }
    scf.yield %next_remaining : vector<8xf32>
  }
  kernel.return
}

kernel.def target(@qwen3_moe_dense_gfx11_wave32) export("ggml_top_k64_f32_reduce_gather_register") @ggml_top_k64_f32_reduce_gather_register(%element_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%element_count: index, %partial_values: buffer, %partial_ids: buffer, %candidate_output: buffer, %logits_output: buffer) {
  %count = index.assume %element_count [range(%element_count, 64, 262144)] : index
  %tid = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %candidate_count = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c0_offset = index.constant 0 : offset
  %negative_large = scalar.constant -3.4028234663852886e+38 : f32
  %largest_i32 = scalar.constant 2147483647 : i32
  %negative_values = vector.splat %negative_large : vector<2xf32>
  %invalid_ids = vector.splat %largest_i32 : vector<2xi32>
  %partial_values_noalias, %partial_ids_noalias, %candidate_output_noalias, %logits_output_noalias = buffer.assume.noalias %partial_values, %partial_ids, %candidate_output, %logits_output : buffer, buffer, buffer, buffer
  %partial_values_view = buffer.view %partial_values_noalias[%c0_offset] : buffer -> view<512xf32>
  %partial_ids_view = buffer.view %partial_ids_noalias[%c0_offset] : buffer -> view<512xi32>
  %candidate_output_view = buffer.view %candidate_output_noalias[%c0_offset] : buffer -> view<64xi32>
  %logits_output_view = buffer.view %logits_output_noalias[%c0_offset] : buffer -> view<64xf32>

  %loaded_values, %loaded_ids = scf.for %slot = [%c0 to %c2 step %c1](%values = %negative_values : vector<2xf32>, %ids = %invalid_ids : vector<2xi32>) -> (vector<2xf32>, vector<2xi32>) unroll {
    %slot_stride = index.mul %slot, %c256 : index
    %partial_index = index.add %tid, %slot_stride : index
    %valid = index.cmp ult, %partial_index, %c512 : index
    %candidate_value, %candidate_id = scf.if %valid -> (f32, i32) {
      %value = view.load %partial_values_view[%partial_index] : view<512xf32> -> f32
      %id = view.load %partial_ids_view[%partial_index] : view<512xi32> -> i32
      scf.yield %value, %id : f32, i32
    } else {
      scf.yield %negative_large, %largest_i32 : f32, i32
    }
    %next_values = vector.insert %candidate_value into %values[%slot] : f32, vector<2xf32>
    %next_ids = vector.insert %candidate_id into %ids[%slot] : i32, vector<2xi32>
    scf.yield %next_values, %next_ids : vector<2xf32>, vector<2xi32>
  }

  %remaining_final = scf.for %rank = [%c0 to %candidate_count step %c1](%remaining = %loaded_values : vector<2xf32>) -> (vector<2xf32>) unroll {
    %local_value, %local_id = scf.for %slot = [%c0 to %c2 step %c1](%best_value = %negative_large : f32, %best_id = %largest_i32 : i32) -> (f32, i32) unroll {
      %candidate_value = vector.extract %remaining[%slot] : vector<2xf32> -> f32
      %candidate_id = vector.extract %loaded_ids[%slot] : vector<2xi32> -> i32
      %is_greater = scalar.cmpf ogt, %candidate_value, %best_value : f32
      %is_equal = scalar.cmpf oeq, %candidate_value, %best_value : f32
      %is_lower_id = scalar.cmpi ult, %candidate_id, %best_id : i32
      %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
      %is_better = scalar.ori %is_greater, %is_lower_tie : i1
      %next_value = scf.select %is_better, %candidate_value, %best_value : f32
      %next_id = scf.select %is_better, %candidate_id, %best_id : i32
      scf.yield %next_value, %next_id : f32, i32
    }
    %winner_value = kernel.workgroup.reduce<maxnumf> %local_value : f32
    %matches_winner = scalar.cmpf oeq, %local_value, %winner_value : f32
    %winner_id_candidate = scf.select %matches_winner, %local_id, %largest_i32 : i32
    %winner_id = kernel.workgroup.reduce<minui> %winner_id_candidate : i32
    %is_tid_zero = index.cmp eq, %tid, %c0 : index
    scf.if %is_tid_zero {
      view.store %winner_id, %candidate_output_view[%rank] : i32, view<64xi32>
      view.store %winner_value, %logits_output_view[%rank] : f32, view<64xf32>
    }
    %next_remaining = scf.for %slot = [%c0 to %c2 step %c1](%values = %remaining : vector<2xf32>) -> (vector<2xf32>) unroll {
      %candidate_id = vector.extract %loaded_ids[%slot] : vector<2xi32> -> i32
      %is_winner = scalar.cmpi eq, %candidate_id, %winner_id : i32
      %old_value = vector.extract %values[%slot] : vector<2xf32> -> f32
      %next_value = scf.select %is_winner, %negative_large, %old_value : f32
      %updated = vector.insert %next_value into %values[%slot] : f32, vector<2xf32>
      scf.yield %updated : vector<2xf32>
    }
    scf.yield %next_remaining : vector<2xf32>
  }
  kernel.return
}

// Exact M128xN64/WG128 Q4_K x affine-U4 WMMA path with in-place K32-half overlap.
config.decl @qwen3.dense_q4_u4asym.shape_k : %value: index where [range(%value, 32, 32768), mul(%value, 32)]

config.decl @qwen3.dense_q4_u4asym.shape_rows : %value: index where [range(%value, 1, 262144)]

config.decl @qwen3.dense_q4_u4asym.shape_cols : %value: index where [range(%value, 1, 32768)]

// Affine-U4 activation and exact Q4_K WMMA contraction schedule.
// QAct storage is normalized before this compile-time template is applied.
template.def<@qwen3.dense.q4.u4asym.wmmai4.body> device @qwen3_dense_q4_u4asym_wmmai4_body(%src0_na: buffer, %dst_na: buffer, %aq_na: buffer, %as_na: buffer, %asum_na: buffer, %base: offset, %qact_scale_base: offset, %zero: index, %one: index, %two: index, %four: index, %eight: index, %sixteen: index, %c32: index, %c17: index, %c34: index, %k_kc: index, %k_astride: index, %k_wstride: index, %k_m: index, %k_n: index, %k_blocks: index, %k_wave: index, %k_wm: index, %fzero: vector<8xf32>, %izero: vector<8xi32>, %k_b: index, %rows_b: index, %cols_b: index, %nchunks: index, %kblocks: index, %col_tile: index, %row_tile: index, %tid: index, %wave: index) {
  %aq_flat = buffer.view %aq_na[%base] : buffer -> view<1073741824xi8>
  %as_flat = buffer.view %as_na[%qact_scale_base] : buffer -> view<33554432xf32>
  %asum_flat = buffer.view %asum_na[%base] : buffer -> view<67108864xi32>
  %zero_i32 = scalar.constant 0 : i32
  %q4_k_block = index.constant 256 : index
  %q4_shift4v = vector.constant 4 : vector<4xi32>
  %q4_shift8v = vector.constant 8 : vector<4xi32>
  %q4_shift16v = vector.constant 16 : vector<4xi32>
  %q4_nibble_mask = vector.constant 252645135 : vector<4xi32>
  %q4_pair_mask = vector.constant 16711935 : vector<4xi32>
  %q4_half_mask = vector.constant 65535 : vector<4xi32>
  %q4_f32_32 = scalar.constant 32.0 : f32
  // dst is [rows, cols] with rows contiguous, and C is [cols, rows].
  %dst_view = buffer.view %dst_na[%base] : buffer -> view<[%cols_b]x[%rows_b]xf32>

  // Packed I4 operands use 32 payload bytes per logical K64 row.
  // A 40-byte LDS stride retains the conflict-avoiding padding of the IU8 body.
  %lds_bytes = index.constant 12288 : offset
  %scratch = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %u4a_schema = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
  %u4_schema = encoding.define #encoding.operand<element_format=u4, payload_elements=16, payload_registers=2> : encoding<schema>
  %al_flat = buffer.view %scratch[%base] : buffer -> view<5120xi8>
  %w_off = index.constant 5120 : offset
  %wl_flat = buffer.view %scratch[%w_off] : buffer -> view<2560xi8>
  %as_off = index.constant 7680 : offset
  %asl_view = buffer.view %scratch[%as_off] : buffer -> view<256xf32>
  %azp_off = index.constant 8704 : offset
  %azpl_view = buffer.view %scratch[%azp_off] : buffer -> view<256xf32>
  %asum_off = index.constant 9728 : offset
  %asuml_view = buffer.view %scratch[%asum_off] : buffer -> view<256xf32>
  %ws_off = index.constant 10752 : offset
  %wsl_view = buffer.view %scratch[%ws_off] : buffer -> view<128xf32>
  %wc_off = index.constant 11264 : offset
  %wcl_view = buffer.view %scratch[%wc_off] : buffer -> view<128xf32>
  %wbc_off = index.constant 11776 : offset
  %wbcl_view = buffer.view %scratch[%wbc_off] : buffer -> view<128xf32>

  %col_base = index.mul %col_tile, %k_m : index
  %row_base = index.mul %row_tile, %k_n : index

  %k_asn = index.constant 256 : index
  %k_lanes0 = index.constant 0 : index
  %k_lanes1 = index.constant 128 : index

  // Four waves own four 32-token blocks and share one 64-row weight tile.
  %wcol = index.rem %wave, %k_wm : index
  %wrow = index.div %wave, %k_wm : index
  %k_mspan = index.constant 32 : index
  %k_nspan = index.constant 64 : index
  %wm_off = index.mul %wcol, %k_mspan : index
  %wn_off = index.mul %wrow, %k_nspan : index
  %m_out = index.add %col_base, %wm_off : index
  %n_out = index.add %row_base, %wn_off : index
  // RDNA3 WMMA RHS lanes map to column lane % 16, so each lane starts at its output row.
  %lane = index.rem %tid, %k_wave : index
  %lane_lo = index.rem %lane, %sixteen : index
  %lane_hi = index.div %lane, %sixteen : index
  %wn_lane = index.add %wn_off, %lane_lo : index
  %lm0 = index.add %wm_off, %zero : index
  %gm0 = index.add %m_out, %zero : index
  %k_ma1 = index.constant 16 : index
  %lm1 = index.add %wm_off, %k_ma1 : index
  %gm1 = index.add %m_out, %k_ma1 : index
  %ln0 = index.add %wn_lane, %zero : index
  %gn0 = index.add %n_out, %zero : index
  %k_nb1 = index.constant 16 : index
  %ln1 = index.add %wn_lane, %k_nb1 : index
  %gn1 = index.add %n_out, %k_nb1 : index
  %k_nb2 = index.constant 32 : index
  %ln2 = index.add %wn_lane, %k_nb2 : index
  %gn2 = index.add %n_out, %k_nb2 : index
  %k_nb3 = index.constant 48 : index
  %ln3 = index.add %wn_lane, %k_nb3 : index
  %gn3 = index.add %n_out, %k_nb3 : index
  %wsb0_0 = index.add %ln0, %zero : index
  %wsb0 = index.mul %wsb0_0, %k_blocks : index
  %wsb1_0 = index.add %ln1, %zero : index
  %wsb1 = index.mul %wsb1_0, %k_blocks : index
  %wsb2_0 = index.add %ln2, %zero : index
  %wsb2 = index.mul %wsb2_0, %k_blocks : index
  %wsb3_0 = index.add %ln3, %zero : index
  %wsb3 = index.mul %wsb3_0, %k_blocks : index
  // Activation scale metadata is [tile][block][lane-half][register].
  %as_tile0 = index.div %lm0, %sixteen : index
  %asb0 = index.mul %as_tile0, %k_blocks : index
  %as_tile1 = index.div %lm1, %sixteen : index
  %asb1 = index.mul %as_tile1, %k_blocks : index

  // Seed K64 before the loop and overwrite each K32 half only after its current consumers finish.
  %q4a_row0 = index.add %col_base, %tid : index
  %q4a_row = index.assume %q4a_row0 [range(%q4a_row0, 0, 32767)] : index
  %q4a_row_bytes = index.div %k_b, %two : index
  %q4a_row_base = index.mul %q4a_row, %q4a_row_bytes : index
  %q4a_initial_src0 = index.assume %q4a_row_base [range(%q4a_row_base, 0, 536870896)] : index
  %q4a_initial_v0 = vector.load %aq_flat[%q4a_initial_src0] : view<1073741824xi8> -> vector<16xi8>
  %q4a_c16 = index.constant 16 : index
  %q4a_initial_src1_0 = index.add %q4a_initial_src0, %q4a_c16 : index
  %q4a_initial_src1 = index.assume %q4a_initial_src1_0 [range(%q4a_initial_src1_0, 16, 536870912)] : index
  %q4a_initial_v1 = vector.load %aq_flat[%q4a_initial_src1] : view<1073741824xi8> -> vector<16xi8>
  %q4a_zero = vector.constant 0 : vector<16xi8>
  %q4a_dst0_0 = index.mul %tid, %k_astride : index
  %q4a_dst0 = index.assume %q4a_dst0_0 [range(%q4a_dst0_0, 0, 5080)] : index
  vector.store %q4a_initial_v0, %al_flat[%q4a_dst0] : vector<16xi8>, view<5120xi8>
  %q4a_dst1_0 = index.add %q4a_dst0, %q4a_c16 : index
  %q4a_dst1 = index.assume %q4a_dst1_0 [range(%q4a_dst1_0, 16, 5096)] : index
  vector.store %q4a_initial_v1, %al_flat[%q4a_dst1] : vector<16xi8>, view<5120xi8>

  %f0_0, %f0_1, %f0_2, %f0_3, %f1_0, %f1_1, %f1_2, %f1_3 = scf.for %chunk = [%zero to %nchunks step %one](%fc0_0 = %fzero : vector<8xf32>, %fc0_1 = %fzero : vector<8xf32>, %fc0_2 = %fzero : vector<8xf32>, %fc0_3 = %fzero : vector<8xf32>, %fc1_0 = %fzero : vector<8xf32>, %fc1_1 = %fzero : vector<8xf32>, %fc1_2 = %fzero : vector<8xf32>, %fc1_3 = %fzero : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %chunk_blk = index.mul %chunk, %k_blocks : index
    %q4a_next_chunk = index.add %chunk, %one : index
    %q4a_has_next = index.cmp ult, %q4a_next_chunk, %nchunks : index

    // One lane owns one output row and packs each native Q4_K K32 group into a 16-byte IU4 LDS payload.
    %q4_weight_lane_count = index.constant 64 : index
    %q4_weight_lane_active = index.cmp ult, %tid, %q4_weight_lane_count : index
    scf.if %q4_weight_lane_active {
      %q4_weight_tid0 = index.rem %tid, %q4_weight_lane_count : index
      %q4_weight_tid = index.assume %q4_weight_tid0 [range(%q4_weight_tid0, 0, 63)] : index
      %q4_block_count = index.div %k_b, %q4_k_block : index
      %q4_block = index.div %chunk, %four : index
      %q4_pair = index.rem %chunk, %four : index
      %q4_row0 = index.add %row_base, %q4_weight_tid : index
      %q4_row = index.assume %q4_row0 [range(%q4_row0, 0, 262143)] : index
      // Capacity-neutral WMMA packing: one header and eight packed K32
      // payload fields, each interleaved across a 64-row output tile.
      %q4_row_group_size = index.constant 64 : index
      %q4_field_count = index.constant 9 : index
      %q4_field_bytes = index.constant 16 : index
      %q4_row_group = index.div %q4_row, %q4_row_group_size : index
      %q4_row_lane = index.rem %q4_row, %q4_row_group_size : index
      %q4_group_block0 = index.mul %q4_row_group, %q4_block_count : index
      %q4_group_block = index.add %q4_group_block0, %q4_block : index
      %q4_group_field_base = index.mul %q4_group_block, %q4_field_count : index
      %q4_header_lane_base = index.mul %q4_group_field_base, %q4_row_group_size : index
      %q4_header_lane = index.add %q4_header_lane_base, %q4_row_lane : index
      %q4_header_byte_index = index.mul %q4_header_lane, %q4_field_bytes : index
      %q4_header_byte_base = index.cast %q4_header_byte_index : index to offset
      %q4_header_view = buffer.view %src0_na[%q4_header_byte_base] : buffer -> view<4xi32>
      %q4_header = vector.load %q4_header_view[%zero] : view<4xi32> -> vector<4xi32>
      %q4_header_halves = vector.bitcast %q4_header : vector<4xi32> to vector<8xf16>
      %q4_d_f16 = vector.extract %q4_header_halves[0] : vector<8xf16> -> f16
      %q4_dmin_f16 = vector.extract %q4_header_halves[1] : vector<8xf16> -> f16
      %q4_scale0 = vector.extract %q4_header[1] : vector<4xi32> -> i32
      %q4_scale1 = vector.extract %q4_header[2] : vector<4xi32> -> i32
      %q4_scale2 = vector.extract %q4_header[3] : vector<4xi32> -> i32
      %q4_d = scalar.extf %q4_d_f16 : f16 to f32
      %q4_dmin = scalar.extf %q4_dmin_f16 : f16 to f32
      %q4_low_group = index.mul %q4_pair, %two : index
      %q4_high_group = index.add %q4_low_group, %one : index
      %q4_scale_low, %q4_min_low = func.call @qwen3_moe_q4k_scale_from_header(%q4_scale0, %q4_scale1, %q4_scale2, %q4_low_group) : (i32, i32, i32, index) -> (i32, i32)
      %q4_scale_high, %q4_min_high = func.call @qwen3_moe_q4k_scale_from_header(%q4_scale0, %q4_scale1, %q4_scale2, %q4_high_group) : (i32, i32, i32, index) -> (i32, i32)
      %q4_scale_low_f32 = scalar.uitofp %q4_scale_low : i32 to f32
      %q4_scale_high_f32 = scalar.uitofp %q4_scale_high : i32 to f32
      %q4_min_low_f32 = scalar.uitofp %q4_min_low : i32 to f32
      %q4_min_high_f32 = scalar.uitofp %q4_min_high : i32 to f32
      %q4_d0 = scalar.mulf %q4_d, %q4_scale_low_f32 : f32
      %q4_d1 = scalar.mulf %q4_d, %q4_scale_high_f32 : f32
      %q4_m0 = scalar.mulf %q4_dmin, %q4_min_low_f32 : f32
      %q4_m1 = scalar.mulf %q4_dmin, %q4_min_high_f32 : f32
      // Sum both nibbles while the materialized 16-byte U4 payload is live for affine correction.
      %q4_low_field0 = index.add %q4_low_group, %one : index
      %q4_high_field0 = index.add %q4_high_group, %one : index
      %q4_low_field = index.add %q4_group_field_base, %q4_low_field0 : index
      %q4_high_field = index.add %q4_group_field_base, %q4_high_field0 : index
      %q4_low_lane_base = index.mul %q4_low_field, %q4_row_group_size : index
      %q4_high_lane_base = index.mul %q4_high_field, %q4_row_group_size : index
      %q4_low_lane = index.add %q4_low_lane_base, %q4_row_lane : index
      %q4_high_lane = index.add %q4_high_lane_base, %q4_row_lane : index
      %q4_low_byte_index = index.mul %q4_low_lane, %q4_field_bytes : index
      %q4_high_byte_index = index.mul %q4_high_lane, %q4_field_bytes : index
      %q4_low_byte_base = index.cast %q4_low_byte_index : index to offset
      %q4_high_byte_base = index.cast %q4_high_byte_index : index to offset
      %q4_low_view = buffer.view %src0_na[%q4_low_byte_base] : buffer -> view<4xi32>
      %q4_high_view = buffer.view %src0_na[%q4_high_byte_base] : buffer -> view<4xi32>
      %q4_low_words = vector.load %q4_low_view[%zero] : view<4xi32> -> vector<4xi32>
      %q4_high_words = vector.load %q4_high_view[%zero] : view<4xi32> -> vector<4xi32>
      %q4_low_packed = vector.bitcast %q4_low_words : vector<4xi32> to vector<16xi8>
      %q4_high_packed = vector.bitcast %q4_high_words : vector<4xi32> to vector<16xi8>
      %q4_low_lo = vector.andi %q4_low_words, %q4_nibble_mask : vector<4xi32>
      %q4_low_hi0 = vector.shrui %q4_low_words, %q4_shift4v : vector<4xi32>
      %q4_low_hi = vector.andi %q4_low_hi0, %q4_nibble_mask : vector<4xi32>
      %q4_low_bytes = vector.addi %q4_low_lo, %q4_low_hi : vector<4xi32>
      %q4_low_pair0 = vector.andi %q4_low_bytes, %q4_pair_mask : vector<4xi32>
      %q4_low_pair_shift = vector.shrui %q4_low_bytes, %q4_shift8v : vector<4xi32>
      %q4_low_pair1 = vector.andi %q4_low_pair_shift, %q4_pair_mask : vector<4xi32>
      %q4_low_pairs = vector.addi %q4_low_pair0, %q4_low_pair1 : vector<4xi32>
      %q4_low_half0 = vector.andi %q4_low_pairs, %q4_half_mask : vector<4xi32>
      %q4_low_half1 = vector.shrui %q4_low_pairs, %q4_shift16v : vector<4xi32>
      %q4_low_word_sums = vector.addi %q4_low_half0, %q4_low_half1 : vector<4xi32>
      %q4_sum_low = vector.reduce<addi> %q4_low_word_sums, %zero_i32 : vector<4xi32>, i32
      %q4_high_lo = vector.andi %q4_high_words, %q4_nibble_mask : vector<4xi32>
      %q4_high_hi0 = vector.shrui %q4_high_words, %q4_shift4v : vector<4xi32>
      %q4_high_hi = vector.andi %q4_high_hi0, %q4_nibble_mask : vector<4xi32>
      %q4_high_bytes = vector.addi %q4_high_lo, %q4_high_hi : vector<4xi32>
      %q4_high_pair0 = vector.andi %q4_high_bytes, %q4_pair_mask : vector<4xi32>
      %q4_high_pair_shift = vector.shrui %q4_high_bytes, %q4_shift8v : vector<4xi32>
      %q4_high_pair1 = vector.andi %q4_high_pair_shift, %q4_pair_mask : vector<4xi32>
      %q4_high_pairs = vector.addi %q4_high_pair0, %q4_high_pair1 : vector<4xi32>
      %q4_high_half0 = vector.andi %q4_high_pairs, %q4_half_mask : vector<4xi32>
      %q4_high_half1 = vector.shrui %q4_high_pairs, %q4_shift16v : vector<4xi32>
      %q4_high_word_sums = vector.addi %q4_high_half0, %q4_high_half1 : vector<4xi32>
      %q4_sum_high = vector.reduce<addi> %q4_high_word_sums, %zero_i32 : vector<4xi32>, i32
      %q4_weight_row_base = index.mul %q4_weight_tid, %k_wstride : index
      %q4_w0 = index.assume %q4_weight_row_base [range(%q4_weight_row_base, 0, 2520)] : index
      %q4_w1_0 = index.add %q4_weight_row_base, %sixteen : index
      %q4_w1 = index.assume %q4_w1_0 [range(%q4_w1_0, 16, 2536)] : index
      vector.store %q4_low_packed, %wl_flat[%q4_w0] : vector<16xi8>, view<2560xi8>
      vector.store %q4_high_packed, %wl_flat[%q4_w1] : vector<16xi8>, view<2560xi8>
