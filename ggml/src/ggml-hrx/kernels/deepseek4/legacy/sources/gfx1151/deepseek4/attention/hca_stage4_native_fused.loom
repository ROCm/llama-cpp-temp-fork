// DSV4 HCA/CSA stage-4 native helpers.

func.def inline @dsv4_yarn_normal_pair_f32(
    %x0: f32, %x1: f32, %pair: index, %pos_i32: i32,
    %attn_factor: f32, %beta_fast: f32, %beta_slow: f32,
    %ext_factor: f32, %freq_base: f32, %freq_scale: f32,
    %n_ctx_orig: index) -> (f32, f32) {
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %two_f32 = scalar.constant 2.0 : f32
  %minus_two_f32 = scalar.constant -2.0 : f32
  %point_one_f32 = scalar.constant 0.1 : f32
  %point_001_f32 = scalar.constant 0.001 : f32
  %two_pi_f32 = scalar.constant 6.283185307179586 : f32
  %ln2_f32 = scalar.constant 0.6931471805599453 : f32
  %n_dims_i32 = scalar.constant 64 : i32
  %n_dims_f32 = scalar.sitofp %n_dims_i32 : i32 to f32
  %theta_exponent = scalar.divf<nnan|ninf|nsz> %minus_two_f32, %n_dims_f32 : f32
  %theta_scale = scalar.powf<afn> %freq_base, %theta_exponent : f32
  %pos_f32 = scalar.sitofp %pos_i32 : i32 to f32
  %pair_i32 = index.cast %pair : index to i32
  %pair_f32 = scalar.sitofp %pair_i32 : i32 to f32
  %theta_pow = scalar.powf<afn> %theta_scale, %pair_f32 : f32
  %theta_extrap = scalar.mulf<nnan|ninf|nsz> %pos_f32, %theta_pow : f32
  %theta_interp = scalar.mulf<nnan|ninf|nsz> %theta_extrap, %freq_scale : f32
  %n_ctx_orig_i32 = index.cast %n_ctx_orig : index to i32
  %n_ctx_orig_f32 = scalar.sitofp %n_ctx_orig_i32 : i32 to f32
  %freq_base_log2 = scalar.log2f<afn> %freq_base : f32
  %corr_den = scalar.mulf<nnan|ninf|nsz> %two_f32, %freq_base_log2 : f32
  %fast_two_pi = scalar.mulf<nnan|ninf|nsz> %beta_fast, %two_pi_f32 : f32
  %slow_two_pi = scalar.mulf<nnan|ninf|nsz> %beta_slow, %two_pi_f32 : f32
  %fast_arg = scalar.divf<nnan|ninf|nsz> %n_ctx_orig_f32, %fast_two_pi : f32
  %slow_arg = scalar.divf<nnan|ninf|nsz> %n_ctx_orig_f32, %slow_two_pi : f32
  %fast_log2 = scalar.log2f<afn> %fast_arg : f32
  %slow_log2 = scalar.log2f<afn> %slow_arg : f32
  %corr_start_num = scalar.mulf<nnan|ninf|nsz> %n_dims_f32, %fast_log2 : f32
  %corr_end_num = scalar.mulf<nnan|ninf|nsz> %n_dims_f32, %slow_log2 : f32
  %corr_start_raw = scalar.divf<nnan|ninf|nsz> %corr_start_num, %corr_den : f32
  %corr_end_raw = scalar.divf<nnan|ninf|nsz> %corr_end_num, %corr_den : f32
  %corr_start_floor = scalar.floorf %corr_start_raw : f32
  %corr_end_ceil = scalar.ceilf %corr_end_raw : f32
  %corr_start_lt_zero = scalar.cmpf olt, %corr_start_floor, %zero_f32 : f32
  %corr_start = scf.if %corr_start_lt_zero -> (f32) {
    scf.yield %zero_f32 : f32
  } else {
    scf.yield %corr_start_floor : f32
  }
  %n_dims_minus_one = scalar.subf<nnan|ninf|nsz> %n_dims_f32, %one_f32 : f32
  %corr_end_gt_max = scalar.cmpf ogt, %corr_end_ceil, %n_dims_minus_one : f32
  %corr_end = scf.if %corr_end_gt_max -> (f32) {
    scf.yield %n_dims_minus_one : f32
  } else {
    scf.yield %corr_end_ceil : f32
  }
  %corr_span = scalar.subf<nnan|ninf|nsz> %corr_end, %corr_start : f32
  %corr_span_small = scalar.cmpf olt, %corr_span, %point_001_f32 : f32
  %corr_den_safe = scf.if %corr_span_small -> (f32) {
    scf.yield %point_001_f32 : f32
  } else {
    scf.yield %corr_span : f32
  }
  %pair_minus_start = scalar.subf<nnan|ninf|nsz> %pair_f32, %corr_start : f32
  %ramp_unclamped = scalar.divf<nnan|ninf|nsz> %pair_minus_start, %corr_den_safe : f32
  %ramp_lt_zero = scalar.cmpf olt, %ramp_unclamped, %zero_f32 : f32
  %ramp_nonnegative = scf.if %ramp_lt_zero -> (f32) {
    scf.yield %zero_f32 : f32
  } else {
    scf.yield %ramp_unclamped : f32
  }
  %ramp_gt_one = scalar.cmpf ogt, %ramp_nonnegative, %one_f32 : f32
  %ramp_clamped = scf.if %ramp_gt_one -> (f32) {
    scf.yield %one_f32 : f32
  } else {
    scf.yield %ramp_nonnegative : f32
  }
  %ramp = scalar.subf<nnan|ninf|nsz> %one_f32, %ramp_clamped : f32
  %ramp_mix = scalar.mulf<nnan|ninf|nsz> %ramp, %ext_factor : f32
  %one_minus_mix = scalar.subf<nnan|ninf|nsz> %one_f32, %ramp_mix : f32
  %interp_part = scalar.mulf<nnan|ninf|nsz> %theta_interp, %one_minus_mix : f32
  %extrap_part = scalar.mulf<nnan|ninf|nsz> %theta_extrap, %ramp_mix : f32
  %theta = scalar.addf<nnan|ninf|nsz> %interp_part, %extrap_part : f32
  %freq_scale_inv = scalar.divf<nnan|ninf|nsz> %one_f32, %freq_scale : f32
  %freq_scale_inv_log2 = scalar.log2f<afn> %freq_scale_inv : f32
  %freq_scale_inv_log = scalar.mulf<nnan|ninf|nsz> %freq_scale_inv_log2, %ln2_f32 : f32
  %mscale_delta0 = scalar.mulf<nnan|ninf|nsz> %point_one_f32, %freq_scale_inv_log : f32
  %mscale_delta = scalar.addf<nnan|ninf|nsz> %one_f32, %mscale_delta0 : f32
  %mscale = scalar.mulf<nnan|ninf|nsz> %attn_factor, %mscale_delta : f32
  %cos0 = scalar.cosf<afn> %theta : f32
  %sin0 = scalar.sinf<afn> %theta : f32
  %cos_theta = scalar.mulf<nnan|ninf|nsz> %cos0, %mscale : f32
  %sin_theta = scalar.mulf<nnan|ninf|nsz> %sin0, %mscale : f32
  %x0_cos = scalar.mulf<nnan|ninf|nsz> %x0, %cos_theta : f32
  %x1_sin = scalar.mulf<nnan|ninf|nsz> %x1, %sin_theta : f32
  %out0 = scalar.subf<nnan|ninf|nsz> %x0_cos, %x1_sin : f32
  %x0_sin = scalar.mulf<nnan|ninf|nsz> %x0, %sin_theta : f32
  %x1_cos = scalar.mulf<nnan|ninf|nsz> %x1, %cos_theta : f32
  %out1 = scalar.addf<nnan|ninf|nsz> %x0_sin, %x1_cos : f32
  func.return %out0, %out1 : f32, f32
}

kernel.def export("hrx2_dsv4_rms_mul_qact_q8_k1024") @hrx2_dsv4_rms_mul_qact_q8_k1024() {
  %one = index.constant 1 : index
  %tokens = index.constant 512 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %one, %one)
      workgroup_size(%threads, %one, %one) : index
} launch(%eps: f32, %src: buffer, %weight: buffer, %qs: buffer, %ds: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %c1024 = index.constant 1024 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_v4 = vector.constant 0.0 : vector<4xf32>
  %amax_eps = scalar.constant 1.0000000000000001e-30 : f32
  %inv127 = scalar.constant 0.007874015748031496 : f32
  %f127 = scalar.constant 127.0 : f32
  %xor1 = scalar.constant 1 : i32
  %xor2 = scalar.constant 2 : i32
  %xor4 = scalar.constant 4 : i32
  %shuffle_width = scalar.constant 32 : i32
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %tid0 = kernel.workitem.id<x> : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %lane = index.rem %tid, %c32 : index
  %lane_in_group = index.rem %lane, %c8 : index
  %block = index.div %tid, %c8 : index
  %is_scale_leader = index.cmp eq, %lane_in_group, %zero : index
  %src_g = buffer.assume.memory_space<global> %src : buffer
  %weight_g = buffer.assume.memory_space<global> %weight : buffer
  %qs_g = buffer.assume.memory_space<global> %qs : buffer
  %ds_g = buffer.assume.memory_space<global> %ds : buffer
  %src_na, %weight_na, %qs_na, %ds_na = buffer.assume.noalias %src_g, %weight_g, %qs_g, %ds_g : buffer, buffer, buffer, buffer
  %src_v = buffer.view %src_na[%base] : buffer -> view<524288xf32, #dense>
  %weight_v = buffer.view %weight_na[%base] : buffer -> view<1024xf32, #dense>
  %qs_v = buffer.view %qs_na[%base] : buffer -> view<131072xi32, #dense>
  %ds_v = buffer.view %ds_na[%base] : buffer -> view<16384xf32, #dense>
  %row_base0 = index.mul %token, %c1024 : index
  %row_base = index.assume %row_base0 [range(%row_base0, 0, 523264)] : index
  %sum = scf.for %col = [%tid to %c1024 step %c256]
      (%acc = %zero_f32 : f32) -> (f32) {
    %index0 = index.add %row_base, %col : index
    %index = index.assume %index0 [range(%index0, 0, 524287)] : index
    %value = view.load %src_v[%index] : view<524288xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %row_sum = kernel.workgroup.reduce<addf> %sum : f32
  %ncols_i32 = scalar.constant 1024 : i32
  %ncols_f32 = scalar.sitofp %ncols_i32 : i32 to f32
  %mean = scalar.divf<reassoc|nnan|ninf|nsz> %row_sum, %ncols_f32 : f32
  %biased = scalar.addf<nnan|ninf|nsz> %mean, %eps : f32
  %rms_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased : f32
  %coord_base0 = index.mul %block, %c32 : index
  %lane_coord = index.mul %lane_in_group, %four : index
  %coord_base = index.add %coord_base0, %lane_coord : index
  %values = scf.for %j = [%zero to %four step %one]
      (%acc = %zero_v4 : vector<4xf32>) -> (vector<4xf32>) {
    %coord = index.add %coord_base, %j : index
    %index0 = index.add %row_base, %coord : index
    %index = index.assume %index0 [range(%index0, 0, 524287)] : index
    %x = view.load %src_v[%index] : view<524288xf32, #dense> -> f32
    %normed = scalar.mulf<nnan|ninf|nsz> %x, %rms_scale : f32
    %w = view.load %weight_v[%coord] : view<1024xf32, #dense> -> f32
    %value = scalar.mulf<nnan|ninf|nsz> %normed, %w : f32
    %next = vector.insert %value into %acc[%j] : f32, vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  %abs_values = vector.absf %values : vector<4xf32>
  %lane_max = vector.reduce<maxnumf, reassoc|nnan|nsz> %abs_values, %zero_f32 : vector<4xf32>, f32
  %max_x1_peer, %max_x1_valid = kernel.subgroup.shuffle<xor> %lane_max, %xor1, %shuffle_width : f32, i32, i32
  %max_x1 = scalar.maxnumf %lane_max, %max_x1_peer : f32
  %max_x2_peer, %max_x2_valid = kernel.subgroup.shuffle<xor> %max_x1, %xor2, %shuffle_width : f32, i32, i32
  %max_x2 = scalar.maxnumf %max_x1, %max_x2_peer : f32
  %max_x4_peer, %max_x4_valid = kernel.subgroup.shuffle<xor> %max_x2, %xor4, %shuffle_width : f32, i32, i32
  %group_max = scalar.maxnumf %max_x2, %max_x4_peer : f32
  %amax = scalar.maxnumf %group_max, %amax_eps : f32
  %a_scale = scalar.mulf<reassoc|nnan|ninf|nsz> %amax, %inv127 : f32
  %a_rscale = scalar.divf<reassoc|nnan|ninf|nsz> %f127, %amax : f32
  %token_group_base = index.mul %token, %c32 : index
  %gid = index.add %token_group_base, %block : index
  scf.if %is_scale_leader {
    view.store %a_scale, %ds_v[%gid] : f32, view<16384xf32, #dense>
  }
  %rs = vector.splat %a_rscale : vector<4xf32>
  %scaled = vector.mulf %values, %rs : vector<4xf32>
  %rounded = vector.roundf %scaled : vector<4xf32>
  %q32 = vector.fptosi %rounded : vector<4xf32> to vector<4xi32>
  %q8 = vector.trunci %q32 : vector<4xi32> to vector<4xi8>
  %qwordv = vector.bitcast %q8 : vector<4xi8> to vector<1xi32>
  %qword = vector.extract %qwordv[0] : vector<1xi32> -> i32
  %word_base = index.mul %gid, %c8 : index
  %word_index = index.add %word_base, %lane_in_group : index
  view.store %qword, %qs_v[%word_index] : i32, view<131072xi32, #dense>
  kernel.return
}

kernel.def export("hrx2_dsv4_hca_stage4_terminal_f32_f16") @hrx2_dsv4_hca_stage4_terminal_f32_f16() {
  %one = index.constant 1 : index
  %groups = index.constant 32768 : index
  %threads = index.constant 256 : index
