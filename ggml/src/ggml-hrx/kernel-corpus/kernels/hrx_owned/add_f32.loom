amdgpu.target<gfx11-generic> @ggml_add_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.scale.scale : f32

config.decl @ggml.scale.bias : f32

kernel.def target(@ggml_add_gfx11_wave64) export("ggml_add_f32") @ggml_add_f32(%element_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%element_count: index, %a: buffer, %b: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %c256 = index.constant 256 : index
  %base0 = index.mul %workgroup, %c256 : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %c0_offset = index.constant 0 : offset
  // The two read-only operands may be the same GGML value (for example, x + x).
  // Only the output is required to be disjoint from each input.
  %a_noalias, %output_from_a_noalias = buffer.assume.noalias %a, %output : buffer, buffer
  %b_noalias, %output_noalias = buffer.assume.noalias %b, %output_from_a_noalias : buffer, buffer
  %a_view = buffer.view %a_noalias[%c0_offset] : buffer -> view<[%count]xf32>
  %b_view = buffer.view %b_noalias[%c0_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %a_value = view.load %a_view[%linear] : view<[%count]xf32> -> f32
    %b_value = view.load %b_view[%linear] : view<[%count]xf32> -> f32
    %sum = scalar.addf %a_value, %b_value : f32
    view.store %sum, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

check.case public @ggml_add_f32_small_case {
  %c4 = check.literal value(4) : index
  %a = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %b = check.generate.fill value(10.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(11.0) step(1.0) : tensor<4xf32>
  kernel.launch @ggml_add_f32[%c4](%c4, %a, %b, %output) : [index](index, tensor<4xf32>, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@ggml_add_f32_small_case> @ggml_add_f32_small

kernel.def target(@ggml_add_gfx11_wave64) export("ggml_scale_bias_f32") @ggml_scale_bias_f32(%element_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%element_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 134217728)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %c256 = index.constant 256 : index
  %base0 = index.mul %workgroup, %c256 : index
  %linear0 = index.add %base0, %workitem : index
  %linear = index.assume %linear0 [range(%linear0, 0, 134217983)] : index
  %in_bounds = index.cmp ult, %linear, %count : index
  %scale = config.get @ggml.scale.scale : f32
  %bias = config.get @ggml.scale.bias : f32
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%count]xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%count]xf32>
  scf.if %in_bounds {
    %input_value = view.load %input_view[%linear] : view<[%count]xf32> -> f32
    %scaled = scalar.mulf %input_value, %scale : f32
    %result = scalar.addf %scaled, %bias : f32
    view.store %result, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

check.case public @ggml_scale_bias_f32_small_case {
  %c4 = check.literal value(4) : index
  %input = check.generate.iota offset(-2.0) step(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(-3.0) step(2.0) : tensor<4xf32>
  kernel.launch @ggml_scale_bias_f32[%c4](%c4, %input, %output) : [index](index, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@ggml_scale_bias_f32_small_case> @ggml_scale_bias_f32_small
