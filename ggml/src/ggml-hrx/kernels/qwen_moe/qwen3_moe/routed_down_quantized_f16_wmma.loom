      %rd_p1_g1_own_nib = vector.andi %rd_p1_g1_own_shift, %nibble_mask_v4 : vector<4xi32>
      %rd_p1_g1_qh_masked = vector.andi %rd_qh, %rd_qh_mask5 : vector<4xi32>
