      %rd_p1_q0_c = index.constant 768 : index
      %rd_p1_q0_i = index.add %rd_p1_half_base, %rd_p1_q0_c : index
      %rd_p1_q0_o = index.cast %rd_p1_q0_i : index to offset
      %rd_p1_q0_v = buffer.view %src0_na[%rd_p1_q0_o] : buffer -> view<4xi32>
      %rd_p1_pack0 = vector.load %rd_p1_q0_v[%zero] : view<4xi32> -> vector<4xi32>
      %rd_p1_q1_c = index.constant 1024 : index
      %rd_p1_q1_i = index.add %rd_p1_half_base, %rd_p1_q1_c : index
