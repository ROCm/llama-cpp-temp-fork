      workgroup_size(%threads, %one, %one) : index
} launch(%eps: f32, %attn_factor: f32, %beta_fast: f32, %beta_slow: f32,
         %ext_factor: f32, %freq_base: f32, %freq_scale: f32,
         %primary: buffer, %secondary: buffer, %secondary_weight: buffer,
         %pos: buffer, %cache_indices: buffer, %cache_dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
