          %rhs0_values = vector.bitcast %rhs0_bits : vector<8xi32> to vector<16xbf16>
          %rhs1_values = vector.bitcast %rhs1_bits : vector<8xi32> to vector<16xbf16>
          %rhs0 = vector.fragment<rhs> %rhs0_values shape [%sixteen, %sixteen] : vector<16xbf16>
          %rhs1 = vector.fragment<rhs> %rhs1_values shape [%sixteen, %sixteen] : vector<16xbf16>
          %lhs0, %lhs1 = scf.if %act_buffer_is_zero -> (vector<16xbf16>, vector<16xbf16>) {
            %lhs0_ping = vector.fragment.load<lhs> %act0_view[%zero, %zero] shape [%sixteen, %sixteen] : view<16x32xbf16, #dense> -> vector<16xbf16>
            %lhs1_ping = vector.fragment.load<lhs> %act0_view[%zero, %sixteen] shape [%sixteen, %sixteen] : view<16x32xbf16, #dense> -> vector<16xbf16>
            scf.yield %lhs0_ping, %lhs1_ping : vector<16xbf16>, vector<16xbf16>
          } else {
