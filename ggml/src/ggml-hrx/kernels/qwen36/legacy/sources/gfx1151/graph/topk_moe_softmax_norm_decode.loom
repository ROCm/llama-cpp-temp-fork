// Exact one-wave Qwen MoE router tail for decode (one token).
//
// The live allocator aliases the 8-f32 terminal weights output with part of the
// 256-f32 logits allocation. Every lane therefore loads all eight logits it
// owns before the first store, and a workgroup barrier separates the global
// reads from lane 0's writes. The full 256-i32 ARGSORT backing is a separate
// allocation; only words 0..7 are materialized because its sole live view is
// the top-8 prefix.
//
// Ranking is performed on the rounded full-softmax probabilities, not logits.
// Repeated argmax plus the lower expert id tie break exactly implements stable
// descending ARGSORT for the first eight entries.

kernel.def export("hrx2_topk_moe_softmax_norm_decode_f32") @hrx2_topk_moe_softmax_norm_decode_f32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit)
      workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%logits: buffer, %ids: buffer, %weights: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eight = index.constant 8 : index
  %thirty_two = index.constant 32 : index
  %sixty_four = index.constant 64 : index
  %ninety_six = index.constant 96 : index
  %one_twenty_eight = index.constant 128 : index
  %one_sixty = index.constant 160 : index
  %one_ninety_two = index.constant 192 : index
  %two_twenty_four = index.constant 224 : index

  %zero_i32 = scalar.constant 0 : i32
  %sentinel_i32 = scalar.constant 256 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %neg_max_f32 = scalar.constant -3.4028234663852886e+38 : f32
  %denom_min = scalar.constant 6.103515625e-5 : f32
  %sentinel_i32_v = vector.constant 256 : vector<8xi32>
  %empty_ids = vector.constant 256 : vector<8xi32>
  %empty_probs = vector.constant 0.0 : vector<8xf32>
  %neg_max_v = vector.constant -3.4028234663852886e+38 : vector<8xf32>

  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index

  %expert0 = index.add %lane, %zero : index
  %expert1_0 = index.add %lane, %thirty_two : index
  %expert1 = index.assume %expert1_0 [range(%expert1_0, 32, 63)] : index
  %expert2_0 = index.add %lane, %sixty_four : index
  %expert2 = index.assume %expert2_0 [range(%expert2_0, 64, 95)] : index
  %expert3_0 = index.add %lane, %ninety_six : index
  %expert3 = index.assume %expert3_0 [range(%expert3_0, 96, 127)] : index
  %expert4_0 = index.add %lane, %one_twenty_eight : index
  %expert4 = index.assume %expert4_0 [range(%expert4_0, 128, 159)] : index
  %expert5_0 = index.add %lane, %one_sixty : index
  %expert5 = index.assume %expert5_0 [range(%expert5_0, 160, 191)] : index
  %expert6_0 = index.add %lane, %one_ninety_two : index
  %expert6 = index.assume %expert6_0 [range(%expert6_0, 192, 223)] : index
  %expert7_0 = index.add %lane, %two_twenty_four : index
  %expert7 = index.assume %expert7_0 [range(%expert7_0, 224, 255)] : index

  %expert0_i32 = index.cast %expert0 : index to i32
  %expert1_i32 = index.cast %expert1 : index to i32
  %expert2_i32 = index.cast %expert2 : index to i32
  %expert3_i32 = index.cast %expert3 : index to i32
  %expert4_i32 = index.cast %expert4 : index to i32
  %expert5_i32 = index.cast %expert5 : index to i32
  %expert6_i32 = index.cast %expert6 : index to i32
  %expert7_i32 = index.cast %expert7 : index to i32
  %expert_ids = vector.from_elements %expert0_i32, %expert1_i32, %expert2_i32, %expert3_i32, %expert4_i32, %expert5_i32, %expert6_i32, %expert7_i32 : vector<8xi32>

  %logits_global = buffer.assume.memory_space<global> %logits : buffer
  %ids_global = buffer.assume.memory_space<global> %ids : buffer
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  // Do not assert logits/weights noalias: they overlap in the live graph.
  %logits_view = buffer.view %logits_global[%base] : buffer -> view<256xf32>
  %ids_view = buffer.view %ids_global[%base] : buffer -> view<256xi32>
  %weights_view = buffer.view %weights_global[%base] : buffer -> view<8xf32>

  %x0 = view.load %logits_view[%expert0] : view<256xf32> -> f32
  %x1 = view.load %logits_view[%expert1] : view<256xf32> -> f32
  %x2 = view.load %logits_view[%expert2] : view<256xf32> -> f32
  %x3 = view.load %logits_view[%expert3] : view<256xf32> -> f32
  %x4 = view.load %logits_view[%expert4] : view<256xf32> -> f32
  %x5 = view.load %logits_view[%expert5] : view<256xf32> -> f32
  %x6 = view.load %logits_view[%expert6] : view<256xf32> -> f32
  %x7 = view.load %logits_view[%expert7] : view<256xf32> -> f32
  %values = vector.from_elements %x0, %x1, %x2, %x3, %x4, %x5, %x6, %x7 : vector<8xf32>

  // All 256 logits are now resident in the wave before an aliased output store.
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %lane_max = vector.reduce<maxnumf> %values, %neg_max_f32 : vector<8xf32>, f32
  %row_max = kernel.subgroup.reduce<maxnumf> %lane_max : f32
  %row_max_v = vector.splat %row_max : vector<8xf32>
  %shifted = vector.subf<nnan|ninf|nsz> %values, %row_max_v : vector<8xf32>
  %exps = vector.expf<afn> %shifted : vector<8xf32>
  %lane_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %exps, %zero_f32 : vector<8xf32>, f32
  %row_sum = kernel.subgroup.reduce<addf> %lane_sum : f32
  %row_sum_v = vector.splat %row_sum : vector<8xf32>
  %probs = vector.divf<nnan|ninf|nsz|arcp> %exps, %row_sum_v : vector<8xf32>

  %live_final, %selected_ids, %selected_probs = scf.for %slot = [%zero to %eight step %one](%live = %probs : vector<8xf32>, %ids_acc = %empty_ids : vector<8xi32>, %probs_acc = %empty_probs : vector<8xf32>) -> (vector<8xf32>, vector<8xi32>, vector<8xf32>) unroll {
    %lane_best = vector.reduce<maxnumf> %live, %neg_max_f32 : vector<8xf32>, f32
    %winner_prob = kernel.subgroup.reduce<maxnumf> %lane_best : f32
    %winner_prob_v = vector.splat %winner_prob : vector<8xf32>
    %matching = vector.cmpf oeq, %live, %winner_prob_v : vector<8xf32> -> vector<8xi1>
    %matching_ids = vector.select %matching, %expert_ids, %sentinel_i32_v : vector<8xi32>
    %lane_winner_id = vector.reduce<minsi> %matching_ids, %sentinel_i32 : vector<8xi32>, i32
    %winner_id = kernel.subgroup.reduce<minsi> %lane_winner_id : i32

    %ids_next = vector.insert %winner_id into %ids_acc[%slot] : i32, vector<8xi32>
    %probs_next = vector.insert %winner_prob into %probs_acc[%slot] : f32, vector<8xf32>
    %winner_id_v = vector.splat %winner_id : vector<8xi32>
    %winner_mask = vector.cmpi eq, %expert_ids, %winner_id_v : vector<8xi32> -> vector<8xi1>
    %live_next = vector.select %winner_mask, %neg_max_v, %live : vector<8xf32>
    scf.yield %live_next, %ids_next, %probs_next : vector<8xf32>, vector<8xi32>, vector<8xf32>
  }

  %selected_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %selected_probs, %zero_f32 : vector<8xf32>, f32
  %denom = scalar.maxnumf %selected_sum, %denom_min : f32

  %lane_i32 = index.cast %lane : index to i32
  %lane_is_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %lane_is_zero {
    scf.for %slot = [%zero to %eight step %one] unroll {
      %winner_id = vector.extract %selected_ids[%slot] : vector<8xi32> -> i32
      %winner_prob = vector.extract %selected_probs[%slot] : vector<8xf32> -> f32
      %weight = scalar.divf<nnan|ninf|nsz|arcp> %winner_prob, %denom : f32
      view.store %winner_id, %ids_view[%slot] : i32, view<256xi32>
      view.store %weight, %weights_view[%slot] : f32, view<8xf32>
    }
  }
  kernel.return
}
