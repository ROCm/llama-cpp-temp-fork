      %p1_3_t1_rb = vector.fragment<rhs> %p1_3_t1_rb_words shape [%k_wmma, %k_wmma] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
      %p1_3_t1_iz = vector.fragment<init> %izero8 shape [%k_wmma, %k_wmma] : vector<8xi32>
