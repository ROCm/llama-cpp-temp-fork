      %p1_3_t1_auv = vector.sitofp %p1_3_t1_aui : vector<8xi32> to vector<8xf32>
      %p1_3_t1_f = vector.sitofp %p1_3_t1_i1 : vector<8xi32> to vector<8xf32>
      %p1_3_t1_u = vector.mulf %p1_3_t1_f, %p1_3_t1_dv : vector<8xf32>
      %p1_3_t1_c = vector.mulf %p1_3_t1_auv, %p1_3_t1_mv : vector<8xf32>
